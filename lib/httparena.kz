// HttpArena HTTP/1.1 endpoints — validate.sh is the spec.

~import std/compress

const std = @import("std");
const ha_compress = @import("root").koru_std.koru_compress;
const ha_freestanding = @import("builtin").target.os.tag == .freestanding;

// Reusable gzip machinery — the scratch buffer is threadlocal and grows to
// the largest body seen. Every request is still serialized and compressed
// fresh; only the allocation is shared. The returned slices are borrowed
// and must not be freed. std/compress covers every input size on every
// target (multi-block past 64KB) — there is no zlib left in this path.
threadlocal var gz_buf: []u8 = &.{};
threadlocal var json_scratch: []u8 = &.{};

fn gzipBody(allocator: std.mem.Allocator, content: []const u8) ?[]u8 {
    // std/compress is the whole path on every target: dynamic Huffman with
    // a per-worker cached tree, slicing-by-8 CRC trailer, tighter output
    // than zlib at BEST_SPEED and a faster encode measured both per-call
    // and end-to-end.
    const need = ha_compress.gzipBound(content.len);
    if (gz_buf.len < need) {
        const nb = allocator.alloc(u8, need) catch return null;
        if (gz_buf.len > 0) allocator.free(gz_buf);
        gz_buf = nb;
    }
    return gz_buf[0..ha_compress.gzipInto(content, gz_buf)];
}

const orisha = @import("root").koru_orisha;
const Impl = struct {
        const alloc = @import("root").koru_allocator();
        const Rating = struct { score: i64, count: i64 };
        const DatasetItem = struct {
            id: i64,
            name: []const u8,
            category: []const u8,
            price: i64,
            quantity: i64,
            active: bool,
            tags: []const []const u8,
            rating: Rating,
        };

        var dataset_parsed: ?std.json.Parsed([]DatasetItem) = null;
        var dataset_bytes: ?[]u8 = null;

        threadlocal var body_work: [192 * 1024]u8 = undefined;
        threadlocal var http_out: [196 * 1024]u8 = undefined;

        // Pre-rendered: answer() emits the whole message verbatim (no Date/X-Powered-By tax).
        const pipeline_response =
            "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 2\r\n\r\nok";

        // The response item as the wire carries it — the dataset fields plus
        // the per-request total. Serialized by Stringify on every request:
        // the profiles measure the serializer, not a memo table.
        const ResponseItem = struct {
            id: i64,
            name: []const u8,
            category: []const u8,
            price: i64,
            quantity: i64,
            active: bool,
            tags: []const []const u8,
            rating: Rating,
            total: i64,
        };

        const Body = struct {
            items: []const ResponseItem,
            count: usize,
        };

        // Room in front of the body for the response head — the body renders
        // first (Content-Length needs its length), the head lands directly
        // ahead of it, and head+body leave as one contiguous slice.
        const HEAD_RESERVE: usize = 128;

        // Per-request items — totals are live (price*quantity*m); everything
        // else comes from the parsed fixture. Sized to the shipped dataset,
        // which the first load bounds.
        const MAX_ITEMS = 1024;
        threadlocal var tl_items: [MAX_ITEMS]ResponseItem = undefined;

        fn responseItems(source: []const DatasetItem, count: usize, m: i64) ?[]const ResponseItem {
            if (count > MAX_ITEMS) return null;
            for (0..count) |i| {
                const src = source[i];
                tl_items[i] = .{
                    .id = src.id,
                    .name = src.name,
                    .category = src.category,
                    .price = src.price,
                    .quantity = src.quantity,
                    .active = src.active,
                    .tags = src.tags,
                    .rating = src.rating,
                    .total = src.price * src.quantity * m,
                };
            }
            return tl_items[0..count];
        }

        fn finishHttp(content_type: []const u8, body: []const u8) ?[]const u8 {
            return std.fmt.bufPrint(
                &http_out,
                "HTTP/1.1 200 OK\r\nContent-Type: {s}\r\nContent-Length: {d}\r\n\r\n{s}",
                .{ content_type, body.len, body },
            ) catch null;
        }

        fn plainIntResponse(n: i64) ?[]const u8 {
            var num: [32]u8 = undefined;
            const num_slice = std.fmt.bufPrint(&num, "{d}", .{n}) catch return null;
            return finishHttp("text/plain", num_slice);
        }

        // The complete wire message — status line, headers, JSON — written
        // once, contiguously. The body is serialized per request through
        // Stringify into the back of the staging span (HEAD_RESERVE leaves
        // room for the head, since Content-Length needs the body's length
        // before the head can exist); the head lands directly in front of
        // it and the message slides to the staging boundary. When the
        // request rides an io_uring conn whose send buffer is unpinned,
        // ringRenderTarget hands back that exact span and appendPending
        // claims it by pointer — the only move is the head-align shift.
        fn jsonResponse(source: []const DatasetItem, count: usize, m: i64, fd: usize) ?[]const u8 {
            const items = responseItems(source, count, m) orelse return null;
            const bound = HEAD_RESERVE + count * 256 + 64;
            const dst: []u8 = if (fd != 0 and !ha_freestanding)
                (orisha.koru_pump.ringRenderTarget(@intCast(fd), bound) orelse
                    (if (body_work.len >= bound) body_work[0..] else return null))
            else
                (if (body_work.len >= bound) body_work[0..] else return null);
            var w = std.Io.Writer.fixed(dst[HEAD_RESERVE..]);
            std.json.Stringify.value(Body{ .items = items, .count = count }, .{}, &w) catch return null;
            const body_len = w.end;
            var hdr: [200]u8 = undefined;
            // The Date line is embedded at render time — httpDateLine() is
            // the per-second threadlocal the send path splices in anyway —
            // so the baked-head contract finds the field already present and
            // emits the message as one unspliced segment.
            const hs = std.fmt.bufPrint(&hdr,
                "HTTP/1.1 200 OK\r\n{s}Content-Type: application/json\r\nContent-Length: {d}\r\n\r\n",
                .{ orisha.httpDateLine(), body_len }) catch return null;
            if (hs.len > HEAD_RESERVE) return null;
            const start = HEAD_RESERVE - hs.len;
            @memcpy(dst[start..HEAD_RESERVE], hs);
            const msg_len = hs.len + body_len;
            // No slide to dst[0]: on a ring conn the send path claims the
            // span with a send_base offset, so the whole 8 KB+ body move is
            // gone; off-ring the slice copies into pending either way.
            return dst[start .. start + msg_len];
        }

        // Serialize {"items":[...],"count":N} per request through Stringify
        // into the reusable scratch buffer. Null on overflow → heap fallback.
        fn jsonBodyScratch(source: []const DatasetItem, count: usize, m: i64) ?[]const u8 {
            const items = responseItems(source, count, m) orelse return null;
            const need = count * 256 + 64;
            if (json_scratch.len < need) {
                const nb = alloc.alloc(u8, need) catch return null;
                if (json_scratch.len > 0) alloc.free(json_scratch);
                json_scratch = nb;
            }
            var w = std.Io.Writer.fixed(json_scratch);
            std.json.Stringify.value(Body{ .items = items, .count = count }, .{}, &w) catch return null;
            return w.buffered();
        }

        // Freestanding has no filesystem and no env: the dataset the file
        // would hold is baked into the image instead. Same parsed result,
        // one less machine to ask for it.
        const dataset_baked: []const u8 = if (ha_freestanding) @embedFile("data/dataset.json") else &.{};

        fn datasetItems() ![]const DatasetItem {
            if (dataset_parsed) |parsed| return parsed.value;
            if (ha_freestanding) {
                dataset_parsed = try std.json.parseFromSlice([]DatasetItem, alloc, dataset_baked, .{ .allocate = .alloc_always });
                return dataset_parsed.?.value;
            }
            const path = std.posix.getenv("DATASET_PATH") orelse "/data/dataset.json";
            dataset_bytes = std.fs.cwd().readFileAlloc(alloc, path, 16 * 1024 * 1024) catch
                try std.fs.cwd().readFileAlloc(alloc, "data/dataset.json", 16 * 1024 * 1024);
            dataset_parsed = try std.json.parseFromSlice([]DatasetItem, alloc, dataset_bytes.?, .{ .allocate = .alloc_always });
            return dataset_parsed.?.value;
        }

        fn sumQueryValues(query: ?[]const u8) i64 {
            var sum: i64 = 0;
            const q = query orelse return 0;
            var parts = std.mem.splitScalar(u8, q, '&');
            while (parts.next()) |pair| {
                const eq = std.mem.indexOfScalar(u8, pair, '=') orelse continue;
                sum += std.fmt.parseInt(i64, pair[eq + 1 ..], 10) catch 0;
            }
            return sum;
        }

        fn queryParamInt(query: ?[]const u8, key: []const u8, fallback: i64) i64 {
            const q = query orelse return fallback;
            var parts = std.mem.splitScalar(u8, q, '&');
            while (parts.next()) |pair| {
                const eq = std.mem.indexOfScalar(u8, pair, '=') orelse continue;
                if (!std.mem.eql(u8, pair[0..eq], key)) continue;
                return std.fmt.parseInt(i64, pair[eq + 1 ..], 10) catch fallback;
            }
            return fallback;
        }

        fn bodyAsInt(body: ?[]const u8) i64 {
            const b = body orelse return 0;
            const trimmed = std.mem.trim(u8, b, " \t\r\n");
            if (trimmed.len == 0) return 0;
            return std.fmt.parseInt(i64, trimmed, 10) catch 0;
        }

        fn wantsGzip(accept_encoding: ?[]const u8) bool {
            const ae = accept_encoding orelse return false;
            var lower_buf: [256]u8 = undefined;
            if (ae.len > lower_buf.len) return false;
            const lower = std.ascii.lowerString(&lower_buf, ae);
            return std.mem.indexOf(u8, lower, "gzip") != null;
        }

        fn handlePipeline(r: *orisha.Request) orisha.Response {
            _ = r;
            return .{ .status = 200, .body = pipeline_response, .content_type = "text/plain", .body_allocated = false, .body_static = true };
        }

        fn handleBaseline(r: *orisha.Request) orisha.Response {
            var total = sumQueryValues(r.query);
            if (std.mem.eql(u8, r.method, "POST")) total += bodyAsInt(r.body);
            if (plainIntResponse(total)) |msg| {
                return .{ .status = 200, .body = msg, .content_type = "text/plain", .body_allocated = false };
            }
            const body = std.fmt.allocPrint(alloc, "{d}", .{total}) catch {
                return .{ .status = 500, .body = "out of memory", .content_type = "text/plain", .body_allocated = false };
            };
            return .{ .status = 200, .body = body, .content_type = "text/plain", .body_allocated = true };
        }

        fn handleJson(r: *orisha.Request, count_str: []const u8) orisha.Response {
            const want_count = std.fmt.parseInt(usize, count_str, 10) catch 0;
            const m = queryParamInt(r.query, "m", 1);
            const source = datasetItems() catch {
                return .{ .status = 500, .body = "No dataset", .content_type = "text/plain", .body_allocated = false };
            };
            const count = @min(want_count, source.len);

            if (!wantsGzip(r.accept_encoding)) {
                if (jsonResponse(source, count, m, r.fd)) |msg| {
                    return .{ .status = 200, .body = msg, .content_type = "application/json", .body_allocated = false };
                }
            }

            // Gzip fast path: serialize into the threadlocal scratch and
            // deflate through the reusable stream — zero heap traffic per
            // request. Borrowed buffers → body_allocated = false.
            if (wantsGzip(r.accept_encoding)) {
                if (jsonBodyScratch(source, count, m)) |jb| {
                    if (gzipBody(alloc, jb)) |gz| {
                        return .{ .status = 200, .body = gz, .content_type = "application/json", .content_encoding = "gzip", .body_allocated = false };
                    }
                }
            }

            // Gzip overflow / non-gzip overflow fallback: build JSON in the heap.
            var out_items = alloc.alloc(ResponseItem, count) catch {
                return .{ .status = 500, .body = "out of memory", .content_type = "text/plain", .body_allocated = false };
            };
            defer alloc.free(out_items);
            for (0..count) |i| {
                const src = source[i];
                out_items[i] = .{
                    .id = src.id,
                    .name = src.name,
                    .category = src.category,
                    .price = src.price,
                    .quantity = src.quantity,
                    .active = src.active,
                    .tags = src.tags,
                    .rating = src.rating,
                    .total = src.price * src.quantity * m,
                };
            }
            const json_body = std.json.Stringify.valueAlloc(alloc, .{ .items = out_items, .count = count }, .{}) catch {
                return .{ .status = 500, .body = "json encode failed", .content_type = "text/plain", .body_allocated = false };
            };
            if (wantsGzip(r.accept_encoding)) {
                if (gzipBody(alloc, json_body)) |gz| {
                    alloc.free(json_body);
                    return .{ .status = 200, .body = gz, .content_type = "application/json", .content_encoding = "gzip", .body_allocated = false };
                }
            }
            if (finishHttp("application/json", json_body)) |msg| {
                alloc.free(json_body);
                return .{ .status = 200, .body = msg, .content_type = "application/json", .body_allocated = false };
            }
            return .{ .status = 200, .body = json_body, .content_type = "application/json", .body_allocated = true };
        }

        fn handle(r: *orisha.Request) orisha.Response {
            if (std.mem.eql(u8, r.path, "/pipeline")) return handlePipeline(r);

            if (std.mem.eql(u8, r.path, "/baseline11")) return handleBaseline(r);

            if (std.mem.startsWith(u8, r.path, "/json/")) {
                const count_str = r.path["/json/".len..];
                return handleJson(r, count_str);
            }

            return .{ .status = 404, .body = "not found", .content_type = "text/plain", .body_allocated = false };
        }
};

~proc dispatch|zig {
    return Impl.handle(req);
}

~proc pipeline|zig {
    return Impl.handlePipeline(req);
}

~proc baseline|zig {
    return Impl.handleBaseline(req);
}

~proc json|zig {
    return Impl.handleJson(req, count);
}
