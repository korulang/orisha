// Orisha — the implementation.
//
// Zig lives here: the socket calls, the request parser, the router transform,
// the static-asset embedder. Every Koru declaration this module exposes is in
// the companion `index.k` beside this file, which is why that one has no `~`
// in it and this one does — the character is a parser switch, and there is a
// host language here to switch out of.
//
// The two files share a stem and are ONE module. A `~pub tor` may not be
// declared here while that companion exists (KORU111): the public surface is
// the contract's job.

~std/compiler:requires {
    exe.linkSystemLibrary("z");
    exe.linkLibC();
}

const std = @import("std");
const ast = @import("ast");
const Program = ast.Program;
const posix = std.posix;
const libc = std.c;
// The ONE clock symbol Orisha needs, declared rather than @cImport-ed.
//
// `@cImport(@cInclude("time.h"))` needs libc HEADERS at compile time, and a
// freestanding target has none — it was one of the two things stopping Orisha
// from linking into a unikernel at all (`error: 'time.h' file not found`). An
// `extern fn` needs no header: it resolves at link time against whatever libc
// the image actually has, which on Unikraft is nolibc, in the same address
// space. Same trick koru/examples/unikraft-net uses for socket/bind/listen.
//
// `gmtime_r` and `strftime` are gone with it — see formatHttpDate, which now
// does the calendar arithmetic itself. Fewer symbols to find on a platform
// that may not have them, and the HTTP date format is fixed by RFC 9110
// anyway, so there was never anything for strftime to decide.
extern fn time(t: ?*i64) i64;

// ============================================================================
// PUBLIC TYPES
// ============================================================================

pub const Request = struct {
    method: []const u8,
    path: []const u8,
    query: ?[]const u8 = null,
    body: ?[]const u8,
    accept_encoding: ?[]const u8 = null,
    if_none_match: ?[]const u8 = null,

    // For param extraction by router
    allocator: std.mem.Allocator,
};

pub const ServerHandle = struct {
    inner: std.net.Server,
    allocator: std.mem.Allocator,
};

pub const ConnHandle = struct {
    stream: std.net.Stream,
    allocator: std.mem.Allocator,
};

// ============================================================================
// LISTEN — open the socket
// ============================================================================

~proc listen|zig {
    const allocator = std.heap.c_allocator;

    const address = std.net.Address.parseIp("0.0.0.0", port) catch {
        return .{ .failed = "Invalid address" };
    };

    const server = address.listen(.{
        .reuse_address = true,
        .kernel_backlog = 128,
    }) catch {
        return .{ .failed = "Failed to listen" };
    };

    const handle = allocator.create(ServerHandle) catch {
        return .{ .failed = "Failed to allocate server handle" };
    };
    handle.* = .{ .inner = server, .allocator = allocator };

    std.debug.print("Orisha listening on http://0.0.0.0:{}\n", .{port});
    return .{ .listening = handle };
}
~proc accept|zig {
    const allocator = server.allocator;

    // Accept connection
    const conn = server.inner.accept() catch {
        return .{ .failed = .{ .msg = "Accept failed", .server = server } };
    };

    // Read HTTP request
    var buffer: [4096]u8 = undefined;
    const bytes_read = conn.stream.read(&buffer) catch {
        conn.stream.close();
        return .{ .failed = .{ .msg = "Read failed", .server = server } };
    };

    if (bytes_read == 0) {
        conn.stream.close();
        return .{ .failed = .{ .msg = "Empty request", .server = server } };
    }

    // Parse HTTP request line: "GET /path HTTP/1.1"
    const request_data = buffer[0..bytes_read];
    var method: []const u8 = "GET";
    var path: []const u8 = "/";

    if (std.mem.indexOf(u8, request_data, " ")) |method_end| {
        method = request_data[0..method_end];
        const after_method = request_data[method_end + 1..];
        if (std.mem.indexOf(u8, after_method, " ")) |path_end| {
            // Same seam as `answer` below — a query string and percent-encoding
            // both belong to the request target, not to the resource name.
            path = requestPathKey(allocator, after_method[0..path_end]);
        }
    }

    // Parse body from request data
    var body: ?[]const u8 = null;
    if (std.mem.indexOf(u8, request_data, "\r\n\r\n")) |header_end| {
        const body_start = header_end + 4;
        if (body_start < request_data.len) {
            body = request_data[body_start..];
        }
    }

    // Allocate request
    const req = allocator.create(Request) catch {
        conn.stream.close();
        return .{ .failed = .{ .msg = "Failed to allocate request", .server = server } };
    };
    const duped_body: ?[]const u8 = if (body) |b| allocator.dupe(u8, b) catch b else null;
    req.* = .{
        .method = allocator.dupe(u8, method) catch method,
        .path = allocator.dupe(u8, path) catch path,
        .body = duped_body,
        .if_none_match = null,
        .allocator = allocator,
    };

    // Allocate connection handle
    const conn_handle = allocator.create(ConnHandle) catch {
        conn.stream.close();
        return .{ .failed = .{ .msg = "Failed to allocate connection", .server = server } };
    };
    conn_handle.* = .{ .stream = conn.stream, .allocator = allocator };

    return .{ .request = .{ .req = req, .conn = conn_handle, .server = server } };
}

~proc send|zig {
    const allocator = conn.allocator;
    const ct = if (content_type) |ct_str| ct_str else "text/plain";

    // Build HTTP response
    var response_buf: std.ArrayList(u8) = .empty;
    defer response_buf.deinit(allocator);

    var len_buf: [20]u8 = undefined;
    const len_str = std.fmt.bufPrint(&len_buf, "{}", .{body.len}) catch "0";
    var date_buf: [29]u8 = undefined;
    formatHttpDate(&date_buf);
    if (headerPrefixClose(status)) |prefix| {
        response_buf.appendSlice(allocator, prefix) catch {};
        response_buf.appendSlice(allocator, len_str) catch {};
        response_buf.appendSlice(allocator, "\r\nContent-Type: ") catch {};
        response_buf.appendSlice(allocator, ct) catch {};
        response_buf.appendSlice(allocator, "\r\nDate: ") catch {};
        response_buf.appendSlice(allocator, &date_buf) catch {};
        response_buf.appendSlice(allocator, "\r\nConnection: close\r\n\r\n") catch {};
    } else {
        response_buf.appendSlice(allocator, "HTTP/1.1 ") catch {};
        var status_buf: [3]u8 = undefined;
        _ = std.fmt.bufPrint(&status_buf, "{}", .{status}) catch {};
        response_buf.appendSlice(allocator, &status_buf) catch {};
        response_buf.appendSlice(allocator, " ") catch {};
        response_buf.appendSlice(allocator, statusText(status)) catch {};
        response_buf.appendSlice(allocator, "\r\n") catch {};
        response_buf.appendSlice(allocator, "Content-Type: ") catch {};
        response_buf.appendSlice(allocator, ct) catch {};
        response_buf.appendSlice(allocator, "\r\n") catch {};
        response_buf.appendSlice(allocator, "Content-Length: ") catch {};
        response_buf.appendSlice(allocator, len_str) catch {};
        response_buf.appendSlice(allocator, "\r\nDate: ") catch {};
        response_buf.appendSlice(allocator, &date_buf) catch {};
        response_buf.appendSlice(allocator, "\r\nConnection: close\r\n\r\n") catch {};
    }

    // Body
    response_buf.appendSlice(allocator, body) catch {};

    // Send
    _ = conn.stream.writeAll(response_buf.items) catch {
        conn.stream.close();
        return .{ .failed = "Write failed" };
    };

    conn.stream.close();
    return .{ .sent = {} };
}


// The response's content type. `?string` in a RETURN RECORD does not lower to
// Zig yet (params lower via emitter_helpers.zig:907 / regression 400_181; the
// bare-return record path writeBareReturnType only lowers exact `string`), so
// the optional field names this module-local alias instead — the same
// mechanism `*Request` uses.
pub const ContentType = []const u8;

// The response shape every handler/tor produces. A NAMED type so a user tor
// chained from a router branch (`-> my-handler(req)`) returns the SAME Zig type
// as the abstract handler — anonymous struct outputs are nominally distinct in
// Zig and a `return` would fail to unify despite identical fields.
pub const Response = struct {
    status: u16,
    body: []const u8,
    content_type: ?ContentType,
    content_encoding: ?ContentType = null,
    // Caller-supplied extra header lines, verbatim including \r\n terminators
    // ("Vary: Accept\r\nVary: accept-encoding\r\n"). Spliced into the head
    // between the managed headers and the trailer. Null = no extras.
    extra_headers: ?ContentType = null,
    // fmt.blk HTML is `allocPrint`; JSON `fmt:ln` is a TLS buffer; static
    // routes are comptime slices. Only the first must be freed after send.
    // Default false so existing `{ status, body, content_type }` produces stay
    // honest — they do not own the bytes.
    body_allocated: bool = false,
};

// The header is built into a buffer that outlives the frame, because `answer`
// returns a SLICE of it and a slice of a dead frame is a bug this file has
// shipped before.
//
// `threadlocal` is what makes that safe once a pump runs more than one loop.
// A worker pool has several exchanges in flight at once, and a single shared
// buffer would have two threads writing headers over each other — which does
// not crash, it ships one response wearing another's Content-Length. That is
// the same "sometimes it works" shape as every other bug in this file's
// history, and the only reason a plain `var` was ever sound here is that the
// pump had exactly one thread from the day the workers were removed.
//
// Freestanding gets one too. The unikernel never spawns a thread, so it has
// exactly one of these. 1024 bytes — the managed head is ~250, the rest is
// headroom for caller `extra_headers`.
threadlocal var header_buf: [1024]u8 = undefined;

// ============================================================================
// THE ALLOCATOR SEAM
// ============================================================================
// `Request.allocator` used to be `std.heap.page_allocator` outright. That is an
// OPERATING SYSTEM allocator: it reaches `std.posix` for mmap, and on
// x86_64-freestanding `std.posix` has no `MAP` and no `MREMAP` to reach for.
// It was the second of the two things that stopped Orisha linking into a
// unikernel — and, unlike the libc time header, it is not a missing symbol but
// a missing MACHINE. There is no kernel to ask for pages.
//
// So the allocator becomes a seam, the same way the readiness loop did. A
// hosted build keeps the page allocator. A freestanding build gets a fixed
// arena carved out of the image itself, reset at the top of every exchange —
// which is sound for exactly the reason the header buffer above is sound: a
// pump delivers one exchange at a time. Nothing above this line changes, and
// `answer` still never names a platform.
const koru_builtin = @import("builtin");
const orisha_freestanding = koru_builtin.target.os.tag == .freestanding;

var request_arena_buf: [64 * 1024]u8 = undefined;
var request_arena = std.heap.FixedBufferAllocator.init(&request_arena_buf);

fn requestAllocator() std.mem.Allocator {
    request_arena.reset();
    return request_arena.allocator();
}

// The request target is not the lookup key, and the difference is invisible
// until a real site is behind it.
//
// A browser sends what the LINK says. `/blog?utm_source=x` and `/blog` want the
// same page, and a filename with a space in it arrives percent-encoded — the
// route table holds the decoded name, because that is what the file is called.
// Matching the target verbatim, as this did until 2026-08-10, misses both, and
// the miss is silent: the SPA fallback answers 200 with the shell, so the
// browser renders something and only the missing image tells you.
//
// Measured against korulang.org: two screenshots referenced from studio.html and
// a blog post never arrived, and every link carrying a query string — including
// the site's own `?status=` lesson filter — landed on the fallback.
fn requestPathKey(allocator: std.mem.Allocator, target: []const u8) []const u8 {
    // A query string addresses the same resource.
    const without_query = if (std.mem.indexOfScalar(u8, target, '?')) |q| target[0..q] else target;

    // Common case allocates nothing.
    if (std.mem.indexOfScalar(u8, without_query, '%') == null) return without_query;

    var out = allocator.alloc(u8, without_query.len) catch return without_query;
    var w: usize = 0;
    var r: usize = 0;
    while (r < without_query.len) {
        if (without_query[r] == '%' and r + 2 < without_query.len) {
            const hi = std.fmt.charToDigit(without_query[r + 1], 16) catch {
                out[w] = without_query[r];
                w += 1;
                r += 1;
                continue;
            };
            const lo = std.fmt.charToDigit(without_query[r + 2], 16) catch {
                out[w] = without_query[r];
                w += 1;
                r += 1;
                continue;
            };
            out[w] = hi * 16 + lo;
            w += 1;
            r += 3;
        } else {
            out[w] = without_query[r];
            w += 1;
            r += 1;
        }
    }
    return out[0..w];
}

fn headerValue(raw: []const u8, name: []const u8) ?[]const u8 {
    const first_line = std.mem.indexOf(u8, raw, "\r\n") orelse return null;
    var scan: usize = first_line + 2;
    while (scan < raw.len) {
        const nl = std.mem.indexOfPos(u8, raw, scan, "\r\n") orelse break;
        const line = raw[scan..nl];
        scan = nl + 2;
        if (line.len == 0) break;
        const colon = std.mem.indexOfScalar(u8, line, ':') orelse continue;
        if (!std.ascii.eqlIgnoreCase(line[0..colon], name)) continue;
        return std.mem.trim(u8, line[colon + 1 ..], " \t");
    }
    return null;
}

fn transferEncodingChunkedHead(head: []const u8) bool {
    const value = headerValue(head, "transfer-encoding") orelse return false;
    var lower_buf: [128]u8 = undefined;
    if (value.len > lower_buf.len) return false;
    const lower = std.ascii.lowerString(&lower_buf, value);
    return std.mem.indexOf(u8, lower, "chunked") != null;
}

fn decodeChunkedPayload(body: []const u8, out: []u8) ?[]const u8 {
    var pos: usize = 0;
    var w: usize = 0;
    while (true) {
        const line_end = std.mem.indexOfPos(u8, body, pos, "\r\n") orelse return null;
        const chunk_size = std.fmt.parseInt(usize, body[pos..line_end], 16) catch return null;
        pos = line_end + 2;
        if (chunk_size == 0) return out[0..w];
        if (w + chunk_size > out.len) return null;
        @memcpy(out[w .. w + chunk_size], body[pos .. pos + chunk_size]);
        w += chunk_size;
        pos += chunk_size;
        if (pos + 2 > body.len or body[pos] != '\r' or body[pos + 1] != '\n') return null;
        pos += 2;
    }
}

~proc answer|zig {
    const req_allocator = $mod.requestAllocator();
    var method: []const u8 = "GET";
    var path: []const u8 = "/";
    var query: ?[]const u8 = null;

    var i: usize = 0;
    while (i < raw.len and raw[i] != ' ') : (i += 1) {}
    if (i < raw.len) {
        method = raw[0..i];
        i += 1;
        var j: usize = i;
        while (j < raw.len and raw[j] != ' ') : (j += 1) {}
        if (j > i) {
            const target = raw[i..j];
            if (std.mem.indexOfScalar(u8, target, '?')) |q| {
                query = target[q + 1 ..];
            }
            path = $mod.requestPathKey(req_allocator, target);
        }
    }

    var client_etag: ?[]const u8 = null;
    // Header names are case-insensitive. The Vercel adapter used to omit this
    // header entirely; once it forwards it, browsers send `If-None-Match` in
    // whatever casing their stack picked, and a literal search would miss.
    if (rawHasHeaderName(raw, "if-none-match")) {
        var scan: usize = 0;
        while (scan < raw.len) {
            const nl = std.mem.indexOfPos(u8, raw, scan, "\r\n") orelse break;
            const line = raw[scan..nl];
            scan = nl + 2;
            if (line.len < 15) continue;
            const colon = std.mem.indexOfScalar(u8, line, ':') orelse continue;
            if (!std.ascii.eqlIgnoreCase(line[0..colon], "if-none-match")) continue;
            var etag_raw = std.mem.trim(u8, line[colon + 1 ..], " \t");
            if (etag_raw.len >= 2 and etag_raw[0] == '"' and etag_raw[etag_raw.len - 1] == '"') {
                etag_raw = etag_raw[1 .. etag_raw.len - 1];
            }
            client_etag = etag_raw;
            break;
        }
    }

    const accept_encoding = if (rawHasHeaderName(raw, "accept-encoding"))
        headerValue(raw, "accept-encoding")
    else
        null;

    var body: ?[]const u8 = null;

    if (std.mem.indexOf(u8, raw, "\r\n\r\n")) |header_end| {
        const headers_end = header_end + 4;
        const head = raw[0..headers_end];
        const body_raw = if (headers_end < raw.len) raw[headers_end..] else "";
        if (transferEncodingChunkedHead(head)) {
            var decoded_buf: [4096]u8 = undefined;
            if (decodeChunkedPayload(body_raw, &decoded_buf)) |decoded| {
                body = decoded;
            }
        } else if (body_raw.len > 0) {
            body = body_raw;
        }
    }

    var req = Request{
        .method = method,
        .path = path,
        .query = query,
        .body = body,
        .accept_encoding = accept_encoding,
        .if_none_match = client_etag,
        .allocator = req_allocator,
    };

    const res = $mod.handler_event.handler(.{ .req = &req });

    // A handler that already rendered a whole response (a static route) hands
    // it back verbatim; it goes out as the head with no separate body.
    if (std.mem.startsWith(u8, res.body, "HTTP/1.")) {
        // Pre-rendered static routes: the whole message is `head`. `body`
        // is empty, so it must not carry the allocated flag — freeing ""
        // would be a phantom free of a literal.
        // Baked messages carry no Date — it is serve-time (RFC 9110 §10.1.1),
        // so the send path splices the current line in after the status line.
        // `date_hole` is that insertion offset; 0 means "head is already
        // complete" and every non-baked head takes it.
        const hole = if (std.mem.indexOfScalar(u8, res.body, '\r')) |cr| cr + 2 else 0;
        return .{ .head = res.body, .body = "", .body_allocated = false, .date_hole = hole };
    }

    const res_ct = if (res.content_type) |ct_str| ct_str else "text/plain";
    const extra = res.extra_headers orelse "";
    var date_buf: [29]u8 = undefined;
    formatHttpDate(&date_buf);

    const head = if (res.content_encoding) |enc| blk: {
        if (headerPrefixKeepAlive(res.status)) |prefix| {
            break :blk std.fmt.bufPrint(
                &header_buf,
                "{s}{d}\r\nContent-Type: {s}\r\nContent-Encoding: {s}\r\nDate: {s}\r\n{s}X-Powered-By: koru/orisha\r\nX-Orisha: reactor\r\nConnection: keep-alive\r\n\r\n",
                .{ prefix, res.body.len, res_ct, enc, &date_buf, extra },
            ) catch "HTTP/1.1 500 Internal Server Error\r\nContent-Length: 0\r\nConnection: close\r\n\r\n";
        }
        break :blk std.fmt.bufPrint(
            &header_buf,
            "HTTP/1.1 {d} {s}\r\nContent-Type: {s}\r\nContent-Encoding: {s}\r\nContent-Length: {d}\r\nDate: {s}\r\n{s}X-Powered-By: koru/orisha\r\nX-Orisha: reactor\r\nConnection: keep-alive\r\n\r\n",
            .{ res.status, statusText(res.status), res_ct, enc, res.body.len, &date_buf, extra },
        ) catch "HTTP/1.1 500 Internal Server Error\r\nContent-Length: 0\r\nConnection: close\r\n\r\n";
    } else if (headerPrefixKeepAlive(res.status)) |prefix|
        std.fmt.bufPrint(&header_buf, "{s}{d}\r\nContent-Type: {s}\r\nDate: {s}\r\n{s}X-Powered-By: koru/orisha\r\nX-Orisha: reactor\r\nConnection: keep-alive\r\n\r\n", .{ prefix, res.body.len, res_ct, &date_buf, extra }) catch
            "HTTP/1.1 500 Internal Server Error\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
    else
        std.fmt.bufPrint(
            &header_buf,
            "HTTP/1.1 {d} {s}\r\nContent-Type: {s}\r\nContent-Length: {d}\r\nDate: {s}\r\n{s}X-Powered-By: koru/orisha\r\nX-Orisha: reactor\r\nConnection: keep-alive\r\n\r\n",
            .{ res.status, statusText(res.status), res_ct, res.body.len, &date_buf, extra },
        ) catch "HTTP/1.1 500 Internal Server Error\r\nContent-Length: 0\r\nConnection: close\r\n\r\n";

    return .{ .head = head, .body = res.body, .body_allocated = res.body_allocated, .date_hole = 0 };
}

~proc release-body|zig {
    if (allocated) {
        koru_allocator().free(body);
    }
}

fn statusText(status: u16) []const u8 {
    return switch (status) {
        200 => "OK",
        201 => "Created",
        204 => "No Content",
        400 => "Bad Request",
        401 => "Unauthorized",
        403 => "Forbidden",
        404 => "Not Found",
        500 => "Internal Server Error",
        else => "Unknown",
    };
}

/// `Sun, 09 Aug 2026 14:41:49 GMT` — exactly 29 bytes, the only shape RFC 9110
/// allows in a Date header. Calendar arithmetic rather than strftime, so this
/// needs one C symbol (`time`) instead of three, and works on a target whose
/// libc has a clock and nothing else.
threadlocal var cached_date_epoch: i64 = -1;
threadlocal var cached_date_buf: [29]u8 = undefined;

fn formatHttpDate(buf: *[29]u8) void {
    const epoch = time(null);
    if (epoch != cached_date_epoch) {
        cached_date_epoch = epoch;
        formatHttpDateFromEpoch(&cached_date_buf, epoch);
    }
    @memcpy(buf[0..29], cached_date_buf[0..29]);
}

/// The whole `Date: …\r\n` line (37 bytes) as a stable threadlocal slice, for
/// callers that splice the header into a baked message — the send path's
/// `date_hole` iovec points straight at this. Same second-granularity cache
/// as `formatHttpDate`: Date varies on the clock, not per request, so the
/// hot path does a lookup, never a format.
threadlocal var cached_line_epoch: i64 = -1;
threadlocal var date_line_buf: [37]u8 = undefined;

pub fn httpDateLine() *const [37]u8 {
    const epoch = time(null);
    if (epoch != cached_line_epoch) {
        cached_line_epoch = epoch;
        var v: [29]u8 = undefined;
        formatHttpDateFromEpoch(&v, epoch);
        @memcpy(date_line_buf[0..6], "Date: ");
        @memcpy(date_line_buf[6..35], &v);
        @memcpy(date_line_buf[35..37], "\r\n");
    }
    return &date_line_buf;
}

fn formatHttpDateFromEpoch(buf: *[29]u8, epoch: i64) void {
    const days = @divFloor(epoch, 86400);
    const secs = @as(u32, @intCast(epoch - days * 86400));

    // Howard Hinnant's civil_from_days: shift the era to March so the leap day
    // lands at the end of a year and the month lengths become a linear formula.
    const z = days + 719468;
    const era = @divFloor(z, 146097);
    const doe = @as(u32, @intCast(z - era * 146097));
    const yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    const y0 = @as(i64, yoe) + era * 400;
    const doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    const mp = (5 * doy + 2) / 153;
    const d = doy - (153 * mp + 2) / 5 + 1;
    const m = if (mp < 10) mp + 3 else mp - 9;
    const y = if (m <= 2) y0 + 1 else y0;

    const wday = @as(u32, @intCast(@mod(days + 4, 7))); // 1970-01-01 was a Thursday
    const DAY = [_][]const u8{ "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };
    const MON = [_][]const u8{ "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };

    @memcpy(buf[0..3], DAY[wday]);
    buf[3] = ',';
    buf[4] = ' ';
    two(buf[5..7], d);
    buf[7] = ' ';
    @memcpy(buf[8..11], MON[m - 1]);
    buf[11] = ' ';
    four(buf[12..16], @as(u32, @intCast(y)));
    buf[16] = ' ';
    two(buf[17..19], secs / 3600);
    buf[19] = ':';
    two(buf[20..22], (secs % 3600) / 60);
    buf[22] = ':';
    two(buf[23..25], secs % 60);
    @memcpy(buf[25..29], " GMT");
}

fn rawHasHeaderName(raw: []const u8, comptime name: []const u8) bool {
    if (raw.len < name.len + 2) return false;
    var i: usize = 0;
    while (i + name.len + 1 < raw.len) : (i += 1) {
        if (raw[i] == '\r' and raw[i + 1] == '\n') {
            if (i + 3 < raw.len and raw[i + 2] == '\r' and raw[i + 3] == '\n') return false;
        }
        if (std.ascii.eqlIgnoreCase(raw[i .. i + name.len], name) and raw[i + name.len] == ':') return true;
    }
    return false;
}

fn two(dst: *[2]u8, v: u32) void {
    dst[0] = '0' + @as(u8, @intCast((v / 10) % 10));
    dst[1] = '0' + @as(u8, @intCast(v % 10));
}

fn four(dst: *[4]u8, v: u32) void {
    dst[0] = '0' + @as(u8, @intCast((v / 1000) % 10));
    dst[1] = '0' + @as(u8, @intCast((v / 100) % 10));
    dst[2] = '0' + @as(u8, @intCast((v / 10) % 10));
    dst[3] = '0' + @as(u8, @intCast(v % 10));
}

fn headerPrefixKeepAlive(status: u16) ?[]const u8 {
    return switch (status) {
        200 => "HTTP/1.1 200 OK\r\nContent-Length: ",
        201 => "HTTP/1.1 201 Created\r\nContent-Length: ",
        204 => "HTTP/1.1 204 No Content\r\nContent-Length: ",
        400 => "HTTP/1.1 400 Bad Request\r\nContent-Length: ",
        401 => "HTTP/1.1 401 Unauthorized\r\nContent-Length: ",
        403 => "HTTP/1.1 403 Forbidden\r\nContent-Length: ",
        404 => "HTTP/1.1 404 Not Found\r\nContent-Length: ",
        500 => "HTTP/1.1 500 Internal Server Error\r\nContent-Length: ",
        else => null,
    };
}


~proc router|zig {
    const ast_mod = @import("ast");
    const ast_functional = @import("ast_functional");
    const continuation_codegen = @import("continuation_codegen");

    // Get the flow containing this router invocation
    const flow = if (item.* == .flow)
        &item.flow
    else
        return .{};

    // Check if already transformed
    for (flow.inv().annotations) |ann| {
        if (std.mem.startsWith(u8, ann, "@pass_ran")) {
            return .{};
        }
    }

    // Detect whether this is the flow's own invocation or a nested one.
    // findContainingItem returns the parent flow, so for nested routers
    // we must search the continuation tree for the actual invocation.
    const is_pointer_top = (invocation == flow.inv());

    // Get the request expression from invocation args (the call-site value to splice)
    var req_expr: []const u8 = "req";
    for (invocation.args) |arg| {
        if (std.mem.eql(u8, arg.name, "req")) {
            req_expr = arg.value;
            break;
        }
    }

    // Collect pattern branches from the correct continuations.
    // For top-level: flow.continuations (the flow IS the router).
    // For nested: find the continuation whose node IS our invocation,
    // then use its sub-continuations as pattern branches.
    const PatternCont = struct {
        pattern: []const u8,
        cont: *const ast_mod.Continuation,
    };

    // Helper to find the continuation containing a specific invocation by pointer
    const findContWithInvocation = struct {
        fn search(continuations: []const ast_mod.Continuation, target_inv: *const ast_mod.Invocation) ?*const ast_mod.Continuation {
            for (continuations) |*cont| {
                if (cont.node) |*node| {
                    if (node.* == .invocation and &node.invocation == target_inv) {
                        return cont;
                    }
                }
                if (search(cont.continuations, target_inv)) |found| {
                    return found;
                }
            }
            return null;
        }
    }.search;

    const source_continuations = if (is_pointer_top)
        flow.body.continuations
    else blk: {
        const parent_cont = findContWithInvocation(flow.body.continuations, invocation) orelse {
            std.debug.print("[ROUTER TRANSFORM] WARNING: Could not find nested invocation\n", .{});
            return .{};
        };
        break :blk parent_cont.continuations;
    };

    var patterns: std.ArrayList([]const u8) = .empty;
    var pattern_conts: std.ArrayList(PatternCont) = .empty;
    // Kind awareness: the router DISPATCHES into the matched route, which is
    // effect semantics — so its pattern branches must be effect branches (`!`),
    // not terminal (`|`). Orisha predates BranchKind and was kind-blind; this
    // makes it reject the terminal form loudly (see the @compileError below).
    var has_terminal_pattern = false;
    // The `[...]` glyphs are a source ENCODING of a quoted branch name — the
    // parser strips them (flow_parser.zig parseBranchInfo), so the AST carries
    // `GET /users/:id` or `*`, never `[GET /users/:id]`. A router pattern is
    // therefore a branch that is the catch-all `*` or carries a `METHOD path`
    // pair (contains a space).
    const isPatternBranch = struct {
        fn check(branch: []const u8) bool {
            if (std.mem.eql(u8, branch, "*")) return true;
            return std.mem.indexOfScalar(u8, branch, ' ') != null;
        }
    }.check;
    for (source_continuations, 0..) |*cont, i| {
        if (isPatternBranch(cont.branch)) {
            if (cont.kind != .effect) has_terminal_pattern = true;
            patterns.append(allocator, cont.branch) catch unreachable;
            pattern_conts.append(allocator, .{
                .pattern = cont.branch,
                .cont = &source_continuations[i],
            }) catch unreachable;
        }
    }

    if (patterns.items.len == 0) {
        return .{};
    }

    std.debug.print("[ROUTER TRANSFORM] Found {} pattern branches\n", .{patterns.items.len});

    // Parsed pattern info
    const ParsedPattern = struct {
        raw: []const u8,
        method: []const u8,
        path: []const u8,
        params: []const []const u8,
        is_catchall: bool,
    };

    // Parse all patterns
    var parsed_patterns: std.ArrayList(ParsedPattern) = .empty;
    for (patterns.items) |pattern| {
        if (std.mem.eql(u8, pattern, "*")) {
            parsed_patterns.append(allocator, .{
                .raw = pattern,
                .method = "*",
                .path = "*",
                .params = &.{},
                .is_catchall = true,
            }) catch unreachable;
            continue;
        }

        const inner = pattern; // brackets already stripped by the parser
        const space_idx = std.mem.indexOf(u8, inner, " ") orelse continue;
        const method = inner[0..space_idx];
        const path = inner[space_idx + 1 ..];

        var params_list: std.ArrayList([]const u8) = .empty;
        var path_iter = std.mem.splitScalar(u8, path, '/');
        while (path_iter.next()) |segment| {
            if (segment.len > 1 and segment[0] == ':') {
                params_list.append(allocator, segment[1..]) catch unreachable;
            }
        }

        parsed_patterns.append(allocator, .{
            .raw = pattern,
            .method = method,
            .path = path,
            .params = params_list.toOwnedSlice(allocator) catch unreachable,
            .is_catchall = false,
        }) catch unreachable;
    }

    // Profile-guided branch order — same `orisha.profile` access log as static
    // routes. Reorders the if-chain so hot HttpArena paths (baseline, json, …)
    // are compared first. See orisha/httparena/profiles/ and workload.py.
    if (loadProfileHits(allocator)) |loaded| {
        defer allocator.free(loaded.storage);
        var hits = loaded.hits;
        defer hits.deinit();

        const ScoreCtx = struct {
            h: *std.StringHashMap(u64),
            fn patternPrefix(pp: @TypeOf(parsed_patterns.items[0])) []const u8 {
                if (pp.params.len == 0) return pp.path;
                var end: usize = 0;
                var it = std.mem.splitScalar(u8, pp.path, '/');
                while (it.next()) |seg| {
                    if (seg.len > 0 and seg[0] == ':') break;
                    end += seg.len + 1;
                }
                return if (end > 0) pp.path[0..end] else pp.path;
            }
            fn routeScore(self: @This(), pp: @TypeOf(parsed_patterns.items[0])) u64 {
                if (pp.is_catchall) return 0;
                var sum: u64 = self.h.get(pp.path) orelse 0;
                if (pp.params.len > 0) {
                    const prefix = patternPrefix(pp);
                    var it = self.h.iterator();
                    while (it.next()) |entry| {
                        const key = entry.key_ptr.*;
                        if (!std.mem.eql(u8, key, pp.path) and std.mem.startsWith(u8, key, prefix)) {
                            sum += entry.value_ptr.*;
                        }
                    }
                }
                return sum;
            }
            fn hotter(self: @This(), a: @TypeOf(parsed_patterns.items[0]), b: @TypeOf(parsed_patterns.items[0])) bool {
                const ha = self.routeScore(a);
                const hb = self.routeScore(b);
                if (ha != hb) return ha > hb;
                return std.mem.lessThan(u8, a.raw, b.raw);
            }
        };
        std.sort.block(@TypeOf(parsed_patterns.items[0]), parsed_patterns.items, ScoreCtx{ .h = &hits }, ScoreCtx.hotter);
        const hottest_label = blk: {
            for (parsed_patterns.items) |pp| {
                if (!pp.is_catchall) break :blk pp.raw;
            }
            break :blk parsed_patterns.items[0].raw;
        };
        std.debug.print("[ROUTER TRANSFORM] profile: {d} requests — hottest pattern is {s}\n", .{ loaded.counted, hottest_label });
    } else {
        std.debug.print("[ROUTER TRANSFORM] profile: none (orisha.profile absent) — pattern order unchanged\n", .{});
    }

    // Build inline_body: flat if-else-if-else chain with branch bodies inlined.
    // This runs inline (in scope), so runtime values like the expr are accessible.
    // Using a proper if-else chain means Zig can prove all paths are covered
    // (when a catch-all [*] exists), without needing unreachable.
    var ib: std.ArrayList(u8) = .empty;
    ib.appendSlice(allocator, "//@koru:inline_stmt\n") catch unreachable;

    // Find catch-all pattern and its continuation
    var catch_all_cont: ?*const ast_mod.Continuation = null;
    for (parsed_patterns.items) |*pp| {
        if (pp.is_catchall) {
            for (pattern_conts.items) |pc| {
                if (std.mem.eql(u8, pc.pattern, pp.raw)) {
                    catch_all_cont = pc.cont;
                    break;
                }
            }
        }
    }

    var result_counter: usize = 0;
    var first_branch = true;

    // Emit flat if / else if chain for all non-catchall patterns
    for (parsed_patterns.items) |*pp| {
        if (pp.is_catchall) continue;

        // Find continuation for this pattern
        const cont = find_cont: {
            for (pattern_conts.items) |pc| {
                if (std.mem.eql(u8, pc.pattern, pp.raw)) break :find_cont pc.cont;
            }
            break :find_cont null;
        };

        // Emit if / else if
        if (first_branch) {
            ib.appendSlice(allocator, "    if (") catch unreachable;
            first_branch = false;
        } else {
            ib.appendSlice(allocator, " else if (") catch unreachable;
        }

        // Condition: method AND path
        ib.appendSlice(allocator, "std.mem.eql(u8, (") catch unreachable;
        ib.appendSlice(allocator, req_expr) catch unreachable;
        ib.appendSlice(allocator, ").method, \"") catch unreachable;
        ib.appendSlice(allocator, pp.method) catch unreachable;
        ib.appendSlice(allocator, "\") and ") catch unreachable;

        if (pp.params.len == 0) {
            // Exact path match
            ib.appendSlice(allocator, "std.mem.eql(u8, (") catch unreachable;
            ib.appendSlice(allocator, req_expr) catch unreachable;
            ib.appendSlice(allocator, ").path, \"") catch unreachable;
            ib.appendSlice(allocator, pp.path) catch unreachable;
            ib.appendSlice(allocator, "\")") catch unreachable;
        } else {
            // Prefix match for parameterized routes
            var prefix_end: usize = 0;
            var path_iter = std.mem.splitScalar(u8, pp.path, '/');
            while (path_iter.next()) |seg| {
                if (seg.len > 0 and seg[0] == ':') break;
                prefix_end += seg.len + 1;
            }
            const prefix = if (prefix_end > 0) pp.path[0..prefix_end] else "/";

            ib.appendSlice(allocator, "std.mem.startsWith(u8, (") catch unreachable;
            ib.appendSlice(allocator, req_expr) catch unreachable;
            ib.appendSlice(allocator, ").path, \"") catch unreachable;
            ib.appendSlice(allocator, prefix) catch unreachable;
            ib.appendSlice(allocator, "\")") catch unreachable;
        }

        ib.appendSlice(allocator, ") {\n") catch unreachable;

        // Parameter extraction for parameterized routes
        if (pp.params.len > 0) {
            if (cont) |param_cont| {
                const needs_param = if (param_cont.binding) |binding|
                    !(binding.len > 0 and binding[0] == '_')
                else
                    false;

                if (needs_param) {
                    var prefix_end2: usize = 0;
                    var path_iter2 = std.mem.splitScalar(u8, pp.path, '/');
                    while (path_iter2.next()) |seg| {
                        if (seg.len > 0 and seg[0] == ':') break;
                        prefix_end2 += seg.len + 1;
                    }
                    const prefix2 = if (prefix_end2 > 0) pp.path[0..prefix_end2] else "/";

                    var len_buf: [10]u8 = undefined;
                    const prefix_len_str = std.fmt.bufPrint(&len_buf, "{}", .{prefix2.len}) catch "0";
                    ib.appendSlice(allocator, "        const _p = (") catch unreachable;
                    ib.appendSlice(allocator, req_expr) catch unreachable;
                    ib.appendSlice(allocator, ").path;\n") catch unreachable;
                    ib.appendSlice(allocator, "        const _param = if (_p.len >= ") catch unreachable;
                    ib.appendSlice(allocator, prefix_len_str) catch unreachable;
                    ib.appendSlice(allocator, ") _p[") catch unreachable;
                    ib.appendSlice(allocator, prefix_len_str) catch unreachable;
                    ib.appendSlice(allocator, "..] else \"\";\n") catch unreachable;
                    ib.appendSlice(allocator, "        const ") catch unreachable;
                    ib.appendSlice(allocator, param_cont.binding.?) catch unreachable;
                    ib.appendSlice(allocator, " = .{ .") catch unreachable;
                    ib.appendSlice(allocator, pp.params[0]) catch unreachable;
                    ib.appendSlice(allocator, " = _param };\n") catch unreachable;
                }
            }
        }

        // Continuation code
        if (cont) |active_cont| {
            const code = continuation_codegen.generateContinuationChain(
                allocator,
                active_cont,
                program.main_module_name,
                &result_counter,
                2,
            ) catch unreachable;
            ib.appendSlice(allocator, code) catch unreachable;
        }

        ib.appendSlice(allocator, "    }") catch unreachable;
    }

    // Catch-all as else (guarantees all paths covered for Zig control flow)
    if (catch_all_cont) |cont| {
        ib.appendSlice(allocator, " else {\n") catch unreachable;
        const code = continuation_codegen.generateContinuationChain(
            allocator,
            cont,
            program.main_module_name,
            &result_counter,
            2,
        ) catch unreachable;
        ib.appendSlice(allocator, code) catch unreachable;
        ib.appendSlice(allocator, "    }\n") catch unreachable;
    } else {
        ib.appendSlice(allocator, "\n") catch unreachable;
    }

    const _generated_dispatch = ib.toOwnedSlice(allocator) catch unreachable;
    // If any pattern branch was terminal (`|`) rather than effect (`!`), replace
    // the whole dispatch with a hard compile error. The router is kind-aware now.
    const inline_body_str: []const u8 = if (has_terminal_pattern)
        "//@koru:inline_stmt\ncomptime { @compileError(\"orisha:router pattern branches must use effect `!`, not terminal `|`. Write `! [GET /path]` instead.\"); }\n"
    else
        _generated_dispatch;
    std.debug.print("[ROUTER TRANSFORM] Generated inline dispatch:\n{s}\n", .{inline_body_str});

    if (!is_pointer_top) {
        // NESTED CASE: replace the invocation node with inline_code, not the whole flow.
        // Strip the //@koru:inline_stmt prefix — inline_code nodes emit raw code.
        const prefix = "//@koru:inline_stmt\n";
        const code_str = if (std.mem.startsWith(u8, inline_body_str, prefix))
            inline_body_str[prefix.len..]
        else
            inline_body_str;

        const new_node = ast_mod.Node{ .inline_code = code_str };
        const empty_conts = allocator.alloc(ast_mod.Continuation, 0) catch unreachable;
        const maybe_new = ast_functional.replaceInvocationNodeAndContinuationsRecursive(
            allocator,
            program,
            invocation,
            new_node,
            empty_conts,
            true, // synthesized graft — exempt from structural branch rules
        ) catch unreachable;
        if (maybe_new) |new_program_val| {
            const result = allocator.create(ast_mod.Program) catch unreachable;
            result.* = new_program_val;
            return .{ .whole_program = result };
        }
        return .{};
    }

    // TOP-LEVEL CASE: replace the entire flow
    // Mark as transformed (keep original invocation path)
    const new_inv_annotations = allocator.alloc([]const u8, flow.inv().annotations.len + 1) catch unreachable;
    for (flow.inv().annotations, 0..) |ann, j| {
        new_inv_annotations[j] = ann;
    }
    new_inv_annotations[flow.inv().annotations.len] = allocator.dupe(u8, "@pass_ran(\"transform\")") catch unreachable;

    const new_invocation = ast_mod.Invocation{
        .path = flow.inv().path,
        .args = flow.inv().args,
        .annotations = new_inv_annotations,
    };

    const empty_conts = allocator.alloc(ast_mod.Continuation, 0) catch unreachable;

    var transformed_flow = flow.*;
    transformed_flow.body = ast_mod.rootSite(new_invocation, empty_conts, flow.location);
    transformed_flow.inline_body = inline_body_str;

    const new_item = ast_mod.Item{ .flow = transformed_flow };

    // Replace using recursive search (handles .flow and nested module_decls)
    const maybe_new_program = ast_functional.replaceFlowRecursive(allocator, program, flow, new_item) catch unreachable;
    if (maybe_new_program) |new_program_val| {
        const result = allocator.create(ast_mod.Program) catch unreachable;
        result.* = new_program_val;
        return .{ .whole_program = result };
    } else {
        std.debug.print("ERROR: Router transform failed - flow not found in program\n", .{});
        return .{};
    }
}

// ============================================================================
// STATIC FILE SERVING
// ============================================================================
// Compile-time static file embedding with gzip compression, ETags, and
// automatic MIME type detection.
//
// Usage:
//   ~orisha:static(name: "site", root: "public", fallback: "200.html")
//   ~orisha:handler = orisha:static-router(name: "site")
//   ~orisha:serve(port: 3000)

const Sha256 = std.crypto.hash.sha2.Sha256;
const zlib = @cImport({
    @cInclude("zlib.h");
});

const ProcessedRoute = struct {
    method: []const u8,
    path: []const u8,
    response: []const u8,
    response_gzip: ?[]const u8,
    etag: []const u8,
    etag_gzip: ?[]const u8,
};

fn stripQuotes(s: []const u8) []const u8 {
    if (s.len >= 2 and s[0] == '"' and s[s.len - 1] == '"') {
        return s[1 .. s.len - 1];
    }
    return s;
}

fn processDirectory(allocator: std.mem.Allocator, routes: *std.ArrayList(ProcessedRoute), method: []const u8, base_path: []const u8, dir_path: []const u8) void {
    var dir = std.fs.cwd().openDir(dir_path, .{ .iterate = true }) catch return;
    defer dir.close();
    var walker = dir.walk(allocator) catch return;
    defer walker.deinit();
    while (walker.next() catch null) |entry| {
        if (entry.kind != .file) continue;
        const file_path = std.fmt.allocPrint(allocator, "{s}/{s}", .{ dir_path, entry.path }) catch continue;
        const route_path = if (std.mem.eql(u8, base_path, "/"))
            std.fmt.allocPrint(allocator, "/{s}", .{entry.path}) catch continue
        else
            std.fmt.allocPrint(allocator, "{s}/{s}", .{ base_path, entry.path }) catch continue;
        const content = std.fs.cwd().readFileAlloc(allocator, file_path, 10 * 1024 * 1024) catch continue;
        // SvelteKit's hashed assets all live under /_app/ — their URLs change
        // when the content does, so they are safe to cache as immutable.
        const http_resp = buildHttpResponse(allocator, content, mimeTypeFromPath(file_path), std.mem.startsWith(u8, route_path, "/_app/")) catch continue;
        routes.append(allocator, .{ .method = method, .path = route_path, .response = http_resp.response, .response_gzip = http_resp.response_gzip, .etag = http_resp.etag, .etag_gzip = http_resp.etag_gzip }) catch continue;
        if (std.mem.eql(u8, entry.path, "index.html") and std.mem.eql(u8, base_path, "/")) {
            routes.append(allocator, .{ .method = method, .path = "/", .response = http_resp.response, .response_gzip = http_resp.response_gzip, .etag = http_resp.etag, .etag_gzip = http_resp.etag_gzip }) catch continue;
        }

        // A page is requested at /blog, and it is stored as blog.html. Serving
        // only the literal name is what every other static server resolves for
        // you, and skipping it does not look like a bug — the SPA fallback
        // answers 200 with the empty shell, so the browser fills the page in and
        // only a crawler can tell. Measured against korulang.org's own build on
        // 2026-08-10: 233 real pages embedded, ONE of them (the root) reachable.
        //
        // Both spellings get registered, with and without the trailing slash,
        // because a link may carry either and neither should be a miss.
        if (std.mem.endsWith(u8, route_path, ".html")) {
            const stem = route_path[0 .. route_path.len - ".html".len];
            const target = if (std.mem.endsWith(u8, stem, "/index"))
                stem[0 .. stem.len - "/index".len] // /docs/index.html -> /docs
            else
                stem; // /blog.html -> /blog
            if (target.len > 0) {
                routes.append(allocator, .{ .method = method, .path = target, .response = http_resp.response, .response_gzip = http_resp.response_gzip, .etag = http_resp.etag, .etag_gzip = http_resp.etag_gzip }) catch continue;
                const slashed = std.fmt.allocPrint(allocator, "{s}/", .{target}) catch continue;
                routes.append(allocator, .{ .method = method, .path = slashed, .response = http_resp.response, .response_gzip = http_resp.response_gzip, .etag = http_resp.etag, .etag_gzip = http_resp.etag_gzip }) catch continue;
            }
        }
    }
}

fn processFile(allocator: std.mem.Allocator, routes: *std.ArrayList(ProcessedRoute), method: []const u8, path: []const u8, file_path: []const u8, content_type_override: ?[]const u8) void {
    const content = std.fs.cwd().readFileAlloc(allocator, file_path, 10 * 1024 * 1024) catch return;
    const content_type = content_type_override orelse mimeTypeFromPath(file_path);
    const http_resp = buildHttpResponse(allocator, content, content_type, std.mem.startsWith(u8, path, "/_app/")) catch return;
    routes.append(allocator, .{ .method = method, .path = path, .response = http_resp.response, .response_gzip = http_resp.response_gzip, .etag = http_resp.etag, .etag_gzip = http_resp.etag_gzip }) catch return;
}

fn computeEtag(content: []const u8, out: *[64]u8) void {
    var hash: [32]u8 = undefined;
    Sha256.hash(content, &hash, .{});
    const hex_chars = "0123456789abcdef";
    for (hash, 0..) |byte, i| {
        out[i * 2] = hex_chars[byte >> 4];
        out[i * 2 + 1] = hex_chars[byte & 0x0f];
    }
}

const HttpResponse = struct { response: []const u8, response_gzip: ?[]const u8, etag: []const u8, etag_gzip: ?[]const u8 };

fn isCompressible(content_type: []const u8) bool {
    if (std.mem.startsWith(u8, content_type, "text/")) return true;
    if (std.mem.startsWith(u8, content_type, "application/javascript")) return true;
    if (std.mem.startsWith(u8, content_type, "application/json")) return true;
    if (std.mem.startsWith(u8, content_type, "image/svg")) return true;
    return false;
}

fn gzipCompress(allocator: std.mem.Allocator, content: []const u8) ?[]const u8 {
    if (content.len < 100) return null;
    const max_output = zlib.compressBound(@intCast(content.len));
    const output = allocator.alloc(u8, max_output) catch return null;
    var strm: zlib.z_stream = std.mem.zeroes(zlib.z_stream);
    strm.next_in = @constCast(content.ptr);
    strm.avail_in = @intCast(content.len);
    strm.next_out = output.ptr;
    strm.avail_out = @intCast(output.len);
    if (zlib.deflateInit2(&strm, zlib.Z_DEFAULT_COMPRESSION, zlib.Z_DEFLATED, 15 + 16, 8, zlib.Z_DEFAULT_STRATEGY) != zlib.Z_OK) {
        allocator.free(output);
        return null;
    }
    const result = zlib.deflate(&strm, zlib.Z_FINISH);
    const compressed_size = output.len - strm.avail_out;
    _ = zlib.deflateEnd(&strm);
    if (result != zlib.Z_STREAM_END or compressed_size >= content.len) {
        allocator.free(output);
        return null;
    }
    return allocator.realloc(output, compressed_size) catch output[0..compressed_size];
}

// Both representations are baked per route — identity always, gzip when the
// MIME type is compressible and deflate actually wins — because the client is
// only known at request time. Serving the gzip bytes to a client that never
// advertised `Accept-Encoding: gzip` is a protocol violation; a body it cannot
// decode is a 200 that renders as garbage. `Vary: Accept-Encoding` goes on
// BOTH variants so a shared cache keys them apart instead of replaying
// whichever one it saw first.
fn buildHttpResponse(allocator: std.mem.Allocator, content: []const u8, content_type: []const u8, is_immutable: bool) !HttpResponse {
    var etag_buf: [64]u8 = undefined;
    computeEtag(content, &etag_buf);
    const etag = try allocator.dupe(u8, etag_buf[0..16]);
    const compressed = if (isCompressible(content_type)) gzipCompress(allocator, content) else null;
    const negotiated = compressed != null;
    // Strong etags are per-REPRESENTATION (RFC 9110 §8.8.3): the identity and
    // gzip bodies are different bytes, so they carry different validators.
    // Sharing one strong etag lets a cache treat the two as interchangeable.
    var etag_gzip: ?[]const u8 = null;
    if (compressed) |gz| {
        var gz_buf: [64]u8 = undefined;
        computeEtag(gz, &gz_buf);
        etag_gzip = try allocator.dupe(u8, gz_buf[0..16]);
    }
    const response = try renderResponse(allocator, content, content_type, etag, false, negotiated, is_immutable);
    const response_gzip: ?[]const u8 = if (compressed) |gz|
        try renderResponse(allocator, gz, content_type, etag_gzip.?, true, true, is_immutable)
    else
        null;
    return .{ .response = response, .response_gzip = response_gzip, .etag = etag, .etag_gzip = etag_gzip };
}

fn renderResponse(allocator: std.mem.Allocator, body: []const u8, content_type: []const u8, etag: []const u8, gzipped: bool, negotiated: bool, is_immutable: bool) ![]const u8 {
    var response: std.ArrayList(u8) = .empty;
    try response.appendSlice(allocator, "HTTP/1.1 200 OK\r\nContent-Type: ");
    try response.appendSlice(allocator, content_type);
    try response.appendSlice(allocator, "\r\n");
    if (gzipped) try response.appendSlice(allocator, "Content-Encoding: gzip\r\n");
    if (negotiated) try response.appendSlice(allocator, "Vary: Accept-Encoding\r\n");
    try response.appendSlice(allocator, "Content-Length: ");
    var len_buf: [20]u8 = undefined;
    try response.appendSlice(allocator, std.fmt.bufPrint(&len_buf, "{}", .{body.len}) catch "0");
    try response.appendSlice(allocator, "\r\nETag: \"");
    try response.appendSlice(allocator, etag);
    // The baked content cannot change without a rebuild, so it is safe to
    // cache: hashed asset URLs are immutable for a year; pages get a one-day
    // shared-cache lifetime with stale-while-revalidate, and the client
    // revalidates via the ETag above (max-age=0 on the client-facing header).
    //
    // Vercel will cache a Function response that carries s-maxage — but only
    // if that directive sits on `Vercel-CDN-Cache-Control` (or
    // `CDN-Cache-Control`). Putting s-maxage on `Cache-Control` alone is what
    // we did first: Vercel strips it before the browser sees the response
    // (`cache-control: public, max-age=0`) and still runs the function every
    // time (`x-vercel-cache: MISS`). The two CDN headers are the ones that
    // actually move a deployment off the function-per-request meter.
    //
    // A Koru/Orisha response is baked by the runtime that answers it. This
    // header is the self-identification — the crown, not a host label — so
    // any caller can verify the page was served by Orisha (never a SvelteKit
    // hydration shell) straight off the wire. It sits BEFORE `Connection:` and
    // the `\r\n\r\n` that terminates the head; putting it after the head
    // terminator would push it into the BODY and corrupt every baked response.
    try response.appendSlice(allocator, "\"\r\nX-Powered-By: koru/orisha\r\nX-Orisha: reactor\r\nConnection: keep-alive\r\n");
    if (is_immutable) {
        try response.appendSlice(allocator, "Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable\r\n" ++
            "CDN-Cache-Control: public, s-maxage=31536000, immutable\r\n" ++
            "Vercel-CDN-Cache-Control: public, s-maxage=31536000, immutable\r\n\r\n");
    } else {
        try response.appendSlice(allocator, "Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=86400\r\n" ++
            "CDN-Cache-Control: public, s-maxage=86400, stale-while-revalidate=86400\r\n" ++
            "Vercel-CDN-Cache-Control: public, s-maxage=86400, stale-while-revalidate=86400\r\n\r\n");
    }
    try response.appendSlice(allocator, body);
    return response.items;
}

fn mimeTypeFromPath(path: []const u8) []const u8 {
    if (std.mem.endsWith(u8, path, ".html")) return "text/html; charset=utf-8";
    if (std.mem.endsWith(u8, path, ".css")) return "text/css; charset=utf-8";
    if (std.mem.endsWith(u8, path, ".js")) return "application/javascript; charset=utf-8";
    if (std.mem.endsWith(u8, path, ".json")) return "application/json";
    if (std.mem.endsWith(u8, path, ".png")) return "image/png";
    if (std.mem.endsWith(u8, path, ".jpg") or std.mem.endsWith(u8, path, ".jpeg")) return "image/jpeg";
    if (std.mem.endsWith(u8, path, ".gif")) return "image/gif";
    if (std.mem.endsWith(u8, path, ".svg")) return "image/svg+xml";
    if (std.mem.endsWith(u8, path, ".ico")) return "image/x-icon";
    if (std.mem.endsWith(u8, path, ".woff")) return "font/woff";
    if (std.mem.endsWith(u8, path, ".woff2")) return "font/woff2";
    if (std.mem.endsWith(u8, path, ".ttf")) return "font/ttf";
    if (std.mem.endsWith(u8, path, ".webp")) return "image/webp";
    return "application/octet-stream";
}

fn appendFmt(allocator: std.mem.Allocator, list: *std.ArrayList(u8), comptime fmt: []const u8, args: anytype) !void {
    var buf: [4096]u8 = undefined;
    try list.appendSlice(allocator, std.fmt.bufPrint(&buf, fmt, args) catch return error.OutOfMemory);
}

// Order the routes by how often they are actually requested.
//
// This is the compile-time half of what a C toolchain calls profile-guided
// optimisation, and it is available here for a reason no other web server can
// copy: at the moment this runs, the entire site is a value in memory. nginx
// cannot reorder around your traffic because nginx has not met your site yet —
// it discovers files at runtime, one open() at a time, which is the only moment
// at which reordering is no longer free.
//
// What ordering buys is NOT lookup: the table is a comptime hash and a hash does
// not care where an entry sits. What it buys is LAYOUT — the response bodies are
// emitted in this order, so the pages that serve most of the traffic end up
// adjacent in the binary instead of scattered across it by alphabetical
// accident. Whether that is worth anything is an empirical question and it may
// well be worth nothing; see benchmarks/twobox.
//
// The profile is `orisha.profile` in the working directory when it exists — a
// plain access log. No profile, no reordering, and it says which it did.
fn loadProfileHits(allocator: std.mem.Allocator) ?struct { hits: std.StringHashMap(u64), counted: u64, storage: []u8 } {
    const profile_text = std.fs.cwd().readFileAlloc(allocator, "orisha.profile", 64 * 1024 * 1024) catch return null;

    var hits = std.StringHashMap(u64).init(allocator);
    var lines = std.mem.splitScalar(u8, profile_text, '\n');
    var counted: u64 = 0;
    while (lines.next()) |line| {
        const q = std.mem.indexOfScalar(u8, line, '"') orelse continue;
        var parts = std.mem.tokenizeScalar(u8, line[q + 1 ..], ' ');
        _ = parts.next() orelse continue; // method
        const target = parts.next() orelse continue;
        const path = if (std.mem.indexOfScalar(u8, target, '?')) |qi| target[0..qi] else target;
        const gop = hits.getOrPut(path) catch continue;
        if (!gop.found_existing) gop.value_ptr.* = 0;
        gop.value_ptr.* += 1;
        counted += 1;
    }
    if (counted == 0) {
        hits.deinit();
        allocator.free(profile_text);
        return null;
    }
    return .{ .hits = hits, .counted = counted, .storage = profile_text };
}

fn orderByProfile(allocator: std.mem.Allocator, routes: []ProcessedRoute) void {
    const loaded = loadProfileHits(allocator) orelse {
        std.debug.print("[STATIC_ROUTER] profile: none (orisha.profile absent) — routes keep directory order\n", .{});
        return;
    };
    defer allocator.free(loaded.storage);
    var hits = loaded.hits;
    defer hits.deinit();

    const Ctx = struct {
        h: *std.StringHashMap(u64),
        fn hotter(self: @This(), a: ProcessedRoute, b: ProcessedRoute) bool {
            const ha = self.h.get(a.path) orelse 0;
            const hb = self.h.get(b.path) orelse 0;
            if (ha != hb) return ha > hb;
            return std.mem.lessThan(u8, a.path, b.path); // stable for the cold tail
        }
    };
    std.sort.block(ProcessedRoute, routes, Ctx{ .h = &hits }, Ctx.hotter);

    var named: u64 = 0;
    for (routes) |r| { if (hits.get(r.path)) |_| named += 1; }
    std.debug.print("[STATIC_ROUTER] profile: {d} requests over {d} paths — hottest is {s}, {d}/{d} routes appear\n", .{ loaded.counted, hits.count(), routes[0].path, named, routes.len });
}

fn appendZigString(allocator: std.mem.Allocator, output: *std.ArrayList(u8), bytes: []const u8) !void {
    try output.append(allocator, '"');
    for (bytes) |byte| {
        switch (byte) {
            '\n' => try output.appendSlice(allocator, "\\n"),
            '\r' => try output.appendSlice(allocator, "\\r"),
            '\t' => try output.appendSlice(allocator, "\\t"),
            '"' => try output.appendSlice(allocator, "\\\""),
            '\\' => try output.appendSlice(allocator, "\\\\"),
            0x20...0x21, 0x23...0x5b, 0x5d...0x7e => try output.append(allocator, byte),
            else => {
                var hex_buf: [4]u8 = undefined;
                _ = std.fmt.bufPrint(&hex_buf, "\\x{x:0>2}", .{byte}) catch unreachable;
                try output.appendSlice(allocator, &hex_buf);
            },
        }
    }
    try output.append(allocator, '"');
}

fn generateNamedRoutesFile(allocator: std.mem.Allocator, routes_const: []const ProcessedRoute, name: []const u8) !void {
    // Copied because ordering mutates, and the caller's slice is shared.
    const routes = try allocator.dupe(ProcessedRoute, routes_const);
    defer allocator.free(routes);
    orderByProfile(allocator, routes);

    std.fs.cwd().makeDir("generated") catch |err| switch (err) {
        error.PathAlreadyExists => {},
        else => return err,
    };
    var output: std.ArrayList(u8) = .empty;
    defer output.deinit(allocator);
    try output.appendSlice(allocator,
        \\// AUTO-GENERATED by Orisha
        \\const std = @import("std");
        \\pub const Route = struct { method: []const u8, path: []const u8, response: []const u8, response_gzip: ?[]const u8, etag: []const u8, etag_gzip: ?[]const u8 };
        \\pub const response_304 = "HTTP/1.1 304 Not Modified\r\nConnection: keep-alive\r\n\r\n";
        \\pub const routes = [_]Route{
        \\
    );
    for (routes) |route| {
        try appendFmt(allocator, &output, "    .{{ .method = \"{s}\", .path = \"{s}\", .etag = \"{s}\", .response = ", .{ route.method, route.path, route.etag });
        try appendZigString(allocator, &output, route.response);
        if (route.response_gzip) |gz| {
            try output.appendSlice(allocator, ", .response_gzip = ");
            try appendZigString(allocator, &output, gz);
        } else {
            try output.appendSlice(allocator, ", .response_gzip = null");
        }
        if (route.etag_gzip) |eg| {
            try appendFmt(allocator, &output, ", .etag_gzip = \"{s}\"", .{eg});
        } else {
            try output.appendSlice(allocator, ", .etag_gzip = null");
        }
        try output.appendSlice(allocator, " },\n");
    }
    // The index, keyed on path, built while this program compiles.
    //
    // This was a linear walk of every route with a string compare per entry,
    // which for this site meant up to 1,587 `memcmp`s to answer one request.
    // It also made throughput a function of ALPHABETICAL POSITION: `/index.html`
    // sits 10th and `/200.html` 832nd, and the two benchmarked 25% apart for
    // that reason alone — a difference we spent a morning attributing to
    // payload size.
    //
    // Nothing here needed discovering at runtime. Every route is known while
    // the program compiles, which is the whole premise, and the dispatch was
    // the one place not acting like it.
    try output.appendSlice(allocator,
        \\};
        \\
        \\/// path -> index into `routes`. Built at comptime; no scan at runtime.
        \\pub const by_path = std.StaticStringMap(u32).initComptime(.{
        \\
    );
    for (routes, 0..) |route, i| {
        try appendFmt(allocator, &output, "    .{{ \"{s}\", {d} }},\n", .{ route.path, i });
    }
    try output.appendSlice(allocator,
        \\});
        \\
        \\/// Did this coding's own parameters refuse it? `q=0` is an explicit
        \\/// refusal — presence in the list is not consent. A malformed qvalue
        \\/// refuses too: identity is always legal, so doubt serves identity.
        \\fn codingRefused(params: []const u8) bool {
        \\    var it = std.mem.splitScalar(u8, params, ';');
        \\    while (it.next()) |param| {
        \\        const p = std.mem.trim(u8, param, " \t");
        \\        if (p.len >= 2 and (p[0] == 'q' or p[0] == 'Q') and p[1] == '=') {
        \\            const v = std.fmt.parseFloat(f64, std.mem.trim(u8, p[2..], " \t")) catch return true;
        \\            return v == 0;
        \\        }
        \\    }
        \\    return false;
        \\}
        \\pub fn wantsGzip(accept_encoding: ?[]const u8) bool {
        \\    const ae = accept_encoding orelse return false;
        \\    var star: ?[]const u8 = null;
        \\    var it = std.mem.splitScalar(u8, ae, ',');
        \\    while (it.next()) |raw_entry| {
        \\        const entry = std.mem.trim(u8, raw_entry, " \t");
        \\        const semi = std.mem.indexOfScalar(u8, entry, ';') orelse entry.len;
        \\        const name = std.mem.trim(u8, entry[0..semi], " \t");
        \\        if (std.ascii.eqlIgnoreCase(name, "gzip")) {
        \\            // An explicit entry beats the wildcard (RFC 9110 §12.5.3).
        \\            return !codingRefused(entry[semi..]);
        \\        }
        \\        if (std.mem.eql(u8, name, "*")) star = entry[semi..];
        \\    }
        \\    const sp = star orelse return false;
        \\    return !codingRefused(sp);
        \\}
        \\/// A GET route also answers HEAD — same selected representation, with
        \\/// only the head on the wire (RFC 9110 §9.3.2: no body, ever).
        \\fn headOnly(response: []const u8) []const u8 {
        \\    const end = std.mem.indexOf(u8, response, "\r\n\r\n") orelse return response;
        \\    return response[0 .. end + 4];
        \\}
        \\pub fn lookup(method: []const u8, path: []const u8) ?[]const u8 {
        \\    const head = std.mem.eql(u8, method, "HEAD");
        \\    const i = by_path.get(path) orelse return null;
        \\    const r = routes[i];
        \\    if (!std.mem.eql(u8, r.method, if (head) "GET" else method)) return null;
        \\    return if (head) headOnly(r.response) else r.response;
        \\}
        \\pub fn lookupWithEtag(method: []const u8, path: []const u8, client_etag: ?[]const u8, accept_encoding: ?[]const u8) ?[]const u8 {
        \\    const head = std.mem.eql(u8, method, "HEAD");
        \\    const i = by_path.get(path) orelse return null;
        \\    const r = routes[i];
        \\    if (!std.mem.eql(u8, r.method, if (head) "GET" else method)) return null;
        \\    // If-None-Match validates the SELECTED representation: identity and
        \\    // gzip are different bytes and carry different strong etags.
        \\    const use_gz = r.response_gzip != null and wantsGzip(accept_encoding);
        \\    const picked = if (use_gz) r.response_gzip.? else r.response;
        \\    const picked_etag = if (use_gz) r.etag_gzip.? else r.etag;
        \\    if (client_etag) |e| if (std.mem.eql(u8, e, picked_etag)) return response_304;
        \\    return if (head) headOnly(picked) else picked;
        \\}
        \\
        \\test "wantsGzip reads the advertisement" {
        \\    try std.testing.expect(!wantsGzip(null));
        \\    try std.testing.expect(wantsGzip("gzip"));
        \\    try std.testing.expect(wantsGzip("br, GZIP, deflate"));
        \\    try std.testing.expect(!wantsGzip("br"));
        \\    try std.testing.expect(!wantsGzip("deflate"));
        \\
        \\    // q=0 is an explicit refusal — presence is not consent.
        \\    try std.testing.expect(!wantsGzip("gzip;q=0"));
        \\    try std.testing.expect(!wantsGzip("gzip;q=0.000"));
        \\    try std.testing.expect(!wantsGzip("br;q=1, gzip;q=0"));
        \\    try std.testing.expect(wantsGzip("gzip;q=0.5"));
        \\    try std.testing.expect(wantsGzip("gzip ; q=0.5"));
        \\
        \\    // The wildcard admits what nothing refused — and an explicit
        \\    // gzip entry decides over it in either direction.
        \\    try std.testing.expect(wantsGzip("*"));
        \\    try std.testing.expect(wantsGzip("br, *"));
        \\    try std.testing.expect(!wantsGzip("*;q=0"));
        \\    try std.testing.expect(!wantsGzip("gzip;q=0, *"));
        \\    try std.testing.expect(wantsGzip("*;q=0, gzip"));
        \\}
        \\
        \\test "negotiated routes serve identity unless gzip is advertised" {
        \\    for (routes) |r| {
        \\        const gz = r.response_gzip orelse continue;
        \\        try std.testing.expectEqualStrings(r.response, lookupWithEtag(r.method, r.path, null, null).?);
        \\        try std.testing.expectEqualStrings(r.response, lookupWithEtag(r.method, r.path, null, "br").?);
        \\        try std.testing.expectEqualStrings(r.response, lookupWithEtag(r.method, r.path, null, "gzip;q=0").?);
        \\        try std.testing.expectEqualStrings(gz, lookupWithEtag(r.method, r.path, null, "gzip").?);
        \\        try std.testing.expectEqualStrings(gz, lookupWithEtag(r.method, r.path, null, "*").?);
        \\        const gz_head = gz[0..std.mem.indexOf(u8, gz, "\r\n\r\n").?];
        \\        const id_head = r.response[0..std.mem.indexOf(u8, r.response, "\r\n\r\n").?];
        \\        try std.testing.expect(std.mem.indexOf(u8, gz_head, "Content-Encoding: gzip") != null);
        \\        try std.testing.expect(std.mem.indexOf(u8, gz_head, "Vary: Accept-Encoding") != null);
        \\        try std.testing.expect(std.mem.indexOf(u8, id_head, "Vary: Accept-Encoding") != null);
        \\        try std.testing.expect(std.mem.indexOf(u8, id_head, "Content-Encoding") == null);
        \\        try std.testing.expectEqualStrings(response_304, lookupWithEtag(r.method, r.path, r.etag, null).?);
        \\    }
        \\}
        \\
        \\test "non-negotiated routes serve identity even when gzip is advertised" {
        \\    for (routes) |r| {
        \\        if (r.response_gzip != null) continue;
        \\        try std.testing.expectEqualStrings(r.response, lookupWithEtag(r.method, r.path, null, "gzip").?);
        \\        const head = r.response[0..std.mem.indexOf(u8, r.response, "\r\n\r\n").?];
        \\        try std.testing.expect(std.mem.indexOf(u8, head, "Content-Encoding") == null);
        \\    }
        \\}
        \\
        \\test "HEAD answers with the selected variant's head and no body" {
        \\    for (routes) |r| {
        \\        const head = lookupWithEtag("HEAD", r.path, null, null).?;
        \\        const head_end = std.mem.indexOf(u8, r.response, "\r\n\r\n").? + 4;
        \\        // The head is the identity variant's head — and it is ALL of it.
        \\        try std.testing.expectEqualStrings(r.response[0..head_end], head);
        \\        try std.testing.expectEqual(head_end, head.len);
        \\        if (r.response_gzip) |gz| {
        \\            const gz_head = lookupWithEtag("HEAD", r.path, null, "gzip").?;
        \\            const gz_end = std.mem.indexOf(u8, gz, "\r\n\r\n").? + 4;
        \\            try std.testing.expectEqualStrings(gz[0..gz_end], gz_head);
        \\            try std.testing.expectEqual(gz_end, gz_head.len);
        \\        }
        \\    }
        \\}
        \\
        \\test "identity and gzip carry distinct strong etags" {
        \\    for (routes) |r| {
        \\        const gz_etag = r.etag_gzip orelse continue;
        \\        try std.testing.expect(!std.mem.eql(u8, r.etag, gz_etag));
        \\        // 304 only when the client holds the SELECTED variant's etag.
        \\        try std.testing.expectEqualStrings(response_304, lookupWithEtag(r.method, r.path, gz_etag, "gzip").?);
        \\        try std.testing.expectEqualStrings(response_304, lookupWithEtag(r.method, r.path, r.etag, null).?);
        \\        // The other variant's etag does not validate this selection.
        \\        try std.testing.expectEqualStrings(r.response_gzip.?, lookupWithEtag(r.method, r.path, r.etag, "gzip").?);
        \\    }
        \\}
        \\
    );
    const filename = try std.fmt.allocPrint(allocator, "generated/{s}_routes.zig", .{name});
    const file = try std.fs.cwd().createFile(filename, .{});
    defer file.close();
    try file.writeAll(output.items);
}

~proc static-router|zig {
    const ast_mod = @import("ast");
    const ast_functional = @import("ast_functional");

    // Get the flow containing this static-router invocation
    const flow = if (item.* == .flow)
        &item.flow
    else
        return .{};

    // Check if already transformed
    for (flow.inv().annotations) |ann| {
        if (std.mem.startsWith(u8, ann, "@pass_ran")) {
            return .{};
        }
    }

    // Extract name parameter
    var static_name: []const u8 = "site";
    for (invocation.args) |arg| {
        if (std.mem.eql(u8, arg.name, "name")) {
            static_name = stripQuotes(arg.value);
            break;
        }
    }

    std.debug.print("[STATIC_ROUTER TRANSFORM] Processing static-router for '{s}'\n", .{static_name});

    // Find the matching ~orisha:static(name: "...") declaration in the program
    var static_root: ?[]const u8 = null;
    var static_fallback: ?[]const u8 = null;

    for (program.items) |prog_item| {
        if (prog_item != .flow) continue;
        const inv = prog_item.flow.inv().*;
        if (inv.path.segments.len == 0) continue;
        const last_segment = inv.path.segments[inv.path.segments.len - 1];
        if (!std.mem.eql(u8, last_segment, "static")) continue;

        var found_name: ?[]const u8 = null;
        for (inv.args) |arg| {
            if (std.mem.eql(u8, arg.name, "name")) found_name = stripQuotes(arg.value);
            if (std.mem.eql(u8, arg.name, "root")) static_root = stripQuotes(arg.value);
            if (std.mem.eql(u8, arg.name, "fallback")) static_fallback = stripQuotes(arg.value);
        }
        if (found_name) |n| {
            if (std.mem.eql(u8, n, static_name)) break;
        }
        // Reset if this wasn't the matching declaration
        static_root = null;
        static_fallback = null;
    }

    if (static_root == null) {
        std.debug.print("ERROR: No ~orisha:static(name: \"{s}\") declaration found\n", .{static_name});
        return .{};
    }

    std.debug.print("[STATIC_ROUTER] root={s}, fallback={s}\n", .{
        static_root.?,
        if (static_fallback) |f| f else "(none)",
    });

    // Process the directory and generate routes file
    var routes: std.ArrayList(ProcessedRoute) = .empty;
    processDirectory(allocator, &routes, "GET", "/", static_root.?);

    const routes_filename = std.fmt.allocPrint(allocator, "generated/{s}_routes.zig", .{static_name}) catch unreachable;
    std.debug.print("[STATIC_ROUTER] Generating {s} ({} routes)\n", .{ routes_filename, routes.items.len });

    generateNamedRoutesFile(allocator, routes.items, static_name) catch |err| {
        std.debug.print("ERROR generating {s}: {}\n", .{ routes_filename, err });
        return .{};
    };

    // Build inline_body: import routes, lookup, return response
    var ib: std.ArrayList(u8) = .empty;
    ib.appendSlice(allocator, "//@koru:inline_stmt\n") catch unreachable;

    // Import the generated routes — use @import with the generated file path
    ib.appendSlice(allocator, "    const _static_routes = @import(\"generated/") catch unreachable;
    ib.appendSlice(allocator, static_name) catch unreachable;
    ib.appendSlice(allocator, "_routes.zig\");\n") catch unreachable;

    // Lookup with ETag: use req from the handler's scope
    ib.appendSlice(allocator, "    if (_static_routes.lookupWithEtag(req.method, req.path, req.if_none_match, req.accept_encoding)) |_static_resp| {\n") catch unreachable;
    ib.appendSlice(allocator, "        return .{ .status = 200, .body = _static_resp, .content_type = null };\n") catch unreachable;
    ib.appendSlice(allocator, "    }") catch unreachable;

    // Fallback handling
    if (static_fallback) |fallback| {
        // SPA fallback: look up the fallback file
        // HEAD must keep its head-only semantics through the fallback too —
        // hardcoding "GET" here would ship the body (RFC 9110 §9.3.2).
        ib.appendSlice(allocator, " else if (_static_routes.lookupWithEtag(if (std.mem.eql(u8, req.method, \"HEAD\")) \"HEAD\" else \"GET\", \"/") catch unreachable;
        ib.appendSlice(allocator, fallback) catch unreachable;
        ib.appendSlice(allocator, "\", null, req.accept_encoding)) |_fallback_resp| {\n") catch unreachable;
        ib.appendSlice(allocator, "        return .{ .status = 200, .body = _fallback_resp, .content_type = null };\n") catch unreachable;
        ib.appendSlice(allocator, "    } else {\n") catch unreachable;
        ib.appendSlice(allocator, "        return .{ .status = 404, .body = \"Not Found\", .content_type = null };\n") catch unreachable;
        ib.appendSlice(allocator, "    }\n") catch unreachable;
    } else {
        // No fallback: 404
        ib.appendSlice(allocator, " else {\n") catch unreachable;
        ib.appendSlice(allocator, "        return .{ .status = 404, .body = \"Not Found\", .content_type = null };\n") catch unreachable;
        ib.appendSlice(allocator, "    }\n") catch unreachable;
    }

    const inline_body_str = ib.toOwnedSlice(allocator) catch unreachable;
    std.debug.print("[STATIC_ROUTER TRANSFORM] Generated inline dispatch:\n{s}\n", .{inline_body_str});

    // Check if this invocation is the flow's top-level invocation or nested in a continuation.
    // If the flow's invocation IS static-router, we're standalone (top-level handler).
    // If it's something else (e.g., router), we're nested in a catch-all continuation.
    //
    // The name is the DECLARED one — kebab, as `[comptime|transform]pub tor
    // static-router` spells it in the companion contract. It read `static_router`
    // here until 2026-08-10, and a name that never matches does not fail loudly:
    // the nested branch below finds no continuation either, and falls through to
    // replacing the WHOLE flow. Standalone handlers survived that by coincidence;
    // a router with a static catch-all had every one of its own routes discarded.
    const flow_inv_name = if (flow.inv().path.segments.len > 0)
        flow.inv().path.segments[flow.inv().path.segments.len - 1]
    else
        "";
    const is_top_level = std.mem.eql(u8, flow_inv_name, "static-router");

    if (!is_top_level) {
        // Nested case: only replace the continuation's node, preserving the parent flow
        // so the outer transform (e.g., router) can still process it.
        std.debug.print("[STATIC_ROUTER TRANSFORM] Nested in '{s}' flow — replacing continuation only\n", .{flow_inv_name});

        // Strip //@koru:inline_stmt prefix — not needed for continuation inline_code nodes
        const prefix = "//@koru:inline_stmt\n";
        var nested_code = inline_body_str;
        if (std.mem.startsWith(u8, nested_code, prefix)) {
            nested_code = nested_code[prefix.len..];
        }

        // Find the continuation whose node is the static-router invocation and replace its node
        var new_conts = allocator.alloc(ast_mod.Continuation, flow.body.continuations.len) catch unreachable;
        var replaced = false;
        for (flow.body.continuations, 0..) |cont, ci| {
            if (!replaced) {
                if (cont.node) |node| {
                    if (node == .invocation) {
                        const segs = node.invocation.path.segments;
                        if (segs.len > 0 and std.mem.eql(u8, segs[segs.len - 1], "static-router")) {
                            // Verify name arg matches
                            var name_match = false;
                            for (node.invocation.args) |arg| {
                                if (std.mem.eql(u8, arg.name, "name") and
                                    std.mem.eql(u8, stripQuotes(arg.value), static_name)) {
                                    name_match = true;
                                    break;
                                }
                            }
                            if (name_match) {
                                // Copy-then-mutate: preserve every continuation field
                                // (incl. kind — the router re-runs after this and is
                                // kind-aware), swap only the node for the inline code.
                                var new_cont = cont;
                                new_cont.node = ast_mod.Node{ .inline_code = nested_code };
                                new_conts[ci] = new_cont;
                                replaced = true;
                                continue;
                            }
                        }
                    }
                }
            }
            new_conts[ci] = cont;
        }

        if (replaced) {
            // Keep the original invocation (no @pass_ran!) — only swap the
            // branch continuations under it.
            var modified_flow = flow.*;
            var new_body = flow.body;
            new_body.continuations = new_conts;
            modified_flow.body = new_body;

            const new_item = ast_mod.Item{ .flow = modified_flow };
            const maybe_new_program = ast_functional.replaceFlowRecursive(allocator, program, flow, new_item) catch unreachable;
            if (maybe_new_program) |new_program_val| {
                const result = allocator.create(ast_mod.Program) catch unreachable;
                result.* = new_program_val;
                std.debug.print("[STATIC_ROUTER TRANSFORM] Replaced nested continuation (preserving parent flow for '{s}')\n", .{flow_inv_name});
                return .{ .whole_program = result };
            }
        }
        // Fall through to top-level behavior if replacement didn't work
        std.debug.print("[STATIC_ROUTER TRANSFORM] WARNING: Could not find matching continuation, falling back to top-level replacement\n", .{});
    }

    // Top-level case: replace the entire flow (standalone handler)
    // Mark as transformed
    const new_inv_annotations = allocator.alloc([]const u8, flow.inv().annotations.len + 1) catch unreachable;
    for (flow.inv().annotations, 0..) |ann, j| {
        new_inv_annotations[j] = ann;
    }
    new_inv_annotations[flow.inv().annotations.len] = allocator.dupe(u8, "@pass_ran(\"transform\")") catch unreachable;

    const new_invocation = ast_mod.Invocation{
        .path = flow.inv().path,
        .args = flow.inv().args,
        .annotations = new_inv_annotations,
    };

    const empty_conts = allocator.alloc(ast_mod.Continuation, 0) catch unreachable;

    var transformed_flow = flow.*;
    transformed_flow.body = ast_mod.rootSite(new_invocation, empty_conts, flow.location);
    transformed_flow.inline_body = inline_body_str;

    const new_item = ast_mod.Item{ .flow = transformed_flow };

    // Hand the runner the change as a VALUE and let it own the placement.
    //
    // This used to rewrite the whole program itself and return it through the
    // `whole_program` escape. That escape is reserved for transforms that are
    // irreducibly global, and this one is not — it replaces exactly one site.
    // The cost was not style: the runner presents a NESTED site (a static
    // catch-all inside a router) as a synthetic top-level view, so the rewrite
    // landed on that synthetic copy and the real invocation was never replaced.
    // The compiler calls that out as KORU124 rather than letting it through.
    // `replacement` works for both positions — root swaps the whole item,
    // nested swaps the holding continuation's node.
    return .{ .replacement = new_item };
}
