// Canonical-decode tables computed once at comptime. Appendix B assigns
// codes consecutively within each bit length (gaps exist BETWEEN lengths —
// e.g. no 9-bit or 29-bit codes, and the 30-bit codes do not begin where a
// strictly-canonical walk would put them), so the only safe membership test
// per length is "first_code[L] <= code < first_code[L] + count[L]", all of
// which comes straight out of HUFF_CODES.
const HUFF = blk: {
    @setEvalBranchQuota(200_000); // the (bits, code) sort of 256 symbols
    var count = [_]u16{0} ** 31;
    var first = [_]u32{std.math.maxInt(u32)} ** 31;
    var off = [_]u16{0} ** 31;
    var syms: [256]u8 = undefined;
    for (HUFF_CODES[0..256]) |e| {
        count[e.bits] += 1;
        first[e.bits] = @min(first[e.bits], e.code);
    }
    var run: u16 = 0;
    var l: usize = 1;
    while (l <= 30) : (l += 1) {
        off[l] = run;
        run += count[l];
    }
    // Symbol order inside a length is by code value — sort the 256 symbol
    // ids on (bits, code). Insertion sort is fine at comptime.
    var order: [256]u8 = undefined;
    for (0..256) |i| order[i] = @intCast(i);
    var i: usize = 1;
    while (i < 256) : (i += 1) {
        const s = order[i];
        var j = i;
        while (j > 0) {
            const a = HUFF_CODES[order[j - 1]];
            const b = HUFF_CODES[s];
            if (a.bits < b.bits or (a.bits == b.bits and a.code < b.code)) break;
            order[j] = order[j - 1];
            j -= 1;
        }
        order[j] = s;
    }
    for (0..256) |s_i| syms[s_i] = order[s_i];
    break :blk .{ .count = count, .first = first, .off = off, .syms = syms };
};

const HUFF_MAX_BITS = 30; // EOS is 30 one-bits; no symbol is longer.

// Huffman-decode `bytes` into an owned slice parked on `retired`. MSB-first
// bit walk resolving one length at a time against HUFF. Errors are the spec
// ones (§5.2): an invalid code, EOS emitted as a symbol (its 30 one-bits
// simply never resolve), leftover padding longer than 7 bits, or padding
// that is not all ones.
fn huffDecode(table: *HpackTable, alloc: std.mem.Allocator, bytes: []const u8) ?[]const u8 {
    var out: std.ArrayListUnmanaged(u8) = .{};
    var code: u32 = 0;
    var nbits: u6 = 0;
    for (bytes) |byte| {
        var k: u4 = 8;
        while (k > 0) {
            k -= 1;
            code = (code << 1) | @as(u32, (byte >> @as(u3, @intCast(k))) & 1);
            nbits += 1;
            if (nbits > HUFF_MAX_BITS) {
                out.deinit(alloc);
                return null;
            }
            const cnt = HUFF.count[nbits];
            if (cnt != 0) {
                // Below this length's code range the prefix can never reach
                // any later code either — canonical ranges only grow.
                if (code < HUFF.first[nbits]) {
                    out.deinit(alloc);
                    return null;
                }
                const idx = code - HUFF.first[nbits];
                if (idx < cnt) {
                    out.append(alloc, HUFF.syms[HUFF.off[nbits] + idx]) catch {
                        out.deinit(alloc);
                        return null;
                    };
                    code = 0;
                    nbits = 0;
                }
            }
        }
    }
    // Whatever bits didn't complete a symbol are the padding: at most 7
    // bits, and every one of them a 1 (an EOS-code prefix).
    if (nbits > 7 or code != (@as(u32, 1) << @as(u5, @intCast(nbits))) - 1) {
        out.deinit(alloc);
        return null;
    }
    const s = out.toOwnedSlice(alloc) catch return null;
    table.retired.append(alloc, s) catch {
        alloc.free(s);
        return null;
    };
    return s;
}

// Wire index to pair: 1..61 is the static table, 62+ counts back from the
// newest dynamic entry. Index 0 and over-index are both malformed.
fn hpackLookup(table: *HpackTable, idx: u64) ?HpackPair {
    if (idx == 0) return null;
    if (idx <= HPACK_STATIC_COUNT) return HPACK_STATIC[idx - 1];
    const d = idx - 62;
    if (d >= table.entries.items.len) return null;
    return table.entries.items[table.entries.items.len - 1 - @as(usize, @intCast(d))];
}

// Move one table entry's bytes onto `retired` — emitted pairs this block
// may still borrow them, so the free is deferred to the next call.
fn hpackRetire(table: *HpackTable, alloc: std.mem.Allocator, e: HpackPair) bool {
    table.retired.append(alloc, e.name) catch {
        alloc.free(e.name);
        alloc.free(e.value);
        return false;
    };
    table.retired.append(alloc, e.value) catch {
        alloc.free(e.value);
        return false;
    };
    return true;
}

// Evict oldest-first until size <= max_size; `all` empties the table (the
// oversized-entry case, RFC §4.4). False on OOM — a failed decode frees
// callers from ever reading the borrowed pairs, so retiring early is safe.
fn hpackEvict(table: *HpackTable, alloc: std.mem.Allocator, comptime all: bool) bool {
    while (table.entries.items.len > 0 and (all or table.size > table.max_size)) {
        const e = table.entries.orderedRemove(0);
        table.size -= e.name.len + e.value.len + 32;
        if (!hpackRetire(table, alloc, e)) return false;
    }
    return true;
}

// §4.3: a new entry prepends to the index space (stored at the tail) and
// may push evictions out the other end. An entry larger than the whole
// table empties it and is not stored — still a valid block, not an error.
fn hpackInsert(table: *HpackTable, alloc: std.mem.Allocator, name: []const u8, value: []const u8) bool {
    const cost = name.len + value.len + 32;
    if (cost > table.max_size) return hpackEvict(table, alloc, true);
    const n = alloc.dupe(u8, name) catch return false;
    const v = alloc.dupe(u8, value) catch {
        alloc.free(n);
        return false;
    };
    table.entries.append(alloc, .{ .name = n, .value = v }) catch {
        alloc.free(n);
        alloc.free(v);
        return false;
    };
    table.size += cost;
    return hpackEvict(table, alloc, false);
}

// Decode one complete header block (one HEADERS + its CONTINUATIONs,
// assembled by the caller) into `pairs`. Returns the pair count, or null
// on malformed input — bad prefixes, over-index, invalid Huffman, an
// undersized pairs buffer — where the conn dies anyway, so a partially
// mutated table is fine: every committed field keeps it coherent.
pub fn hpackDecode(
    table: *HpackTable,
    alloc: std.mem.Allocator,
    block: []const u8,
    pairs: []HpackPair,
) ?usize {
    // Contract boundary: bytes retired by the previous call die now.
    for (table.retired.items) |s| alloc.free(s);
    table.retired.clearRetainingCapacity();

    var pos: usize = 0;
    var n: usize = 0;
    var fields_seen = false;
    while (pos < block.len) {
        const b = block[pos];
        if (b & 0x80 != 0) {
            // §6.1 — indexed header field.
            const idx = hpackInt(block, &pos, 7) orelse return null;
            const p = hpackLookup(table, idx) orelse return null;
            if (n == pairs.len) return null;
            pairs[n] = p;
            n += 1;
            fields_seen = true;
        } else if (b & 0xc0 == 0x40) {
            // §6.2.1 — literal with incremental indexing; the field joins
            // the dynamic table so later blocks can index it.
            const idx = hpackInt(block, &pos, 6) orelse return null;
            const name = if (idx == 0)
                (hpackString(table, alloc, block, &pos) orelse return null)
            else
                (hpackLookup(table, idx) orelse return null).name;
            const value = hpackString(table, alloc, block, &pos) orelse return null;
            if (n == pairs.len) return null;
            pairs[n] = .{ .name = name, .value = value };
            n += 1;
            fields_seen = true;
            if (!hpackInsert(table, alloc, name, value)) return null;
        } else if (b & 0xe0 == 0x20) {
            // §6.3 — dynamic table size update. Legal only ahead of the
            // block's first field (RFC §4.2) and only up to the negotiated
            // ceiling.
            if (fields_seen) return null;
            const new_max = hpackInt(block, &pos, 5) orelse return null;
            if (new_max > HPACK_MAX_TABLE_SIZE) return null;
            table.max_size = @intCast(new_max);
            if (!hpackEvict(table, alloc, false)) return null;
        } else {
            // §6.2.2/§6.2.3 — literal without indexing / never indexed.
            // The never-indexed bit is an encoder hint to intermediaries;
            // on the wire both forms decode identically.
            const idx = hpackInt(block, &pos, 4) orelse return null;
            const name = if (idx == 0)
                (hpackString(table, alloc, block, &pos) orelse return null)
            else
                (hpackLookup(table, idx) orelse return null).name;
            const value = hpackString(table, alloc, block, &pos) orelse return null;
            if (n == pairs.len) return null;
            pairs[n] = .{ .name = name, .value = value };
            n += 1;
            fields_seen = true;
        }
    }
    return n;
}

const H2_PREFACE = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n";

// First-bytes tri-state for conns on the shared port: .wait when the
// bytes so far are a strict prefix of the preface (more could still
// arrive), .h2c on a full match, .h1 on the first divergence. "PRI * "
// is not a request line an h1 client sends, so the check is decisive.
const PrefaceSniff = enum { wait, h2c, h1 };

fn h2cSniffPreface(bytes: []const u8) PrefaceSniff {
    const n = @min(bytes.len, H2_PREFACE.len);
    if (!std.mem.eql(u8, bytes[0..n], H2_PREFACE[0..n])) return .h1;
    return if (bytes.len < H2_PREFACE.len) .wait else .h2c;
}
const H2_SETTINGS_FRAME = [_]u8{ 0, 0, 0, 0x04, 0x00, 0, 0, 0, 0 };
const H2_SETTINGS_ACK = [_]u8{ 0, 0, 0, 0x04, 0x01, 0, 0, 0, 0 };

// Per-stream state — HTTP/2 multiplexes, so a conn can carry many
// outstanding requests. Streams are transient: a slot lives from
// HEADERS to END_STREAM response.
const H2_STREAMS_MAX = 32;
const H2Ready = struct { stream_id: u32, raw: []u8 };
const H2Stream = struct {
    id: u32 = 0,
    // HEADERS block bytes across CONTINUATION frames until END_HEADERS.
    head_block: std.ArrayListUnmanaged(u8) = .{},
    // DATA accumulation for request bodies until END_STREAM.
    body: std.ArrayListUnmanaged(u8) = .{},
    headers_done: bool = false,
    // HEADERS arrived without END_HEADERS — CONTINUATION frames append.
    headers_pending: bool = false,
    // END_STREAM rode on HEADERS; the stream serves when the block closes.
    end_stream_on_headers: bool = false,
    // Deferred response bytes (flow control or parked delay) — staged
    // per-stream because conn pending is shared ordering.
    sendq: std.ArrayListUnmanaged(u8) = .{},
    body_send_off: usize = 0,
    send_window: i64 = 65535,
    park_until: i64 = 0,
};

// Conn-level h2 flow control + the peer's SETTINGS preferences.
// send_window_conn is the 65535 connection window replenished only by
// WINDOW_UPDATE on stream 0 — we must never exceed it.
fn h2StreamSlot(st: *ConnState, id: u32) ?*H2Stream {
    for (&st.h2_streams) |*s| if (s.id == id) return s;
    for (&st.h2_streams) |*s| {
        if (s.id == 0) {
            s.* = .{ .id = id, .send_window = st.h2_peer_initial_window };
            return s;
        }
    }
    return null;
}

fn h2StreamDrop(st: *ConnState, id: u32) void {
    for (&st.h2_streams) |*s| {
        if (s.id == id) {
            s.head_block.deinit(pumpAlloc());
            s.body.deinit(pumpAlloc());
            s.sendq.deinit(pumpAlloc());
            s.* = .{};
            return;
        }
    }
}

// A complete h2 request becomes a synthesized h1-format head at the seam:
// the handler's Request parse is unchanged, the .k surface untouched. The
// block is assembled in the conn's own scratch so `x.raw` borrows st-owned
// bytes for the duration of arrived().
fn h2ServeStream(st: *ConnState, s: *H2Stream) void {
    st.h2_req_scratch.clearRetainingCapacity();
    // The synthesized request: METHOD SP HTTP/1.1 + a few real headers.
    // Path, method come from the HPACK-decoded pseudo-headers.
    h2FillRequestHead(st, s) catch {
        // Malformed pseudo-headers — RST the stream, keep the conn.
        h2WriteRstStream(st, s.id, 0x1); // PROTOCOL_ERROR
        h2StreamDrop(st, s.id);
        return;
    };
    // `arrived` is an effect that binds inside ~proc scopes — this module
    // fn can't fire it. The request queues on st.h2_ready as OWNED bytes
    // (freed by the dispatch site after the arm returns) and the ~proc
    // body drains it: scanRequest → Exchange{.h2_stream} → arrived.
    const raw = pumpAlloc().dupe(u8, st.h2_req_scratch.items) catch {
        h2WriteRstStream(st, s.id, 0x2); // INTERNAL_ERROR
        h2StreamDrop(st, s.id);
        return;
    };
    if (st.h2_ready_n >= st.h2_ready.len) {
        pumpAlloc().free(raw);
        h2WriteRstStream(st, s.id, 0x7); // REFUSED_STREAM
        h2StreamDrop(st, s.id);
        return;
    }
    st.h2_ready[st.h2_ready_n] = .{ .stream_id = s.id, .raw = raw };
    st.h2_ready_n += 1;
}

fn h2cPopReady(st: *ConnState) ?H2Ready {
    if (st.h2_ready_n == 0) return null;
    const r = st.h2_ready[0];
    for (1..st.h2_ready_n) |i| st.h2_ready[i - 1] = st.h2_ready[i];
    st.h2_ready_n -= 1;
    return r;
}

// Extracts :method/:path from the decoded pseudo-headers and writes the
// synthetic h1 block into st.h2_req_scratch: "M SP HTTP/1.1\r\n
// content-length: N\r\n<decoded headers>\r\n<body>". Content-length is
// stamped from the accumulated DATA bytes so echo-style routes work.
fn h2FillRequestHead(st: *ConnState, s: *H2Stream) !void {
    const a = pumpAlloc();
    const rq = &st.h2_req_scratch;
    var pairs: [64]HpackPair = undefined;
    const n = hpackDecode(&st.h2_hpack, a, s.head_block.items, &pairs) orelse
        return error.HpackMalformed;
    var method: []const u8 = "";
    var path: []const u8 = "";
    var authority: []const u8 = "";
    for (pairs[0..n]) |p| {
        if (std.mem.eql(u8, p.name, ":method")) method = p.value;
        if (std.mem.eql(u8, p.name, ":path")) path = p.value;
        if (std.mem.eql(u8, p.name, ":authority")) authority = p.value;
    }
    if (method.len == 0 or path.len == 0) return error.MissingPseudo;
    try rq.appendSlice(a, method);
    try rq.appendSlice(a, " ");
    try rq.appendSlice(a, path);
    try rq.appendSlice(a, " HTTP/1.1\r\nhost: ");
    try rq.appendSlice(a, authority);
    try rq.appendSlice(a, "\r\n");
    // Real request headers the handlers read (accept-encoding, content-type…)
    // map straight through — pseudo-headers don't.
    for (pairs[0..n]) |p| {
        if (p.name.len == 0 or p.name[0] == ':') continue;
        if (std.mem.eql(u8, p.name, "content-length")) continue;
        try rq.appendSlice(a, p.name);
        try rq.appendSlice(a, ": ");
        try rq.appendSlice(a, p.value);
        try rq.appendSlice(a, "\r\n");
    }
    var cl_buf: [24]u8 = undefined;
    const cl = std.fmt.bufPrint(&cl_buf, "content-length: {}\r\n\r\n", .{s.body.items.len}) catch return error.OOM;
    try rq.appendSlice(a, cl);
    try rq.appendSlice(a, s.body.items);
}

fn h2WriteRstStream(st: *ConnState, stream_id: u32, err: u32) void {
    var buf: [13]u8 = undefined;
    h2WriteFrameHeadSlice(buf[0..9], 0x3, 0, stream_id, 4);
    std.mem.writeInt(u32, buf[9..13], err, .big);
    _ = appendPending(st, &.{&buf});
}

fn h2WriteFrameHeadSlice(h: []u8, typ: u8, flags: u8, stream_id: u32, len: usize) void {
    h[0] = @intCast((len >> 16) & 0xFF);
    h[1] = @intCast((len >> 8) & 0xFF);
    h[2] = @intCast(len & 0xFF);
    h[3] = typ;
    h[4] = flags;
    std.mem.writeInt(u32, h[5..9], stream_id & 0x7FFFFFFF, .big);
}

// Response emit for an h2 stream: HEADERS (status + content-length +
// content-type, literal-without-indexing) + DATA chunked under the peer's
// max frame size, honoring both windows. `head` is the h1-rendered head
// — status is digits at 9..12, content-type is pulled by name.
fn h2Reply(st: *ConnState, x: *Exchange, head: []const u8, body: []const u8, delay_ms: i64) bool {
    const s = h2StreamSlot(st, x.h2_stream) orelse return false;
    // Stream staging: everything this response writes goes into s.sendq —
    // parked delay and window starvation both mean "hold this stream's
    // bytes"; conn pending stays ordered for streams that CAN write.
    s.sendq.clearRetainingCapacity();
    const a = pumpAlloc();
    const w = &s.sendq;
    // HPACK: literal-without-indexing for everything — :status 200 is a
    // static-table index (0x88); other statuses spell their digits.
    var hblk: [128]u8 = undefined;
    var hn: usize = 0;
    const status = if (head.len >= 12) head[9..12] else "200";
    if (std.mem.eql(u8, status, "200")) {
        hblk[hn] = 0x88;
        hn += 1;
    } else {
        hn += h2EncodePair(hblk[hn..], ":status", status);
    }
    hn = h2ContentHeaders(&hblk, hn, body.len, head);
    // A gRPC stream's status lives in trailers: the DATA frames carry the
    // message, then a trailing HEADERS closes with grpc-status — END_STREAM
    // moves off DATA entirely (RFC 7540 §8.1 + the gRPC wire spec).
    const is_grpc = std.mem.indexOf(u8, head, "application/grpc") != null;
    var fh: [9]u8 = undefined;
    h2WriteFrameHeadSlice(&fh, 0x1, 0x4, x.h2_stream, hn); // HEADERS, END_HEADERS
    w.appendSlice(a, &fh) catch return false;
    w.appendSlice(a, hblk[0..hn]) catch return false;
    // DATA: one or more frames, END_STREAM on the last unless trailers
    // follow (gRPC).
    var off: usize = 0;
    while (true) {
        const chunk = @min(body.len - off, st.h2_peer_max_frame);
        const last = off + chunk >= body.len;
        var dh: [9]u8 = undefined;
        h2WriteFrameHeadSlice(dh[0..9], 0x0, if (last and !is_grpc) 0x1 else 0x0, x.h2_stream, chunk);
        w.appendSlice(a, dh[0..9]) catch return false;
        w.appendSlice(a, body[off .. off + chunk]) catch return false;
        off += chunk;
        if (last) break;
    }
    if (is_grpc) {
        var tbl: [32]u8 = undefined;
        const tn = h2EncodePair(&tbl, "grpc-status", "0");
        var th: [9]u8 = undefined;
        h2WriteFrameHeadSlice(&th, 0x1, 0x4 | 0x1, x.h2_stream, tn); // HEADERS, END_HEADERS|END_STREAM
        w.appendSlice(a, &th) catch return false;
        w.appendSlice(a, tbl[0..tn]) catch return false;
    }
    if (delay_ms > 0) s.park_until = std.time.milliTimestamp() + delay_ms;
    // Emit what the windows allow; the rest stays staged in sendq.
    h2FlushStream(st, s);
    return true;
}

// The h1-rendered head carries exactly what h2 needs: status digits and a
// Content-Type line. Parses them into literal-without-indexing pairs.
fn h2ContentHeaders(hblk: *[128]u8, start: usize, body_len: usize, head: []const u8) usize {
    var hn = start;
    var cl_buf: [20]u8 = undefined;
    const cl = std.fmt.bufPrint(&cl_buf, "{}", .{body_len}) catch "0";
    hn += h2EncodePair(hblk[hn..], "content-length", cl);
    var ctype: []const u8 = "text/plain";
    if (std.mem.indexOf(u8, head, "Content-Type: ")) |at| {
        const vs = at + 14;
        const ve = std.mem.indexOfScalarPos(u8, head, vs, '\r') orelse head.len;
        ctype = head[vs..ve];
    }
    hn += h2EncodePair(hblk[hn..], "content-type", ctype);
    return hn;
}

// literal-without-indexing, new name: 0x00 prefix + name string + value
// string — always legal, never the wrong index. Huffman stays off; an
// encoder may always choose the plain form.
fn h2EncodePair(out: []u8, name: []const u8, value: []const u8) usize {
    out[0] = 0x00;
    var n: usize = 1;
    n += h2EncodeStr(out[n..], name, false);
    n += h2EncodeStr(out[n..], value, false);
    return n;
}

fn h2EncodeStr(out: []u8, s: []const u8, huffman: bool) usize {
    var n: usize = 0;
    var v = s.len;
    const hbit: u8 = if (huffman) 0x80 else 0;
    out[n] = hbit | @as(u8, @intCast(@min(v, 0x7F)));
    n += 1;
    if (v >= 0x7F) {
        v -= 0x7F;
        while (v >= 128) { out[n] = @intCast((v & 0x7F) | 0x80); n += 1; v >>= 7; }
        out[n] = @intCast(v); n += 1;
    }
    @memcpy(out[n .. n + s.len], s);
    return n + s.len;
}

// Move staged stream bytes into conn pending while the windows allow.
// send_window is per-stream; h2_send_window_conn is connection-wide.
fn h2FlushStream(st: *ConnState, s: *H2Stream) void {
    if (s.park_until > 0 and s.park_until > std.time.milliTimestamp()) return;
    while (s.body_send_off < s.sendq.items.len) {
        const allow: usize = @intCast(@max(0, @min(s.send_window, st.h2_send_window_conn)));
        // Only DATA payload costs window; HEADERS and frame bytes flow free.
        const take = h2WholeFramesWithin(s.sendq.items[s.body_send_off..], allow);
        if (take == 0) return; // windows shut — WINDOW_UPDATE re-opens
        _ = appendPending(st, &.{s.sendq.items[s.body_send_off .. s.body_send_off + take]});
        const cost = h2DataCost(s.sendq.items[s.body_send_off .. s.body_send_off + take]);
        s.body_send_off += take;
        s.send_window -= @intCast(cost);
        st.h2_send_window_conn -= @intCast(cost);
    }
    if (s.body_send_off >= s.sendq.items.len) h2StreamDrop(st, s.id);
}

// Frame-aligned prefix: the largest run of complete frames inside `bytes`
// whose DATA payload total ≤ budget. HEADERS and frame headers ride free —
// RFC 7540 §6.9: only DATA consumes flow-control window.
fn h2WholeFramesWithin(bytes: []const u8, data_budget: usize) usize {
    var off: usize = 0;
    var spent: usize = 0;
    while (off + 9 <= bytes.len) {
        const flen = (@as(usize, bytes[off]) << 16) | (@as(usize, bytes[off + 1]) << 8) | bytes[off + 2];
        if (off + 9 + flen > bytes.len) break;
        if (bytes[off + 3] == 0x0) { // DATA
            if (spent + flen > data_budget) break;
            spent += flen;
        }
        off += 9 + flen;
    }
    return off;
}

fn h2DataCost(bytes: []const u8) usize {
    var off: usize = 0;
    var cost: usize = 0;
    while (off + 9 <= bytes.len) {
        const flen = (@as(usize, bytes[off]) << 16) | (@as(usize, bytes[off + 1]) << 8) | bytes[off + 2];
        if (off + 9 + flen > bytes.len) break;
        if (bytes[off + 3] == 0x0) cost += flen;
        off += 9 + flen;
    }
    return cost;
}

fn h2StreamLookup(st: *ConnState, id: u32) ?*H2Stream {
    for (&st.h2_streams) |*s| if (s.id == id) return s;
    return null;
}

fn h2WriteWindowUpdate(st: *ConnState, stream_id: u32, inc: u32) void {
    if (inc == 0) return;
    var buf: [13]u8 = undefined;
    h2WriteFrameHeadSlice(buf[0..9], 0x8, 0, stream_id, 4);
    std.mem.writeInt(u32, buf[9..13], inc, .big);
    _ = appendPending(st, &.{&buf});
}

// Bytes from a h2c conn. Consumes what it can; what it can't needs more
// wire (or a dead conn). Returns the consumed count like scanRequest does.
fn h2cProcess(st: *ConnState, bytes: []const u8) usize {
    if (!st.h2_prefaced) {
        if (bytes.len < H2_PREFACE.len) return 0;
        if (!std.mem.eql(u8, bytes[0..H2_PREFACE.len], H2_PREFACE)) {
            st.ring_dead = true;
            return bytes.len;
        }
        st.h2_prefaced = true;
        _ = appendPending(st, &.{&H2_SETTINGS_FRAME});
        return H2_PREFACE.len;
    }
    var consumed: usize = 0;
    while (consumed + 9 <= bytes.len) {
        const len = (@as(u32, bytes[consumed]) << 16) | (@as(u32, bytes[consumed + 1]) << 8) | bytes[consumed + 2];
        const typ = bytes[consumed + 3];
        const flags = bytes[consumed + 4];
        const stream_id = std.mem.readInt(u32, bytes[consumed + 5 ..][0..4], .big) & 0x7FFFFFFF;
        if (consumed + 9 + len > bytes.len) break;
        const payload = bytes[consumed + 9 .. consumed + 9 + len];
        consumed += 9 + len;
        switch (typ) {
            0x00 => { // DATA — request body
                const s = h2StreamLookup(st, stream_id) orelse continue;
                var pl = payload;
                if (flags & 0x08 != 0 and pl.len > 0) { // PADDED
                    const pad = pl[0];
                    pl = if (pl.len - 1 >= pad) pl[1 .. pl.len - pad] else &.{};
                }
                s.body.appendSlice(pumpAlloc(), pl) catch {
                    h2WriteRstStream(st, stream_id, 0x2); // INTERNAL_ERROR
                    h2StreamDrop(st, stream_id);
                    continue;
                };
                // Our receive window is spent — hand it back immediately.
                h2WriteWindowUpdate(st, 0, @intCast(payload.len));
                h2WriteWindowUpdate(st, stream_id, @intCast(payload.len));
                if (flags & 0x01 != 0) h2ServeStream(st, s); // END_STREAM
            },
            0x01 => { // HEADERS — new request or trailers
                const s = h2StreamSlot(st, stream_id) orelse {
                    h2WriteRstStream(st, stream_id, 0x7); // REFUSED_STREAM
                    continue;
                };
                var pl = payload;
                if (flags & 0x08 != 0 and pl.len > 0) { // PADDED
                    const pad = pl[0];
                    pl = if (pl.len - 1 >= pad) pl[1 .. pl.len - pad] else &.{};
                }
                if (flags & 0x20 != 0 and pl.len >= 5) pl = pl[5..]; // PRIORITY
                s.head_block.appendSlice(pumpAlloc(), pl) catch {
                    h2WriteRstStream(st, stream_id, 0x2);
                    h2StreamDrop(st, stream_id);
                    continue;
                };
                if (flags & 0x01 != 0) s.end_stream_on_headers = true;
                if (flags & 0x04 != 0) { // END_HEADERS
                    s.headers_done = true;
                    if (s.end_stream_on_headers) h2ServeStream(st, s);
                } else s.headers_pending = true;
            },
            0x09 => { // CONTINUATION — the tail of a HEADERS block
                const s = h2StreamLookup(st, stream_id) orelse continue;
                if (!s.headers_pending) continue;
                s.head_block.appendSlice(pumpAlloc(), payload) catch {
                    h2WriteRstStream(st, stream_id, 0x2);
                    h2StreamDrop(st, stream_id);
                    continue;
                };
                if (flags & 0x04 != 0) {
                    s.headers_done = true;
                    s.headers_pending = false;
                    if (s.end_stream_on_headers) h2ServeStream(st, s);
                }
            },
            0x03 => h2StreamDrop(st, stream_id), // RST_STREAM
            0x04 => { // SETTINGS
                if (flags & 0x01 == 0) {
                    _ = appendPending(st, &.{&H2_SETTINGS_ACK});
                    // The peer's preferences shape OUR sends: id 4 is
                    // INITIAL_WINDOW_SIZE (per-stream), id 5 MAX_FRAME_SIZE.
                    var i: usize = 0;
                    while (i + 6 <= payload.len) : (i += 6) {
                        const id = std.mem.readInt(u16, payload[i..][0..2], .big);
                        const val = std.mem.readInt(u32, payload[i + 2 ..][0..4], .big);
                        if (id == 4) st.h2_peer_initial_window = @intCast(@min(val, std.math.maxInt(i32)));
                        if (id == 5) st.h2_peer_max_frame = @max(16384, @min(@as(usize, val), 16777215));
                    }
                }
            },
            0x06 => { // PING
                if (flags & 0x01 == 0 and payload.len == 8) {
                    var ack: [17]u8 = .{ 0, 0, 8, 0x06, 0x01, 0, 0, 0, 0 } ++ @as([8]u8, undefined);
                    @memcpy(ack[9..], payload);
                    _ = appendPending(st, &.{&ack});
                }
            },
            0x07 => { // GOAWAY — the peer is done; drain what was sent
                st.ring_dead = true;
            },
            0x08 => { // WINDOW_UPDATE — opens send windows
                if (payload.len < 4) continue;
                const inc: i64 = @intCast(std.mem.readInt(u32, payload[0..4], .big) & 0x7FFFFFFF);
                if (stream_id == 0) {
                    st.h2_send_window_conn = @min(@as(i64, std.math.maxInt(i32)), st.h2_send_window_conn + inc);
                    for (&st.h2_streams) |*s| if (s.id != 0) h2FlushStream(st, s);
                } else if (h2StreamLookup(st, stream_id)) |s| {
                    s.send_window = @min(@as(i64, std.math.maxInt(i32)), s.send_window + inc);
                    h2FlushStream(st, s);
                }
            },
            else => {},
        }
    }
    return consumed;
}

// TLS exists only where a system openssl can be linked — this must stay the
// same condition as koru/openssl's ~std/build:requires, which emits no link
// flags outside it. When this is comptime-false nothing can ever assign
// `st.ssl` (acceptServerSsl is unreachable), so every `if (st.ssl)` leg below
// is dead code Zig never analyzes — which is also what keeps the package's
// @cImport out of the build and lets non-TLS programs cross-compile for musl
// and freestanding targets at all.
pub const HAS_OPENSSL = switch (@import("builtin").os.tag) {
    .macos => true,
    .linux => @import("builtin").abi != .musl,
    else => false,
};

// Participant-verb state (std/pump contract). `init` fills these; `step`
// accepts against the listener; `wait` exposes it; `stop`/`live` carry the
// retirement flag. The workers' kqueues stay participant-internal — a conn
// fd's readiness never reaches the pump's union wait.
var listen_server: ?std.net.Server = null;
var worker_kqs: [MAX_WORKERS]i32 = undefined;
var worker_total: usize = 0;
var worker_next: usize = 0;
var should_stop: bool = false;
// Set by `init` on success — `live` reports 0 until the machinery actually
// stands up, so a failed init retires the participant instead of pinning the
// pump on an immortal that never was.
var pump_started: bool = false;

// Drop the requests already answered and slide the unfinished tail to the
// front, so the next read continues it instead of mistaking it for a new one.
fn retainTail(buf: []u8, len: usize, consumed: usize) usize {
    if (consumed == 0) return len;
    const remaining = len - consumed;
    if (remaining > 0) std.mem.copyForwards(u8, buf[0..remaining], buf[consumed..len]);
    return remaining;
}

// ---------------------------------------------------------------------------
// Websocket framing — the ws half of ConnState.mode.
// ---------------------------------------------------------------------------
// The wire grammar (RFC 6455 §5.2): fin/opcode byte, mask+length byte, 0/2/8
// extended-length bytes, 0/4 mask-key bytes, payload. Every read boundary can
// split ANY of those, so parsing is a state machine across fills — ws_in_frame
// etc. on ConnState — not a slice function like requestLen.

const WsHdr = struct {
    fin: bool,
    op: u8,
    mask: [4]u8, // all-zero when the frame is unmasked, so XOR is uniform
    len: usize,
    hdr: usize, // header byte count — consumed before the payload starts
};

// Parse one frame header, or null when the buffered bytes cannot spell one
// yet. A 64-bit length with the high bit set is a malformed frame — but so is
// an unmasked client frame per RFC 6455 §5.3; both are accepted leniently
// (topcoat's tokio-tungstenite rejects unmasked; the oracle never sends one,
// so the divergence is unmeasured).
fn wsHeader(buf: []const u8) ?WsHdr {
    if (buf.len < 2) return null;
    const fin = buf[0] & 0x80 != 0;
    const op = buf[0] & 0x0F;
    const masked = buf[1] & 0x80 != 0;
    var len: usize = buf[1] & 0x7F;
    var i: usize = 2;
    if (len == 126) {
        if (buf.len < i + 2) return null;
        len = std.mem.readInt(u16, buf[i..][0..2], .big);
        i += 2;
    } else if (len == 127) {
        if (buf.len < i + 8) return null;
        len = @intCast(std.mem.readInt(u64, buf[i..][0..8], .big));
        i += 8;
    }
    var mask: [4]u8 = .{ 0, 0, 0, 0 };
    if (masked) {
        if (buf.len < i + 4) return null;
        @memcpy(&mask, buf[i..][0..4]);
        i += 4;
    }
    return .{ .fin = fin, .op = op, .mask = mask, .len = len, .hdr = i };
}

// What a completed websocket frame means for the loop. `message` borrows
// st.ws_msg — valid until the caller clears it, which it must do once `frame`
// returns. `ping`/`close` borrow st.ws_ctrl. `dead` is a protocol violation:
// the connection is finished either way.
const WsItem = union(enum) {
    message: struct { op: u8, payload: []const u8 },
    ping: []const u8,
    close: []const u8,
    dead,
};

// Consume bytes for the next dispatchable item. Returns null when nothing
// complete is buffered. Control frames complete inside one ws_ctrl buffer;
// data frames append to ws_msg and a fragmented message only surfaces when
// its final continuation lands.
fn wsNext(st: *ConnState, consumed: *usize) ?WsItem {
    while (consumed.* < st.len) {
        if (!st.ws_in_frame) {
            const h = wsHeader(st.buf[consumed.*..st.len]) orelse return null;
            consumed.* += h.hdr;
            st.ws_in_frame = true;
            st.ws_op = h.op;
            st.ws_fin = h.fin;
            st.ws_need = h.len;
            st.ws_mask = h.mask;
            st.ws_seen = 0;
            st.ws_ctrl_len = 0;
        }
        if (st.ws_need > 0) {
            const take = @min(st.ws_need, st.len - consumed.*);
            if (st.ws_op >= 0x8) {
                // A control frame over 125 bytes violates RFC 6455 §5.5.
                if (st.ws_ctrl_len + take > st.ws_ctrl.len) return .dead;
                for (st.buf[consumed.* .. consumed.* + take], 0..) |b, k| {
                    st.ws_ctrl[st.ws_ctrl_len + k] = b ^ st.ws_mask[(st.ws_seen + k) & 3];
                }
                st.ws_ctrl_len += take;
            } else {
                const base = st.ws_msg.items.len;
                st.ws_msg.resize(pumpAlloc(), base + take) catch return .dead;
                for (st.buf[consumed.* .. consumed.* + take], 0..) |b, k| {
                    st.ws_msg.items[base + k] = b ^ st.ws_mask[(st.ws_seen + k) & 3];
                }
            }
            consumed.* += take;
            st.ws_seen += take;
            st.ws_need -= take;
            if (st.ws_need != 0) return null;
        }
        // Frame complete.
        st.ws_in_frame = false;
        switch (st.ws_op) {
            0x8 => return .{ .close = st.ws_ctrl[0..st.ws_ctrl_len] },
            0x9 => return .{ .ping = st.ws_ctrl[0..st.ws_ctrl_len] },
            0xA => continue, // pong — nothing to answer
            0x0 => {
                // Continuation outside a fragmented message violates §5.4.
                if (!st.ws_msg_open) return .dead;
                if (st.ws_fin) {
                    st.ws_msg_open = false;
                    return .{ .message = .{ .op = st.ws_msg_op, .payload = st.ws_msg.items } };
                }
            },
            0x1, 0x2 => {
                // A new data frame mid-message violates §5.4.
                if (st.ws_msg_open) return .dead;
                st.ws_msg_op = st.ws_op;
                if (st.ws_fin) {
                    return .{ .message = .{ .op = st.ws_op, .payload = st.ws_msg.items } };
                }
                st.ws_msg_open = true;
            },
            else => return .dead,
        }
    }
    return null;
}

// Emit one unmasked frame — server frames are never masked (§5.1) and never
// fragmented here: a message the application sent is one frame. The Raw half
// writes; the locking half is what `ws-send`-in-an-arm and `ws-send-fd` from
// another thread both funnel through, so two writers on one connection can
// never interleave bytes mid-frame.
fn wsSendFrameRaw(st: *ConnState, opcode: u8, payload: []const u8) bool {
    var hdr: [10]u8 = undefined;
    hdr[0] = 0x80 | opcode;
    var hlen: usize = 2;
    if (payload.len < 126) {
        hdr[1] = @intCast(payload.len);
    } else if (payload.len <= 0xFFFF) {
        hdr[1] = 126;
        std.mem.writeInt(u16, hdr[2..4], @intCast(payload.len), .big);
        hlen = 4;
    } else {
        hdr[1] = 127;
        std.mem.writeInt(u64, hdr[2..10], payload.len, .big);
        hlen = 10;
    }
    // head+payload in ONE writev — two write()s per frame doubled the
    // syscall count on broadcast paths (fan-out pays it per subscriber).
    return writevAllConn(st, hdr[0..hlen], payload, 0, false, false);
}

fn wsSendFrame(st: *ConnState, opcode: u8, payload: []const u8) bool {
    st.ws_mu.lock();
    defer st.ws_mu.unlock();
    return wsSendFrameRaw(st, opcode, payload);
}

// The cross-thread counterpart: name a connection by descriptor rather than
// by the exchange being dispatched. The lookup happens under conn_states_mu
// and ws_mu is taken BEFORE that lock drops — releaseConn detaches the slot
// under the same mutex and then waits on ws_mu before freeing, so a ConnState
// cannot be destroyed between lookup and send. Lock order is fixed:
// conn_states_mu, then ws_mu, never the reverse.
fn wsSendFd(fd: usize, opcode: u8, payload: []const u8) bool {
    if (fd >= MAX_TRACKED_FD) return false;
    conn_states_mu.lock();
    const st = conn_states[fd] orelse {
        conn_states_mu.unlock();
        return false;
    };
    if (st.mode != .ws) {
        conn_states_mu.unlock();
        return false;
    }
    st.ws_mu.lock();
    conn_states_mu.unlock();
    defer st.ws_mu.unlock();
    const ok = wsSendFrameRaw(st, opcode, payload);
    // A stalled queue written from off the owning worker needs the owner's
    // write-readiness armed explicitly — nobody else will. Skip when a WRITE
    // arm is already live (a broadcast armed it); the live arm will drain.
    if (pendingLen(st) > 0 and !st.armed.swap(true, .acq_rel)) {
        armOwnerWrite(st);
    }
    return ok;
}

// Re-arm write readiness on whatever reactor owns this conn — used by
// cross-thread sends (ws-send-fd) that left bytes in the queue. The pump is
// comptime-selected per binary, so `owner_q` means exactly one thing.
fn armOwnerWrite(st: *ConnState) void {
    if (st.owner_q < 0) return;
    if (@import("builtin").os.tag == .linux) {
        const linux = std.os.linux;
        var wait = linux.epoll_event{
            .events = linux.EPOLL.IN | linux.EPOLL.OUT,
            .data = .{ .ptr = @intFromPtr(st) },
        };
        _ = linux.epoll_ctl(st.owner_q, linux.EPOLL.CTL_MOD, st.fd, &wait);
    } else {
        armKqueueFilter(st.owner_q, st.fd, libc.EVFILT.WRITE);
    }
}

// Serialize one frame into a refcounted Frame — the broadcast's shared
// bytes. Same shape wsSendFrameRaw builds, allocated once per publish
// instead of once per conn.
fn wsFrameAlloc(opcode: u8, payload: []const u8) ?*Frame {
    const hlen: usize = if (payload.len < 126) 2 else if (payload.len <= 0xFFFF) 4 else 10;
    const f = frameAlloc(hlen + payload.len) orelse return null;
    const bytes = f.bytes;
    bytes[0] = 0x80 | opcode;
    if (payload.len < 126) {
        bytes[1] = @intCast(payload.len);
    } else if (payload.len <= 0xFFFF) {
        bytes[1] = 126;
        std.mem.writeInt(u16, bytes[2..4], @intCast(payload.len), .big);
    } else {
        bytes[1] = 127;
        std.mem.writeInt(u64, bytes[2..10], payload.len, .big);
    }
    @memcpy(bytes[hlen..], payload);
    return f;
}

// One owner-arm entry: the conn (alive via the producer's refs) plus the
// socket — captured under conn_states_mu during the resolution pass
// (releaseConn detaches under the same lock, so the fd is this conn's at
// capture and cannot be closed mid-capture). The batched arm below uses
// the captured values, so it never resolves anything after the lock drops.
const Arm = struct { st: *ConnState, fd: posix.fd_t };

// The broadcast fan-out — lock-free on the producer side. One wsFrameAlloc
// serializes the frame once; each matching conn then holds a refcounted
// share of it in its wsq, and the OWNING worker does the socket: the owning
// reactor's WRITE drain (flushPendingOwned → flushWsq) does the writes, so
// the producer pays O(#owners) batched arms, not O(#conns) syscalls. A conn
// that can't take the frame (dead fd, over MAX_PENDING, alloc failure) is
// skipped — broadcast is best-effort per conn, matching fanout semantics.
fn wsPublishFrame(fds: []const usize, opcode: u8, payload: []const u8) usize {
    const f = wsFrameAlloc(opcode, payload) orelse return 0;
    defer frameDecref(f);
    const Held = struct { st: *ConnState, ring: bool };
    var held: [64]Held = undefined;
    var n: usize = 0;
    conn_states_mu.lock();
    for (fds[0..@min(fds.len, held.len)]) |fd| {
        if (fd >= MAX_TRACKED_FD) continue;
        const st = conn_states[fd] orelse continue;
        if (st.mode != .ws) continue;
        _ = st.refs.fetchAdd(1, .monotonic);
        if (st.owner_ring != null) {
            st.ws_mu.lock();
            held[n] = .{ .st = st, .ring = true };
        } else {
            held[n] = .{ .st = st, .ring = false };
        }
        n += 1;
    }
    conn_states_mu.unlock();
    var arms: [64]Arm = undefined;
    var arms_n: usize = 0;
    var queued: usize = 0;
    for (held[0..n]) |h| {
        if (h.ring) {
            const st = h.st;
            var pushed = false;
            // Ring conns drain `pending` through send SQEs, not the wsq
            // lane — the shared frame lands as bytes there.
            if (pendingLen(st) + f.bytes.len <= MAX_PENDING) {
                st.pending.appendSlice(pumpAlloc(), f.bytes) catch {
                    st.ws_mu.unlock();
                    continue;
                };
                pushed = true;
            }
            if (pushed) {
                queued += 1;
                if (!st.armed.swap(true, .acq_rel) and st.owner_q >= 0 and arms_n < arms.len) {
                    arms[arms_n] = .{ .st = st, .fd = st.fd };
                    arms_n += 1;
                }
            }
            st.ws_mu.unlock();
            continue;
        }
        if (!wsqPushFrame(h.st, f)) continue;
        queued += 1;
        if (!h.st.armed.swap(true, .acq_rel) and h.st.owner_q >= 0 and arms_n < arms.len) {
            arms[arms_n] = .{ .st = h.st, .fd = h.st.fd };
            arms_n += 1;
        }
    }
    // The arm must precede the unref: epoll_ctl carries st in event.data, so
    // the refs held above are what keep a just-released conn alive through
    // the MOD call.
    armOwnerWritesBatched(arms[0..arms_n]);
    for (held[0..n]) |h| connUnref(h.st);
    return queued;
}

// Arm write-readiness on the owner reactors for every conn that just got a
// queued frame. kqueue takes a changelist, so all conns owned by one worker
// arm in a single kevent(); epoll_ctl is one fd per call, so Linux keeps the
// per-conn arm. One syscall per distinct owner.
fn armOwnerWritesBatched(arms: []const Arm) void {
    if (@import("builtin").os.tag == .linux) {
        for (arms) |a| armOwnerWrite(a.st);
        return;
    }
    var owners: [64]i32 = undefined;
    var o_n: usize = 0;
    for (arms) |a| {
        var found = false;
        for (owners[0..o_n]) |o| {
            if (o == a.st.owner_q) {
                found = true;
                break;
            }
        }
        if (!found and o_n < owners.len) {
            owners[o_n] = a.st.owner_q;
            o_n += 1;
        }
    }
    var changes: [64]libc.Kevent = undefined;
    var none: [0]libc.Kevent = undefined;
    for (owners[0..o_n]) |q| {
        var cnt: usize = 0;
        for (arms) |a| {
            if (a.st.owner_q != q) continue;
            if (cnt == changes.len) break;
            changes[cnt] = .{
                .ident = @intCast(a.fd),
                .filter = libc.EVFILT.WRITE,
                .flags = libc.EV.ADD | libc.EV.ONESHOT,
                .fflags = 0,
                .data = 0,
                .udata = undefined,
            };
            cnt += 1;
        }
        if (cnt > 0) _ = libc.kevent(q, &changes, @intCast(cnt), &none, 0, null);
    }
}

// ---------------------------------------------------------------------------
// The unikernel's sockets, as plain C.
// ---------------------------------------------------------------------------
// Unikraft's posix-socket + lwip put these in the image as ordinary symbols in
// the same address space — the same way std/io reaches nolibc's fputs. They are
// declared here rather than reached through `std.net` because STD.NET CANNOT
// EXIST on this target: `std.posix` has no `sockaddr` there, and it is a hard
// compile error rather than a missing feature. That is the whole reason this
// file is split by platform. Measured in koru/examples/unikraft-net.
extern fn socket(domain: c_int, stype: c_int, protocol: c_int) c_int;
extern fn bind(fd: c_int, addr: *const anyopaque, len: u32) c_int;
extern fn listen(fd: c_int, backlog: c_int) c_int;
extern fn accept(fd: c_int, addr: ?*anyopaque, len: ?*u32) c_int;
extern fn recv(fd: c_int, buf: [*]u8, len: usize, flags: c_int) isize;
extern fn send(fd: c_int, buf: [*]const u8, len: usize, flags: c_int) isize;
extern fn close(fd: c_int) c_int;

// Wall-clock seconds. The idle timeout below has to be measured in TIME, and
// the pump's own loop is not a clock — see KEEPALIVE_IDLE_SECONDS.
//
// Bound through `@extern` rather than declared as `extern fn time`, because the
// companion contract already declares that symbol for the Date header and the
// two modules are emitted into ONE file: two declarations of the same name are
// an ambiguous reference, not a duplicate the compiler can silently accept.
const wallClockSeconds = @extern(*const fn (?*i64) callconv(.c) i64, .{ .name = "time" });

// Unikraft's nolibc imports musl's `netinet/in.h`, where there is NO `sin_len`
// byte: the family is a u16 at offset 0. Writing the BSD layout instead puts
// 0x0210 where the family belongs, and then `socket` and `listen` both succeed
// while `bind` fails — so the error points at the wrong call.
const SockaddrIn = extern struct {
    family: u16 = 2,
    port: u16,
    addr: u32,
    zero: [8]u8 = [_]u8{0} ** 8,
};

// `poll`, from the same place the socket calls come from — Unikraft's
// posix-socket layer, as an ordinary symbol in the same address space.
//
// The unikernel pump needs it for the reason the hosted pumps need kqueue and
// epoll: a browser opens SEVERAL connections and holds them all open. A loop
// that accepts one connection and serves it to completion answers the first
// browser connection and never accepts the second, so the page never finishes
// loading. Measured 2026-08-10 against korulang.org in this very image: curl
// worked perfectly (it closes between requests) and Firefox timed out on every
// page, because the difference is not the requests, it is how many sockets are
// open at once.
const PollFd = extern struct { fd: c_int, events: c_short, revents: c_short };
const POLLIN: c_short = 0x001;
// A hangup is not readability. `poll` reports a peer that went away through
// these, and it may report them WITHOUT POLLIN — so a loop that waits only for
// readable data never learns the connection is dead and never frees its slot.
// The table then fills with sockets nobody is on the other end of, and the next
// real connection is the one that suffers.
const POLLERR: c_short = 0x008;
const POLLHUP: c_short = 0x010;
const POLLNVAL: c_short = 0x020;
const POLLOUT: c_short = 0x004;
extern fn poll(fds: [*]PollFd, nfds: c_ulong, timeout: c_int) c_int;

// One in-flight connection per slot, each owning the request it has not
// finished reading.
//
// A browser does not close a connection when it is finished with it — it keeps
// it open in case there is more to fetch. One page of korulang.org issues 68
// requests, spread over however many sockets Firefox feels like holding, and
// those sockets stay open across page loads. So slots do not free themselves on
// any timescale the server controls.
// Keep this comfortably BELOW lwip's own pool (CONFIG_LWIP_NUM_TCPCON in the
// Kraftfile), so the pump is what runs out first and does so gracefully —
// hanging up on its idlest connection — rather than the network stack refusing
// a connection the pump never hears about.
//
// Measured 2026-08-10: with both set to 64 they collided exactly there. Load at
// 48 concurrent connections was clean; 64 produced dropped reads, because two
// independent limits with the same value have no headroom between them.
const MAX_UK_CONNS = 128;

// A unikernel connection is a connection plus the bookkeeping only this pump
// does. The socket and the held bytes are `ConnState`, the same type the hosted
// pumps use, so `fill` takes one thing on every platform rather than two shapes
// that happen to have the same fields.
const UkConn = struct {
    st: ConnState = .{},
    /// When this connection was last heard from. Only the ORDER matters.
    seq: u64 = 0,
    /// Wall-clock second this connection was last heard from.
    last_seen: i64 = 0,
};

var uk_conns: [MAX_UK_CONNS]UkConn = [_]UkConn{.{}} ** MAX_UK_CONNS;
var uk_seq: u64 = 0;

// Hang up on a connection nobody is using.
//
// A slot is not the scarce thing — lwip's own connection pool is, and it is
// sized in the image config (CONFIG_LWIP_NUM_TCPCON). A browser holds keep-alive
// sockets open indefinitely, so if the server never hangs up, that pool fills
// with connections nobody is on and the NEXT visitor gets a reset. Waiting for
// the client to close is waiting for something that does not happen.
//
// Every other HTTP server has this timeout; this one did not until 2026-08-10,
// and the symptom was a browser that loaded eighteen pages and then could not
// load any.
const POLL_TICK_MS: c_int = 1000;

// Idle time is measured with a CLOCK, not by counting loop iterations.
//
// This counted iterations until 2026-08-10, and an event loop is not a clock:
// when there is work to do `poll` returns immediately, so the loop spins
// thousands of times a second and "5 ticks" becomes a few milliseconds. Any
// connection that simply had no data ready for five consecutive iterations —
// which under load is most of them, most of the time — was hung up on mid-use.
//
// The measurement hid it: an IDLE browser lets `poll` block its full second, so
// ticks and seconds coincide exactly when nothing is happening. It only bit
// under load, as a slow drip of dropped reads — 19 in 30 seconds at just 32
// connections, scaling with both concurrency and duration.
const KEEPALIVE_IDLE_SECONDS: i64 = 5;

// Give a newly accepted connection a slot, evicting the longest-idle one if
// every slot is taken.
//
// Refusing the NEW connection instead — which is what this did first — drops
// the request somebody is actually waiting for in favour of sockets a browser
// has finished with but not closed. Firefox reports that as NS_ERROR_NET_RESET
// and the page fails to load, after three page loads had filled the table.
// A unikernel conn dies in place — there is no releaseConn here. The caller
// fires `closed` first (it lives in the drive body's scope); this is only the
// socket teardown.
fn ukRelease(st: *ConnState) void {
    _ = close(st.fd);
    st.fd = -1;
    st.len = 0;
}

// The descriptor of an evicted websocket connection, if eviction is what the
// admit cost — so the caller can fire `closed` for it.
fn ukAdmit(incoming: c_int) ?c_int {
    uk_seq += 1;
    for (&uk_conns) |*s| {
        if (s.st.fd >= 0) continue;
        // A slot keeps its buffer's ws state across connections otherwise:
        // the second connection through a slot that ran websocket traffic
        // would start in ws mode with a half-parsed frame.
        s.st.ws_msg.deinit(pumpAlloc());
        s.st.h2_hpack.deinit(pumpAlloc());
        s.st = .{ .fd = incoming };
        s.seq = uk_seq;
        s.last_seen = wallClockSeconds(null);
            return null;
    }

    var oldest: *UkConn = &uk_conns[0];
    for (&uk_conns) |*s| {
        if (s.seq < oldest.seq) oldest = s;
    }
    // The evicted connection's ws-ness rides back so the caller can fire
    // `closed` — the arm callback only exists in the drive body's scope.
    const evicted_ws = oldest.st.mode == .ws;
    const evicted_fd = oldest.st.fd;
    ukRelease(&oldest.st);
    oldest.st.ws_msg.deinit(pumpAlloc());
    oldest.st.h2_hpack.deinit(pumpAlloc());
    oldest.st = .{ .fd = incoming };
    oldest.seq = uk_seq;
    oldest.last_seen = wallClockSeconds(null);
    return if (evicted_ws) evicted_fd else null;
}

fn armKqueueFilter(kq: i32, fd: posix.fd_t, filter: i16) void {
    // Callers hold the fd, not the ConnState — peek the table (no create)
    // for the same park gate the st-holding arms have.
    conn_states_mu.lock();
    const st = if (@as(usize, @intCast(fd)) < MAX_TRACKED_FD) conn_states[@intCast(fd)] else null;
    conn_states_mu.unlock();
    if (st) |s| {
        if (s.park_until != 0) {
            if (!s.parked) parkInsert(s);
            return;
        }
    }
    var changes: [1]libc.Kevent = undefined;
    var none: [0]libc.Kevent = undefined;
    changes[0] = .{
        .ident = @intCast(fd),
        .filter = filter,
        .flags = libc.EV.ADD | libc.EV.ONESHOT,
        .fflags = 0,
        .data = 0,
        .udata = undefined,
    };
    _ = libc.kevent(kq, &changes, 1, &none, 0, null);
}

fn armKqueueRead(kq: i32, fd: posix.fd_t) void {
    armKqueueFilter(kq, fd, libc.EVFILT.READ);
}

// The kqueue spelling of the same mask epollMask builds: a closing conn asks
// only to drain, a queued-up conn adds EVFILT_WRITE, a live conn keeps
// reading. Two filters are two change entries — there is no combined event.
fn kqueueRearm(kq: i32, fd: posix.fd_t, st: *ConnState) void {
    if (st.park_until != 0) {
        if (!st.parked) parkInsert(st);
        return;
    }
    var changes: [2]libc.Kevent = undefined;
    var count: usize = 0;
    if (!st.close_when_drained) {
        changes[count] = .{
            .ident = @intCast(fd),
            .filter = libc.EVFILT.READ,
            .flags = libc.EV.ADD | libc.EV.ONESHOT,
            .fflags = 0,
            .data = 0,
            .udata = undefined,
        };
        count += 1;
    }
    if (hasWork(st) and !st.armed.swap(true, .acq_rel)) {
        changes[count] = .{
            .ident = @intCast(fd),
            .filter = libc.EVFILT.WRITE,
            .flags = libc.EV.ADD | libc.EV.ONESHOT,
            .fflags = 0,
            .data = 0,
            .udata = undefined,
        };
        count += 1;
    }
    if (count == 0) return;
    var none: [0]libc.Kevent = undefined;
    _ = libc.kevent(kq, &changes, @intCast(count), &none, 0, null);
}

// Create the SSL and bind the descriptor — nothing more. The handshake
// itself is deliberately NOT here: SSL_accept drives out of the owning
// worker's event loop (driveTlsHandshake, one step per readiness event), so
// the crypto of a thousand simultaneous handshakes spreads across every
// worker instead of queueing behind one accept thread.
fn beginTlsHandshake(client_fd: c_int) ?*ServerTls {
    const ctx = tls_server_ctx orelse {
        posix.close(@intCast(client_fd));
        return null;
    };
    return beginTlsHandshakeCtx(client_fd, ctx);
}

// Same creation path against a caller-chosen ctx — the h2-TLS listener's
// ctx carries the h2-only ALPN policy, the h1 ctx must stay ALPN-free.
fn beginTlsHandshakeCtx(client_fd: c_int, ctx: *ServerTlsCtx) ?*ServerTls {
    if (HAS_OPENSSL) {
        const openssl = @import("root").koru_koru.koru_openssl;
        const begun = openssl.acceptBegin(ctx, client_fd, std.heap.page_allocator);
        return switch (begun) {
            .ok => |ssl| blk: {
                // The pump wraps the raw handle in the package's Tls so
                // `ConnState.ssl` names what it is — an open TLS connection.
                // The fd stays pump-owned: teardown frees via releaseServerSsl
                // + destroy, never the package `close` (it would double-close).
                const conn = std.heap.page_allocator.create(openssl.Tls) catch {
                    openssl.releaseServerSsl(ssl);
                    posix.close(@intCast(client_fd));
                    return null;
                };
                conn.* = .{ .ssl = ssl, .ctx = ctx.ctx, .owns_ctx = false, .fd = client_fd, .allocator = std.heap.page_allocator };
                break :blk conn;
            },
            .err => {
                posix.close(@intCast(client_fd));
                return null;
            },
        };
    } else {
        // Refuse the connection we cannot handshake — also keeps client_fd a
        // real use, where `_ = client_fd` would error as a pointless discard.
        posix.close(@intCast(client_fd));
    }
    return null;
}

const TlsStep = enum { ready, want_read, want_write, failed };

// One non-blocking SSL_accept step. `want_*` names the readiness the caller
// must re-arm; `failed` is a dead connection, already queue-drained.
fn driveTlsHandshake(st: *ConnState) TlsStep {
    if (HAS_OPENSSL) {
        const openssl = @import("root").koru_koru.koru_openssl;
        if (st.ssl) |tls| {
            const s = tls.ssl orelse return .failed;
            return switch (openssl.driveAccept(s)) {
                .ready => .ready,
                .want_read => .want_read,
                .want_write => .want_write,
                .failed => .failed,
            };
        }
    } else {
        std.mem.doNotOptimizeAway(st);
    }
    return .failed;
}

// ---------------------------------------------------------------------------
// Ring-TLS — the io_uring pump's TLS plumbing
// ---------------------------------------------------------------------------
// A TLS ring conn rides a socket-BIO SSL driven by poll_add readiness:
// handshake flights and records flow through SSL_accept/SSL_read/SSL_write
// on the fd itself, so the ring never touches ciphertext. The ctx carries
// SSL_OP_ENABLE_KTLS — at handshake end OpenSSL installs the kernel record
// layer itself where the host supports it, and the conn then drops the SSL
// and goes cleartext-shaped (pool recv + send SQEs, kernel does the crypto).

// Socket-BIO accept — the io_uring pump's TLS shape. OpenSSL owns the fd:
// handshake flights leave through its own writes, records through SSL_read/
// SSL_write, and ENABLE_KTLS on the ctx lets it hand the record layer to the
// kernel at handshake end. The ring never sees ciphertext — it supplies
// readiness via poll_add and, once offloaded, plaintext recv/send SQEs.
fn beginTlsHandshakeSock(client_fd: c_int) ?*ServerTls {
    const ctx = tls_server_ctx orelse {
        posix.close(@intCast(client_fd));
        return null;
    };
    return beginTlsHandshakeSockCtx(client_fd, ctx);
}

// Caller-chosen ctx — the h2-TLS leg binds to the ctx with the h2-only
// ALPN policy; the h1 leg stays on the shared one.
fn beginTlsHandshakeSockCtx(client_fd: c_int, ctx: *ServerTlsCtx) ?*ServerTls {
    if (HAS_OPENSSL) {
        const openssl = @import("root").koru_koru.koru_openssl;
        const begun = openssl.acceptBegin(ctx, @intCast(client_fd), std.heap.page_allocator);
        return switch (begun) {
            .ok => |ssl| blk: {
                const conn = std.heap.page_allocator.create(openssl.Tls) catch {
                    openssl.releaseServerSsl(ssl);
                    posix.close(@intCast(client_fd));
                    return null;
                };
                conn.* = .{ .ssl = ssl, .ctx = ctx.ctx, .owns_ctx = false, .fd = client_fd, .allocator = std.heap.page_allocator };
                break :blk conn;
            },
            .err => {
                posix.close(@intCast(client_fd));
                return null;
            },
        };
    } else {
        posix.close(@intCast(client_fd));
    }
    return null;
}


fn registerClient(client_fd: posix.fd_t, ssl: ?*ServerTls, kq: i32) void {
    disableNagle(client_fd);
    markNonBlocking(client_fd);
    const st = connState(client_fd) orelse {
        if (HAS_OPENSSL) {
            if (ssl) |tls| {
                const mod = @import("root").koru_koru.koru_openssl;
                if (tls.ssl) |s| mod.releaseServerSsl(s);
                tls.allocator.destroy(tls);
            }
        }
        posix.close(client_fd);
        return;
    };
    st.ssl = ssl;
    st.tls_hs = ssl != null;
    st.owner_q = kq;
    armKqueueRead(kq, client_fd);
}

// h2c conns take no TLS object and start in .h2c — the preface and every
// frame after it route through h2cProcess, not scanRequest.
fn registerClientH2c(client_fd: posix.fd_t, kq: i32) void {
    disableNagle(client_fd);
    markNonBlocking(client_fd);
    const st = connState(client_fd) orelse {
        posix.close(client_fd);
        return;
    };
    st.mode = .h2c;
    st.owner_q = kq;
    armKqueueRead(kq, client_fd);
}

// h2-over-TLS: the conn is h2c once the handshake completes — the ctx's
// ALPN callback already refused anything that didn't offer "h2". tls_hs
// marks the handshake as outstanding exactly like an h1-TLS accept.
fn registerClientH2cTls(client_fd: posix.fd_t, ssl: ?*ServerTls, kq: i32) void {
    disableNagle(client_fd);
    markNonBlocking(client_fd);
    const st = connState(client_fd) orelse {
        if (HAS_OPENSSL) {
            if (ssl) |tls| {
                const mod = @import("root").koru_koru.koru_openssl;
                if (tls.ssl) |s| mod.releaseServerSsl(s);
                tls.allocator.destroy(tls);
            }
        }
        posix.close(client_fd);
        return;
    };
    st.ssl = ssl;
    st.tls_hs = ssl != null;
    st.mode = .h2c;
    st.owner_q = kq;
    armKqueueRead(kq, client_fd);
}

fn registerClientEpoll(client_fd: posix.fd_t, ssl: ?*ServerTls, epfd: i32) void {
    const linux = std.os.linux;
    disableNagle(client_fd);
    // Callers hand us an already-nonblocking fd — accept4(SOCK.NONBLOCK) on the
    // hot path, markNonBlocking in the TLS accept loop for its blocking accept.
    const st = connState(client_fd) orelse {
        if (HAS_OPENSSL) {
            if (ssl) |tls| {
                const mod = @import("root").koru_koru.koru_openssl;
                if (tls.ssl) |s| mod.releaseServerSsl(s);
                tls.allocator.destroy(tls);
            }
        }
        posix.close(client_fd);
        return;
    };
    st.ssl = ssl;
    st.tls_hs = ssl != null;
    st.owner_q = epfd;
    var client_event = linux.epoll_event{
        .events = linux.EPOLL.IN,
        .data = .{ .ptr = @intFromPtr(st) },
    };
    _ = linux.epoll_ctl(epfd, linux.EPOLL.CTL_ADD, client_fd, &client_event);
}

// The readiness a conn wants next, as epoll bits: a closing conn asks only
// to drain, a queued-up conn asks for write-ready as well as reads, and a
// live conn keeps reading. The mask is PERSISTENT — a conn lives on exactly
// one worker's private epoll, so there is no ONESHOT hand-off to re-arm and
// epoll_ctl fires only when this mask changes, never per event.
fn epollMask(st: *ConnState) u32 {
    const linux = std.os.linux;
    if (st.close_when_drained) return linux.EPOLL.OUT;
    var mask: u32 = linux.EPOLL.IN;
    if (hasWork(st)) mask |= linux.EPOLL.OUT;
    return mask;
}

// ---------------------------------------------------------------------------
// RUN — the loop. One variant per platform.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Shared helpers — identical on every POSIX platform, written once.
// ---------------------------------------------------------------------------

// Ask the TARGET what non-blocking means; do not assert it.
//
// This was `0x0004` — the macOS value — hardcoded, and the Linux pump used it
// too. On Linux the bit is `0x800`, so the flag never took: the socket stayed
// blocking, and an accept loop whose only exit is "would block" never exits.
// The Linux build therefore accepted connections forever and read none of them.
// It printed "Orisha listening", accepted the first connection, and went silent
// — a server that looks up and answers nothing.
//
// A number copied from one platform's headers is a fact about THAT platform. The
// pump seam exists precisely so each platform states its own; this one line went
// around it, which is why the bug survived until the program was first run on
// Linux (2026-08-10, in a container).
const O_NONBLOCK: u32 = @as(u32, @bitCast(posix.O{ .NONBLOCK = true }));

fn openListener(port: u16) ?std.net.Server {
    const address = std.net.Address.parseIp("0.0.0.0", port) catch return null;
    return address.listen(.{
        .reuse_address = true,
        .kernel_backlog = 16384,
    }) catch null;
}

// One listener per ring worker: SO_REUSEPORT lets every worker bind the same
// port and the kernel hashes each incoming connection to a single queue — no
// accept thread, no handoff. This is the shape zix's URING engine uses, and
// it is why its accept path costs nothing under a connect storm.
fn openReusePortListener(port: u16) ?posix.fd_t {
    const fd = posix.socket(posix.AF.INET, posix.SOCK.STREAM | posix.SOCK.CLOEXEC, posix.IPPROTO.TCP) catch return null;
    errdefer posix.close(fd);
    const yes: c_int = 1;
    posix.setsockopt(fd, posix.SOL.SOCKET, posix.SO.REUSEADDR, std.mem.asBytes(&yes)) catch return null;
    posix.setsockopt(fd, posix.SOL.SOCKET, posix.SO.REUSEPORT, std.mem.asBytes(&yes)) catch {};
    const addr = std.net.Address.parseIp("0.0.0.0", port) catch return null;
    posix.bind(fd, &addr.any, addr.getOsSockLen()) catch return null;
    posix.listen(fd, 16384) catch return null;
    return fd;
}

fn markNonBlocking(fd: posix.fd_t) void {
    const flags = posix.fcntl(fd, posix.F.GETFL, 0) catch 0;
    _ = posix.fcntl(fd, posix.F.SETFL, flags | O_NONBLOCK) catch {};
}

fn disableNagle(fd: posix.fd_t) void {
    const enable: i32 = 1;
    posix.setsockopt(fd, posix.IPPROTO.TCP, posix.TCP.NODELAY, std.mem.asBytes(&enable)) catch {};
}

// Let the kernel poll the device queue for this socket's packets for 50µs
// before sleeping — the same window zix arms by default. Busy-poll trades a
// bounded slice of CPU for skipping the wakeup path on a connection that is
// about to deliver, which is every connection under pipelined load.
fn armBusyPoll(fd: posix.fd_t) void {
    const usecs: i32 = 50;
    posix.setsockopt(fd, posix.SOL.SOCKET, std.os.linux.SO.BUSY_POLL, std.mem.asBytes(&usecs)) catch {};
}

// Write the whole thing, and treat "would block" as what it is — a request to
// come back later, not a failure and not a license to sleep.
//
// Every accepted connection is non-blocking (markNonBlocking, below). So once a
// response is bigger than the kernel's send buffer, `write` stops accepting and
// says WouldBlock. Catching that alongside real errors and returning false — as
// this did until 2026-08-10 — abandons the response part-written and closes the
// connection, while the headers have already promised the full Content-Length.
// Nothing about that looks like a failure from the outside: measured against
// korulang.org, one 1.5 MB image returned 327093, 1561984, 1348077, 768057 and
// 498501 bytes on five consecutive requests. A browser renders half an image,
// and a truncated JavaScript module simply fails to import.
//
// The first fix waited — `poll` inside the write loop, up to WRITE_WAIT_MS.
// That made a stalled peer stall its whole worker: every other connection on
// it froze behind one full socket buffer. The second fix is the honest one:
// unwritten bytes go into `st.pending` and a write-ready event drains them
// (queueAndFlush/flushPending, above), so a slow peer costs the worker memory
// — capped at MAX_PENDING — instead of time.

// ---------------------------------------------------------------------------
// How many loops a hosted pump runs.
// ---------------------------------------------------------------------------
// One readiness loop saturates one core and no more, so a single-threaded pump
// on a twelve-core machine is measured against eleven idle ones. This is the
// same choice nginx spells `worker_processes auto`, and comparing against nginx
// with that set while running one loop is not a comparison — it is a handicap
// nobody wrote down.
//
// Each worker owns a private readiness instance and the connections handed to
// it. Nothing is shared: a descriptor belongs to exactly one worker for its
// whole life, so the connection table is only ever touched at an index one
// thread owns. The one genuinely shared thing in a request's path — the buffer
// the response header is built into — is `threadlocal` in the companion, and
// was the ONLY thing that had to change above this file.
const MAX_WORKERS = 128;

fn workerCount() usize {
    const n = std.Thread.getCpuCount() catch return 1;
    return @min(@max(n, 1), MAX_WORKERS);
}

// ---------------------------------------------------------------------------
// FILL — the read seam. One variant per platform, mirroring `reply`.
// ---------------------------------------------------------------------------

// The hosted read: everything with a `std.posix`.
//
// `read` says "nothing available right now" by returning error.WouldBlock, and
// a peer that has finished says it by returning zero bytes. The loops used to
// spell this `catch 0` and then treat zero as the end of the connection, which
// gives those two answers the same meaning. They are not the same: one is a
// connection with more to come, the other is a connection with nothing more
// ever. Separating them is what `idle` is for.
~proc fill|zig {
    if ($mod.HAS_OPENSSL) {
        if (st.ssl) |tls| {
            const mod = @import("root").koru_koru.koru_openssl;
            // `sslFill` can't substitute here — its `more` carries no byte
            // count, and this read must advance st.len.
            const s = tls.ssl orelse return .gone;
            const rc = mod.c.SSL_read(s, @ptrCast(st.buf[st.len..].ptr), @intCast(st.buf.len - st.len));
            if (rc > 0) {
                st.len += @intCast(rc);
                return .more;
            }
            const err_code = mod.c.SSL_get_error(s, rc);
            return switch (err_code) {
                mod.c.SSL_ERROR_WANT_READ, mod.c.SSL_ERROR_WANT_WRITE => .idle,
                else => .gone,
            };
        }
    }
    const n = $mod.posix.read(@intCast(st.fd), st.buf[st.len..]) catch |err| switch (err) {
        error.WouldBlock => return .idle,
        else => return .gone,
    };
    if (n == 0) return .gone;
    st.len += n;
    return .more;
}

// The unikernel's read. `posix.read` has no implementation on a freestanding
// target; `recv` is the socket symbol this pump already uses for everything
// else.
//
// A negative result is an error and zero is a closed peer — but this pump only
// calls `fill` after `poll` said the socket was readable, so "nothing to read"
// is not a case it reaches. Both fold to `gone`.
~proc fill|unikraft {
    const got = $mod.recv(st.fd, @ptrCast(&st.buf[st.len]), st.buf.len - st.len, 0);
    if (got <= 0) return .gone;
    st.len += @intCast(got);
    return .more;
}

// ---------------------------------------------------------------------------
// kqueue — macOS and the BSDs. The default variant.
// ---------------------------------------------------------------------------

~proc init|zig {
    $mod.ignoreSigpipe();

    $mod.h2c_listen_port = $mod.h2cPortEnv();
    if ($mod.maybeStartTls(tls_port, cert_path, key_path)) |err_msg| {
        return .{ .failed = err_msg };
    }
    if ($mod.maybeStartH2Tls($mod.h2TlsPortEnv(), cert_path, key_path)) |err_msg| {
        return .{ .failed = err_msg };
    }

    $mod.listen_server = $mod.openListener(port) orelse return .{ .failed = "Failed to listen" };
    $mod.worker_total = $mod.workerCount();
    $mod.should_stop = false;

    // The per-connection half of the loop, unchanged — one runs per worker,
    // each on its own kqueue, each seeing only the descriptors handed to it.
    const Worker = struct {
    fn loop(kq: i32) void {
        var no_changes: [0]$mod.libc.Kevent = undefined;
        var events: [$mod.MAX_EVENTS]$mod.libc.Kevent = undefined;

        while (true) {
            // Parked conns emit nothing — the wait must wake for their
            // deadline or a /delay reply would sleep until unrelated traffic
            // happened to arrive.
            var wait_ts: std.c.timespec = undefined;
            const park_ms = $mod.parkMsUntilDue();
            const ts: ?*std.c.timespec = if (park_ms == std.math.maxInt(i64)) null else blk: {
                wait_ts = .{ .sec = @intCast(@divTrunc(park_ms, 1000)), .nsec = @intCast(@mod(park_ms, 1000) * 1000000) };
                break :blk &wait_ts;
            };
            const n = $mod.libc.kevent(kq, &no_changes, 0, &events, $mod.MAX_EVENTS, ts);
            while ($mod.parkDue()) |pst| {
                const pfd: $mod.posix.fd_t = @intCast(pst.fd);
                switch ($mod.flushPendingOwned(pst)) {
                    .dead => {
                        $mod.releaseConn(pfd);
                        continue;
                    },
                    .stalled, .drained => {},
                }
                if (pst.close_when_drained and !$mod.hasWork(pst)) {
                    $mod.releaseConn(pfd);
                    continue;
                }
                $mod.kqueueRearm(kq, pfd, pst);
            }
            if (n <= 0) continue;
            @import("root").koru_orisha.stampHttpDateLine();

            for (events[0..@intCast(n)]) |event| {
                const fd: $mod.posix.fd_t = @intCast(event.ident);

                const st = $mod.connState(fd) orelse {
                    $mod.posix.close(fd);
                    continue;
                };

                // The conn registers before its handshake finishes — step it
                // once per readiness event so a thousand concurrent
                // handshakes spread over every worker, and trust no bytes as
                // requests until the cipher is up.
                if (st.tls_hs) {
                    switch ($mod.driveTlsHandshake(st)) {
                        .ready => st.tls_hs = false,
                        .want_read => {
                            $mod.armKqueueFilter(kq, fd, $mod.libc.EVFILT.READ);
                            continue;
                        },
                        .want_write => {
                            $mod.armKqueueFilter(kq, fd, $mod.libc.EVFILT.WRITE);
                            continue;
                        },
                        .failed => {
                            $mod.releaseConn(fd);
                            continue;
                        },
                    }
                }

                // Write-ready drains whatever earlier sends could not
                // deliver; a conn closing behind a queue ends here.
                if (event.filter == $mod.libc.EVFILT.WRITE) {
                    switch ($mod.flushPendingOwned(st)) {
                        .dead => {
                            if (st.mode == .ws) closed(@intCast(fd));
                            $mod.releaseConn(fd);
                            continue;
                        },
                        .stalled => {
                            $mod.kqueueRearm(kq, fd, st);
                            continue;
                        },
                        .drained => {
                            if (st.close_when_drained) {
                                if (st.mode == .ws) closed(@intCast(fd));
                                $mod.releaseConn(fd);
                                continue;
                            }
                        },
                    }
                    // A WRITE event carries no request bytes — back to read
                    // readiness for the next one.
                    $mod.armKqueueFilter(kq, fd, $mod.libc.EVFILT.READ);
                    continue;
                }

                switch ($mod.fill_event.handler(.{ .st = st })) {
                    .more => {},
                    // Nothing new to frame, but the connection is alive.
                    // Re-arm and wait rather than closing it.
                    .idle => {
                        $mod.kqueueRearm(kq, fd, st);
                        continue;
                    },
                    .gone => {
                        if (st.mode == .ws) closed(@intCast(fd));
                        $mod.releaseConn(fd);
                        continue;
                    },
                }

                // An upgraded connection speaks frames, not requests — wsNext
                // is the splitter, control frames are answered at the seam,
                // and complete messages reach the flow's `! frame` arm.
                if (st.mode == .ws) {
                    var ws_consumed: usize = 0;
                    var ws_alive = true;
                    while (ws_consumed < st.len) {
                        const item = $mod.wsNext(st, &ws_consumed) orelse break;
                        switch (item) {
                            .ping => |pl| {
                                if (!$mod.wsSendFrame(st, 0xA, pl)) ws_alive = false;
                            },
                            .close => |pl| {
                                _ = $mod.wsSendFrame(st, 0x8, pl);
                                ws_alive = false;
                            },
                            .dead => ws_alive = false,
                            .message => |m| {
                                var fx = $mod.Exchange{ .fd = fd, .st = st, .raw = m.payload, .opcode = m.op };
                                frame(&fx);
                                st.ws_msg.clearRetainingCapacity();
                                if (!fx.keep_alive) ws_alive = false;
                            },
                        }
                        if (!ws_alive) break;
                    }
                    st.len = $mod.retainTail(st.buf, st.len, ws_consumed);
                    if (ws_alive and st.len == st.buf.len) ws_alive = $mod.growReqBuf(st);
                    if (!ws_alive) {
                        if ($mod.hasWork(st)) {
                            st.close_when_drained = true;
                            $mod.armKqueueFilter(kq, fd, $mod.libc.EVFILT.WRITE);
                            continue;
                        }
                        if (st.mode == .ws) closed(@intCast(fd));
                        $mod.releaseConn(fd);
                        continue;
                    }
                    $mod.kqueueRearm(kq, fd, st);
                    continue;
                }

                // Answer every COMPLETE request; keep any unfinished tail
                // for the next read rather than parsing it as a fresh one.
                // Replies batch in pending — one flush per read event, not
                // one syscall per answer.
                st.batching = true;
                var consumed: usize = 0;
                var alive = true;
                var head_pairs: [$mod.HEAD_PAIRS_MAX]$mod.HeadPair = undefined;
                if (!st.preface_checked) {
                    switch ($mod.h2cSniffPreface(st.buf[0..st.len])) {
                        .h2c => { st.mode = .h2c; st.preface_checked = true; },
                        .h1 => st.preface_checked = true,
                        .wait => {},
                    }
                }
                if (st.mode == .h2c) {
                    // Frames, not request bytes — h2cProcess consumes what it
                    // can and queues completed requests; arrived fires here
                    // because the effect only binds in ~proc scope.
                    consumed = $mod.h2cProcess(st, st.buf[0..st.len]);
                    while ($mod.h2cPopReady(st)) |r| {
                        var head: $mod.Head = .{ .pairs = &head_pairs };
                        _ = $mod.scanRequest(r.raw, &head) orelse {
                            $mod.pumpAlloc().free(r.raw);
                            continue;
                        };
                        var exchange = $mod.Exchange{ .fd = fd, .st = st, .raw = r.raw, .head = &head, .h2_stream = r.stream_id };
                        arrived(&exchange);
                        $mod.pumpAlloc().free(r.raw);
                    }
                } else if (st.preface_checked) { while (consumed < st.len) {
                    var head: $mod.Head = .{ .pairs = &head_pairs };
                    const take = $mod.scanRequest(st.buf[consumed..st.len], &head) orelse break;
                    var exchange = $mod.Exchange{ .fd = fd, .st = st, .raw = st.buf[consumed .. consumed + take], .head = &head };
                    if (head.wants_close) exchange.keep_alive = false;
                    arrived(&exchange);
                    consumed += take;
                    if (!exchange.keep_alive) {
                        alive = false;
                        break;
                    }
                } }
                st.batching = false;
                _ = $mod.flushPending(st);
                st.len = $mod.retainTail(st.buf, st.len, consumed);

                // Headers that never end are not a request this server can answer.
                if (alive and st.len == st.buf.len) alive = $mod.growReqBuf(st);

                if (!alive) {
                    if ($mod.hasWork(st)) {
                        st.close_when_drained = true;
                        $mod.armKqueueFilter(kq, fd, $mod.libc.EVFILT.WRITE);
                        continue;
                    }
                    if (st.mode == .ws) closed(@intCast(fd));
                    $mod.releaseConn(fd);
                    continue;
                }

                // ONESHOT disarms on delivery — re-arm for the next request.
                $mod.kqueueRearm(kq, fd, st);
            }
        }
    }
};

    for (0..$mod.worker_total) |i| {
        $mod.worker_kqs[i] = $mod.posix.kqueue() catch {
            if ($mod.listen_server) |*srv| { srv.deinit(); $mod.listen_server = null; }
            return .{ .failed = "Failed to create kqueue" };
        };
        _ = std.Thread.spawn(.{}, Worker.loop, .{ $mod.worker_kqs[i] }) catch {
            if ($mod.listen_server) |*srv| { srv.deinit(); $mod.listen_server = null; }
            return .{ .failed = "Failed to spawn worker" };
        };
    }

    if ($mod.tls_server_ctx != null) {
            const TlsAccept = struct {
        fn loop(kqs_ptr: *[$mod.MAX_WORKERS]i32, n: usize, next_ptr: *usize) void {
            var tls_listener = $mod.openListener($mod.tls_listen_port) orelse return;
            defer tls_listener.deinit();
            while (true) {
                const conn = tls_listener.accept() catch continue;
                const client_fd = conn.stream.handle;
                // Only the SSL object is made here — the handshake runs in
                // the worker loop, one step per readiness event.
                const ssl = $mod.beginTlsHandshake(@intCast(client_fd)) orelse continue;
                const worker = next_ptr.*;
                next_ptr.* = (next_ptr.* + 1) % n;
                $mod.registerClient(client_fd, ssl, kqs_ptr[worker]);
            }
        }
    };

        _ = std.Thread.spawn(.{}, TlsAccept.loop, .{ &$mod.worker_kqs, $mod.worker_total, &$mod.worker_next }) catch
            return .{ .failed = "Failed to spawn TLS accept thread" };
    }

    if ($mod.h2c_listen_port != 0) {
        const H2cAccept = struct {
            fn loop(kqs_ptr: *[$mod.MAX_WORKERS]i32, n: usize, next_ptr: *usize) void {
                var h2c_listener = $mod.openListener($mod.h2c_listen_port) orelse return;
                defer h2c_listener.deinit();
                while (true) {
                    const conn = h2c_listener.accept() catch continue;
                    const client_fd = conn.stream.handle;
                    const worker = next_ptr.*;
                    next_ptr.* = (next_ptr.* + 1) % n;
                    $mod.registerClientH2c(client_fd, kqs_ptr[worker]);
                }
            }
        };
        _ = std.Thread.spawn(.{}, H2cAccept.loop, .{ &$mod.worker_kqs, $mod.worker_total, &$mod.worker_next }) catch
            return .{ .failed = "Failed to spawn h2c accept thread" };
    }

    std.debug.print("Orisha listening on http://0.0.0.0:{}\n", .{port});
    if ($mod.tls_server_ctx != null) {
        std.debug.print("Orisha listening on https://0.0.0.0:{}\n", .{$mod.tls_listen_port});
    }
    std.debug.print("Pump: kqueue, {} workers, keep-alive, TCP_NODELAY\n", .{$mod.worker_total});

    $mod.pump_started = true;
    return .{ .started = .{} };
}

~proc step|zig {
    _ = &__koru_event_input;
    // One pass of the old accept loop: while the listener signals, take the
    // connection and hand it to the next worker in turn. Non-blocking poll
    // first — accept() itself stays blocking; it just never gets the chance.
    var accepted: i32 = 0;
    if ($mod.listen_server) |*srv| {
        while (true) {
            var pfd = [_]std.posix.pollfd{.{ .fd = srv.stream.handle, .events = std.posix.POLL.IN, .revents = 0 }};
            if ((std.posix.poll(&pfd, 0) catch 0) <= 0) break;
            const conn = srv.accept() catch break;
            const client_fd = conn.stream.handle;
            const w = $mod.worker_next;
            $mod.worker_next = (w + 1) % $mod.worker_total;
            $mod.registerClient(client_fd, null, $mod.worker_kqs[w]);
            accepted += 1;
        }
    }
    return accepted;
}

~proc live|zig {
    _ = &__koru_event_input;
    return @intFromBool($mod.pump_started and !$mod.should_stop);
}

~proc wait|zig {
    _ = i;
    const fd: i32 = if ($mod.listen_server) |*srv| srv.stream.handle else -1;
    return .{ .fd = fd, .wait_ns = std.math.maxInt(i128) };
}

~proc stop|zig {
    _ = &__koru_event_input;
    $mod.should_stop = true;
}

~proc deinit|zig {
    _ = &__koru_event_input;
    if ($mod.listen_server) |*srv| {
        srv.deinit();
        $mod.listen_server = null;
    }
    $mod.pump_started = false;
    $mod.should_stop = false;
}

// Retirement verdict for a captured run's `| stopped` — "somebody stopped a
// running server" versus "the machinery never stood up" (init failed). The
// pump's driver calls the retire unit on the first `live() == 0` pass; this
// is what keeps `| stopped` honest inside a compound pump. A stopped
// participant also releases its listener — retirement means torn down, not
// merely quiet.
~proc __retire|zig {
    _ = &__koru_event_input;
    const stopped = $mod.pump_started and $mod.should_stop;
    if (!stopped) return .{ .silent = .{} };
    $mod.deinit_event.handler(.{});
    return .{ .stopped = .{} };
}

// ---------------------------------------------------------------------------
// RUN — context-aware. `orisha/pump:run(...)` reads the same whether it owns
// the program's loop or an open `std/pump` absorbs it: no open pump ahead of
// the site → emits `drive` (the standalone accept loops below). An open pump
// → emits `init` at the site (carrying `! arrived` and `| failed`) plus the
// join units `std/pump:run` enumerates: `__pump_<name>_{step,live,wait}_<idx>`,
// and `__pump_<name>_retired_<idx>` when `| stopped` is armed.
// ---------------------------------------------------------------------------

~proc run|zig {
    const ast_functional = @import("ast_functional");

    const flow = if (item.* == .flow) &item.flow else return .{};
    const rinv = flow.inv();
    if (rinv.inline_body != null) return .{};

    // Helpers live in one container — a Zig local struct can't see the
    // function's other locals, so these are members looking sideways at each
    // other. The marker/decl scans restate koru_pump's PH (private to
    // std/pump — consumer-side transforms restate them, channel.kz precedent).
    //
    // RULED: `// __pump_decl_<name>` / `// __pump_ran_<name>` is the
    // open-pump marker spelling — decided in koru 7636e4146 and named in
    // koru concepts/frag-comment-markers-are-the-inter-transform-wire.
    //
    // ASPIRATIONAL — the `__pump_decl_/__pump_ran_` scan is one edge of the
    // comment wire, duplicated per participant library. The resolved
    // migration is a typed program item (facet_decl precedent) owned by
    // std/pump and queried, not scanned. See the frag above.
    const TH = struct {
        fn mkPath(a: std.mem.Allocator, module: []const u8, name: []const u8) ast.DottedPath {
            const segs = a.alloc([]const u8, 1) catch unreachable;
            segs[0] = a.dupe(u8, name) catch unreachable;
            return ast.DottedPath{ .module_qualifier = a.dupe(u8, module) catch unreachable, .segments = segs };
        }
        fn refuse(a: std.mem.Allocator, f: *const ast.Flow, msg: []const u8) ast.Item {
            const code = std.fmt.allocPrint(a, "comptime {{ @compileError(\"{s}\"); }}", .{msg}) catch unreachable;
            return ast.Item{ .inline_code = ast.InlineCode{ .code = code, .location = f.location, .module = f.module } };
        }
        // A marker host_line is exactly `// <marker>` — anything looser and
        // prose naming the marker (this file's own comments do) reads as a
        // planted pump.
        fn markerScan(its: []const ast.Item, w: []const u8) bool {
            for (its) |*pi| {
                switch (pi.*) {
                    .host_line => |*hl| {
                        const t = std.mem.trim(u8, hl.content, " \r\n\t");
                        if (t.len >= 3 and std.mem.startsWith(u8, t, "// ") and std.mem.eql(u8, t[3..], w)) return true;
                    },
                    .module_decl => |*md| {
                        if (markerScan(md.items, w)) return true;
                    },
                    else => {},
                }
            }
            return false;
        }
        fn markerExists(prog: *const ast.Program, w: []const u8) bool {
            return markerScan(prog.items, w);
        }
        // `// __pump_decl_<name>` planted whole — prose may name the marker
        // pattern (`<name>` in angle brackets), so the tail must parse as a
        // bare identifier.
        fn declName(t: []const u8) ?[]const u8 {
            const prefix = "// __pump_decl_";
            if (!std.mem.startsWith(u8, t, prefix)) return null;
            const name = t[prefix.len..];
            if (name.len == 0) return null;
            for (name) |ch| {
                if (!std.ascii.isAlphanumeric(ch) and ch != '_') return null;
            }
            return name;
        }
        fn declScan(its: []const ast.Item, want: []const u8) bool {
            for (its) |*pi| {
                switch (pi.*) {
                    .event_decl => |*ed| {
                        if (ed.path.segments.len > 0 and std.mem.eql(u8, ed.path.segments[ed.path.segments.len - 1], want)) return true;
                    },
                    .proc_decl => |*pd| {
                        if (pd.path.segments.len > 0 and std.mem.eql(u8, pd.path.segments[pd.path.segments.len - 1], want)) return true;
                    },
                    .module_decl => |*md| {
                        if (declScan(md.items, want)) return true;
                    },
                    else => {},
                }
            }
            return false;
        }
        fn declExists(prog: *const ast.Program, want: []const u8) bool {
            return declScan(prog.items, want);
        }
        fn collectOpen(list: *std.ArrayList([]const u8), a: std.mem.Allocator, prog: *const ast.Program, its: []const ast.Item) void {
            for (its) |*pi| {
                switch (pi.*) {
                    .host_line => |*hl| {
                        const t = std.mem.trim(u8, hl.content, " \r\n\t");
                        if (declName(t)) |name| {
                            for (list.items) |seen| {
                                if (std.mem.eql(u8, seen, name)) break;
                            } else {
                                const ran = std.fmt.allocPrint(a, "__pump_ran_{s}", .{name}) catch unreachable;
                                if (!markerExists(prog, ran)) list.append(a, a.dupe(u8, name) catch unreachable) catch unreachable;
                            }
                        }
                    },
                    .module_decl => |*md| collectOpen(list, a, prog, md.items),
                    else => {},
                }
            }
        }
        // A `->` return inside a transplanted arm would leave the generated
        // unit's flow — detect it before splicing.
        fn hasReturn(cont: *const ast.Continuation) bool {
            if (cont.node) |*n| {
                if (n.* == .branch_constructor) return true;
            }
            for (cont.continuations) |*cc| {
                if (hasReturn(cc)) return true;
            }
            return false;
        }
        fn bareRet(a: std.mem.Allocator, val: []const u8) ast.Continuation {
            return ast.Continuation{
                .branch = a.dupe(u8, "") catch unreachable,
                .binding = null,
                .kind = .terminal,
                .condition = null,
                .node = ast.Node{ .branch_constructor = ast.BranchConstructor{
                    .branch_name = a.dupe(u8, "") catch unreachable,
                    .fields = &[_]ast.Field{},
                    .plain_value = a.dupe(u8, val) catch unreachable,
                    .is_bare_return = true,
                } },
                .indent = 0,
                .continuations = &[_]ast.Continuation{},
            };
        }
        // `__pump_<p>_<verb>_<i>` decl + impl: the module verb call, bound
        // `-> <bind_name>`, with a bare-return tail answering `ret_expr`.
        fn emitUnit(a: std.mem.Allocator, items: *std.ArrayList(ast.Item), flow_: *const ast.Flow, qual: ?[]const u8, unit: []const u8, verb: []const u8, args: []ast.Arg, input: []ast.Field, ret_ty: []const u8, bind_name: []const u8, ret_expr: []const u8, retain: []const []const u8) void {
            const uname = a.dupe(u8, unit) catch unreachable;
            items.append(a, ast.Item{ .event_decl = ast.EventDecl{
                .path = mkPath(a, flow_.module, uname),
                .input = ast.Shape{ .fields = input },
                .branches = &[_]ast.Branch{},
                .return_type = a.dupe(u8, ret_ty) catch unreachable,
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = retain,
                .location = flow_.location,
                .module = a.dupe(u8, flow_.module) catch unreachable,
            } }) catch unreachable;
            const vsegs = a.alloc([]const u8, 1) catch unreachable;
            vsegs[0] = a.dupe(u8, verb) catch unreachable;
            const vinv = ast.Invocation{
                .path = ast.DottedPath{
                    .module_qualifier = if (qual) |mq| a.dupe(u8, mq) catch unreachable else null,
                    .segments = vsegs,
                },
                .args = args,
                .source_module = a.dupe(u8, flow_.module) catch unreachable,
                .return_binding = a.dupe(u8, bind_name) catch unreachable,
            };
            const tail = a.alloc(ast.Continuation, 1) catch unreachable;
            tail[0] = bareRet(a, ret_expr);
            items.append(a, ast.Item{ .flow = ast.Flow{
                .body = ast.rootSite(vinv, tail, flow_.location),
                .pre_label = null,
                .impl_of = mkPath(a, flow_.module, uname),
                .super_shape = null,
                .is_pure = false,
                .is_transitively_pure = false,
                .location = flow_.location,
                .module = a.dupe(u8, flow_.module) catch unreachable,
            } }) catch unreachable;
        }
    };

    // Open pumps: `__pump_decl_<n>` planted and no `__pump_ran_<n>` yet.
    // One open pump absorbs this site; more than one is ambiguous.
    var open = std.ArrayList([]const u8).initCapacity(allocator, 2) catch unreachable;
    TH.collectOpen(&open, allocator, program, program.items);
    if (open.items.len > 1) {
        const msg = std.fmt.allocPrint(allocator, "orisha/pump:run: two pumps are open ('{s}', '{s}') - a captured run can't tell which to join; drive one before opening the next", .{ open.items[0], open.items[1] }) catch unreachable;
        return .{ .replacement = TH.refuse(allocator, flow, msg) };
    }

    // Partition the site's arms: `!` is `arrived` (one exchange per request)
    // or `frame` (one dispatch per complete websocket message); `|` answers
    // are `stopped`/`failed`; unlabeled `|>` steps ride the emitted call in
    // either mode.
    var arrived_arm: ?*const ast.Continuation = null;
    var frame_arm: ?*const ast.Continuation = null;
    var closed_arm: ?*const ast.Continuation = null;
    var stopped_arm: ?*const ast.Continuation = null;
    var failed_arm: ?*const ast.Continuation = null;
    for (flow.body.continuations) |*cont| {
        const cb = std.mem.trim(u8, cont.branch, " ");
        if (cont.kind == .effect) {
            if (std.mem.eql(u8, cb, "arrived") and arrived_arm == null) {
                arrived_arm = cont;
                continue;
            }
            if (std.mem.eql(u8, cb, "frame") and frame_arm == null) {
                frame_arm = cont;
                continue;
            }
            if (std.mem.eql(u8, cb, "closed") and closed_arm == null) {
                closed_arm = cont;
                continue;
            }
            const msg = std.fmt.allocPrint(allocator, "orisha/pump:run: `! {s}` doesn't parse on a run call - the pump's effects are `! arrived` (one exchange per request), `! frame` (one websocket message) and `! closed` (an upgraded connection released)", .{cb}) catch unreachable;
            return .{ .replacement = TH.refuse(allocator, flow, msg) };
        }
        if (cb.len == 0) continue;
        if (std.mem.eql(u8, cb, "stopped")) {
            if (stopped_arm != null) {
                return .{ .replacement = TH.refuse(allocator, flow, "orisha/pump:run: one `| stopped` per run") };
            }
            stopped_arm = cont;
        } else if (std.mem.eql(u8, cb, "failed")) {
            if (failed_arm != null) {
                return .{ .replacement = TH.refuse(allocator, flow, "orisha/pump:run: one `| failed` per run") };
            }
            failed_arm = cont;
        } else {
            const msg = std.fmt.allocPrint(allocator, "orisha/pump:run: `| {s}` doesn't parse - a run answers `| stopped` and `| failed`", .{cb}) catch unreachable;
            return .{ .replacement = TH.refuse(allocator, flow, msg) };
        }
    }

    if (open.items.len == 0) {
        // Standalone — `drive` is today's fused accept loop, variants and all.
        var inv_clone = ast_functional.cloneInvocation(allocator, rinv) catch unreachable;
        const dsegs = allocator.alloc([]const u8, 1) catch unreachable;
        dsegs[0] = allocator.dupe(u8, "drive") catch unreachable;
        inv_clone.path.segments = dsegs;
        const cloned = allocator.alloc(ast.Continuation, flow.body.continuations.len) catch unreachable;
        for (flow.body.continuations, 0..) |*cont, i| {
            cloned[i] = ast_functional.cloneContinuation(allocator, cont) catch unreachable;
        }
        return .{ .replacement = ast.Item{ .flow = ast.Flow{
            .body = ast.rootSite(inv_clone, cloned, flow.location),
            .annotations = flow.annotations,
            .pre_label = flow.pre_label,
            .impl_of = flow.impl_of,
            .super_shape = flow.super_shape,
            .inline_body = flow.inline_body,
            .preamble_code = flow.preamble_code,
            .is_pure = flow.is_pure,
            .is_transitively_pure = flow.is_transitively_pure,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } } };
    }

    // Captured — join the open pump.
    const pump_name = open.items[0];
    if (stopped_arm) |sa| {
        if (sa.binding) |b| {
            if (b.len > 0 and !std.mem.eql(u8, b, "_")) {
                return .{ .replacement = TH.refuse(allocator, flow, "orisha/pump:run: a captured `| stopped` can't bind a payload - the driver retires the participant; no reason string reaches the arm") };
            }
        }
        if (TH.hasReturn(sa)) {
            return .{ .replacement = TH.refuse(allocator, flow, "orisha/pump:run: a captured `| stopped` can't `->` return - the arm runs inside the pump's retire unit, not this flow") };
        }
    }

    var join_idx: usize = 0;
    while (TH.declExists(program, std.fmt.allocPrint(allocator, "__pump_{s}_step_{d}", .{ pump_name, join_idx }) catch unreachable)) join_idx += 1;

    var appended = std.ArrayList(ast.Item).initCapacity(allocator, 8) catch unreachable;
    const retain_ann = blk_ra: {
        const anns = allocator.alloc([]const u8, 1) catch unreachable;
        anns[0] = allocator.dupe(u8, "retain") catch unreachable;
        break :blk_ra anns;
    };
    const mq = rinv.path.module_qualifier;
    TH.emitUnit(allocator, &appended, flow, mq, std.fmt.allocPrint(allocator, "__pump_{s}_step_{d}", .{ pump_name, join_idx }) catch unreachable, "step", &[_]ast.Arg{}, &[_]ast.Field{}, "i32", "__koru_r", "__koru_r", retain_ann);
    TH.emitUnit(allocator, &appended, flow, mq, std.fmt.allocPrint(allocator, "__pump_{s}_live_{d}", .{ pump_name, join_idx }) catch unreachable, "live", &[_]ast.Arg{}, &[_]ast.Field{}, "i64", "__koru_r", "__koru_r", retain_ann);
    const wait_field = allocator.alloc(ast.Field, 1) catch unreachable;
    wait_field[0] = ast.Field{ .name = allocator.dupe(u8, "i") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
    const wait_arg = allocator.alloc(ast.Arg, 1) catch unreachable;
    wait_arg[0] = ast.Arg{ .name = allocator.dupe(u8, "i") catch unreachable, .value = allocator.dupe(u8, "i") catch unreachable };
    TH.emitUnit(allocator, &appended, flow, mq, std.fmt.allocPrint(allocator, "__pump_{s}_wait_{d}", .{ pump_name, join_idx }) catch unreachable, "wait", wait_arg, wait_field, "{ fd: i32, wait_ns: i128 }", "__koru_w", ".{ .fd = __koru_w.fd, .wait_ns = __koru_w.wait_ns }", retain_ann);

    if (stopped_arm) |sa| {
        const rname = std.fmt.allocPrint(allocator, "__pump_{s}_retired_{d}", .{ pump_name, join_idx }) catch unreachable;
        appended.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
            .path = TH.mkPath(allocator, flow.module, rname),
            .input = ast.Shape{ .fields = &[_]ast.Field{} },
            .branches = &[_]ast.Branch{},
            .is_public = false,
            .is_implicit_flow = false,
            .annotations = retain_ann,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;
        const rsegs = allocator.alloc([]const u8, 1) catch unreachable;
        rsegs[0] = allocator.dupe(u8, "__retire") catch unreachable;
        const retire_inv = ast.Invocation{
            .path = ast.DottedPath{
                .module_qualifier = if (mq) |q| allocator.dupe(u8, q) catch unreachable else null,
                .segments = rsegs,
            },
            .args = &[_]ast.Arg{},
            .source_module = allocator.dupe(u8, flow.module) catch unreachable,
        };
        const sconts = allocator.alloc(ast.Continuation, 1) catch unreachable;
        sconts[0] = ast_functional.cloneContinuation(allocator, sa) catch unreachable;
        appended.append(allocator, ast.Item{ .flow = ast.Flow{
            .body = ast.rootSite(retire_inv, sconts, flow.location),
            .pre_label = null,
            .impl_of = TH.mkPath(allocator, flow.module, rname),
            .super_shape = null,
            .is_pure = false,
            .is_transitively_pure = false,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;
    }

    // The site's replacement: `init` with the same args, wearing `! arrived`,
    // `| failed`, and the unlabeled chain — everything but `| stopped`, which
    // lives on the retire unit now.
    var init_inv = ast_functional.cloneInvocation(allocator, rinv) catch unreachable;
    const isegs = allocator.alloc([]const u8, 1) catch unreachable;
    isegs[0] = allocator.dupe(u8, "init") catch unreachable;
    init_inv.path.segments = isegs;
    var iconts = std.ArrayList(ast.Continuation).initCapacity(allocator, flow.body.continuations.len) catch unreachable;
    for (flow.body.continuations) |*cont| {
        if (stopped_arm != null and cont == stopped_arm.?) continue;
        iconts.append(allocator, ast_functional.cloneContinuation(allocator, cont) catch unreachable) catch unreachable;
    }
    return .{ .replacement = ast.Item{ .flow = ast.Flow{
        .body = ast.rootSite(init_inv, iconts.items, flow.location),
        .annotations = flow.annotations,
        .pre_label = flow.pre_label,
        .impl_of = flow.impl_of,
        .super_shape = flow.super_shape,
        .inline_body = flow.inline_body,
        .preamble_code = flow.preamble_code,
        .is_pure = flow.is_pure,
        .is_transitively_pure = flow.is_transitively_pure,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } }, .appended = appended.toOwnedSlice(allocator) catch unreachable };
}

~proc drive|zig {
    $mod.ignoreSigpipe();

    $mod.h2c_listen_port = $mod.h2cPortEnv();
    if ($mod.maybeStartTls(tls_port, cert_path, key_path)) |err_msg| {
        return .{ .failed = err_msg };
    }
    if ($mod.maybeStartH2Tls($mod.h2TlsPortEnv(), cert_path, key_path)) |err_msg| {
        return .{ .failed = err_msg };
    }

    var server = $mod.openListener(port) orelse return .{ .failed = "Failed to listen" };

    const n_workers = $mod.workerCount();

    // The listener is NOT in anybody's readiness set. This thread does nothing
    // but accept, and blocks while it waits — which is why the listener stays
    // blocking where the connections do not. Arming it inside a worker's kqueue
    // would make that one worker answer every new connection as well as its own
    // traffic.
    var kqs: [$mod.MAX_WORKERS]i32 = undefined;

    // The per-connection half of the loop, which is the whole loop now that
    // accepting has moved out. One runs per worker, each on its own kqueue,
    // each seeing only the descriptors handed to it.
    const Worker = struct {
        fn loop(kq: i32) void {
            var no_changes: [0]$mod.libc.Kevent = undefined;
            var events: [$mod.MAX_EVENTS]$mod.libc.Kevent = undefined;

            while (true) {
                var wait_ts: std.c.timespec = undefined;
                const park_ms = $mod.parkMsUntilDue();
                const ts: ?*std.c.timespec = if (park_ms == std.math.maxInt(i64)) null else blk: {
                    wait_ts = .{ .sec = @intCast(@divTrunc(park_ms, 1000)), .nsec = @intCast(@mod(park_ms, 1000) * 1000000) };
                    break :blk &wait_ts;
                };
                const n = $mod.libc.kevent(kq, &no_changes, 0, &events, $mod.MAX_EVENTS, ts);
                while ($mod.parkDue()) |pst| {
                    const pfd: $mod.posix.fd_t = @intCast(pst.fd);
                    switch ($mod.flushPendingOwned(pst)) {
                        .dead => {
                            $mod.releaseConn(pfd);
                            continue;
                        },
                        .stalled, .drained => {},
                    }
                    if (pst.close_when_drained and !$mod.hasWork(pst)) {
                        $mod.releaseConn(pfd);
                        continue;
                    }
                    $mod.kqueueRearm(kq, pfd, pst);
                }
                if (n <= 0) continue;
                @import("root").koru_orisha.stampHttpDateLine();

                for (events[0..@intCast(n)]) |event| {
                    const fd: $mod.posix.fd_t = @intCast(event.ident);

                    const st = $mod.connState(fd) orelse {
                        $mod.posix.close(fd);
                        continue;
                    };

                    // The conn registers before its handshake finishes —
                    // step it once per readiness event so a thousand
                    // concurrent handshakes spread over every worker, and
                    // trust no bytes as requests until the cipher is up.
                    if (st.tls_hs) {
                        switch ($mod.driveTlsHandshake(st)) {
                            .ready => st.tls_hs = false,
                            .want_read => {
                                $mod.armKqueueFilter(kq, fd, $mod.libc.EVFILT.READ);
                                continue;
                            },
                            .want_write => {
                                $mod.armKqueueFilter(kq, fd, $mod.libc.EVFILT.WRITE);
                                continue;
                            },
                            .failed => {
                                $mod.releaseConn(fd);
                                continue;
                            },
                        }
                    }

                    // Write-ready drains whatever earlier sends could not
                    // deliver; a conn closing behind a queue ends here.
                    if (event.filter == $mod.libc.EVFILT.WRITE) {
                        switch ($mod.flushPendingOwned(st)) {
                            .dead => {
                                if (st.mode == .ws) closed(@intCast(fd));
                                $mod.releaseConn(fd);
                                continue;
                            },
                            .stalled => {
                                $mod.kqueueRearm(kq, fd, st);
                                continue;
                            },
                            .drained => {
                                if (st.close_when_drained) {
                                    if (st.mode == .ws) closed(@intCast(fd));
                                    $mod.releaseConn(fd);
                                    continue;
                                }
                            },
                        }
                        // A WRITE event carries no request bytes — back to
                        // read readiness for the next one.
                        $mod.armKqueueFilter(kq, fd, $mod.libc.EVFILT.READ);
                        continue;
                    }

                    switch ($mod.fill_event.handler(.{ .st = st })) {
                        .more => {},
                        // Nothing new to frame, but the connection is alive.
                        // Re-arm and wait rather than closing it.
                        .idle => {
                            $mod.kqueueRearm(kq, fd, st);
                            continue;
                        },
                        .gone => {
                            if (st.mode == .ws) closed(@intCast(fd));
                            $mod.releaseConn(fd);
                            continue;
                        },
                    }

                    // Upgraded connection: frames, not requests — same seam as
                    // `init|zig`'s `st.mode == .ws` block above.
                    if (st.mode == .ws) {
                        var ws_consumed: usize = 0;
                        var ws_alive = true;
                        while (ws_consumed < st.len) {
                            const item = $mod.wsNext(st, &ws_consumed) orelse break;
                            switch (item) {
                                .ping => |pl| {
                                    if (!$mod.wsSendFrame(st, 0xA, pl)) ws_alive = false;
                                },
                                .close => |pl| {
                                    _ = $mod.wsSendFrame(st, 0x8, pl);
                                    ws_alive = false;
                                },
                                .dead => ws_alive = false,
                                .message => |m| {
                                    var fx = $mod.Exchange{ .fd = fd, .st = st, .raw = m.payload, .opcode = m.op };
                                    frame(&fx);
                                    st.ws_msg.clearRetainingCapacity();
                                    if (!fx.keep_alive) ws_alive = false;
                                },
                            }
                            if (!ws_alive) break;
                        }
                        st.len = $mod.retainTail(st.buf, st.len, ws_consumed);
                        if (ws_alive and st.len == st.buf.len) ws_alive = $mod.growReqBuf(st);
                        if (!ws_alive) {
                            if ($mod.hasWork(st)) {
                                st.close_when_drained = true;
                                $mod.armKqueueFilter(kq, fd, $mod.libc.EVFILT.WRITE);
                                continue;
                            }
                            if (st.mode == .ws) closed(@intCast(fd));
                            $mod.releaseConn(fd);
                            continue;
                        }
                        $mod.kqueueRearm(kq, fd, st);
                        continue;
                    }

                    // Answer every COMPLETE request; keep any unfinished tail
                    // for the next read rather than parsing it as a fresh one.
                    // Replies batch in pending — one flush per read event, not
                    // one syscall per answer.
                    st.batching = true;
                    var consumed: usize = 0;
                    var alive = true;
                    var head_pairs: [$mod.HEAD_PAIRS_MAX]$mod.HeadPair = undefined;
                    if (!st.preface_checked) {
                        switch ($mod.h2cSniffPreface(st.buf[0..st.len])) {
                            .h2c => { st.mode = .h2c; st.preface_checked = true; },
                            .h1 => st.preface_checked = true,
                            .wait => {},
                        }
                    }
                    if (st.mode == .h2c) {
                        consumed = $mod.h2cProcess(st, st.buf[0..st.len]);
                        while ($mod.h2cPopReady(st)) |r| {
                            var head: $mod.Head = .{ .pairs = &head_pairs };
                            _ = $mod.scanRequest(r.raw, &head) orelse {
                                $mod.pumpAlloc().free(r.raw);
                                continue;
                            };
                            var exchange = $mod.Exchange{ .fd = fd, .st = st, .raw = r.raw, .head = &head, .h2_stream = r.stream_id };
                            arrived(&exchange);
                            $mod.pumpAlloc().free(r.raw);
                        }
                    } else if (st.preface_checked) { while (consumed < st.len) {
                        var head: $mod.Head = .{ .pairs = &head_pairs };
                        const take = $mod.scanRequest(st.buf[consumed..st.len], &head) orelse break;
                        var exchange = $mod.Exchange{ .fd = fd, .st = st, .raw = st.buf[consumed .. consumed + take], .head = &head };
                        if (head.wants_close) exchange.keep_alive = false;
                        arrived(&exchange);
                        consumed += take;
                        if (!exchange.keep_alive) {
                            alive = false;
                            break;
                        }
                    } }
                    st.batching = false;
                    _ = $mod.flushPending(st);
                    st.len = $mod.retainTail(st.buf, st.len, consumed);

                    // Headers that never end are not a request this server can answer.
                    if (alive and st.len == st.buf.len) alive = $mod.growReqBuf(st);

                    if (!alive) {
                        // A closing answer still in the queue drains first —
                        // releasing here would cut it mid-flight.
                        if ($mod.hasWork(st)) {
                            st.close_when_drained = true;
                            $mod.armKqueueFilter(kq, fd, $mod.libc.EVFILT.WRITE);
                            continue;
                        }
                        if (st.mode == .ws) closed(@intCast(fd));
                        $mod.releaseConn(fd);
                        continue;
                    }

                    // ONESHOT disarms on delivery — re-arm for the next request.
                    $mod.kqueueRearm(kq, fd, st);
                }
            }
        }
    };

    for (0..n_workers) |i| {
        kqs[i] = $mod.posix.kqueue() catch return .{ .failed = "Failed to create kqueue" };
        _ = std.Thread.spawn(.{}, Worker.loop, .{kqs[i]}) catch
            return .{ .failed = "Failed to spawn worker" };
    }

    var next: usize = 0;
    if ($mod.tls_server_ctx != null) {
        const TlsAccept = struct {
            fn loop(kqs_ptr: *[$mod.MAX_WORKERS]i32, n: usize, next_ptr: *usize) void {
                var tls_listener = $mod.openListener($mod.tls_listen_port) orelse return;
                defer tls_listener.deinit();
                while (true) {
                    const conn = tls_listener.accept() catch continue;
                    const client_fd = conn.stream.handle;
                    // Only the SSL object is made here — the handshake runs
                    // in the worker loop, one step per readiness event.
                    const ssl = $mod.beginTlsHandshake(@intCast(client_fd)) orelse continue;
                    const worker = next_ptr.*;
                    next_ptr.* = (next_ptr.* + 1) % n;
                    $mod.registerClient(client_fd, ssl, kqs_ptr[worker]);
                }
            }
        };
        _ = std.Thread.spawn(.{}, TlsAccept.loop, .{ &kqs, n_workers, &next }) catch
            return .{ .failed = "Failed to spawn TLS accept thread" };
    }

    if ($mod.h2c_listen_port != 0) {
        const H2cAccept = struct {
            fn loop(kqs_ptr: *[$mod.MAX_WORKERS]i32, n: usize, next_ptr: *usize) void {
                var h2c_listener = $mod.openListener($mod.h2c_listen_port) orelse return;
                defer h2c_listener.deinit();
                while (true) {
                    const conn = h2c_listener.accept() catch continue;
                    const client_fd = conn.stream.handle;
                    const worker = next_ptr.*;
                    next_ptr.* = (next_ptr.* + 1) % n;
                    $mod.registerClientH2c(client_fd, kqs_ptr[worker]);
                }
            }
        };
        _ = std.Thread.spawn(.{}, H2cAccept.loop, .{ &kqs, n_workers, &next }) catch
            return .{ .failed = "Failed to spawn h2c accept thread" };
    }

    if ($mod.h2_tls_server_ctx != null) {
        const H2TlsAccept = struct {
            fn loop(kqs_ptr: *[$mod.MAX_WORKERS]i32, n: usize, next_ptr: *usize) void {
                var h2_listener = $mod.openListener($mod.h2_tls_listen_port) orelse return;
                defer h2_listener.deinit();
                while (true) {
                    const conn = h2_listener.accept() catch continue;
                    const client_fd = conn.stream.handle;
                    const ctx = $mod.h2_tls_server_ctx orelse break;
                    const ssl = $mod.beginTlsHandshakeCtx(@intCast(client_fd), ctx) orelse continue;
                    const worker = next_ptr.*;
                    next_ptr.* = (next_ptr.* + 1) % n;
                    $mod.registerClientH2cTls(client_fd, ssl, kqs_ptr[worker]);
                }
            }
        };
        _ = std.Thread.spawn(.{}, H2TlsAccept.loop, .{ &kqs, n_workers, &next }) catch
            return .{ .failed = "Failed to spawn h2-TLS accept thread" };
    }

    std.debug.print("Orisha listening on http://0.0.0.0:{}\n", .{port});
    if ($mod.tls_server_ctx != null) {
        std.debug.print("Orisha listening on https://0.0.0.0:{}\n", .{$mod.tls_listen_port});
    }
    if ($mod.h2_tls_server_ctx != null) {
        std.debug.print("Orisha listening on h2s://0.0.0.0:{}\n", .{$mod.h2_tls_listen_port});
    }
    std.debug.print("Pump: kqueue, {} workers, keep-alive, TCP_NODELAY\n", .{n_workers});

    // Hand each new connection to the next worker in turn. A descriptor belongs
    // to that worker for the rest of its life, which is what makes the shared
    // connection table safe without a lock: no index is ever touched twice.
    while (true) {
        const conn = server.accept() catch continue;
        const client_fd = conn.stream.handle;
        const worker = next;
        next = (next + 1) % n_workers;
        $mod.registerClient(client_fd, null, kqs[worker]);
    }

    return .{ .stopped = "Server stopped" };
}

// ---------------------------------------------------------------------------
// epoll — Linux. Selected by `--build=linux`.
// ---------------------------------------------------------------------------

~proc drive|epoll {
    $mod.ignoreSigpipe();

    const linux = std.os.linux;

    $mod.h2c_listen_port = $mod.h2cPortEnv();
    if ($mod.maybeStartTls(tls_port, cert_path, key_path)) |err_msg| {
        return .{ .failed = err_msg };
    }
    if ($mod.maybeStartH2Tls($mod.h2TlsPortEnv(), cert_path, key_path)) |err_msg| {
        return .{ .failed = err_msg };
    }

    const n_workers = $mod.workerCount();

    // One epoll instance AND one SO_REUSEPORT listener per worker — the
    // shared-nothing shape the ring pump uses. A connection is accepted,
    // served and released on a single thread, so "exactly one worker holds
    // a descriptor" is true by construction — which is the only thing
    // EPOLLONESHOT was enforcing on the previous shared-epfd design.
    //
    // That buys the per-request bookkeeping syscall back. ONESHOT disarms a
    // descriptor on every delivery, so the shared-epfd loop paid one
    // epoll_ctl(CTL_MOD) re-arm per readiness event — measured under wrk
    // (strace -c, cost-hunt session) as read:write:epoll_ctl in exact 1:1:1,
    // a full third of all syscalls — and every re-arm took the shared
    // instance's lock against eleven other workers' epoll_waits.
    //
    // With a persistent level-triggered registration, epoll_ctl fires once
    // at accept and then only on readiness-SHAPE changes: a stalled write
    // adds EPOLLOUT, a drained queue drops it, a TLS handshake step picks a
    // direction. Steady state per request is read + write plus an
    // epoll_wait that returns ~a full 64-event batch under load.

    // data.ptr tags that can never alias a *ConnState: the userspace
    // pointers this process hands out keep the top bits clear. One tag per
    // listener kind; the worker knows which fd each names because it owns
    // both.
    const LISTENER_TAG: usize = 0x8000_0000_0000_0000;
    const TLS_LISTENER_TAG: usize = 0x8000_0000_0000_0001;
    // Backlog beyond this stays queued and refires the level-triggered
    // listener event next pass — a bounded accept keeps a connect storm
    // from starving the readiness batch behind it.
    const ACCEPT_BURST = 128;

    const Worker = struct {
        // The only epoll_ctl left in the pump: re-shape a LIVE
        // registration — a stall gaining EPOLLOUT, a drain dropping it, a
        // handshake step taking a direction. Never once per event.
        fn arm(epfd: i32, st: *$mod.ConnState, mask: u32) void {
            if (st.park_until != 0) {
                if (!st.parked) $mod.parkInsert(st);
                return;
            }
            // `armed` tracks the OUT bit of every installed mask — the flag
            // a wsPublishFrame producer reads before deciding to arm.
            st.armed.store((mask & linux.EPOLL.OUT) != 0, .release);
            var ev = linux.epoll_event{
                .events = mask,
                .data = .{ .ptr = @intFromPtr(st) },
            };
            _ = linux.epoll_ctl(epfd, linux.EPOLL.CTL_MOD, st.fd, &ev);
        }

        fn takeConns(listen_fd: $mod.posix.fd_t, epfd: i32) void {
            for (0..ACCEPT_BURST) |_| {
                const client_fd = $mod.posix.accept(listen_fd, null, null, $mod.posix.SOCK.NONBLOCK | $mod.posix.SOCK.CLOEXEC) catch break;
                $mod.registerClientEpoll(client_fd, null, epfd);
            }
        }

        fn takeTlsConns(listen_fd: $mod.posix.fd_t, epfd: i32) void {
            for (0..ACCEPT_BURST) |_| {
                const client_fd = $mod.posix.accept(listen_fd, null, null, $mod.posix.SOCK.NONBLOCK | $mod.posix.SOCK.CLOEXEC) catch break;
                // Only the SSL object is made here — the handshake runs
                // below, one step per readiness event.
                const ssl = $mod.beginTlsHandshake(@intCast(client_fd)) orelse continue;
                $mod.registerClientEpoll(client_fd, ssl, epfd);
            }
        }

        fn loop(listen_fd: $mod.posix.fd_t, tls_listen_fd: $mod.posix.fd_t, epfd: i32) void {
            // The listener must not block the worker: a drained accept
            // queue answers EAGAIN, not sleep.
            $mod.markNonBlocking(listen_fd);
            var lev = linux.epoll_event{
                .events = linux.EPOLL.IN,
                .data = .{ .ptr = LISTENER_TAG },
            };
            _ = linux.epoll_ctl(epfd, linux.EPOLL.CTL_ADD, listen_fd, &lev);
            if (tls_listen_fd >= 0) {
                $mod.markNonBlocking(tls_listen_fd);
                lev.data = .{ .ptr = TLS_LISTENER_TAG };
                _ = linux.epoll_ctl(epfd, linux.EPOLL.CTL_ADD, tls_listen_fd, &lev);
            }

            var events: [$mod.MAX_EVENTS]linux.epoll_event = undefined;
            while (true) {
                // Same rule as the kqueue wait: a parked conn's deadline
                // is the latest this wait may sleep.
                const park_ms = $mod.parkMsUntilDue();
                const wait_ms: i32 = if (park_ms == std.math.maxInt(i64)) -1 else @intCast(@min(park_ms, std.math.maxInt(i32) - 1));
                const n_rc = linux.epoll_wait(epfd, &events, $mod.MAX_EVENTS, wait_ms);
                while ($mod.parkDue()) |pst| {
                    switch ($mod.flushPendingOwned(pst)) {
                        .dead => {
                            $mod.releaseConn(@intCast(pst.fd));
                            continue;
                        },
                        .stalled, .drained => {},
                    }
                    if (pst.close_when_drained and !$mod.hasWork(pst)) {
                        $mod.releaseConn(@intCast(pst.fd));
                        continue;
                    }
                    arm(epfd, pst, $mod.epollMask(pst));
                }
                const n: i32 = @bitCast(@as(u32, @truncate(n_rc)));
                if (n <= 0) continue;
                @import("root").koru_orisha.stampHttpDateLine();

                for (events[0..@intCast(n)]) |event| {
                    if (event.data.ptr == LISTENER_TAG) {
                        takeConns(listen_fd, epfd);
                        continue;
                    }
                    if (event.data.ptr == TLS_LISTENER_TAG) {
                        takeTlsConns(tls_listen_fd, epfd);
                        continue;
                    }

                    // The epoll set carries *ConnState in data.ptr — no
                    // fd→state table lookup, no conn_states_mu on the
                    // dispatch path. Only this worker can ever dispatch or
                    // release the conn, so the pointer cannot be freed
                    // under us: release happens here.
                    const st: *$mod.ConnState = @ptrFromInt(event.data.ptr);
                    const fd: $mod.posix.fd_t = st.fd;

                    // The conn registers before its handshake finishes —
                    // step it once per readiness event and trust no bytes
                    // as requests until the cipher is up.
                    if (st.tls_hs) {
                        switch ($mod.driveTlsHandshake(st)) {
                            .ready => {
                                st.tls_hs = false;
                                // The handshake armed one direction; a live
                                // conn reads and drains.
                                arm(epfd, st, $mod.epollMask(st));
                            },
                            // Arm only the direction the cipher asked for:
                            // a want_read conn armed IN|OUT refires
                            // instantly (OUT is level-true on any writable
                            // socket), drowning real readiness in futile
                            // SSL_accept calls.
                            .want_read, .want_write => |w| {
                                const dir: u32 = if (w == .want_read) linux.EPOLL.IN else linux.EPOLL.OUT;
                                arm(epfd, st, dir);
                                continue;
                            },
                            .failed => {
                                $mod.releaseConn(fd);
                                continue;
                            },
                        }
                    }

                    // Write-ready drains whatever earlier sends could not
                    // deliver; a conn closing behind a queue ends here.
                    if (event.events & linux.EPOLL.OUT != 0) {
                        switch ($mod.flushPendingOwned(st)) {
                            .dead => {
                                if (st.mode == .ws) closed(@intCast(fd));
                                $mod.releaseConn(fd);
                                continue;
                            },
                            // Still stalled — EPOLLOUT stays armed, so the
                            // next writable instant refires on its own.
                            // flushPendingOwned cleared `armed` at its drain
                            // boundary; the live arm means the flag is true.
                            .stalled => {
                                st.armed.store(true, .release);
                                continue;
                            },
                            .drained => {
                                if (st.close_when_drained) {
                                    if (st.mode == .ws) closed(@intCast(fd));
                                    $mod.releaseConn(fd);
                                    continue;
                                }
                                // EPOLLOUT is level-true on a writable
                                // socket: drop it or every wait returns a
                                // write-ready event for a conn with nothing
                                // left to write.
                                arm(epfd, st, $mod.epollMask(st));
                                if (event.events & linux.EPOLL.IN == 0) continue;
                            },
                        }
                    }

                    switch ($mod.fill_event.handler(.{ .st = st })) {
                        .more => {},
                        // Nothing arrived after all — the IN registration
                        // persists, so there is nothing to re-arm.
                        .idle => continue,
                        .gone => {
                            if (st.mode == .ws) closed(@intCast(fd));
                            $mod.releaseConn(fd);
                            continue;
                        },
                    }

                    // Upgraded connection: frames, not requests — same seam
                    // as the kqueue pump's `st.mode == .ws` block.
                    if (st.mode == .ws) {
                        var ws_consumed: usize = 0;
                        var ws_alive = true;
                        while (ws_consumed < st.len) {
                            const item = $mod.wsNext(st, &ws_consumed) orelse break;
                            switch (item) {
                                .ping => |pl| {
                                    if (!$mod.wsSendFrame(st, 0xA, pl)) ws_alive = false;
                                },
                                .close => |pl| {
                                    _ = $mod.wsSendFrame(st, 0x8, pl);
                                    ws_alive = false;
                                },
                                .dead => ws_alive = false,
                                .message => |m| {
                                    var fx = $mod.Exchange{ .fd = fd, .st = st, .raw = m.payload, .opcode = m.op };
                                    frame(&fx);
                                    st.ws_msg.clearRetainingCapacity();
                                    if (!fx.keep_alive) ws_alive = false;
                                },
                            }
                            if (!ws_alive) break;
                        }
                        st.len = $mod.retainTail(st.buf, st.len, ws_consumed);
                        if (ws_alive and st.len == st.buf.len) ws_alive = $mod.growReqBuf(st);
                        if (!ws_alive) {
                            if ($mod.hasWork(st)) {
                                st.close_when_drained = true;
                                arm(epfd, st, $mod.epollMask(st));
                                continue;
                            }
                            if (st.mode == .ws) closed(@intCast(fd));
                            $mod.releaseConn(fd);
                            continue;
                        }
                        // A stalled frame queue asks for write-readiness
                        // beside reads; a clean conn's IN persists untouched.
                        if ($mod.hasWork(st)) arm(epfd, st, $mod.epollMask(st));
                        continue;
                    }

                    // Same shape as the kqueue pump — see requestLen and retainTail.
                    // Replies batch in pending — one flush per read event.
                    st.batching = true;
                    var consumed: usize = 0;
                    var alive = true;
                    var head_pairs: [$mod.HEAD_PAIRS_MAX]$mod.HeadPair = undefined;
                    if (!st.preface_checked) {
                        switch ($mod.h2cSniffPreface(st.buf[0..st.len])) {
                            .h2c => { st.mode = .h2c; st.preface_checked = true; },
                            .h1 => st.preface_checked = true,
                            .wait => {},
                        }
                    }
                    if (st.mode == .h2c) {
                        consumed = $mod.h2cProcess(st, st.buf[0..st.len]);
                        while ($mod.h2cPopReady(st)) |r| {
                            var head: $mod.Head = .{ .pairs = &head_pairs };
                            _ = $mod.scanRequest(r.raw, &head) orelse {
                                $mod.pumpAlloc().free(r.raw);
                                continue;
                            };
                            var exchange = $mod.Exchange{ .fd = fd, .st = st, .raw = r.raw, .head = &head, .h2_stream = r.stream_id };
                            arrived(&exchange);
                            $mod.pumpAlloc().free(r.raw);
                        }
                    } else if (st.preface_checked) { while (consumed < st.len) {
                        var head: $mod.Head = .{ .pairs = &head_pairs };
                        const take = $mod.scanRequest(st.buf[consumed..st.len], &head) orelse break;
                        var exchange = $mod.Exchange{ .fd = fd, .st = st, .raw = st.buf[consumed .. consumed + take], .head = &head };
                        if (head.wants_close) exchange.keep_alive = false;
                        arrived(&exchange);
                        consumed += take;
                        if (!exchange.keep_alive) {
                            alive = false;
                            break;
                        }
                    } }
                    st.batching = false;
                    _ = $mod.flushPending(st);
                    st.len = $mod.retainTail(st.buf, st.len, consumed);
                    if (alive and st.len == st.buf.len) alive = $mod.growReqBuf(st);

                    if (!alive) {
                        // A closing answer still in the queue drains first —
                        // releasing here would cut it mid-flight.
                        if ($mod.hasWork(st)) {
                            st.close_when_drained = true;
                            arm(epfd, st, $mod.epollMask(st));
                            continue;
                        }
                        if (st.mode == .ws) closed(@intCast(fd));
                        $mod.releaseConn(fd);
                        continue;
                    }

                    // A flush that stalled asks for write-readiness beside
                    // reads — the one shape change the hot path can cause.
                    // A clean conn needs nothing: EPOLLIN persists.
                    if ($mod.hasWork(st)) arm(epfd, st, $mod.epollMask(st));
                }
            }
        }
    };

    // REUSEPORT hands each worker its own listener, the kernel hashes flows
    // across them, and accept + serve + release all stay on one thread —
    // no acceptor threads, no cross-worker registration, no shared lock.
    var lfds: [$mod.MAX_WORKERS]$mod.posix.fd_t = undefined;
    var tls_lfds: [$mod.MAX_WORKERS]$mod.posix.fd_t = undefined;
    var epfds: [$mod.MAX_WORKERS]i32 = undefined;
    var n_workers_up: usize = 0;
    for (0..n_workers) |i| {
        const lfd = $mod.openReusePortListener(port) orelse break;
        const rc = linux.epoll_create1(0);
        if (rc < 0) {
            $mod.posix.close(lfd);
            break;
        }
        lfds[i] = lfd;
        epfds[i] = @bitCast(@as(u32, @truncate(rc)));
        tls_lfds[i] = -1;
        if ($mod.tls_server_ctx != null) {
            tls_lfds[i] = $mod.openReusePortListener($mod.tls_listen_port) orelse -1;
        }
        n_workers_up += 1;
    }
    if (n_workers_up == 0) return .{ .failed = "Failed to listen" };
    for (1..n_workers_up) |i| {
        _ = std.Thread.spawn(.{}, Worker.loop, .{ lfds[i], tls_lfds[i], epfds[i] }) catch
            return .{ .failed = "Failed to spawn worker" };
    }

    std.debug.print("Orisha listening on http://0.0.0.0:{}\n", .{port});
    if ($mod.tls_server_ctx != null) {
        std.debug.print("Orisha listening on https://0.0.0.0:{}\n", .{$mod.tls_listen_port});
    }
    std.debug.print("Pump: epoll, {} workers (epoll + listener each), keep-alive, TCP_NODELAY\n", .{n_workers_up});

    Worker.loop(lfds[0], tls_lfds[0], epfds[0]);

    return .{ .stopped = "Server stopped" };
}

// ---------------------------------------------------------------------------
// io_uring — Linux 5.x and later. Selected by `--build=io-uring`.
// ---------------------------------------------------------------------------
// The other three pumps ask the kernel WHICH descriptor is ready and then do the
// read themselves. This one submits the read up front and is told it has already
// happened — so there is no readiness step, and the loop body handles a result
// rather than a hint.
//
// That is a different shape, not a faster spelling of the same one, and it is
// the reason the seam is worth having: everything above `run` is untouched by
// the inversion. Framing, buffering and the idle timeout are the shared helpers
// the other pumps use; only the way bytes arrive is new.
//
// A blocking write is used for the reply (the `reply|zig` body, unchanged): the
// connections here are never marked non-blocking, so `write` completes or waits,
// and there is no readiness to wait for anyway.
//
// This is also the one pump that does NOT go through `fill`, and the inversion
// is why: `fill` is a call that fetches bytes, and here nobody calls anything —
// the bytes are already in the buffer by the time the loop hears about them, and
// the count arrives in the completion. The three answers `fill` gives are all
// still here, just read off `cqe.res` instead of returned. Anything that wants
// to sit between the wire and the parser attaches at that harvest below, not at
// a call site.

// Bounded batch wait: enter once, come back with up to wait_nr completions or
// at the deadline, whichever lands first. `submit_and_wait(1)` parks on the
// FIRST completion, so a hot worker pays one enter per CQE; a bounded wait
// amortizes enters across the batch the same way the CQE drain amortizes
// dispatch. The deadline must ride inside the wait (IORING_ENTER_EXT_ARG,
// kernel 5.11+) — an IORING_OP_TIMEOUT SQE's clock starts at submission, not
// at the wait, so a deadline that expires before the wait begins becomes part
// of the sample the wakeup is judged against: a hang, not a late wakeup. TIME
// is a normal short batch, not an error — the caller reaps whatever landed.
fn ringWaitTimeout(ring: *std.os.linux.IoUring, wait_nr: u32, timeout_ns: i64) !void {
    const linux = std.os.linux;
    const deadline: linux.kernel_timespec = .{ .sec = 0, .nsec = timeout_ns };
    const wait_arg: linux.io_uring_getevents_arg = .{
        .sigmask = 0,
        .sigmask_sz = 0,
        .pad = 0,
        .ts = @intFromPtr(&deadline),
    };
    const res = linux.syscall6(
        .io_uring_enter,
        @as(usize, @intCast(ring.fd)),
        ring.flush_sq(),
        wait_nr,
        linux.IORING_ENTER_GETEVENTS | linux.IORING_ENTER_EXT_ARG,
        @intFromPtr(&wait_arg),
        @sizeOf(linux.io_uring_getevents_arg),
    );
    switch (linux.E.init(res)) {
        .SUCCESS, .TIME => {},
        else => return error.RingWaitFailed,
    }
}

~proc drive|io-uring {
    $mod.h2c_listen_port = $mod.h2cPortEnv();
    if ($mod.maybeStartTls(tls_port, cert_path, key_path)) |err_msg| {
        return .{ .failed = err_msg };
    }
    if ($mod.maybeStartH2Tls($mod.h2TlsPortEnv(), cert_path, key_path)) |err_msg| {
        return .{ .failed = err_msg };
    }
    // `std.os.linux.IoUring` cannot be NAMED on a non-Linux target — it reaches
    // for `linux.E` and a macOS build has `darwin.E` instead, so this is a type
    // error, not a missing feature. The guard is comptime-known, so the body
    // below is never analysed when the host is not Linux, and `koruc` can still
    // produce its host executable on a laptop.
    if (@import("builtin").os.tag != .linux) {
        return .{ .failed = "io_uring is a Linux mechanism — build with --build=linux for this host" };
    }

    $mod.ignoreSigpipe();

    const linux = std.os.linux;
    const n_workers = $mod.workerCount();

    // Shared-nothing fleet: one ring + one SO_REUSEPORT listener per worker —
    // no accept thread, no readiness handoff; a connection lives its whole
    // life on the worker whose listener took it. user_data carries the
    // *ConnState tagged in the low bits, so a completion never touches the
    // connection table or its mutex.
    //
    // Per connection, at most one send SQE is in flight over send_buf, plus
    // (cleartext, with a buffer pool) one multishot recv that stays armed for
    // the conn's whole life — reads proceed while a send is outstanding, so
    // a pipelined burst no longer queues behind the reply's own CQE. Replies
    // stage into send_buf between completions and leave as ONE send SQE per
    // readable batch — a 16-deep pipeline pays one send, not sixteen writes.
    // Bytes written while a send is in flight queue in `pending` — send_buf
    // is kernel-owned until its CQE lands — and drain into the tail at the
    // next submission boundary. Teardown detaches and closes the fd at once
    // but frees the ConnState only when every armed op has folded in.

    const W = struct {
        const TAG_SEND: u64 = 1;
        const TAG_POLL: u64 = 2;
        const CQE_BATCH = 512;
        const SUBMIT_STRIDE = 16; // push staged SQEs every N completions in a deep batch
        // Coalesced completion wait: a hot worker asks for up to this many
        // CQEs per enter so wakeups amortize; the deadline bounds how long a
        // short batch may be held — far below a request round trip.
        const WAIT_COALESCE_MAX: u32 = 32;
        const WAIT_COALESCE_NS: i64 = 20_000;

        ring: linux.IoUring,
        listen_fd: $mod.posix.fd_t,
        tls_listen_fd: $mod.posix.fd_t,
        h2c_listen_fd: $mod.posix.fd_t = -1,
        h2_tls_listen_fd: $mod.posix.fd_t = -1,
        // Provided-buffer pool for cleartext multishot recv: the kernel picks
        // the destination per packet and the op stays armed for the conn's
        // life — no per-recv SQE prep, and reads proceed while a send is in
        // flight. Null when the kernel won't register one (pre-5.19, tiny
        // RLIMIT_MEMLOCK): those conns fall back to one-shot st.buf recvs.
        //
        // This is deliberately NOT std's IoUring.BufferGroup: that registers
        // an incremental ring, and incremental rings change delivery
        // semantics. A plain ring keeps each CQE = one fresh buffer.
        bufgrp: ?*Pool = null,
        ms_seen: bool = false,
        // The worker's db conn — null when PG_HOST is unreachable at
        // startup; /db then falls through to the app's own handler.
        pg: ?*$mod.PgConn = null,

        const Pool = struct {
            ring: *linux.IoUring,
            buffers: []u8,
            br: *linux.io_uring_buf_ring,
            mask: u16,
            size: u32,

            fn init(ring: *linux.IoUring, size: u32, count: u16) !Pool {
                const buffers = try $mod.pumpAlloc().alloc(u8, @as(usize, size) * count);
                errdefer $mod.pumpAlloc().free(buffers);
                const br = try linux.IoUring.setup_buf_ring(ring.fd, count, 1, .{ .inc = false });
                linux.IoUring.buf_ring_init(br);
                const mask = linux.IoUring.buf_ring_mask(count);
                var i: u16 = 0;
                while (i < count) : (i += 1) {
                    const pos = @as(usize, size) * i;
                    linux.IoUring.buf_ring_add(br, buffers[pos .. pos + size], i, mask, i);
                }
                linux.IoUring.buf_ring_advance(br, count);
                return .{ .ring = ring, .buffers = buffers, .br = br, .mask = mask, .size = size };
            }

            fn arm(p: *Pool, user_data: u64, fd: $mod.posix.fd_t) !*linux.io_uring_sqe {
                const sqe = try p.ring.get_sqe();
                sqe.prep_rw(.RECV, fd, 0, 0, 0);
                sqe.flags |= linux.IOSQE_BUFFER_SELECT;
                sqe.buf_index = 1;
                sqe.user_data = user_data;
                sqe.ioprio |= linux.IORING_RECV_MULTISHOT;
                return sqe;
            }

            fn sliceAt(p: *Pool, buffer_id: u16, n: usize) []u8 {
                const pos = @as(usize, p.size) * buffer_id;
                return p.buffers[pos .. pos + n];
            }

            // Hand the CQE's buffer straight back — recycled the moment it is
            // consumed so a deep batch can't starve the pool.
            fn release(p: *Pool, cqe: linux.io_uring_cqe) void {
                const bid = cqe.buffer_id() catch return;
                const pos = @as(usize, p.size) * bid;
                linux.IoUring.buf_ring_add(p.br, p.buffers[pos .. pos + p.size], bid, p.mask, 0);
                linux.IoUring.buf_ring_advance(p.br, 1);
            }

        };

        fn udSend(st: *$mod.ConnState) u64 {
            return @intFromPtr(st) | TAG_SEND;
        }

        fn cqeConn(ud: u64) *$mod.ConnState {
            return @ptrFromInt(@as(usize, @intCast(ud & ~@as(u64, 3))));
        }

        // A multishot recv is armed for the conn's whole life, so teardown is
        // two-step: the slot is detached and the fd closed NOW (a reissued
        // descriptor must meet fresh state), and close() makes the kernel
        // retire the armed recv — its terminal CQE is what frees st. Frees
        // deferred until nothing in flight can still name the struct.
        fn teardown(w: *@This(), st: *$mod.ConnState) void {
            if (!st.ring_closing) {
                st.ring_closing = true;
                st.ring_dead = true;
                if ($mod.connIsWs(st.fd)) closed(@intCast(st.fd));
                if ($mod.HAS_OPENSSL) $mod.closeConnTls(st);
                if (st.fd >= 0) {
                    $mod.detachConn(st.fd);
                    $mod.posix.shutdown(@intCast(st.fd), .both) catch {};
                    $mod.posix.close(@intCast(st.fd));
                    st.fd = -1;
                }
            }
            w.maybeFreeRing(st);
        }

        fn maybeFreeRing(w: *@This(), st: *$mod.ConnState) void {
            _ = w;
            if (!st.ring_closing or st.recv_armed or st.poll_armed or st.send_len != 0) return;
            // Nothing can still reference st: recv folded, no send in flight,
            // fd already detached and closed. A `ws-send-fd` pusher could be
            // mid-write — same wait releaseConn does. The unlock must precede
            // destroy: a defer would run on freed memory.
            st.ws_mu.lock();
            $mod.closeConnMem(st);
            st.ws_mu.unlock();
            $mod.pumpAlloc().destroy(st);
        }

        // Readiness for a socket-BIO TLS conn — the only SQE kind it takes,
        // since the wire belongs to OpenSSL. poll_armed plays recv_armed's
        // teardown role: the free waits for this CQE before releasing st.
        fn submitPoll(w: *@This(), st: *$mod.ConnState, mask: u32) bool {
            st.poll_armed = true;
            _ = w.ring.poll_add(@intFromPtr(st) | TAG_POLL, st.fd, mask) catch {
                _ = w.ring.submit() catch {};
                _ = w.ring.poll_add(@intFromPtr(st) | TAG_POLL, st.fd, mask) catch {
                    st.poll_armed = false;
                    return false;
                };
            };
            return true;
        }

        fn submitRecv(w: *@This(), st: *$mod.ConnState) bool {
            // Socket-BIO TLS conns never arm a recv: the wire is OpenSSL's,
            // and their bytes arrive through poll_add + SSL_read instead.
            if ($mod.HAS_OPENSSL and st.tls_sockbio) return true;
            // Cleartext: one multishot recv rides the provided-buffer pool for
            // the conn's whole life — nothing to re-arm per batch. Already
            // armed conns (and the send-in-flight window) just return.
            if (st.recv_armed) return true;
            if (w.bufgrp) |bg| {
                if (!st.ms_off) {
                    _ = bg.arm(@intFromPtr(st), st.fd) catch {
                        _ = w.ring.submit() catch {};
                        _ = bg.arm(@intFromPtr(st), st.fd) catch return false;
                    };
                    st.recv_armed = true;
                    return true;
                }
            }
            const buf = st.buf[st.len..];
            _ = w.ring.recv(@intFromPtr(st), st.fd, .{ .buffer = buf }, 0) catch {
                _ = w.ring.submit() catch {};
                _ = w.ring.recv(@intFromPtr(st), st.fd, .{ .buffer = buf }, 0) catch return false;
            };
            return true;
        }

        fn submitSend(w: *@This(), st: *$mod.ConnState) bool {
            if (st.send_iov_n > 0) {
                _ = w.ring.writev(udSend(st), st.fd, st.send_iov[st.send_iov_pos..st.send_iov_n], 0) catch {
                    _ = w.ring.submit() catch {};
                    _ = w.ring.writev(udSend(st), st.fd, st.send_iov[st.send_iov_pos..st.send_iov_n], 0) catch return false;
                };
                return true;
            }
            _ = w.ring.send(udSend(st), st.fd, st.send_buf[st.send_off..st.send_len], linux.MSG.NOSIGNAL) catch {
                _ = w.ring.submit() catch {};
                _ = w.ring.send(udSend(st), st.fd, st.send_buf[st.send_off..st.send_len], linux.MSG.NOSIGNAL) catch return false;
            };
            return true;
        }

        // The one place a conn's next SQE is chosen. Staged output always
        // outranks new reads: a burst of pipelined replies coalesces into one
        // send, and a conn answered `keep_alive = false` still flushes its
        // last response before the fd drops.
        fn advance(w: *@This(), st: *$mod.ConnState) void {
            // A parked conn's deadline outranks every next op — nothing is
            // submitted until fireParked drops it back here with
            // park_until cleared.
            if (st.park_until != 0) {
                if (!st.parked) $mod.parkInsert(st);
                return;
            }
            // Socket-BIO TLS conns own none of the ring's send machinery —
            // output leaves through SSL_write and readiness is poll_add.
            if (st.tls_sockbio) {
                w.advanceSockBio(st);
                return;
            }
            if (st.send_len != 0 or st.send_iov_n != 0) return;
            const pn = $mod.pendingLen(st);
            // Bytes spilled while a plan window was open are NEWER than the
            // plan's — this window drains only up to the spill mark.
            const drain_n = if (st.spill_mark == std.math.maxInt(usize))
                pn
            else
                @min(pn, st.spill_mark -| st.pending_off);
            var drained_lo: usize = 0;
            var drained_n: usize = 0;
            if (drain_n > 0) {
                if (st.mode == .ws) st.ws_mu.lock();
                drained_lo = st.send_staged;
                const room = st.send_staged + drain_n;
                if (st.send_buf.len < room) {
                    const nb = $mod.pumpAlloc().alloc(u8, @max(4096, st.send_buf.len * 2, room)) catch {
                        if (st.mode == .ws) st.ws_mu.unlock();
                        w.teardown(st);
                        return;
                    };
                    @memcpy(nb[0..st.send_staged], st.send_buf[0..st.send_staged]);
                    if (st.send_buf.len > 0) $mod.pumpAlloc().free(st.send_buf);
                    st.send_buf = nb;
                }
                @memcpy(st.send_buf[st.send_staged..][0..drain_n], st.pending.items[st.pending_off..][0..drain_n]);
                st.send_staged += drain_n;
                drained_n = drain_n;
                st.pending_off += drain_n;
                if (st.pending_off == st.pending.items.len) {
                    st.pending.clearRetainingCapacity();
                    st.pending_off = 0;
                }
                if (st.mode == .ws) st.ws_mu.unlock();
            }
            if (st.send_plan_n > 0) {
                // Plan → iovecs: drained pending (older than the plan) goes
                // first, then plan order. BUF entries resolve against the
                // FINAL send_buf — after every grow in this window.
                var n: usize = 0;
                if (drained_n > 0) {
                    st.send_iov[0] = .{ .base = st.send_buf.ptr + drained_lo, .len = drained_n };
                    n = 1;
                }
                for (st.send_plan[0..st.send_plan_n]) |e| {
                    st.send_iov[n] = .{
                        .base = if (e.buf) st.send_buf.ptr + e.base else @ptrFromInt(e.base),
                        .len = e.len,
                    };
                    n += 1;
                }
                st.send_iov_n = n;
                st.send_iov_pos = 0;
                st.send_plan_n = 0;
                st.send_base = 0;
                st.send_staged = 0;
                st.send_date_len = 0;
                st.spill_mark = std.math.maxInt(usize);
                if (!w.submitSend(st)) {
                    st.send_iov_n = 0;
                    w.teardown(st);
                }
                return;
            }
            if (st.send_staged > 0) {
                st.send_off = st.send_base;
                st.send_base = 0;
                st.send_len = st.send_staged;
                st.send_staged = 0;
                if (!w.submitSend(st)) {
                    st.send_len = 0;
                    w.teardown(st);
                }
                return;
            }
            if (st.ring_dead or (st.len == st.buf.len and !$mod.growReqBuf(st))) {
                w.teardown(st);
                return;
            }
            if (!w.submitRecv(st)) w.teardown(st);
        }

        fn handleCqe(w: *@This(), cqe: linux.io_uring_cqe) void {
            const ud = cqe.user_data;
            if (ud == $mod.URING_ACCEPT or ud == $mod.URING_ACCEPT_TLS or ud == $mod.URING_ACCEPT_H2C or ud == $mod.URING_ACCEPT_H2TLS) {
                const is_tls = ud == $mod.URING_ACCEPT_TLS;
                const is_h2c = ud == $mod.URING_ACCEPT_H2C;
                const is_h2tls = ud == $mod.URING_ACCEPT_H2TLS;
                const accept_fd = if (is_tls) w.tls_listen_fd else if (is_h2c) w.h2c_listen_fd else if (is_h2tls) w.h2_tls_listen_fd else w.listen_fd;
                // Multishot: this one SQE reaps the whole connect storm.
                // F_MORE cleared means the op retired — re-arm it once.
                if (cqe.res >= 0) {
                    const cfd: $mod.posix.fd_t = @intCast(cqe.res);
                    $mod.disableNagle(cfd);
                    $mod.armBusyPoll(cfd);
                    // Multishot recv terminates at the first delivery on a
                    // blocking fd — the kernel cannot wait for more without
                    // a poll arm. O_NONBLOCK keeps it armed across CQEs.
                    $mod.markNonBlocking(cfd);
                    if ($mod.connState(cfd)) |st| {
                        st.len = 0;
                        st.owner_ring = @ptrCast(w);
                        var ready = true;
                        if (is_h2c or is_h2tls) st.mode = .h2c;
                        if (is_tls or is_h2tls) {
                            // Socket-BIO SSL — OpenSSL keeps the wire, the
                            // ring supplies readiness. ENABLE_KTLS on the ctx
                            // hands the record layer to the kernel at
                            // handshake end where the host supports it. The
                            // h2-TLS leg handshakes on its own ctx — the one
                            // with the h2-only ALPN policy.
                            const ctx = if (is_h2tls) $mod.h2_tls_server_ctx else $mod.tls_server_ctx;
                            st.ssl = if (ctx) |hctx| $mod.beginTlsHandshakeSockCtx(@intCast(cfd), hctx) else null;
                            if (st.ssl == null) {
                                // A failed begin already closed cfd — keep
                                // teardown from closing it twice.
                                st.fd = -1;
                                ready = false;
                            } else {
                                st.tls_hs = true;
                                st.tls_sockbio = true;
                            }
                        }
                        // A TLS conn's first op is a poll arm for the
                        // handshake's next flight; cleartext goes straight
                        // to the recv pool.
                        if (ready) {
                            if (st.tls_sockbio) {
                                if (!w.submitPoll(st, @intCast($mod.POLLIN))) w.teardown(st);
                            } else if (!w.submitRecv(st)) {
                                w.teardown(st);
                            }
                        } else {
                            w.teardown(st);
                        }
                    } else {
                        $mod.posix.close(cfd);
                    }
                }
                if (cqe.flags & linux.IORING_CQE_F_MORE == 0) {
                    // The acceptor retired — a worker without one is a dead
                    // quarter of the port (SO_REUSEPORT keeps hashing conns
                    // to it), so a full SQ is not an acceptable answer: push
                    // what's staged and try again.
                    _ = w.ring.accept_multishot(ud, accept_fd, null, null, 0) catch {
                        _ = w.ring.submit() catch {};
                        _ = w.ring.accept_multishot(ud, accept_fd, null, null, 0) catch {};
                    };
                }
                return;
            }

            const st = cqeConn(ud);
            if (ud & TAG_SEND != 0) {
                if (cqe.res <= 0) {
                    st.send_len = 0;
                    st.send_iov_n = 0;
                    w.teardown(st);
                    return;
                }
                if (st.send_iov_n > 0) {
                    // Walk the written bytes across the iovec list; resubmit
                    // with whatever pos/remainder is left.
                    var rem: usize = @intCast(cqe.res);
                    var pos = st.send_iov_pos;
                    while (rem > 0 and pos < st.send_iov_n) {
                        const l = st.send_iov[pos].len;
                        if (rem >= l) {
                            rem -= l;
                            pos += 1;
                        } else {
                            st.send_iov[pos].base += rem;
                            st.send_iov[pos].len -= rem;
                            rem = 0;
                        }
                    }
                    st.send_iov_pos = pos;
                    if (pos < st.send_iov_n) {
                        if (!w.submitSend(st)) {
                            st.send_iov_n = 0;
                            w.teardown(st);
                        }
                        return;
                    }
                    st.send_iov_n = 0;
                    st.send_iov_pos = 0;
                    w.advance(st);
                    return;
                }
                st.send_off += @intCast(cqe.res);
                if (st.send_off < st.send_len) {
                    // Partial send — resubmit the remainder, still in flight.
                    if (!w.submitSend(st)) {
                        st.send_len = 0;
                        w.teardown(st);
                    }
                    return;
                }
                st.send_len = 0;
                st.send_off = 0;
                w.advance(st);
                return;
            }

            if (ud & TAG_POLL != 0) {
                st.poll_armed = false;
                w.pollCqe(st, cqe);
                return;
            }

            // recv completion. recv_armed means the conn's bytes ride the
            // provided-buffer pool — the CQE names a buffer id, not a place
            // we chose. Socket-BIO TLS conns take no recv SQEs at all; any
            // conn reaching here is cleartext or kTLS-offloaded, and its
            // plaintext lands in st.buf. Both are one-shot: the op is consumed.
            if (st.recv_armed) {
                w.msRecvCqe(st, cqe);
                return;
            }
            if (cqe.res <= 0 or st.ring_dead) {
                w.teardown(st);
                return;
            }
            st.len += @intCast(cqe.res);
            w.dispatchReadable(st);
            w.advance(st);
        }

        // A multishot recv CQE: res bytes sit in pool buffer `buffer_id`,
        // IORING_CQE_F_MORE says the op stays armed. Bytes join st.buf (older
        // recv_hold overflow first — pipelined ordering is a stream invariant),
        // the pool buffer goes straight back, and dispatch runs on the same
        // contiguous view the other pumps have.
        fn msRecvCqe(w: *@This(), st: *$mod.ConnState, cqe: linux.io_uring_cqe) void {
            if (!w.ms_seen) {
                w.ms_seen = true;
                std.debug.print("Pump: multishot recv live on provided buffers\n", .{});
            }
            const bg = w.bufgrp.?;
            // ring_dead set BY this CQE's dispatch (Connection: close, a dead
            // ws frame) must still reach advance() — the staged response has
            // to flush before the fd drops. Only a conn already dead on
            // arrival tears down without draining.
            const pre_dead = st.ring_dead;
            var dispatched = false;
            if (cqe.res > 0) {
                const n: usize = @intCast(cqe.res);
                if (cqe.buffer_id()) |bid| {
                    const buf = bg.sliceAt(bid, n);
                    if (!pre_dead and st.len == 0 and st.recv_hold.items.len == 0 and st.mode != .ws) {
                        // Dispatch where the kernel left the bytes: a request
                        // fully inside the pool buffer never touches st.buf —
                        // only a request straddling this buffer's end parks
                        // its tail there. x.raw borrows `buf` for arrived()
                        // exactly as it borrows st.buf on every other pump,
                        // so the buffer must not rejoin the pool until the
                        // dispatch below is done.
                        const consumed = w.dispatchHttpSlice(st, buf);
                        dispatched = true;
                        if (consumed < buf.len and !st.ring_dead) {
                            const tail = buf[consumed..];
                            if (tail.len > st.buf.len) {
                                while (st.buf.len < tail.len and $mod.growReqBuf(st)) {}
                                if (tail.len > st.buf.len) st.ring_dead = true;
                            }
                            if (tail.len <= st.buf.len and !st.ring_dead) {
                                @memcpy(st.buf[0..tail.len], tail);
                                st.len = tail.len;
                            }
                        }
                    } else {
                        w.drainRecvHold(st);
                        const room = st.buf.len - st.len;
                        const fit = @min(room, n);
                        @memcpy(st.buf[st.len..][0..fit], buf[0..fit]);
                        st.len += fit;
                        if (n > fit) {
                            st.recv_hold.appendSlice($mod.pumpAlloc(), buf[fit..n]) catch {
                                st.ring_dead = true;
                            };
                        }
                    }
                } else |_| {
                    // A buffer id we cannot resolve means lost wire bytes —
                    // the stream is desynced, so the conn cannot continue.
                    st.ring_dead = true;
                }
            }
            // The buffer goes back whenever the kernel consumed one — F_BUFFER,
            // not res, is the signal. A terminal CQE (EOF, error) can still
            // carry a consumed buffer; gating release on res>0 leaks one per
            // conn close, and churn drains the pool into ENOBUFS collapse.
            if (cqe.flags & linux.IORING_CQE_F_BUFFER != 0) bg.release(cqe);
            if (cqe.flags & linux.IORING_CQE_F_MORE == 0) st.recv_armed = false;
            if (pre_dead or cqe.res == 0) {
                w.teardown(st);
                return;
            }
            if (cqe.res < 0) {
                // -ENOBUFS means the pool ran dry mid-storm: the op retired
                // with nothing lost (the kernel kept the bytes), and advance
                // re-arms. Anything else kills the conn.
                if (cqe.res == -@as(i32, @intFromEnum(linux.E.NOBUFS))) {
                    // Pool ran dry — re-arming instantly would just bounce
                    // ENOBUFS forever. Finish the conn on one-shot recvs.
                    st.ms_off = true;
                    w.advance(st);
                    return;
                }
                w.teardown(st);
                return;
            }
            if (!dispatched) w.dispatchReadable(st);
            w.drainRecvHold(st);
            w.advance(st);
        }

        // recv_hold is overflow from a pool buffer that out-ran st.buf's
        // remaining room — parked bytes, older than anything still on the
        // wire. Each dispatch may free room; drain what fits and re-dispatch
        // until the hold empties or the buffer genuinely fills.
        fn drainRecvHold(w: *@This(), st: *$mod.ConnState) void {
            while (!st.ring_dead and (st.len < st.buf.len or $mod.growReqBuf(st)) and st.recv_hold_off < st.recv_hold.items.len) {
                const room = st.buf.len - st.len;
                const avail = st.recv_hold.items.len - st.recv_hold_off;
                const n = @min(room, avail);
                @memcpy(st.buf[st.len..][0..n], st.recv_hold.items[st.recv_hold_off..][0..n]);
                st.len += n;
                st.recv_hold_off += n;
                if (st.recv_hold_off == st.recv_hold.items.len) {
                    st.recv_hold.clearRetainingCapacity();
                    st.recv_hold_off = 0;
                }
                w.dispatchReadable(st);
            }
        }

        // Answer every complete request (or frame, once upgraded) already
        // sitting in st.buf — the same helpers the other pumps use, so a
        // browser is handled identically here. Replies stage in send_buf and
        // leave as one send SQE per readable batch.
        fn dispatchReadable(w: *@This(), st: *$mod.ConnState) void {
            // Upgraded connection: frames, not requests — same seam as the
            // kqueue pump's `st.mode == .ws` block; the re-arm is the next
            // submitted SQE rather than a readiness re-arm.
            if (st.mode == .ws) {
                var ws_consumed: usize = 0;
                var ws_alive = true;
                while (ws_consumed < st.len) {
                    const item = $mod.wsNext(st, &ws_consumed) orelse break;
                    switch (item) {
                        .ping => |pl| {
                            if (!$mod.wsSendFrame(st, 0xA, pl)) ws_alive = false;
                        },
                        .close => |pl| {
                            _ = $mod.wsSendFrame(st, 0x8, pl);
                            ws_alive = false;
                        },
                        .dead => ws_alive = false,
                        .message => |m| {
                            var fx = $mod.Exchange{ .fd = st.fd, .st = st, .raw = m.payload, .opcode = m.op };
                            frame(&fx);
                            st.ws_msg.clearRetainingCapacity();
                            if (!fx.keep_alive) ws_alive = false;
                        },
                    }
                    if (!ws_alive) break;
                }
                st.len = $mod.retainTail(st.buf, st.len, ws_consumed);
                if (ws_alive and st.len == st.buf.len) ws_alive = $mod.growReqBuf(st);
                if (!ws_alive) st.ring_dead = true;
                return;
            }

            const consumed = w.dispatchHttpSlice(st, st.buf[0..st.len]);
            st.len = $mod.retainTail(st.buf, st.len, consumed);
            if (!st.ring_dead and st.len == st.buf.len and !$mod.growReqBuf(st)) st.ring_dead = true;
        }

        // A poll CQE on a socket-BIO TLS conn. Handshake-era CQEs step
        // SSL_accept; at `.ready` the ctx's ENABLE_KTLS option has already
        // tried the offload — sslKtlsState reads what the kernel kept.
        // Offloaded: free the SSL, the conn goes cleartext and advance arms
        // the buffer pool. Still userspace: the conn lives on poll +
        // SSL_read/SSL_write, with owed output flushed before new reads —
        // the same ordering advance() keeps for cleartext.
        fn pollCqe(w: *@This(), st: *$mod.ConnState, cqe: linux.io_uring_cqe) void {
            if (st.ring_dead or cqe.res < 0) {
                w.teardown(st);
                return;
            }
            const revents: u32 = @intCast(cqe.res);
            if (st.tls_hs) {
                const mod = @import("root").koru_koru.koru_openssl;
                switch ($mod.driveTlsHandshake(st)) {
                    .ready => {
                        st.tls_hs = false;
                        if (mod.sslKtlsState(@intCast(st.fd)) == .offloaded) {
                            // A request pipelined inside the handshake flight
                            // may already sit decrypted in OpenSSL's buffers —
                            // freeing the SSL would drop those bytes and hang
                            // the conn. Drain before the cleartext transition;
                            // want_read means OpenSSL is holding nothing.
                            const tls = st.ssl.?;
                            if (tls.ssl) |s| {
                                while (st.len < st.buf.len or $mod.growReqBuf(st)) {
                                    switch (mod.sslMemRead(s, st.buf[st.len..])) {
                                        .read => |n| st.len += n,
                                        else => break,
                                    }
                                }
                                mod.sslFreeNoShutdown(s);
                            }
                            tls.allocator.destroy(tls);
                            st.ssl = null;
                            st.tls_sockbio = false;
                            st.ktls_on = true;
                            if (st.len > 0) w.dispatchReadable(st);
                            w.advance(st);
                            return;
                        }
                    },
                    .want_read => {
                        if (!w.submitPoll(st, @intCast($mod.POLLIN))) w.teardown(st);
                        return;
                    },
                    .want_write => {
                        if (!w.submitPoll(st, @intCast($mod.POLLIN | $mod.POLLOUT))) w.teardown(st);
                        return;
                    },
                    .failed => {
                        w.teardown(st);
                        return;
                    },
                }
            }
            // Steady state on userspace crypto. Output owed to the cipher
            // goes first — the queue's ordering is the wire's.
            if ($mod.pendingLen(st) > 0) {
                switch ($mod.flushPending(st)) {
                    .dead => {
                        w.teardown(st);
                        return;
                    },
                    .stalled => {
                        if (!w.submitPoll(st, @intCast($mod.POLLIN | $mod.POLLOUT))) w.teardown(st);
                        return;
                    },
                    .drained => {},
                }
            }
            // Error bits without POLLIN still need a read attempt: SSL_read
            // is how EOF and peer errors surface to the conn at all — skipping
            // it would re-arm a dead fd's poll forever.
            if (revents & @as(u32, @intCast($mod.POLLIN | $mod.POLLHUP | $mod.POLLERR | $mod.POLLNVAL)) != 0)
                w.sockbioRead(st);
            w.advance(st);
        }

        // SSL_read until the cipher wants more wire — st.buf fills with
        // plaintext exactly as a cleartext recv would leave it, so the
        // shared dispatch sees one shape. sslMemRead is SSL_read with a
        // count; the name is a leftover from the memory-BIO pump.
        fn sockbioRead(w: *@This(), st: *$mod.ConnState) void {
            const mod = @import("root").koru_koru.koru_openssl;
            const s = st.ssl.?.ssl orelse {
                st.ring_dead = true;
                return;
            };
            while (st.len < st.buf.len or $mod.growReqBuf(st)) {
                switch (mod.sslMemRead(s, st.buf[st.len..])) {
                    .read => |n| {
                        st.len += n;
                        // Retry only while OpenSSL still holds buffered
                        // record data — a bare retry buys one read() that
                        // can only EAGAIN. Ciphertext the kernel is still
                        // holding re-fires POLLIN on the re-arm.
                        if (!mod.sslHasUnprocessed(s)) break;
                    },
                    .want_read => break,
                    .gone, .failed => {
                        st.ring_dead = true;
                        break;
                    },
                }
            }
            w.dispatchReadable(st);
        }

        // A socket-BIO conn's next op: queued plaintext through SSL_write,
        // then a poll arm. There is no send SQE — OpenSSL owns the fd —
        // so "send in flight" is a stalled flush, not an outstanding CQE.
        fn advanceSockBio(w: *@This(), st: *$mod.ConnState) void {
            if ($mod.pendingLen(st) > 0) {
                switch ($mod.flushPending(st)) {
                    .dead => {
                        w.teardown(st);
                        return;
                    },
                    .stalled => {
                        if (!w.submitPoll(st, @intCast($mod.POLLIN | $mod.POLLOUT))) w.teardown(st);
                        return;
                    },
                    .drained => {},
                }
            }
            if (st.ring_dead or (st.len == st.buf.len and !$mod.growReqBuf(st))) {
                w.teardown(st);
                return;
            }
            if (!w.submitPoll(st, @intCast($mod.POLLIN))) w.teardown(st);
        }

        // The request-dispatch loop, source-agnostic: `bytes` may be the
        // st.buf prefix or a checked-out pool buffer — x.raw borrows either
        // for the duration of arrived() only, which is the same contract
        // ConnState.buf borrows carry today. Returns bytes consumed; a dying
        // conn sets st.ring_dead rather than reporting it out of band.
        fn dispatchHttpSlice(w: *@This(), st: *$mod.ConnState, bytes: []const u8) usize {
            _ = w;
            if (!st.preface_checked) {
                switch ($mod.h2cSniffPreface(bytes)) {
                    .h2c => { st.mode = .h2c; st.preface_checked = true; },
                    .h1 => st.preface_checked = true,
                    // A strict prefix of the client preface could still grow
                    // into it — consume nothing until the read is decisive.
                    .wait => return 0,
                }
            }
            if (st.mode == .h2c) {
                const taken = $mod.h2cProcess(st, bytes);
                // Completions queue inside h2cProcess — the `arrived` arm
                // only binds in ~proc scope, so they fire here.
                while ($mod.h2cPopReady(st)) |r| {
                    var head_pairs: [$mod.HEAD_PAIRS_MAX]$mod.HeadPair = undefined;
                    var head: $mod.Head = .{ .pairs = &head_pairs };
                    _ = $mod.scanRequest(r.raw, &head) orelse {
                        $mod.pumpAlloc().free(r.raw);
                        continue;
                    };
                    var exchange = $mod.Exchange{ .fd = st.fd, .st = st, .raw = r.raw, .head = &head, .h2_stream = r.stream_id };
                    arrived(&exchange);
                    $mod.pumpAlloc().free(r.raw);
                }
                return taken;
            }
            st.batching = true;
            var consumed: usize = 0;
            var alive = true;
            var head_pairs: [$mod.HEAD_PAIRS_MAX]$mod.HeadPair = undefined;
            while (consumed < bytes.len) {
                var head: $mod.Head = .{ .pairs = &head_pairs };
                const take = $mod.scanRequest(bytes[consumed..], &head) orelse break;
                var exchange = $mod.Exchange{ .fd = st.fd, .st = st, .raw = bytes[consumed .. consumed + take], .head = &head };
                if (head.wants_close) exchange.keep_alive = false;
                arrived(&exchange);
                consumed += take;
                if (!exchange.keep_alive) {
                    alive = false;
                    break;
                }
            }
            st.batching = false;
            if (!alive) st.ring_dead = true;
            return consumed;
        }

        fn run(port_: u16) void {
            // Ring + listener are created on the worker thread itself —
            // SINGLE_ISSUER wants the ring owned by the thread that drives it.
            const ring = linux.IoUring.init($mod.URING_ENTRIES, linux.IORING_SETUP_SINGLE_ISSUER | linux.IORING_SETUP_DEFER_TASKRUN) catch
                linux.IoUring.init($mod.URING_ENTRIES, 0) catch {
                    // Say which io_uring is missing, because there are two very
                    // different reasons and they need opposite responses: an old
                    // kernel, or a container seccomp profile blocking
                    // io_uring_setup on a modern one.
                    std.debug.print("Pump: io_uring refused — io_uring_setup failed (seccomp? try --security-opt seccomp=unconfined; kernel <5.1?; RLIMIT_MEMLOCK?)\n", .{});
                    return;
                };
            const listen_fd = $mod.openReusePortListener(port_) orelse {
                std.debug.print("Pump: io_uring worker failed to listen on :{}\n", .{port_});
                return;
            };
            // A second reuseport listener when TLS is configured — same ring,
            // same machinery, a different UD so accepted conns start as
            // socket-BIO handshakes instead of cleartext reads.
            const tls_listen_fd: $mod.posix.fd_t = if ($mod.tls_listen_port != 0)
                $mod.openReusePortListener($mod.tls_listen_port) orelse {
                    std.debug.print("Pump: io_uring worker failed to listen on :{}\n", .{$mod.tls_listen_port});
                    return;
                }
            else
                -1;
            const h2c_listen_fd: $mod.posix.fd_t = if ($mod.h2c_listen_port != 0)
                $mod.openReusePortListener($mod.h2c_listen_port) orelse
                    std.debug.panic("Pump: io_uring worker failed to listen on :{}\n", .{$mod.h2c_listen_port})
            else -1;
            const h2_tls_listen_fd: $mod.posix.fd_t = if ($mod.h2_tls_listen_port != 0)
                $mod.openReusePortListener($mod.h2_tls_listen_port) orelse {
                    std.debug.print("Pump: io_uring worker failed to listen on :{}\n", .{$mod.h2_tls_listen_port});
                    return;
                }
            else
                -1;
            var w = @This(){ .ring = ring, .listen_fd = listen_fd, .tls_listen_fd = tls_listen_fd, .h2c_listen_fd = h2c_listen_fd, .h2_tls_listen_fd = h2_tls_listen_fd };
            // 1024 pool buffers of 8K per worker — far more than the deepest
            // CQE batch (512) can hold hostage, since each buffer is recycled
            // the moment its CQE is processed. Requests bigger than a buffer
            // simply arrive as several CQEs; st.buf accumulates them.
            var bg_store: ?Pool = Pool.init(&w.ring, 8192, 1024) catch |e| blk: {
                std.debug.print("Pump: provided-buffer pool refused ({s}) — conns use one-shot recv\n", .{@errorName(e)});
                break :blk null;
            };
            if (bg_store) |*bg| {
                w.bufgrp = bg;
                std.debug.print("Pump: buffer pool armed\n", .{});
            }
            _ = w.ring.accept_multishot($mod.URING_ACCEPT, listen_fd, null, null, 0) catch {
                std.debug.print("Pump: io_uring accept arm failed\n", .{});
                return;
            };
            if (h2c_listen_fd >= 0) {
                _ = w.ring.accept_multishot($mod.URING_ACCEPT_H2C, h2c_listen_fd, null, null, 0) catch {
                    std.debug.print("Pump: io_uring h2c accept arm failed\n", .{});
                    return;
                };
            }
            if (h2_tls_listen_fd >= 0) {
                _ = w.ring.accept_multishot($mod.URING_ACCEPT_H2TLS, h2_tls_listen_fd, null, null, 0) catch {
                    std.debug.print("Pump: io_uring h2-TLS accept arm failed\n", .{});
                    return;
                };
            }
            if (tls_listen_fd >= 0) {
                _ = w.ring.accept_multishot($mod.URING_ACCEPT_TLS, tls_listen_fd, null, null, 0) catch {
                    std.debug.print("Pump: io_uring TLS accept arm failed\n", .{});
                    return;
                };
            }

            // Bounded waits need IORING_FEAT_EXT_ARG (kernel 5.11+); without
            // it the only safe bound is one completion, so coalescing stays
            // off and every wait is the plain single-CQE park.
            const coalesce_max: u32 = if (w.ring.features & linux.IORING_FEAT_EXT_ARG != 0) WAIT_COALESCE_MAX else 1;

            var wait_nr: u32 = 1;
            var cqes: [CQE_BATCH]linux.io_uring_cqe = undefined;
            while (true) {
                // A parked conn emits no CQE — when the list is non-empty the
                // wait must be bounded by its deadline, even when the batch
                // shape would otherwise park on a single completion forever.
                const park_ms = $mod.parkMsUntilDue();
                if (park_ms == std.math.maxInt(i64)) {
                    if (wait_nr > 1) {
                        $mod.ringWaitTimeout(&w.ring, wait_nr, WAIT_COALESCE_NS) catch continue;
                    } else {
                        _ = w.ring.submit_and_wait(1) catch continue;
                    }
                } else {
                    const park_ns = park_ms *% std.time.ns_per_ms;
                    const ns = if (wait_nr > 1) @min(WAIT_COALESCE_NS, park_ns) else park_ns;
                    $mod.ringWaitTimeout(&w.ring, @max(wait_nr, 1), ns) catch continue;
                }
                const got = w.ring.copy_cqes(&cqes, 0) catch continue;
                // Due parked conns re-enter here — park_until already cleared,
                // so advance picks their staged pending up as the next send SQE.
                while ($mod.parkDue()) |pst| {
                    w.advance(pst);
                }
                @import("root").koru_orisha.stampHttpDateLine();
                var i: usize = 0;
                for (cqes[0..got]) |cqe| {
                    i += 1;
                    if (i % SUBMIT_STRIDE == 0) _ = w.ring.submit() catch {};
                    w.handleCqe(cqe);
                }
                // Ride the size of the last drain: a deep batch means more
                // completions are already in flight, so the next enter can
                // afford to wait for several; a shallow one decays back to
                // single-completion waits within a pass.
                wait_nr = @min(@max(@as(u32, @intCast(got / 2)), 1), coalesce_max);
            }
        }
    };

    var spawned: usize = 0;
    while (spawned + 1 < n_workers) : (spawned += 1) {
        _ = std.Thread.spawn(.{}, W.run, .{port}) catch break;
    }
    std.debug.print("Orisha listening on http://0.0.0.0:{}\n", .{port});
    std.debug.print("Pump: io_uring, {} workers (ring + listener each), keep-alive, TCP_NODELAY\n", .{spawned + 1});
    W.run(port);

    return .{ .stopped = "Server stopped" };
}

// ---------------------------------------------------------------------------
// race — h1-only io_uring, minimal machinery. Selected by `--build=race`.
//
// Same ring shape as drive|io-uring (single-issuer, DEFER_TASKRUN, provided-
// buffer multishot recv, multishot accept) with everything the h1 arena path
// does not need removed: no TLS/socket-BIO, no h2c, no ws frames, no parked-
// conn deadlines. Dispatch and the send path reuse the same ConnState and
// staging fields — the difference is the absence of the branches, not a
// second implementation of them.
// ---------------------------------------------------------------------------

~proc drive|race {
    if (@import("builtin").os.tag != .linux) {
        return .{ .failed = "io_uring is a Linux mechanism — build with --build=linux for this host" };
    }

    $mod.ignoreSigpipe();

    const linux = std.os.linux;
    const n_workers = $mod.workerCount();

    const W = struct {
        const TAG_SEND: u64 = 1;
        const CQE_BATCH = 512;
        const SUBMIT_STRIDE = 16; // push staged SQEs every N completions in a deep batch
        // Coalesced completion wait, same policy as drive|io-uring.
        const WAIT_COALESCE_MAX: u32 = 32;
        const WAIT_COALESCE_NS: i64 = 20_000;

        ring: linux.IoUring,
        listen_fd: $mod.posix.fd_t,
        // Provided-buffer pool for multishot recv — same design as
        // drive|io-uring's: a plain (non-incremental) ring so each CQE is one
        // fresh buffer. Null when registration is refused; conns then fall
        // back to one-shot st.buf recvs.
        bufgrp: ?*Pool = null,
        ms_seen: bool = false,
        // The worker's db conn — null when PG_HOST is unreachable at
        // startup; /db then falls through to the app's own handler.
        pg: ?*$mod.PgConn = null,

        const Pool = struct {
            ring: *linux.IoUring,
            buffers: []u8,
            br: *linux.io_uring_buf_ring,
            mask: u16,
            size: u32,

            fn init(ring: *linux.IoUring, size: u32, count: u16) !Pool {
                const buffers = try $mod.pumpAlloc().alloc(u8, @as(usize, size) * count);
                errdefer $mod.pumpAlloc().free(buffers);
                const br = try linux.IoUring.setup_buf_ring(ring.fd, count, 1, .{ .inc = false });
                linux.IoUring.buf_ring_init(br);
                const mask = linux.IoUring.buf_ring_mask(count);
                var i: u16 = 0;
                while (i < count) : (i += 1) {
                    const pos = @as(usize, size) * i;
                    linux.IoUring.buf_ring_add(br, buffers[pos .. pos + size], i, mask, i);
                }
                linux.IoUring.buf_ring_advance(br, count);
                return .{ .ring = ring, .buffers = buffers, .br = br, .mask = mask, .size = size };
            }

            fn arm(p: *Pool, user_data: u64, fd: $mod.posix.fd_t) !*linux.io_uring_sqe {
                const sqe = try p.ring.get_sqe();
                sqe.prep_rw(.RECV, fd, 0, 0, 0);
                sqe.flags |= linux.IOSQE_BUFFER_SELECT;
                sqe.buf_index = 1;
                sqe.user_data = user_data;
                sqe.ioprio |= linux.IORING_RECV_MULTISHOT;
                return sqe;
            }

            fn sliceAt(p: *Pool, buffer_id: u16, n: usize) []u8 {
                const pos = @as(usize, p.size) * buffer_id;
                return p.buffers[pos .. pos + n];
            }

            fn release(p: *Pool, cqe: linux.io_uring_cqe) void {
                const bid = cqe.buffer_id() catch return;
                const pos = @as(usize, p.size) * bid;
                linux.IoUring.buf_ring_add(p.br, p.buffers[pos .. pos + p.size], bid, p.mask, 0);
                linux.IoUring.buf_ring_advance(p.br, 1);
            }
        };

        fn udSend(st: *$mod.ConnState) u64 {
            return @intFromPtr(st) | TAG_SEND;
        }

        fn cqeConn(ud: u64) *$mod.ConnState {
            return @ptrFromInt(@as(usize, @intCast(ud & ~@as(u64, 3))));
        }

        // Same two-step as drive|io-uring: detach + close now, st freed once
        // the armed recv's terminal CQE retires it. No TLS, no ws pushers.
        fn teardown(w: *@This(), st: *$mod.ConnState) void {
            if (!st.ring_closing) {
                st.ring_closing = true;
                st.ring_dead = true;
                if (st.fd >= 0) {
                    $mod.detachConn(st.fd);
                    $mod.posix.shutdown(@intCast(st.fd), .both) catch {};
                    $mod.posix.close(@intCast(st.fd));
                    st.fd = -1;
                }
            }
            w.maybeFreeRing(st);
        }

        fn maybeFreeRing(w: *@This(), st: *$mod.ConnState) void {
            _ = w;
            if (!st.ring_closing or st.recv_armed or st.poll_armed or st.send_len != 0) return;
            st.ws_mu.lock();
            $mod.closeConnMem(st);
            st.ws_mu.unlock();
            $mod.pumpAlloc().destroy(st);
        }

        fn submitRecv(w: *@This(), st: *$mod.ConnState) bool {
            if (st.recv_armed) return true;
            if (w.bufgrp) |bg| {
                if (!st.ms_off) {
                    _ = bg.arm(@intFromPtr(st), st.fd) catch {
                        _ = w.ring.submit() catch {};
                        _ = bg.arm(@intFromPtr(st), st.fd) catch return false;
                    };
                    st.recv_armed = true;
                    return true;
                }
            }
            const buf = st.buf[st.len..];
            _ = w.ring.recv(@intFromPtr(st), st.fd, .{ .buffer = buf }, 0) catch {
                _ = w.ring.submit() catch {};
                _ = w.ring.recv(@intFromPtr(st), st.fd, .{ .buffer = buf }, 0) catch return false;
            };
            return true;
        }

        fn submitSend(w: *@This(), st: *$mod.ConnState) bool {
            if (st.send_iov_n > 0) {
                _ = w.ring.writev(udSend(st), st.fd, st.send_iov[st.send_iov_pos..st.send_iov_n], 0) catch {
                    _ = w.ring.submit() catch {};
                    _ = w.ring.writev(udSend(st), st.fd, st.send_iov[st.send_iov_pos..st.send_iov_n], 0) catch return false;
                };
                return true;
            }
            // MSG_MORE measured catastrophic here (-97%): a corked send stalls
            // the pipeline — the response sits unpushed until autocork expiry
            // and the client waits on it before refilling the window.
            _ = w.ring.send(udSend(st), st.fd, st.send_buf[st.send_off..st.send_len], linux.MSG.NOSIGNAL) catch {
                _ = w.ring.submit() catch {};
                _ = w.ring.send(udSend(st), st.fd, st.send_buf[st.send_off..st.send_len], linux.MSG.NOSIGNAL) catch return false;
            };
            return true;
        }

        // Next-op selection, h1 only: staged output outranks new reads — a
        // burst of pipelined replies coalesces into one send — then recv.
        // No parks, no socket-BIO, no ws lock.
        fn advance(w: *@This(), st: *$mod.ConnState) void {
            if (st.send_len != 0 or st.send_iov_n != 0) return;
            const pn = $mod.pendingLen(st);
            const drain_n = if (st.spill_mark == std.math.maxInt(usize))
                pn
            else
                @min(pn, st.spill_mark -| st.pending_off);
            var drained_lo: usize = 0;
            var drained_n: usize = 0;
            if (drain_n > 0) {
                drained_lo = st.send_staged;
                const room = st.send_staged + drain_n;
                if (st.send_buf.len < room) {
                    const nb = $mod.pumpAlloc().alloc(u8, @max(4096, st.send_buf.len * 2, room)) catch {
                        w.teardown(st);
                        return;
                    };
                    @memcpy(nb[0..st.send_staged], st.send_buf[0..st.send_staged]);
                    if (st.send_buf.len > 0) $mod.pumpAlloc().free(st.send_buf);
                    st.send_buf = nb;
                }
                @memcpy(st.send_buf[st.send_staged..][0..drain_n], st.pending.items[st.pending_off..][0..drain_n]);
                st.send_staged += drain_n;
                drained_n = drain_n;
                st.pending_off += drain_n;
                if (st.pending_off == st.pending.items.len) {
                    st.pending.clearRetainingCapacity();
                    st.pending_off = 0;
                }
            }
            if (st.send_plan_n > 0) {
                var n: usize = 0;
                if (drained_n > 0) {
                    st.send_iov[0] = .{ .base = st.send_buf.ptr + drained_lo, .len = drained_n };
                    n = 1;
                }
                for (st.send_plan[0..st.send_plan_n]) |e| {
                    st.send_iov[n] = .{
                        .base = if (e.buf) st.send_buf.ptr + e.base else @ptrFromInt(e.base),
                        .len = e.len,
                    };
                    n += 1;
                }
                st.send_iov_n = n;
                st.send_iov_pos = 0;
                st.send_plan_n = 0;
                st.send_base = 0;
                st.send_staged = 0;
                st.send_date_len = 0;
                st.spill_mark = std.math.maxInt(usize);
                if (!w.submitSend(st)) {
                    st.send_iov_n = 0;
                    w.teardown(st);
                }
                return;
            }
            if (st.send_staged > 0) {
                st.send_off = st.send_base;
                st.send_base = 0;
                st.send_len = st.send_staged;
                st.send_staged = 0;
                if (!w.submitSend(st)) {
                    st.send_len = 0;
                    w.teardown(st);
                }
                return;
            }
            if (st.ring_dead or (st.len == st.buf.len and !$mod.growReqBuf(st))) {
                w.teardown(st);
                return;
            }
            if (!w.submitRecv(st)) w.teardown(st);
        }

        // The conn's next response is a db row — the exchange parks here:
        // its bind joins the worker's batched tx and the conn waits for
        // PG_READ. id is a fresh world row per request.
        fn pgPark(w: *@This(), st: *$mod.ConnState, n: u32, wrap_array: bool, update: bool) void {
            const pg = w.pg.?;
            const a = $mod.pumpAlloc();
            var i: u32 = 0;
            while (i < n) : (i += 1) {
                const id = std.crypto.random.intRangeAtMost(u32, 1, 10000);
                if (update) {
                    const rn = std.crypto.random.intRangeAtMost(u32, 1, 10000);
                    pg.bindExecUpdate(id, rn);
                } else {
                    pg.bindExec(id);
                }
            }
            var wt: $mod.PgWaiter = .{ .st = st, .expected = n, .wrap_array = wrap_array };
            if (wrap_array) wt.buf.append(a, '[') catch return;
            pg.waiters.append(a, wt) catch return;
            st.pg_pending += n;
        }

        // PG_READ: drain response frames; each DataRow completes the front
        // waiter's exchange — stage its response, resume its tail scan.
        fn pgReadCqe(w: *@This(), cqe: linux.io_uring_cqe) void {
            const pg = w.pg.?;
            if (cqe.res <= 0) {
                // Lost the db conn — every parked exchange fails out.
                while (pg.waiters.items.len > 0) {
                    var rm = pg.waiters.orderedRemove(0);
                    rm.st.pg_pending = 0;
                    rm.buf.deinit($mod.pumpAlloc());
                    w.teardown(rm.st);
                }
                pg.pending_binds = 0;
                _ = w.ring.poll_add($mod.URING_PG, pg.fd, linux.POLL.IN) catch {};
                return;
            }
            // poll says readable — drain to EAGAIN
            while (true) {
                const n = $mod.posix.read(pg.fd, pg.rx[pg.rx_len..]) catch |e| switch (e) {
                    error.WouldBlock => 0,
                    else => 0,
                };
                if (n == 0) break;
                pg.rx_len += n;
            }
            while (true) {
                if (pg.msg_rem > 0) {
                    if (pg.rx_pos + pg.msg_rem <= pg.rx_len) {
                        pg.rx_pos += pg.msg_rem; pg.msg_rem = 0;
                    } else {
                        const avail = pg.rx_len - pg.rx_pos;
                        pg.rx_pos += avail; pg.msg_rem -= @intCast(avail);
                        break;
                    }
                }
                if (pg.rx_len - pg.rx_pos < 5) break;
                const t = pg.rx[pg.rx_pos];
                const mlen = std.mem.readInt(u32, pg.rx[pg.rx_pos + 1 ..][0..4], .big) - 4;
                if (pg.rx_len - (pg.rx_pos + 5) < mlen) break;
                pg.rx_pos += 5;
                if (t == 'D') {
                    // id int4-text, randomNumber int4-text
                    const ncols = std.mem.readInt(u16, pg.rx[pg.rx_pos..][0..2], .big);
                    var o = pg.rx_pos + 2;
                    var id_s: []const u8 = "0";
                    var rn_s: []const u8 = "0";
                    var ci: usize = 0;
                    while (ci < ncols) : (ci += 1) {
                        const fl = std.mem.readInt(u32, pg.rx[o..][0..4], .big);
                        o += 4;
                        if (fl == 0xFFFFFFFF) continue;
                        if (ci == 0) id_s = pg.rx[o .. o + fl];
                        if (ci == 1) rn_s = pg.rx[o .. o + fl];
                        o += fl;
                    }
                    pg.rx_pos += mlen;
                    if (pg.waiters.items.len > 0) {
                        const a = $mod.pumpAlloc();
                        const wt = &pg.waiters.items[0];
                        wt.buf.print(a, "{{\"id\":{s},\"randomNumber\":{s}}},", .{ id_s, rn_s }) catch {};
                        wt.st.pg_pending -= 1;
                        pg.pending_binds -= 1;
                        wt.expected -= 1;
                        if (wt.expected == 0) {
                            var done = pg.waiters.orderedRemove(0);
                            // strip the trailing comma; close the array
                            if (done.buf.items.len > 0 and done.buf.items[done.buf.items.len - 1] == ',')
                                done.buf.items.len -= 1;
                            if (done.wrap_array) done.buf.append(a, ']') catch {};
                            w.pgRespond(done.st, done.buf.items);
                            done.buf.deinit(a);
                        }
                    } else if (pg.pending_binds > 0) {
                        pg.pending_binds -= 1;
                    }
                } else {
                    pg.rx_pos += mlen;
                }
            }
            if (pg.rx_pos > 0) {
                std.mem.copyForwards(u8, pg.rx[0..], pg.rx[pg.rx_pos..pg.rx_len]);
                pg.rx_len -= pg.rx_pos;
                pg.rx_pos = 0;
            }
            _ = w.ring.poll_add($mod.URING_PG, pg.fd, linux.POLL.IN) catch {};
        }

        // The row resolved — stage the world JSON as the parked exchange's
        // wire response, then resume the conn's queued requests.
        fn pgRespond(w: *@This(), st: *$mod.ConnState, body: []const u8) void {
            var rb: [2048]u8 = undefined;
            const dl = @import("root").koru_orisha.httpDateLine();
            const resp = std.fmt.bufPrint(&rb,
                "HTTP/1.1 200 OK\r\nContent-Length: {}\r\nContent-Type: application/json\r\nServer: koru-orisha\r\n{s}\r\n{s}",
                .{ body.len, dl[0..], body }) catch return;
            st.pending.appendSlice($mod.pumpAlloc(), resp) catch {
                w.teardown(st);
                return;
            };
            w.advance(st);
            if (st.pg_pending == 0 and st.len > 0 and !st.ring_dead) {
                w.dispatchReadable(st);
            }
            w.advance(st);
        }

        fn handleCqe(w: *@This(), cqe: linux.io_uring_cqe) void {
            const ud = cqe.user_data;
            if (ud == $mod.URING_PG) {
                w.pgReadCqe(cqe);
                return;
            }
            if (ud == $mod.URING_ACCEPT) {
                // Multishot accept: this one SQE reaps the whole storm —
                // re-arm when F_MORE clears.
                if (cqe.res >= 0) {
                    const cfd: $mod.posix.fd_t = @intCast(cqe.res);
                    $mod.disableNagle(cfd);
                    // Multishot recv terminates at the first delivery on a
                    // blocking fd — O_NONBLOCK keeps it armed across CQEs.
                    $mod.markNonBlocking(cfd);
                    if ($mod.connState(cfd)) |st| {
                        st.len = 0;
                        st.owner_ring = @ptrCast(w);
                        if (!w.submitRecv(st)) w.teardown(st);
                    } else {
                        $mod.posix.close(cfd);
                    }
                }
                if (cqe.flags & linux.IORING_CQE_F_MORE == 0) {
                    _ = w.ring.accept_multishot(ud, w.listen_fd, null, null, 0) catch {
                        _ = w.ring.submit() catch {};
                        _ = w.ring.accept_multishot(ud, w.listen_fd, null, null, 0) catch {};
                    };
                }
                return;
            }

            const st = cqeConn(ud);
            if (ud & TAG_SEND != 0) {
                if (cqe.res <= 0) {
                    st.send_len = 0;
                    st.send_iov_n = 0;
                    w.teardown(st);
                    return;
                }
                if (st.send_iov_n > 0) {
                    var rem: usize = @intCast(cqe.res);
                    var pos = st.send_iov_pos;
                    while (rem > 0 and pos < st.send_iov_n) {
                        const l = st.send_iov[pos].len;
                        if (rem >= l) {
                            rem -= l;
                            pos += 1;
                        } else {
                            st.send_iov[pos].base += rem;
                            st.send_iov[pos].len -= rem;
                            rem = 0;
                        }
                    }
                    st.send_iov_pos = pos;
                    if (pos < st.send_iov_n) {
                        if (!w.submitSend(st)) {
                            st.send_iov_n = 0;
                            w.teardown(st);
                        }
                        return;
                    }
                    st.send_iov_n = 0;
                    st.send_iov_pos = 0;
                    w.advance(st);
                    return;
                }
                st.send_off += @intCast(cqe.res);
                if (st.send_off < st.send_len) {
                    if (!w.submitSend(st)) {
                        st.send_len = 0;
                        w.teardown(st);
                    }
                    return;
                }
                st.send_len = 0;
                st.send_off = 0;
                w.advance(st);
                return;
            }

            // recv completion: armed = multishot pool CQE naming a buffer id;
            // unarmed = one-shot st.buf recv, op consumed.
            if (st.recv_armed) {
                w.msRecvCqe(st, cqe);
                return;
            }
            if (cqe.res <= 0 or st.ring_dead) {
                w.teardown(st);
                return;
            }
            st.len += @intCast(cqe.res);
            w.dispatchReadable(st);
            w.advance(st);
        }

        // Multishot recv CQE — same contract as drive|io-uring's: dispatch in
        // place when the buffer holds a whole batch, copy the tail into
        // st.buf otherwise; buffer goes back on the F_BUFFER flag.
        fn msRecvCqe(w: *@This(), st: *$mod.ConnState, cqe: linux.io_uring_cqe) void {
            if (!w.ms_seen) {
                w.ms_seen = true;
                std.debug.print("Pump: multishot recv live on provided buffers\n", .{});
            }
            const bg = w.bufgrp.?;
            const pre_dead = st.ring_dead;
            var dispatched = false;
            if (cqe.res > 0) {
                const n: usize = @intCast(cqe.res);
                if (cqe.buffer_id()) |bid| {
                    const buf = bg.sliceAt(bid, n);
                    if (!pre_dead and st.len == 0 and st.recv_hold.items.len == 0) {
                        const consumed = w.dispatchH1(st, buf);
                        dispatched = true;
                        if (consumed < buf.len and !st.ring_dead) {
                            const tail = buf[consumed..];
                            if (tail.len > st.buf.len) {
                                while (st.buf.len < tail.len and $mod.growReqBuf(st)) {}
                                if (tail.len > st.buf.len) st.ring_dead = true;
                            }
                            if (tail.len <= st.buf.len and !st.ring_dead) {
                                @memcpy(st.buf[0..tail.len], tail);
                                st.len = tail.len;
                            }
                        }
                    } else {
                        w.drainRecvHold(st);
                        const room = st.buf.len - st.len;
                        const fit = @min(room, n);
                        @memcpy(st.buf[st.len..][0..fit], buf[0..fit]);
                        st.len += fit;
                        if (n > fit) {
                            st.recv_hold.appendSlice($mod.pumpAlloc(), buf[fit..n]) catch {
                                st.ring_dead = true;
                            };
                        }
                    }
                } else |_| {
                    st.ring_dead = true;
                }
            }
            // The buffer goes back whenever the kernel consumed one —
            // F_BUFFER, not res, is the signal.
            if (cqe.flags & linux.IORING_CQE_F_BUFFER != 0) bg.release(cqe);
            if (cqe.flags & linux.IORING_CQE_F_MORE == 0) st.recv_armed = false;
            if (pre_dead or cqe.res == 0) {
                w.teardown(st);
                return;
            }
            if (cqe.res < 0) {
                if (cqe.res == -@as(i32, @intFromEnum(linux.E.NOBUFS))) {
                    st.ms_off = true;
                    w.advance(st);
                    return;
                }
                w.teardown(st);
                return;
            }
            if (!dispatched) w.dispatchReadable(st);
            w.drainRecvHold(st);
            w.advance(st);
        }

        fn drainRecvHold(w: *@This(), st: *$mod.ConnState) void {
            while (!st.ring_dead and (st.len < st.buf.len or $mod.growReqBuf(st)) and st.recv_hold_off < st.recv_hold.items.len) {
                const room = st.buf.len - st.len;
                const avail = st.recv_hold.items.len - st.recv_hold_off;
                const n = @min(room, avail);
                @memcpy(st.buf[st.len..][0..n], st.recv_hold.items[st.recv_hold_off..][0..n]);
                st.len += n;
                st.recv_hold_off += n;
                if (st.recv_hold_off == st.recv_hold.items.len) {
                    st.recv_hold.clearRetainingCapacity();
                    st.recv_hold_off = 0;
                }
                w.dispatchReadable(st);
            }
        }

        fn dispatchReadable(w: *@This(), st: *$mod.ConnState) void {
            const consumed = w.dispatchH1(st, st.buf[0..st.len]);
            st.len = $mod.retainTail(st.buf, st.len, consumed);
            if (!st.ring_dead and st.len == st.buf.len and !$mod.growReqBuf(st)) st.ring_dead = true;
        }

        // h1 only — no preface sniff, no h2c, no ws. Same scan loop as
        // drive|io-uring's h1 branch: complete requests dispatch through
        // scanRequest → Exchange → arrived; replies stage for one send.
        fn dispatchH1(w: *@This(), st: *$mod.ConnState, bytes: []const u8) usize {
            st.batching = true;
            var consumed: usize = 0;
            var alive = true;
            var head_pairs: [$mod.HEAD_PAIRS_MAX]$mod.HeadPair = undefined;
            while (consumed < bytes.len) {
                var head: $mod.Head = .{ .pairs = &head_pairs };
                const take = $mod.scanRequestLite(bytes[consumed..], &head) orelse break;
                // Db park: a /db request's response waits on its row, so it
                // skips arrived() entirely. Consecutive /db requests co-park
                // (their binds ride one flush, rows pair in order); a route
                // that is not /db behind a parked one must wait — wire order
                // is request order — so the scan stops there.
                const m_off = consumed + head.method_off;
                const t_off = consumed + head.target_off;
                const method = bytes[m_off .. m_off + head.method_len];
                const target = bytes[t_off .. t_off + head.target_len];
                if (w.pg != null and st.pg_pending == 0 and
                    std.mem.eql(u8, method, "GET") and std.mem.eql(u8, target, "/db")) {
                    w.pgPark(st, 1, false, false);
                    consumed += take;
                    continue;
                }
                if (w.pg != null and st.pg_pending == 0 and
                    std.mem.eql(u8, method, "GET") and
                    (std.mem.startsWith(u8, target, "/queries") or std.mem.startsWith(u8, target, "/updates"))) {
                    var n: u32 = 1;
                    if (std.mem.indexOf(u8, target, "queries=")) |qi| {
                        var e = qi + 8;
                        var v: u32 = 0;
                        var any = false;
                        while (e < target.len and target[e] >= '0' and target[e] <= '9') : (e += 1) {
                            v = v * 10 + (target[e] - '0');
                            any = true;
                        }
                        if (any) n = @min(@max(v, 1), 20);
                    }
                    w.pgPark(st, n, true, std.mem.startsWith(u8, target, "/updates"));
                    consumed += take;
                    continue;
                }
                if (st.pg_pending > 0) break;
                var exchange = $mod.Exchange{ .fd = st.fd, .st = st, .raw = bytes[consumed .. consumed + take], .head = &head };
                if (head.wants_close) exchange.keep_alive = false;
                arrived(&exchange);
                consumed += take;
                if (!exchange.keep_alive) {
                    alive = false;
                    break;
                }
            }
            st.batching = false;
            if (!alive) st.ring_dead = true;
            return consumed;
        }

        fn run(port_: u16) void {
            // Ring + listener on the worker thread — SINGLE_ISSUER wants the
            // ring owned by the thread that drives it. DEFER_TASKRUN stays:
            // dropping it measured -15% on this workload.
            const ring = linux.IoUring.init($mod.URING_ENTRIES, linux.IORING_SETUP_SINGLE_ISSUER | linux.IORING_SETUP_DEFER_TASKRUN) catch
                linux.IoUring.init($mod.URING_ENTRIES, 0) catch {
                    std.debug.print("Pump: io_uring refused — io_uring_setup failed\n", .{});
                    return;
                };
            const listen_fd = $mod.openReusePortListener(port_) orelse {
                std.debug.print("Pump: io_uring worker failed to listen on :{}\n", .{port_});
                return;
            };
            var w = @This(){ .ring = ring, .listen_fd = listen_fd };
            var bg_store: ?Pool = Pool.init(&w.ring, 4096, 1024) catch |e| blk: {
                std.debug.print("Pump: provided-buffer pool refused ({s}) — conns use one-shot recv\n", .{@errorName(e)});
                break :blk null;
            };
            if (bg_store) |*bg| {
                w.bufgrp = bg;
                std.debug.print("Pump: buffer pool armed\n", .{});
            }
            _ = w.ring.accept_multishot($mod.URING_ACCEPT, listen_fd, null, null, 0) catch {
                std.debug.print("Pump: io_uring accept arm failed\n", .{});
                return;
            };

            // The db conn joins the ring as a peer — a readable CQE on it
            // means parked exchanges can resume. Blocking only through the
            // startup handshake; nonblocking once armed.
            if ($mod.PgConn.connect()) |pg| {
                w.pg = pg;
                _ = w.ring.poll_add($mod.URING_PG, pg.fd, linux.POLL.IN) catch {
                    std.debug.print("Pump: pg poll arm failed\n", .{});
                };
                std.debug.print("Pump: pg conn armed on the ring\n", .{});
            }

            const coalesce_max: u32 = if (w.ring.features & linux.IORING_FEAT_EXT_ARG != 0) WAIT_COALESCE_MAX else 1;

            var wait_nr: u32 = 1;
            var cqes: [CQE_BATCH]linux.io_uring_cqe = undefined;
            while (true) {
                // No parked conns, no deadlines: the wait shape is always the
                // coalesced batch or the single park.
                if (wait_nr > 1) {
                    $mod.ringWaitTimeout(&w.ring, wait_nr, WAIT_COALESCE_NS) catch continue;
                } else {
                    _ = w.ring.submit_and_wait(1) catch continue;
                }
                const got = w.ring.copy_cqes(&cqes, 0) catch continue;
                @import("root").koru_orisha.stampHttpDateLine();
                var i: usize = 0;
                for (cqes[0..got]) |cqe| {
                    i += 1;
                    if (i % SUBMIT_STRIDE == 0) _ = w.ring.submit() catch {};
                    w.handleCqe(cqe);
                }
                // Db binds staged this batch go out as one send — the conn's
                // parked requests share a roundtrip.
                if (w.pg) |pg| pg.flush();
                wait_nr = @min(@max(@as(u32, @intCast(got / 2)), 1), coalesce_max);
            }
        }
    };

    var spawned: usize = 0;
    while (spawned + 1 < n_workers) : (spawned += 1) {
        _ = std.Thread.spawn(.{}, W.run, .{port}) catch break;
    }
    std.debug.print("Orisha listening on http://0.0.0.0:{}\n", .{port});
    std.debug.print("Pump: io_uring race, {} workers\n", .{spawned + 1});
    W.run(port);

    return .{ .stopped = "Server stopped" };
}

// ---------------------------------------------------------------------------
// unikraft — a unikernel. Selected by `--build=unikraft`.
// ---------------------------------------------------------------------------
// No kqueue, no epoll, and nothing to multiplex onto: one vCPU, one loop, one
// exchange in flight. A readiness mechanism would buy nothing here, which is
// why this variant is SHORTER than the two above rather than a port of them.
//
// Blocking accept is deliberate. lwip runs its own stack thread, so blocking in
// the application does not stall the network.

~proc drive|unikraft {
    if (tls_port != null) {
        return .{ .failed = "TLS is not supported on the unikernel pump yet" };
    }
    const fd = $mod.socket(2, 1, 0);
    if (fd < 0) return .{ .failed = "socket" };

    var addr = $mod.SockaddrIn{ .port = @byteSwap(port), .addr = 0 };
    if ($mod.bind(fd, &addr, @sizeOf($mod.SockaddrIn)) < 0) return .{ .failed = "bind" };
    if ($mod.listen(fd, 512) < 0) return .{ .failed = "listen" };

    // Wait on the listener AND every live connection at once. Serving one
    // connection to completion before accepting the next is what made a browser
    // hang here while curl was perfectly happy.
    while (true) {
        var pfds: [$mod.MAX_UK_CONNS + 1]$mod.PollFd = undefined;
        var slot: [$mod.MAX_UK_CONNS + 1]i32 = undefined;
        var n: usize = 0;

        pfds[n] = .{ .fd = fd, .events = $mod.POLLIN, .revents = 0 };
        slot[n] = -1; // the listener
        n += 1;

        for (&$mod.uk_conns, 0..) |*conn, i| {
            if (conn.st.fd < 0) continue;
            pfds[n] = .{ .fd = conn.st.fd, .events = $mod.POLLIN, .revents = 0 };
            slot[n] = @intCast(i);
            n += 1;
        }

        const ready = $mod.poll(&pfds, @intCast(n), $mod.POLL_TICK_MS);
        @import("root").koru_orisha.stampHttpDateLine();

        // Time passes whether or not anything arrived, so the sweep runs here.
        const now = $mod.wallClockSeconds(null);
        for (&$mod.uk_conns) |*idle| {
            if (idle.st.fd < 0) continue;
            if (idle.st.len != 0) continue; // mid-request; it is still talking
            if (now - idle.last_seen <= $mod.KEEPALIVE_IDLE_SECONDS) continue;
            if (idle.st.mode == .ws) closed(@intCast(idle.st.fd));
            $mod.ukRelease(&idle.st);
        }

        if (ready <= 0) continue;

        for (pfds[0..n], slot[0..n]) |p, which| {
            const gone = p.revents & ($mod.POLLERR | $mod.POLLHUP | $mod.POLLNVAL) != 0;

            // A dead connection frees its slot even when there is nothing to read.
            if (which >= 0 and gone) {
                const dead = &$mod.uk_conns[@intCast(which)];
                if (dead.st.mode == .ws) closed(@intCast(dead.st.fd));
                $mod.ukRelease(&dead.st);
                continue;
            }

            if (p.revents & $mod.POLLIN == 0) continue;

            if (which < 0) {
                const accepted = $mod.accept(fd, null, null);
                if (accepted < 0) continue;
                if ($mod.ukAdmit(accepted)) |evicted| closed(@intCast(evicted));
                continue;
            }

            const live = &$mod.uk_conns[@intCast(which)];

            // Read onto the END of what is already held, so a request split
            // across two reads is finished rather than restarted.
            // `handler__unikraft`, named outright, because a variants block does
            // NOT reach a call site written in raw Zig — it rewrites the ones the
            // flow makes. `run` and `reply` are chosen for us that way; `fill` is
            // called from inside a loop body, so this body says which reader it
            // wants. Getting this wrong is invisible on a laptop: the default
            // body is `posix.read`, which macOS has and a unikernel does not.
            switch ($mod.fill_event.handler__unikraft(.{ .st = &live.st })) {
                .more => {},
                // `poll` said readable, so this pump has no idle case — but the
                // seam has one, and waiting is always the safe answer to it.
                .idle => continue,
                .gone => {
                    if (live.st.mode == .ws) closed(@intCast(live.st.fd));
                    $mod.ukRelease(&live.st);
                    continue;
                },
            }

            // Heard from — so it is no longer the idlest.
            $mod.uk_seq += 1;
            live.seq = $mod.uk_seq;
            live.last_seen = now;

            // Upgraded connection: frames, not requests — same seam as the
            // kqueue pump's `st.mode == .ws` block. There is no readiness to
            // re-arm here; the poll loop already waits on every live slot.
            if (live.st.mode == .ws) {
                var ws_consumed: usize = 0;
                var ws_alive = true;
                while (ws_consumed < live.st.len) {
                    const item = $mod.wsNext(&live.st, &ws_consumed) orelse break;
                    switch (item) {
                        .ping => |pl| {
                            if (!$mod.wsSendUk(&live.st, 0xA, pl)) ws_alive = false;
                        },
                        .close => |pl| {
                            _ = $mod.wsSendUk(&live.st, 0x8, pl);
                            ws_alive = false;
                        },
                        .dead => ws_alive = false,
                        .message => |m| {
                            var fx = $mod.Exchange{ .fd = live.st.fd, .st = &live.st, .raw = m.payload, .opcode = m.op };
                            frame(&fx);
                            live.st.ws_msg.clearRetainingCapacity();
                            if (!fx.keep_alive) ws_alive = false;
                        },
                    }
                    if (!ws_alive) break;
                }
                live.st.len = $mod.retainTail(&live.st.buf, live.st.len, ws_consumed);
                if (ws_alive and live.st.len == live.st.buf.len) ws_alive = false;
                if (!ws_alive) {
                    closed(@intCast(live.st.fd));
                    $mod.ukRelease(&live.st);
                }
                continue;
            }

            // Answer every COMPLETE request — see requestLen and retainTail.
            var consumed: usize = 0;
            var alive = true;
            var head_pairs: [$mod.HEAD_PAIRS_MAX]$mod.HeadPair = undefined;
            while (consumed < live.st.len) {
                var head: $mod.Head = .{ .pairs = &head_pairs };
                const take = $mod.scanRequest(live.st.buf[consumed..live.st.len], &head) orelse break;
                var x = $mod.Exchange{ .fd = live.st.fd, .st = &live.st, .raw = live.st.buf[consumed .. consumed + take], .head = &head };
                if (head.wants_close) x.keep_alive = false;
                arrived(&x);
                consumed += take;
                if (!x.keep_alive) {
                    alive = false;
                    break;
                }
            }
            live.st.len = $mod.retainTail(&live.st.buf, live.st.len, consumed);
            if (alive and live.st.len == live.st.buf.len) alive = false;

            if (!alive) {
                _ = $mod.close(live.st.fd);
                live.st.fd = -1;
                live.st.len = 0;
            }
        }
    }

    return .{ .stopped = "Server stopped" };
}

// ============================================================================
// REPLY / HANG-UP — how the flow answers an exchange
// ============================================================================

// Write an answer back. `head` and `body` go out in that order; a caller that
// already holds a whole rendered response passes it as `head` with an empty
// `body`, which is what a pre-rendered static route does.
~proc reply|zig {
    if (hang) x.keep_alive = false;
    const st = x.st orelse connState(@intCast(x.fd)) orelse {
        x.keep_alive = false;
        return .{ .broken = "write failed" };
    };
    // HTTP/2: the exchange answers on a stream, not the h1 wire form — the
    // head the handler rendered carries status/content-type which h2Reply
    // re-encodes as HEADERS+DATA honoring both flow-control windows.
    if (x.h2_stream != 0) {
        if (!h2Reply(st, x, head, body, delay)) {
            return .{ .broken = "stream reply failed" };
        }
        return .sent;
    }
    // A 101 answer is the handshake completing. Its head goes out raw like
    // always, but the body — if the handler set one — is already websocket
    // payload: it must be FRAMED, and it must land after the handshake bytes
    // on the wire. This is the welcome-seam: `{"type":"welcome"}` reaches the
    // client before any frame it could have sent.
    if (head.len >= 13 and std.mem.eql(u8, head[0..13], "HTTP/1.1 101 ")) {
        if (!writevAllConn(st, head, "", date_hole, head_static, false)) {
            x.keep_alive = false;
            return .{ .broken = "write failed" };
        }
        st.mode = .ws;
        // Frames must not join a still-batching queue: wsSendFrame holds ws_mu,
        // and appendPending's ws-mode guard would try to take it again. The
        // head is flushed now — order on the wire is head, then this frame.
        st.batching = false;
        _ = flushPending(st);
        if (body.len > 0) {
            if (!wsSendFrame(st, 0x1, body)) x.keep_alive = false;
        }
        // RFC 6455: a close frame's payload opens with the 2-byte status —
        // empty would wire as 1005 (no status), not the 1000 a refused
        // protocol upgrade must send.
        if (!x.keep_alive) _ = wsSendFrame(st, 0x8, "\x03\xe8");
    } else if (delay > 0) {
        // Async delay: stage the WHOLE response in the conn's queue and park
        // it — no write hits the wire until fireParked. appendPending never
        // flushes inline on a parked conn's behalf (the arm gates hold the
        // conn suspended), and ordering is free: pipelined replies queue
        // behind it exactly as HTTP requires.
        const dl: []const u8 = if (date_hole != 0) @import("root").koru_orisha.httpDateLine() else "";
        const segs4: [4][]const u8 = if (date_hole != 0)
            .{ head[0..date_hole], dl, head[date_hole..], body }
        else
            .{ head, body, "", "" };
        if (!appendPending(st, &segs4)) {
            x.keep_alive = false;
            return .{ .broken = "write failed" };
        }
        st.park_until = std.time.milliTimestamp() + delay;
    } else {
        if (!writevAllConn(st, head, body, date_hole, head_static, body_static)) {
            x.keep_alive = false;
            return .{ .broken = "write failed" };
        }
    }
    // keep_alive was already resolved at arrival (the pump scans
    // `Connection: close` once when the request lands) — re-scanning the raw
    // request here was a second full pass for the same answer.
    if (!x.keep_alive) {
        // A FIN before the queue drains would cut the response mid-flight —
        // when bytes are still pending, mark the conn and let the
        // write-ready event do the closing instead. On the ring pump the
        // reply is staged bytes awaiting a send SQE, not wire bytes —
        // shutdown(SHUT_WR) here would race the submit and EPIPE it — so the
        // conn's ring_dead flag (set by the reader on !keep_alive) routes it
        // through advance's drain-then-teardown path instead.
        if (st.owner_ring == null) {
            if (hasWork(st)) {
                st.close_when_drained = true;
            } else {
                $mod.shutdownConn(st);
            }
        }
    }
    return .sent;
}

// The unikernel's writer. `writeAll` above is built on `posix.write`, which has
// no implementation on a freestanding target; `send` is the same loop over the
// socket symbol the pump already uses.
~proc reply|unikraft {
    _ = head_static; // no io_uring scatter send on the unikernel writer
    _ = body_static;
    if (hang) x.keep_alive = false;
    // No scatter write here either — a holed head goes out as three sends:
    // up to the insertion point, the Date line, the rest.
    const segs = if (date_hole != 0)
        [3][]const u8{ head[0..date_hole], @import("root").koru_orisha.httpDateLine(), head[date_hole..] }
    else
        [3][]const u8{ head, "", "" };

    for (segs) |seg| {
        var offset: usize = 0;
        while (offset < seg.len) {
            const n = $mod.send(x.fd, seg.ptr + offset, seg.len - offset, 0);
            if (n <= 0) {
                x.keep_alive = false;
                return .{ .broken = "write failed" };
            }
            offset += @intCast(n);
        }
    }

    // Same flip as the hosted reply — and the same rule for the body: after a
    // 101 it is websocket payload, framed, never raw bytes on the wire.
    if (head.len >= 13 and std.mem.eql(u8, head[0..13], "HTTP/1.1 101 ")) {
        if (x.st) |st| {
            st.mode = .ws;
            if (body.len > 0) {
                if (!$mod.wsSendUk(st, 0x1, body)) x.keep_alive = false;
            }
            if (!x.keep_alive) _ = $mod.wsSendUk(st, 0x8, "");
        }
    } else {
        var body_offset: usize = 0;
        while (body_offset < body.len) {
            const n = $mod.send(x.fd, body.ptr + body_offset, body.len - body_offset, 0);
            if (n <= 0) {
                x.keep_alive = false;
                return .{ .broken = "write failed" };
            }
            body_offset += @intCast(n);
        }
    }
    return .sent;
}

// The unikernel spelling of wsSendFrame — lwip's `send`, no std.posix.
fn wsSendUk(st: *ConnState, opcode: u8, payload: []const u8) bool {
    var hdr: [10]u8 = undefined;
    hdr[0] = 0x80 | opcode;
    var hlen: usize = 2;
    if (payload.len < 126) {
        hdr[1] = @intCast(payload.len);
    } else if (payload.len <= 0xFFFF) {
        hdr[1] = 126;
        std.mem.writeInt(u16, hdr[2..4], @intCast(payload.len), .big);
        hlen = 4;
    } else {
        hdr[1] = 127;
        std.mem.writeInt(u64, hdr[2..10], payload.len, .big);
        hlen = 10;
    }
    const segs = [2][]const u8{ hdr[0..hlen], payload };
    for (segs) |seg| {
        var offset: usize = 0;
        while (offset < seg.len) {
            const n = $mod.send(st.fd, seg.ptr + offset, seg.len - offset, 0);
            if (n <= 0) return false;
            offset += @intCast(n);
        }
    }
    return true;
}

// Send one websocket frame. `opcode` absent means echo the frame being
// answered — x.opcode carries what `frame` dispatched.
~proc ws-send|zig {
    const st = x.st orelse connState(@intCast(x.fd)) orelse {
        x.keep_alive = false;
        return;
    };
    const op = opcode orelse x.opcode;
    const wire_op: u8 = if (op == 0) 0x1 else op;
    if (!$mod.wsSendFrame(st, wire_op, payload)) x.keep_alive = false;
}

~proc ws-send|unikraft {
    const st = x.st orelse {
        x.keep_alive = false;
        return;
    };
    const op = opcode orelse x.opcode;
    const wire_op: u8 = if (op == 0) 0x1 else op;
    if (!$mod.wsSendUk(st, wire_op, payload)) x.keep_alive = false;
}

// Send a close frame and end the connection when the arm returns.
~proc ws-close|zig {
    const st = x.st orelse connState(@intCast(x.fd)) orelse {
        x.keep_alive = false;
        return;
    };
    // 0x03e8 = 1000, normal closure — the code a server-initiated teardown
    // owes the peer (an empty payload wires as 1005 "no status").
    _ = $mod.wsSendFrame(st, 0x8, "\x03\xe8");
    x.keep_alive = false;
}

~proc ws-close|unikraft {
    if (x.st) |st| _ = $mod.wsSendUk(st, 0x8, "\x03\xe8");
    x.keep_alive = false;
}

// The cross-thread send: name the connection by descriptor and the pump does
// the writing. `gone` when nothing upgraded sits on that fd — dead, never
// upgraded, or past MAX_TRACKED_FD — which is also how a registry learns an
// entry it held is finished.
~proc ws-send-fd|zig {
    const wire_op: u8 = opcode orelse 0x1;
    if ($mod.wsSendFd(fd, wire_op, payload)) return .sent;
    return .gone;
}

// The unikernel conn table is the fixed `uk_conns` slot array, and the pump
// is single-threaded there — a scan finds the target and `wsSendUk` writes.
~proc ws-send-fd|unikraft {
    const wire_op: u8 = opcode orelse 0x1;
    for (&$mod.uk_conns) |*uk| {
        if (uk.st.fd < 0) continue;
        if (uk.st.fd != @as(c_int, @intCast(fd))) continue;
        if (uk.st.mode != .ws) return .gone;
        if ($mod.wsSendUk(&uk.st, wire_op, payload)) return .sent;
        return .gone;
    }
    return .gone;
}

// The default ws-frame: a server that never upgrades never sees it, and a
// claimant that upgrades without implementing it drops messages silently —
// the same shape `orisha:handler`'s 404 default takes for requests.
~proc ws-frame|zig {}

// The default ws-closed: a claimant that tracks connections by fd implements
// it to prune; one that doesn't is unaffected either way.
~proc ws-closed|zig {}

// Refuse to keep the connection. The pump closes it when the arm returns.
~proc hang-up|zig {
    x.keep_alive = false;
}

// The raw request bytes, for the parsing layer.


// The descriptor, for arms that hand ownership to something that outlives
// them. Hosted targets and the unikernel read the same integer — both socket
// layers take a descriptor, so there is nothing platform-shaped to vary.
~proc fileno|zig {
    return @intCast(x.fd);
}

~proc fileno|unikraft {
    return @intCast(x.fd);
}
// RAW — owned copy of the request bytes for the parsing layer.
//
// `x.raw` borrows the pump's read buffer (`ConnState.buf`), and a Koru `->`
// return may not hand back a borrow of its parameter (610_007) — so this proc
// copies the bytes into a per-request arena instead of projecting the field.
// Every construction of `Exchange.raw` slices `ConnState.buf` (REQUEST_BUFFER),
// so the copy fits by construction and `catch unreachable` never fires.
//
// The arena MUST be threadlocal: workers run on their own threads and a
// shared arena lets one worker's reset()+dupe overwrite a slice another
// worker's router is still parsing — a mangled path is a 404, a mangled path
// that lands on a live route is a wrong response. The response-side buffer in
// the companion got this treatment; the request side was missed.
threadlocal var raw_arena_buf: [REQUEST_BUFFER]u8 = undefined;

~proc raw|zig {
    var fba = std.heap.FixedBufferAllocator.init(&raw_arena_buf);
    const data = fba.allocator().dupe(u8, x.raw) catch unreachable;
    return data;
}
