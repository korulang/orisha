// Orisha — the pump.
//
// A pump owns the accept-and-readiness loop for exactly one platform. It reads
// a request off the wire and fires `arrived` once per request; everything a
// pump does NOT do — parsing, routing, response shaping — belongs to the Koru
// flow that consumes the stream, and is written once for every platform.
//
// The point of the split: a new platform is a `~proc drive|<name>` body, not a
// copy of the server. Selection is a build-time variant, so the unselected
// pumps are not merely unused — they are not emitted at all.
//
//   ~[build(linux)]std/build:variants { "orisha/pump:drive": "epoll" }
//
// The `unikraft` variant is the reason this file exists: a unikernel has no
// second thread to spawn and no kqueue, so it needs its own loop — and now
// that loop is the only thing it needs.
//
// Note the `$mod.` qualification through both loop bodies: a proc body that
// carries effect branches splices into its CALLER, where this module's scope
// does not exist. The compiler refuses the bare names and says so.

~import koru/openssl

const std = @import("std");
const posix = std.posix;
const c = std.c;

// One request, read and waiting for its answer. `raw` borrows the pump's read
// buffer and is valid for the duration of the `arrived` arm only.
//
// `fd` is `c_int`, not `posix.fd_t`. Exchange is reachable from every pump
// including the unikernel one, and on `x86_64-freestanding` `std.posix` has no
// syscall layer to name a descriptor type with. `c_int` is what `accept`
// returns on every target we build, and it is what `posix.fd_t` already is on
// Linux and macOS, so the hosted pumps are unaffected.
// The header block, parsed once. `scanRequest` walks every head line anyway —
// the old shape threw all of it away except the frame edge and let the
// parsing layer re-walk the same bytes for method, target, and each header
// lookup. Offsets rather than slices: the answer side may be working a copy
// of the bytes (`pump:raw` dupes into its arena), and an offset means the
// same thing in either buffer. Anything past `pairs.len` headers is still
// found — `unstored_tail` is where a miss resumes the line walk, so a lookup
// over this struct is exactly as complete as a scan was.
pub const HEAD_PAIRS_MAX = 64;

pub const HeadPair = struct {
    name_off: u32,
    name_len: u32,
    value_off: u32,
    value_len: u32,
};

pub const Head = struct {
    // Bytes of request line + headers + the blank line. 0 means unparsed —
    // websocket-frame exchanges and any dispatch path without a scan.
    head_len: u32 = 0,
    method_off: u32 = 0,
    method_len: u32 = 0,
    target_off: u32 = 0,
    target_len: u32 = 0,
    // Caller-provided: a HEAD_PAIRS_MAX stack buffer at the dispatch site.
    // Keeping the array outside Head matters — `Head = .{}` with the array
    // inline coalesces into a 1KB memset per request (15% of userspace
    // under pipelined load, 2026-10-11); a slice pointer does not.
    pairs: []HeadPair = &.{},
    pair_count: u8 = 0,
    // Byte offset of the first header line not stored in `pairs` (the cap
    // overflow point), or 0 when every header fit.
    unstored_tail: u32 = 0,
    // Captured during the scan for the two headers `answer` always wants —
    // one line walk yields them instead of two post-walks over `pairs`, and
    // they are found even past the pairs cap. `off != 0` means present (a
    // value can never sit at byte 0 of the head); `len` may be 0.
    accept_encoding_off: u32 = 0,
    accept_encoding_len: u32 = 0,
    if_none_match_off: u32 = 0,
    if_none_match_len: u32 = 0,
    chunked: bool = false,
    wants_close: bool = false,
};

pub const Exchange = struct {
    fd: c_int,
    st: ?*ConnState = null,
    raw: []const u8,
    keep_alive: bool = true,
    // The parse `scanRequest` produced for this request; borrows a stack
    // frame that lives exactly as long as the `arrived` arm, like `raw`.
    head: ?*const Head = null,
    // On a `! frame` dispatch this is the websocket message opcode (0x1 text,
    // 0x2 binary); on `! arrived` it is 0 and means nothing.
    opcode: u8 = 0,
    // HTTP/2 only: the stream this exchange answers — 0 on h1. `reply` forks
    // on it to emit HEADERS+DATA frames instead of the h1 wire form.
    h2_stream: u32 = 0,
};

const READ_BUFFER = 4096;
const MAX_EVENTS = 64;

// One plan entry per wire segment — a pipelined batch of 16 responses at
// ~3 segments each fills 48 of 64.
const SEND_PLAN_MAX = 64;
const SendPlanEntry = struct {
    base: usize, // .buf → offset into send_buf; otherwise a raw pointer
    len: usize,
    buf: bool,
};

// io_uring: how deep the submission ring is, and the tag that marks an accept
// completion apart from a connection's.
//
// kqueue and epoll ask "which of these is ready, so I can then read it". io_uring
// inverts that: the read is submitted UP FRONT and the completion says it already
// happened. So this pump has no readiness step at all — the loop body handles a
// result, never a hint.
const URING_ENTRIES: u16 = 4096;
const URING_ACCEPT: u64 = std.math.maxInt(u64);
const URING_ACCEPT_TLS: u64 = URING_ACCEPT - 1;
const URING_ACCEPT_H2C: u64 = URING_ACCEPT - 2;
const URING_ACCEPT_H2TLS: u64 = URING_ACCEPT - 3;
// The per-worker Postgres conn: its fd rides the ring as a peer of the
// client conns — a readable CQE here means parked exchanges can resume.
const URING_PG: u64 = URING_ACCEPT - 4;

// One read is not one request.
//
// A browser opening a page fires its asset requests back to back, and TCP is
// free to hand all of them over in a single read. Answering only the first —
// which is what all three pumps did until 2026-08-10 — does not drop those
// requests visibly. The connection stays open and the client keeps waiting, so
// when a later response finally arrives the client matches it to the OLDEST
// request it has outstanding. The bytes are then read as the wrong resource:
// Firefox reports a JavaScript module "blocked because of a disallowed MIME
// type (text/html)", because it is being handed the HTML document's response.
//
// curl cannot see this. It waits for each response before sending the next, so
// every request is alone in its packet and the bug never fires. Only a client
// that pipelines reaches it — which is every browser.
//
// This function answers the one question the three pumps share: where does the
// first request in this buffer end? The loops that use it are mechanical; this
// is the part that must not be written three times.
// A "\r\n" terminator as one vectorized scalar scan + a check, not a
// substring search — line-end is the hot path (once per header line per
// request) and indexOfPos costs ~4x indexOfScalarPos for a 2-byte needle.
inline fn indexOfLineEnd(buf: []const u8, pos: usize) ?usize {
    var i = pos;
    while (std.mem.indexOfScalarPos(u8, buf, i, '\n')) |nl| {
        if (nl > pos and buf[nl - 1] == '\r') return nl - 1;
        i = nl + 1;
    }
    return null;
}

fn chunkedMessageLen(body: []const u8) ?usize {
    var pos: usize = 0;
    while (true) {
        const line_end = indexOfLineEnd(body, pos) orelse return null;
        const chunk_size = std.fmt.parseInt(usize, body[pos..line_end], 16) catch return null;
        pos = line_end + 2;
        if (chunk_size == 0) {
            if (pos + 2 <= body.len and body[pos] == '\r' and body[pos + 1] == '\n') return pos + 2;
            return null;
        }
        pos += chunk_size;
        if (pos + 2 > body.len or body[pos] != '\r' or body[pos + 1] != '\n') return null;
        pos += 2;
    }
}

// One pass over the head block yields everything the dispatch loops used to
// scan for separately: the \r\n\r\n terminator, content-length,
// transfer-encoding: chunked, and connection: close. The old shape walked the
// same bytes five times per request (terminator + three header searches + the
// real parse inside arrived()); under pipelined load that was ~20% of all
// samples in indexOfPos. The request line is scanned too — harmless: a
// colon inside an absolute-form URI produces a name that matches nothing.
fn scanRequest(buf: []const u8, head: *Head) ?usize {
    var content_len: ?usize = null;
    var cl_seen = false;
    var te_seen = false;
    var conn_seen = false;
    var ae_seen = false;
    var inm_seen = false;
    var pos: usize = 0;
    var first_line = true;
    while (true) {
        const nl = indexOfLineEnd(buf, pos) orelse return null;
        const line = buf[pos..nl];
        const line_start = pos;
        pos = nl + 2;
        if (line.len == 0) {
            var take = pos;
            if (content_len) |body_len| {
                take += body_len;
            } else if (head.chunked) {
                take += chunkedMessageLen(buf[pos..]) orelse return null;
            }
            if (take > buf.len) return null;
            head.head_len = @intCast(pos);
            return take;
        }
        if (first_line) {
            // The request line is not a header — the old code let it fall
            // through the colon check below, which matched nothing anyway.
            // Splitting it here spares the answer side its own byte-walk.
            first_line = false;
            if (std.mem.indexOfScalar(u8, line, ' ')) |sp| {
                head.method_len = @intCast(sp);
                const rest = line[sp + 1 ..];
                head.target_off = @intCast(sp + 1);
                head.target_len = @intCast(std.mem.indexOfScalar(u8, rest, ' ') orelse rest.len);
            }
            continue;
        }
        const colon = std.mem.indexOfScalar(u8, line, ':') orelse continue;
        const name = std.mem.trim(u8, line[0..colon], " \t");
        const value = std.mem.trim(u8, line[colon + 1 ..], " \t");
        if (head.pair_count < HEAD_PAIRS_MAX) {
            head.pairs[head.pair_count] = .{
                .name_off = @intCast(@intFromPtr(name.ptr) - @intFromPtr(buf.ptr)),
                .name_len = @intCast(name.len),
                .value_off = @intCast(@intFromPtr(value.ptr) - @intFromPtr(buf.ptr)),
                .value_len = @intCast(value.len),
            };
            head.pair_count += 1;
        } else if (head.unstored_tail == 0) {
            head.unstored_tail = @intCast(line_start);
        }
        // Name dispatch on (first char, len) — the five names we resolve
        // here all differ on both. Every other header pays two compares
        // instead of up to five case-insensitive walks.
        const c0 = if (name.len == 0) 0 else std.ascii.toLower(name[0]);
        switch (c0) {
            'c' => {
                if (name.len == 14 and std.ascii.eqlIgnoreCase(name, "content-length")) {
                    // First wins — the helpers this replaces returned the
                    // first match. Malformed stays null so transfer-encoding
                    // is still consulted, as the old fall-through did.
                    if (!cl_seen) {
                        cl_seen = true;
                        content_len = std.fmt.parseInt(usize, value, 10) catch null;
                    }
                } else if (name.len == 10 and std.ascii.eqlIgnoreCase(name, "connection")) {
                    if (!conn_seen) {
                        conn_seen = true;
                        var lower_buf: [64]u8 = undefined;
                        if (value.len <= lower_buf.len) {
                            const lower = std.ascii.lowerString(&lower_buf, value);
                            if (std.mem.indexOf(u8, lower, "close") != null) head.wants_close = true;
                        }
                    }
                }
            },
            't' => {
                if (name.len == 17 and std.ascii.eqlIgnoreCase(name, "transfer-encoding")) {
                    if (!te_seen) {
                        te_seen = true;
                        var lower_buf: [128]u8 = undefined;
                        if (value.len <= lower_buf.len) {
                            const lower = std.ascii.lowerString(&lower_buf, value);
                            if (std.mem.indexOf(u8, lower, "chunked") != null) head.chunked = true;
                        }
                    }
                }
            },
            'a' => {
                if (name.len == 15 and !ae_seen and std.ascii.eqlIgnoreCase(name, "accept-encoding")) {
                    ae_seen = true;
                    head.accept_encoding_off = @intCast(@intFromPtr(value.ptr) - @intFromPtr(buf.ptr));
                    head.accept_encoding_len = @intCast(value.len);
                }
            },
            'i' => {
                if (name.len == 13 and !inm_seen and std.ascii.eqlIgnoreCase(name, "if-none-match")) {
                    inm_seen = true;
                    head.if_none_match_off = @intCast(@intFromPtr(value.ptr) - @intFromPtr(buf.ptr));
                    head.if_none_match_len = @intCast(value.len);
                }
            },
            else => {},
        }
    }
}

// The race variant's scanner: identical contract to scanRequest — same take
// (headers + body), same semantic fields — minus the pairs array. Routes in a
// race build read only field-captured headers (accept-encoding,
// if-none-match answer through headValueParsed's field path); a handler that
// name-searches arbitrary headers needs the full scan, i.e. drive|io-uring.
fn scanRequestLite(buf: []const u8, head: *Head) ?usize {
    var content_len: ?usize = null;
    var cl_seen = false;
    var te_seen = false;
    var conn_seen = false;
    var ae_seen = false;
    var inm_seen = false;
    var pos: usize = 0;
    var first_line = true;
    while (true) {
        const nl = indexOfLineEnd(buf, pos) orelse return null;
        const line = buf[pos..nl];
        pos = nl + 2;
        if (line.len == 0) {
            var take = pos;
            if (content_len) |body_len| {
                take += body_len;
            } else if (head.chunked) {
                take += chunkedMessageLen(buf[pos..]) orelse return null;
            }
            if (take > buf.len) return null;
            head.head_len = @intCast(pos);
            return take;
        }
        if (first_line) {
            first_line = false;
            if (std.mem.indexOfScalar(u8, line, ' ')) |sp| {
                head.method_len = @intCast(sp);
                const rest = line[sp + 1 ..];
                head.target_off = @intCast(sp + 1);
                head.target_len = @intCast(std.mem.indexOfScalar(u8, rest, ' ') orelse rest.len);
            }
            continue;
        }
        const colon = std.mem.indexOfScalar(u8, line, ':') orelse continue;
        const name = std.mem.trim(u8, line[0..colon], " \t");
        const value = std.mem.trim(u8, line[colon + 1 ..], " \t");
        const c0 = if (name.len == 0) 0 else std.ascii.toLower(name[0]);
        switch (c0) {
            'c' => {
                if (name.len == 14 and std.ascii.eqlIgnoreCase(name, "content-length")) {
                    if (!cl_seen) {
                        cl_seen = true;
                        content_len = std.fmt.parseInt(usize, value, 10) catch null;
                    }
                } else if (name.len == 10 and std.ascii.eqlIgnoreCase(name, "connection")) {
                    if (!conn_seen) {
                        conn_seen = true;
                        var lower_buf: [64]u8 = undefined;
                        if (value.len <= lower_buf.len) {
                            const lower = std.ascii.lowerString(&lower_buf, value);
                            if (std.mem.indexOf(u8, lower, "close") != null) head.wants_close = true;
                        }
                    }
                }
            },
            't' => {
                if (name.len == 17 and std.ascii.eqlIgnoreCase(name, "transfer-encoding")) {
                    if (!te_seen) {
                        te_seen = true;
                        var lower_buf: [128]u8 = undefined;
                        if (value.len <= lower_buf.len) {
                            const lower = std.ascii.lowerString(&lower_buf, value);
                            if (std.mem.indexOf(u8, lower, "chunked") != null) head.chunked = true;
                        }
                    }
                }
            },
            'a' => {
                if (name.len == 15 and !ae_seen and std.ascii.eqlIgnoreCase(name, "accept-encoding")) {
                    ae_seen = true;
                    head.accept_encoding_off = @intCast(@intFromPtr(value.ptr) - @intFromPtr(buf.ptr));
                    head.accept_encoding_len = @intCast(value.len);
                }
            },
            'i' => {
                if (name.len == 13 and !inm_seen and std.ascii.eqlIgnoreCase(name, "if-none-match")) {
                    inm_seen = true;
                    head.if_none_match_off = @intCast(@intFromPtr(value.ptr) - @intFromPtr(buf.ptr));
                    head.if_none_match_len = @intCast(value.len);
                }
            },
            else => {},
        }
    }
}

// A request can arrive in pieces, so a connection needs somewhere to keep the
// part that has not finished yet.
//
// Without this the pump had only the bytes of one read. A burst bigger than the
// read buffer therefore split a request down the middle, and the tail was then
// parsed as if it were the start of a new one — which produced EXTRA responses,
// not fewer: measured 43 responses to 40 pipelined requests. A client counting
// replies against its own outstanding requests is desynchronised from then on,
// and what it renders depends on where the split happened to land. That is the
// "sometimes it works" shape.
const REQUEST_BUFFER = 16 * 1024;
// The fd table is indexed by descriptor value, so the bound must cover the
// socket numbers a burst actually issues — the harness runs profiles at
// 16384 conns with nofile=1048576, and every fd past the old 4096 cap was
// silently close()d at registration.
const MAX_TRACKED_FD = 1 << 20;

// One connection, and everything reading it needs: the socket, the bytes held
// so far, and how many of them there are.
//
// `fd` lives here because `fill` takes a connection and nothing else. A read
// step that has to be told which descriptor to read is not a seam — the caller
// would still be the one holding the platform's idea of a socket.
//
// It is `c_int` for the same reason Exchange's is: this type is now reachable
// from the unikernel pump too, and `x86_64-freestanding` has no `std.posix`
// syscall layer to name a descriptor type with. On Linux and macOS `posix.fd_t`
// already IS `c_int`, so the hosted pumps hand theirs over unchanged.
// The connection's protocol mode. `http` is every connection at accept; a 101
// answer flips it to `ws`, after which bytes on the wire are websocket frames
// and `requestLen` never sees them again.
pub const ConnMode = enum { http, ws, h2c };

// One writer at a time on a websocket connection. `ws-send` in a frame arm
// and `ws-send-fd` from a pusher thread can both target the same socket;
// without the lock two frames interleave on the wire. Freestanding targets
// run the pump single-threaded, so the type degrades to a no-op there —
// std.Thread.Mutex's futex path has no kernel behind it on a unikernel.
const SendMutex = switch (@import("builtin").os.tag) {
    .freestanding => struct {
        pub fn lock(_: *const @This()) void {}
        pub fn unlock(_: *const @This()) void {}
    },
    else => std.Thread.Mutex,
};

// The conn-state heap is the same seam the allocator work already taught
// index.kz: `pumpAlloc()` is libc's malloc, and a freestanding
// target has no libc — every reference to it is a hard compile error there,
// even in code that never runs (ukAdmit's ws_msg deinit broke the unikernel
// build when it landed). Freestanding gets a fixed arena carved out of the
// image: one pump, no threads, and bounded RAM is the honest shape of a
// kernel whose entire memory is this binary. 256 KiB covers per-conn ws
// reassembly buffers without touching the 6 MB floor the image serves at.
const pump_freestanding = @import("builtin").target.os.tag == .freestanding;
var pump_arena_buf: [256 * 1024]u8 = undefined;
var pump_arena_state: ?std.heap.FixedBufferAllocator = null;
fn pumpAlloc() std.mem.Allocator {
    if (!pump_freestanding) return std.heap.c_allocator;
    if (pump_arena_state == null)
        pump_arena_state = std.heap.FixedBufferAllocator.init(&pump_arena_buf);
    return pump_arena_state.?.allocator();
}

// One serialized websocket frame shared by every subscriber the broadcast
// reaches: built once, refcounted once per queue it lands on. Broadcast is
// the hot path and per-conn serialization does not scale — the same bytes
// ride N conns.
pub const Frame = struct {
    refcount: std.atomic.Value(u32),
    bytes: []u8,
};

// One node in a hosted ws conn's lock-free broadcast queue. Producers (the
// drainer threads) append via the atomic tail; the owner pops. Strict FIFO —
// each conn has exactly ONE broadcast producer (its fd-shard's drainer), so
// the broadcast path is SPSC; the owner's own replies and `ws-send-fd` still
// ride the mutex-guarded `pending` (control frames, not the fan-out). `off`
// is the owner's write cursor across partial writes.
const WsSeg = struct {
    frame: *Frame,
    off: usize,
    next: std.atomic.Value(?*WsSeg) = .init(null),
};

pub const ConnState = struct {
    fd: c_int = -1,
    ssl: ?*ServerTls = null,
    mode: ConnMode = .http,
    ws_mu: SendMutex = .{},
    // h2c: the 24-byte client preface has been consumed and our SETTINGS
    // frame is out — every frame after that is parsed header-first.
    h2_prefaced: bool = false,
    // The main port speaks both h1 and h2c: the first bytes on a cleartext
    // conn get sniffed for the HTTP/2 client preface (RFC 7540 §3.5) —
    // unary-grpc reaches the same port as baseline, so "PRI * " turns the
    // conn h2c. Set once the first read was decisive either way.
    preface_checked: bool = false,
    // h2 stream table + flow-control windows + HPACK dynamic-table state.
    // h2_send_window_conn is the RFC 7540 §6.9 connection send window —
    // every DATA frame we emit decrements it; only WINDOW_UPDATE on
    // stream 0 refills it.
    h2_streams: [H2_STREAMS_MAX]H2Stream = @splat(.{}),
    h2_send_window_conn: i64 = 65535,
    h2_peer_initial_window: i64 = 65535,
    h2_peer_max_frame: usize = 16384,
    h2_req_scratch: std.ArrayListUnmanaged(u8) = .{},
    h2_hpack: HpackTable = .{},
    // Requests completed inside h2cProcess — the `arrived` effect only
    // binds inside ~proc scopes, so completions queue here and the
    // dispatch site in the ~proc body fires one arm per entry.
    h2_ready: [16]H2Ready = undefined,
    h2_ready_n: usize = 0,
    // Async delay: a handler's `delay_ms` stages its whole response and
    // parks the conn — no read or write arm — until this timestamp. The
    // parked list is per-worker (one thread, one loop), parked gates every
    // re-arm so a suspended conn emits nothing until fireParked runs it
    // through the ordinary next-op choice again. `parked` makes the gate
    // idempotent: a second arm attempt against a parked conn is a no-op,
    // not a double-insert.
    park_until: i64 = 0,
    park_next: ?*ConnState = null,
    parked: bool = false,
    buf: []u8 = &.{},
    len: usize = 0,
    // Websocket reassembly — only meaningful while mode == .ws. `buf` holds
    // undispatched wire bytes like always; frames too big or fragmented for
    // one buffer accumulate their (unmasked) payload into `ws_msg`, and the
    // frame fields carry the in-flight frame's parse state across fills.
    ws_in_frame: bool = false,
    ws_need: usize = 0,
    ws_fin: bool = true,
    ws_op: u8 = 0,
    ws_mask: [4]u8 = .{ 0, 0, 0, 0 },
    ws_seen: usize = 0,
    ws_msg: std.ArrayListUnmanaged(u8) = .{},
    ws_msg_op: u8 = 0,
    ws_msg_open: bool = false,
    // Control payloads are ≤125 bytes by spec (RFC 6455 §5.5) — they get their
    // own fixed buffer so a ping mid-fragment never joins the message.
    ws_ctrl: [125]u8 = undefined,
    ws_ctrl_len: usize = 0,
    // TLS handshake still in flight. The fd registered with the reactor
    // BEFORE SSL_accept finished — the owning worker steps it once per
    // readiness event, and no bytes are framed as a request until it clears.
    // This replaces a single accept thread doing every SSL_accept
    // synchronously, which serialised all handshake crypto onto one core.
    tls_hs: bool = false,
    // io_uring pump only: a socket-BIO TLS conn — OpenSSL owns the wire and
    // the ring drives it with poll_add SQEs rather than recv/send. Set for
    // the conn's whole userspace-crypto life: handshake flights and records
    // all flow through SSL_accept/SSL_read/SSL_write on the fd. Cleared when
    // ENABLE_KTLS hands the record layer to the kernel — the SSL is freed
    // and the conn goes cleartext from that point.
    tls_sockbio: bool = false,
    // A poll_add SQE naming this conn is in flight. Same teardown role as
    // recv_armed: the free waits for the terminal CQE, because its
    // user_data still dereferences this struct.
    poll_armed: bool = false,
    // Output accepted from the app faster than the socket took it. Writes
    // append at the tail, a readiness-for-write event drains from
    // pending_off, and the queue keeps ordering without a copy: nothing a
    // later answer writes can overtake it.
    pending: std.ArrayListUnmanaged(u8) = .{},
    pending_off: usize = 0,
    // Dispatch-loop batching: while the request loop runs, replies append to
    // pending WITHOUT flushing — a pipelined batch of N answers leaves in one
    // write instead of N writev syscalls. Owner-thread only; ws-mode appends
    // serialize through ws_mu because ws-send-fd may write from a pusher.
    batching: bool = false,
    // A closing answer (Connection: close, a ws close frame, a refused
    // upgrade) landed while pending still holds bytes. The close must wait
    // for the drain — closing early would cut the response mid-flight.
    close_when_drained: bool = false,
    // The readiness queue this conn is armed on (a worker's kqueue, or the
    // shared epoll fd) — set at registration. A `ws-send-fd` write from a
    // pusher thread that stalls must re-arm write readiness on the owner,
    // or the queued tail would wait for traffic that may never come.
    owner_q: i32 = -1,
    // Write-readiness handshake (atomic; shared by every producer and the
    // owner). INVARIANT: true iff a WRITE arm is live on the owner's reactor
    // — on kqueue that is a separate EVFILT.WRITE ONESHOT filter, so a READ
    // event cannot consume it; on epoll the persistent mask's OUT bit is the
    // arm and this flag tracks it. A producer appends and then does
    // `swap(true)` — arming ONLY when it saw false; the owner stores false
    // the moment its WRITE-event drain empties the queues, then re-checks
    // for a push that landed in the gap. The swap-after-push /
    // store-then-recheck pairing closes the lost-wakeup race without ws_mu
    // (see flushPendingOwned + kqueueRearm).
    armed: std.atomic.Value(bool) = .init(false),
    // ConnState references: the conn_states table holds the initial one (1);
    // every in-flight wsPublishFrame producer holds one more. connUnref is
    // the only free path — the last drop runs closeConnMem + destroy.
    refs: std.atomic.Value(u32) = .init(1),
    // The lock-free broadcast queue (owner-pull). Producers append refcounted
    // frames through wsq_tail; the owning worker pops and writes them on its
    // own readiness events. wsq_bytes is the atomic MAX_PENDING meter
    // readable from any thread. wsq_stub is the embedded sentinel — never
    // freed, only pointed past.
    wsq_stub: WsSeg = .{ .frame = undefined, .off = 0 },
    wsq_head: ?*WsSeg = null,
    wsq_tail: std.atomic.Value(?*WsSeg) = .init(null),
    wsq_bytes: std.atomic.Value(usize) = .init(0),
    // io_uring pump bookkeeping — inert on every other pump. owner_ring marks
    // a ring-owned conn (opaque so this struct still compiles off-Linux).
    // send_buf is staged output a send SQE can own outright: while a send is
    // in flight the kernel owns [0..send_len) and the buffer must not move,
    // so bytes written mid-flight queue in `pending` and drain into the tail
    // when the CQE lands. Half-duplex: at most one SQE outstanding per conn.
    owner_ring: ?*anyopaque = null,
    send_buf: []u8 = &.{},
    send_staged: usize = 0,
    send_base: usize = 0,
    send_off: usize = 0,
    send_len: usize = 0,
    // Scatter send plan: when a response's segments are immortal memory
    // (baked rodata — Response.body_static) they ride the send SQE as iovecs
    // instead of being copied into send_buf. The plan is the window's wire
    // order: STATIC entries are raw pointers, BUF entries are offsets into
    // send_buf — offsets, not pointers, so a mid-stage realloc cannot kill
    // them. At promote time the plan materializes into send_iov and the
    // send goes out as one writev SQE.
    send_plan: [SEND_PLAN_MAX]SendPlanEntry = undefined,
    send_plan_n: usize = 0,
    // +1: a drained pending span older than the plan precedes its entries.
    send_iov: [SEND_PLAN_MAX + 1]posix.iovec_const = undefined,
    send_iov_n: usize = 0,
    send_iov_pos: usize = 0,
    // Pending bytes appended while a plan window was open are NEWER than the
    // plan's — they must drain in the next window, not this one. spill_mark
    // is pending.items.len at the first such spill; advance drains only the
    // older part. maxInt means "no spill this window".
    spill_mark: usize = std.math.maxInt(usize),
    // The per-second Date line pinned into send_buf so a static response's
    // iovec can point at stable memory; deduped by content within a batch.
    send_date_off: usize = 0,
    send_date_len: usize = 0,
    ring_dead: bool = false,
    // Multishot recv on provided buffers stays armed for the conn's whole
    // life, so it is the one op that outlives teardown interest: its terminal
    // CQE still dereferences this struct through user_data. ring_closing
    // marks the conn detached+closed; the free waits for both arms to fold.
    // recv_hold parks the overflow when a pool buffer delivers more than
    // st.buf has room for — a streamed request must not be cut mid-parse.
    recv_armed: bool = false,
    // Set on -ENOBUFS: the pool ran dry, so this conn finishes on plain
    // one-shot recvs into st.buf. Without it, ENOBUFS → re-arm → ENOBUFS
    // is a submit/reap spin per conn — measured as a throughput collapse
    // with full CPU under -r churn, not a stall.
    ms_off: bool = false,
    ring_closing: bool = false,
    recv_hold: std.ArrayListUnmanaged(u8) = .{},
    recv_hold_off: usize = 0,
    // Db exchanges in flight on this conn — pipelined requests behind a
    // /db wait until its row stages (wire order is request order).
    pg_pending: u32 = 0,
    // The kernel owns the record layer — set when sslKtlsState reports both
    // directions offloaded and the conn has gone cleartext-shaped. Teardown
    // uses it to send close_notify through a control message on the fd.
    ktls_on: bool = false,
};

var conn_states: [MAX_TRACKED_FD]?*ConnState = .{null} ** MAX_TRACKED_FD;

// ---------------------------------------------------------------------------
// Postgres — the driver's twin inside the pump. pg/index.kz is the public
// surface; this is the same protocol specialized for the exchange-park job:
// one prepared statement, batched binds, rows feeding a FIFO of parked
// conns. Trust auth only (TFB/arena topology); the conn is blocking for its
// startup handshake, nonblocking once armed on the ring.
// ---------------------------------------------------------------------------
const PgWaiter = struct {
    st: *ConnState,
    expected: u32,
    wrap_array: bool,
    buf: std.ArrayListUnmanaged(u8) = .{},
};

const PgConn = struct {
    fd: posix.fd_t,
    tx: std.ArrayListUnmanaged(u8) = .{},
    rx: [65536]u8 = undefined,
    rx_len: usize = 0,
    rx_pos: usize = 0,
    msg_rem: u32 = 0,
    // FIFO of parked exchanges — rows pair in bind order, which is
    // request order. expected counts the rows a parked request needs:
    // 1 for /db, N for /queries. buf accumulates the JSON body.
    waiters: std.ArrayListUnmanaged(PgWaiter) = .{},
    // in-flight binds for which no row may come back (conn torn down) —
    // rows with no waiter are dropped, not mismatched.
    pending_binds: u32 = 0,

    fn sendAll(fd: posix.fd_t, buf: []const u8) !void {
        var n: usize = 0;
        var spins: u32 = 0;
        while (n < buf.len) {
            n += posix.send(fd, buf[n..], 0) catch |e| switch (e) {
                // nonblocking fd — the buffer drains eventually; the batch
                // is small enough that a brief wait beats losing the send.
                error.WouldBlock => {
                    spins += 1;
                    if (spins > 1 << 22) return e;
                    continue;
                },
                else => return e,
            };
        }
    }

    fn readFull(fd: posix.fd_t, buf: []u8) !void {
        var n: usize = 0;
        while (n < buf.len) {
            const r = try posix.read(fd, buf[n..]);
            if (r == 0) return error.Eof;
            n += r;
        }
    }

    fn put32(tx: *std.ArrayListUnmanaged(u8), a: std.mem.Allocator, v: u32) !void {
        var x: [4]u8 = undefined; std.mem.writeInt(u32, &x, v, .big);
        try tx.appendSlice(a, &x);
    }
    fn put16(tx: *std.ArrayListUnmanaged(u8), a: std.mem.Allocator, v: u16) !void {
        var x: [2]u8 = undefined; std.mem.writeInt(u16, &x, v, .big);
        try tx.appendSlice(a, &x);
    }
    fn frame(tx: *std.ArrayListUnmanaged(u8), a: std.mem.Allocator, t: u8, payload: []const u8) !void {
        try tx.append(a, t); try put32(tx, a, @intCast(payload.len + 4)); try tx.appendSlice(a, payload);
    }

    // Blocking startup + trust-auth handshake + prepare of the world stmt.
    fn connect() ?*PgConn {
        const a = pumpAlloc();
        const host = posix.getenv("PG_HOST") orelse "127.0.0.1";
        const port_s = posix.getenv("PG_PORT") orelse "5432";
        const user = posix.getenv("PG_USER") orelse "benchmarkdbuser";
        const db = posix.getenv("PG_DB") orelse "hello_world";
        const port = std.fmt.parseInt(u16, port_s, 10) catch 5432;
        const addr = std.net.Address.parseIp(host, port) catch return null;
        const fd = posix.socket(posix.AF.INET, posix.SOCK.STREAM, 0) catch return null;
        $mod.posix.connect(fd, &addr.any, addr.getOsSockLen()) catch {
            $mod.posix.close(fd); return null;
        };
        const pg = a.create(PgConn) catch {
            posix.close(fd); return null;
        };
        pg.* = .{ .fd = fd };
        // startup frame
        var p: std.ArrayListUnmanaged(u8) = .{};
        defer p.deinit(a);
        put32(&p, a, 196608) catch return pg;
        p.appendSlice(a, "user") catch return pg;
        p.append(a, 0) catch return pg;
        p.appendSlice(a, user) catch return pg;
        p.append(a, 0) catch return pg;
        p.appendSlice(a, "database") catch return pg;
        p.append(a, 0) catch return pg;
        p.appendSlice(a, db) catch return pg;
        p.append(a, 0) catch return pg;
        p.append(a, 0) catch return pg;
        put32(&pg.tx, a, @intCast(p.items.len + 4)) catch return pg;
        pg.tx.appendSlice(a, p.items) catch return pg;
        sendAll(fd, pg.tx.items) catch return pg;
        pg.tx.clearRetainingCapacity();
        // drain to ReadyForQuery
        var hdr: [5]u8 = undefined;
        while (true) {
            readFull(fd, &hdr) catch return pg;
            const len = std.mem.readInt(u32, hdr[1..5], .big) - 4;
            var buf: [1024]u8 = undefined;
            readFull(fd, buf[0..@min(len, 1024)]) catch return pg;
            var skip: usize = @min(len, 1024);
            while (skip < len) : (skip += 1024) {
                readFull(fd, buf[0..@min(len - skip, 1024)]) catch return pg;
            }
            if (hdr[0] == 'Z') break;
            if (hdr[0] == 'E') return pg; // auth/config error — dead conn
        }
        // prepare s1 — no Describe, the row shape is compile-time known
        const stmt = "s1";
        const sql = "SELECT id, randomNumber FROM world WHERE id = $1";
        const stmt2 = "s2";
        const sql2 = "UPDATE world SET randomNumber = $2 WHERE id = $1 RETURNING id, randomNumber";
        var pp: std.ArrayListUnmanaged(u8) = .{};
        defer pp.deinit(a);
        pp.appendSlice(a, stmt) catch return pg;
        pp.append(a, 0) catch return pg;
        pp.appendSlice(a, sql) catch return pg;
        pp.append(a, 0) catch return pg;
        put16(&pp, a, 0) catch return pg;
        frame(&pg.tx, a, 'P', pp.items) catch return pg;
        pp.clearRetainingCapacity();
        pp.appendSlice(a, stmt2) catch return pg;
        pp.append(a, 0) catch return pg;
        pp.appendSlice(a, sql2) catch return pg;
        pp.append(a, 0) catch return pg;
        put16(&pp, a, 0) catch return pg;
        frame(&pg.tx, a, 'P', pp.items) catch return pg;
        frame(&pg.tx, a, 'S', "") catch return pg;
        sendAll(fd, pg.tx.items) catch return pg;
        pg.tx.clearRetainingCapacity();
        while (true) {
            readFull(fd, &hdr) catch return pg;
            const len = std.mem.readInt(u32, hdr[1..5], .big) - 4;
            var buf: [1024]u8 = undefined;
            readFull(fd, buf[0..@min(len, 1024)]) catch return pg;
            var skip: usize = @min(len, 1024);
            while (skip < len) : (skip += 1024) {
                readFull(fd, buf[0..@min(len - skip, 1024)]) catch return pg;
            }
            if (hdr[0] == 'Z') break;
            if (hdr[0] == 'E') return pg;
        }
        // nonblocking from here on — the ring polls readability; reads
        // must not block a worker.
        markNonBlocking(pg.fd);
        return pg;
    }

    // B+E for the world stmt appended to tx — flushed by the caller once
    // the scan loop is done (all of a conn's parked requests ride one send).
    fn bindExec(pg: *PgConn, id: u32) void {
        const a = pumpAlloc();
        var bp: std.ArrayListUnmanaged(u8) = .{};
        defer bp.deinit(a);
        bp.append(a, 0) catch return;
        bp.appendSlice(a, "s1") catch return;
        bp.append(a, 0) catch return;
        put16(&bp, a, 0) catch return;
        put16(&bp, a, 1) catch return;
        var idb: [10]u8 = undefined;
        const ids = std.fmt.bufPrint(&idb, "{}", .{id}) catch return;
        put32(&bp, a, @intCast(ids.len)) catch return;
        bp.appendSlice(a, ids) catch return;
        put16(&bp, a, 0) catch return;
        frame(&pg.tx, a, 'B', bp.items) catch return;
        var ep: std.ArrayListUnmanaged(u8) = .{};
        defer ep.deinit(a);
        ep.append(a, 0) catch return;
        put32(&ep, a, 0) catch return;
        frame(&pg.tx, a, 'E', ep.items) catch return;
        // Sync per bind — postgres buffers extended-protocol output until
        // Sync; without it the row never flushes and the poll never fires.
        frame(&pg.tx, a, 'S', "") catch return;
        pg.pending_binds += 1;
    }

    // B+E+S for the update stmt — (id, newRandomNumber) as text params.
    fn bindExecUpdate(pg: *PgConn, id: u32, rn: u32) void {
        const a = pumpAlloc();
        var bp: std.ArrayListUnmanaged(u8) = .{};
        defer bp.deinit(a);
        bp.append(a, 0) catch return;
        bp.appendSlice(a, "s2") catch return;
        bp.append(a, 0) catch return;
        put16(&bp, a, 0) catch return;
        put16(&bp, a, 2) catch return;
        var ib: [10]u8 = undefined;
        const is_ = std.fmt.bufPrint(&ib, "{}", .{id}) catch return;
        put32(&bp, a, @intCast(is_.len)) catch return;
        bp.appendSlice(a, is_) catch return;
        var rb: [10]u8 = undefined;
        const rs = std.fmt.bufPrint(&rb, "{}", .{rn}) catch return;
        put32(&bp, a, @intCast(rs.len)) catch return;
        bp.appendSlice(a, rs) catch return;
        put16(&bp, a, 0) catch return;
        frame(&pg.tx, a, 'B', bp.items) catch return;
        var ep: std.ArrayListUnmanaged(u8) = .{};
        defer ep.deinit(a);
        ep.append(a, 0) catch return;
        put32(&ep, a, 0) catch return;
        frame(&pg.tx, a, 'E', ep.items) catch return;
        frame(&pg.tx, a, 'S', "") catch return;
        pg.pending_binds += 1;
    }

    fn flush(pg: *PgConn) void {
        if (pg.tx.items.len == 0) return;
        sendAll(pg.fd, pg.tx.items) catch {};
        pg.tx.clearRetainingCapacity();
    }
};

// The "no index is ever touched twice" claim is false: the accept thread
// writes the slot (registerClient → connState) while a worker detaches it
// (releaseConn), and the kernel reissues a just-closed fd immediately. The
// lock makes the table honest; the ordering — detach BEFORE close in
// releaseConn — is what keeps a reissued descriptor from inheriting the
// previous connection's buffered tail, ssl, or a second close.
var conn_states_mu: std.Thread.Mutex = .{};

fn connState(fd: posix.fd_t) ?*ConnState {
    const idx: usize = @intCast(fd);
    if (idx >= MAX_TRACKED_FD) return null;
    conn_states_mu.lock();
    defer conn_states_mu.unlock();
    if (conn_states[idx]) |s| return s;
    const s = pumpAlloc().create(ConnState) catch return null;
    s.* = .{ .fd = fd };
    s.buf = pumpAlloc().alloc(u8, REQUEST_BUFFER) catch {
        conn_states[idx] = null;
        pumpAlloc().destroy(s);
        return null;
    };
    s.wsq_head = &s.wsq_stub;
    s.wsq_tail.store(&s.wsq_stub, .monotonic);
    conn_states[idx] = s;
    return s;
}

// The ring pump drops the table slot the moment a conn is dead — a reissued
// descriptor must meet fresh state, not a zombie whose multishot recv is
// still folding in. The ConnState itself is freed later, by the owner.
fn detachConn(fd: posix.fd_t) void {
    const idx: usize = @intCast(fd);
    if (idx >= MAX_TRACKED_FD) return;
    conn_states_mu.lock();
    conn_states[idx] = null;
    conn_states_mu.unlock();
}

fn releaseConn(fd: posix.fd_t) void {
    const idx: usize = @intCast(fd);
    if (idx >= MAX_TRACKED_FD) {
        posix.close(@intCast(fd));
        return;
    }
    conn_states_mu.lock();
    const s = conn_states[idx];
    conn_states[idx] = null;
    conn_states_mu.unlock();
    if (s) |st| {
        // A `ws-send-fd` already mid-write holds ws_mu; teardown waits for it
        // before closing the fd — the fd must not close under a concurrent
        // inline write, and a reissued descriptor must not inherit the old
        // conn's kqueue filters. The memory free waits for every in-flight
        // wsPublishFrame producer via connUnref.
        st.ws_mu.lock();
        closeConnWire(st);
        st.ws_mu.unlock();
        connUnref(st);
    } else {
        posix.close(@intCast(fd));
    }
}

// "Is this fd an upgraded websocket connection right now" — asked at teardown
// sites to decide whether `closed` fires, and asked BEFORE releaseConn takes
// the slot, so the fd still names this connection and not a reissued one.
fn connIsWs(fd: posix.fd_t) bool {
    const idx: usize = @intCast(fd);
    if (idx >= MAX_TRACKED_FD) return false;
    conn_states_mu.lock();
    defer conn_states_mu.unlock();
    const s = conn_states[idx] orelse return false;
    return s.mode == .ws;
}

// TLS side of teardown: needs the live fd — the kTLS alert goes out on it.
// Called on its own by the ring pump, where the fd close must come after
// the table detach (a reissued descriptor must meet fresh state).
fn closeConnTls(st: *ConnState) void {
    if (HAS_OPENSSL) {
        const mod = @import("root").koru_koru.koru_openssl;
        // Kernel-owned record layer: SSL is already gone, so the alert goes
        // out through a control message — the kernel seals it itself.
        if (st.ktls_on and st.fd >= 0) mod.sslKtlsCloseNotify(@intCast(st.fd));
        if (st.ssl) |tls| {
            if (tls.ssl) |s| mod.releaseServerSsl(s);
            tls.allocator.destroy(tls);
            st.ssl = null;
        }
    }
}

fn closeConnWire(st: *ConnState) void {
    closeConnTls(st);
    if (st.fd >= 0) {
        posix.shutdown(@intCast(st.fd), .both) catch {};
        posix.close(@intCast(st.fd));
        st.fd = -1;
    }
}

// Grow the per-conn request buffer past REQUEST_BUFFER only when a request
// actually needs it — a large declared body (the 8gbit echo) must fit whole
// before dispatch, but the baseline conn should never pay for it. Returns
// false past REQ_BUF_MAX: a conn claiming more than that is abuse, not a
// workload.
const REQ_BUF_MAX = 256 * 1024 * 1024;

// Per-worker sorted parked list — conns whose reply is staged but whose
// send waits on a handler-requested delay. Sorted by deadline so the head
// is the next wake; fireParked pops everything due. One worker thread per
// loop means threadlocal is the right scope — a parked conn never migrates.
threadlocal var parked_head: ?*ConnState = null;

fn parkInsert(st: *ConnState) void {
    var slot: *?*ConnState = &parked_head;
    while (slot.*) |next| {
        if (next.park_until > st.park_until) break;
        slot = &next.park_next;
    }
    st.park_next = slot.*;
    st.parked = true;
    slot.* = st;
}

// Milliseconds until the earliest parked conn is due — the ceiling a wait
// timeout must not exceed. maxInt when nothing is parked.
fn parkMsUntilDue() i64 {
    const head = parked_head orelse return std.math.maxInt(i64);
    const d = head.park_until - std.time.milliTimestamp();
    return if (d < 0) 0 else d;
}

// Detach the head if it is due; the caller clears park_until and re-arms —
// what "re-arm" means is the pump variant's own business.
fn parkDue() ?*ConnState {
    const head = parked_head orelse return null;
    if (head.park_until > std.time.milliTimestamp()) return null;
    parked_head = head.park_next;
    head.park_next = null;
    head.parked = false;
    head.park_until = 0;
    return head;
}

fn growReqBuf(st: *ConnState) bool {
    const want = @min(st.buf.len * 4, REQ_BUF_MAX);
    if (want <= st.buf.len) return false;
    const nb = pumpAlloc().alloc(u8, want) catch return false;
    @memcpy(nb[0..st.len], st.buf[0..st.len]);
    pumpAlloc().free(st.buf);
    st.buf = nb;
    return true;
}

// A conn dying while parked must leave the list — the head is live ConnState
// memory and a stale entry is a use-after-free the next fireParked walks into.
// O(n) unlink is fine: the list only ever holds delay-parked conns and removal
// happens once per such conn's death.
fn parkRemove(st: *ConnState) void {
    if (!st.parked) return;
    var slot: *?*ConnState = &parked_head;
    while (slot.*) |next| {
        if (next == st) {
            slot.* = st.park_next;
            break;
        }
        slot = &next.park_next;
    }
    st.park_next = null;
    st.parked = false;
    st.park_until = 0;
}

fn closeConnMem(st: *ConnState) void {
    parkRemove(st);
    if (st.buf.len > 0) {
        pumpAlloc().free(st.buf);
        st.buf = &.{};
    }
    st.ws_msg.deinit(pumpAlloc());
    st.h2_hpack.deinit(pumpAlloc());
    st.pending.deinit(pumpAlloc());
    wsqClear(st);
    st.recv_hold.deinit(pumpAlloc());
    if (st.send_buf.len > 0) {
        pumpAlloc().free(st.send_buf);
        st.send_buf = &.{};
    }
    st.len = 0;
}

fn closeConn(st: *ConnState) void {
    closeConnWire(st);
    closeConnMem(st);
}

// Drop one ConnState reference; the last drop frees the queues and the struct.
// The conn_states table holds the initial reference (1); every in-flight
// wsPublishFrame producer holds one more. releaseConn drops the table's ref
// after detaching; a producer that was still pushing drops its own after the
// push. The final fetchSub runs closeConnMem on whichever thread wins, after
// every producer has finished touching the queues.
fn connUnref(st: *ConnState) void {
    if (st.refs.fetchSub(1, .acq_rel) == 1) {
        closeConnMem(st);
        pumpAlloc().destroy(st);
    }
}

fn shutdownConn(st: *ConnState) void {
    if (st.fd >= 0) {
        posix.shutdown(@intCast(st.fd), .both) catch {};
    }
}

// A stalled peer must not stall the worker. `pending` is the answer a write
// couldn't deliver: bytes land there ordered, a readiness-for-write event
// drains them, and the reactor keeps moving. Above MAX_PENDING the peer is
// not slow, it is gone — the connection dies rather than buffering forever.
const MAX_PENDING: usize = 1 << 20;

const Flush = enum { drained, stalled, dead };

fn pendingLen(st: *ConnState) usize {
    return st.pending.items.len - st.pending_off;
}

// Claim a segment the renderer already wrote inside pending's own spare
// capacity — ringRenderTarget hands TLS conns the pending tail, so the
// pointer IS the queue: extending items (and, on an empty queue, skipping
// the renderer's head gap via pending_off, which is already the drain
// cursor) replaces the copy outright. Returns false for anything that
// isn't already in place — the caller falls back to a real append.
fn pendingClaim(st: *ConnState, seg: []const u8) bool {
    if (st.pending.capacity == 0) return false;
    const off = @intFromPtr(seg.ptr) -% @intFromPtr(st.pending.items.ptr);
    const end = off + seg.len;
    if (off >= st.pending.items.len and end <= st.pending.capacity) {
        if (off == st.pending.items.len) {
            // Contiguous with the queued tail — extend, no copy.
            st.pending.items = st.pending.items.ptr[0..end];
            return true;
        }
        if (st.pending.items.len == 0 and st.pending_off == 0) {
            // Head-parked render on an empty queue: the gap in front is
            // dead render space and pending_off skips it on drain.
            st.pending_off = off;
            st.pending.items = st.pending.items.ptr[0..end];
            return true;
        }
    }
    return false;
}

// Push what the socket will take right now, no waiting. `stalled` leaves the
// tail in pending for a write-ready event; the rearm that follows every
// dispatch is what asks the reactor for it.
fn flushPending(st: *ConnState) Flush {
    // A parked conn must not write — the arm gates suspend scheduling but
    // this is the socket egress every path (batch tails, WRITE events,
    // queueAndFlush, the SSL drain) funnels through. Stalled is the honest
    // answer: bytes are queued, the caller arms, and the park gate parks.
    if (st.park_until != 0) return .stalled;
    while (st.pending_off < st.pending.items.len) {
        if (HAS_OPENSSL) {
            if (st.ssl) |tls| {
                const mod = @import("root").koru_koru.koru_openssl;
                const s = tls.ssl orelse return .dead;
                switch (mod.sslWriteSome(s, st.pending.items[st.pending_off..])) {
                    .wrote => |n| st.pending_off += n,
                    .want_read, .want_write => return .stalled,
                    .failed => return .dead,
                }
                continue;
            }
        }
        const n = posix.write(@intCast(st.fd), st.pending.items[st.pending_off..]) catch |err| switch (err) {
            error.WouldBlock => return .stalled,
            else => return .dead,
        };
        if (n == 0) return .dead;
        st.pending_off += n;
    }
    st.pending.clearRetainingCapacity();
    st.pending_off = 0;
    return .drained;
}

// One broadcast allocation: the serialized frame plus its refcount.
fn frameAlloc(len: usize) ?*Frame {
    const f = pumpAlloc().create(Frame) catch return null;
    const bytes = pumpAlloc().alloc(u8, len) catch {
        pumpAlloc().destroy(f);
        return null;
    };
    f.* = .{ .refcount = std.atomic.Value(u32).init(1), .bytes = bytes };
    return f;
}

fn frameIncref(f: *Frame) void {
    _ = f.refcount.fetchAdd(1, .monotonic);
}

fn frameDecref(f: *Frame) void {
    if (f.refcount.fetchSub(1, .acq_rel) == 1) {
        pumpAlloc().free(f.bytes);
        pumpAlloc().destroy(f);
    }
}

// Total broadcast bytes queued (atomic; readable from any thread). Producers
// add a full frame on push and roll back when over MAX_PENDING; the owner
// subtracts exactly what it writes.
fn wsqBytes(st: *ConnState) usize {
    return st.wsq_bytes.load(.monotonic);
}

// MPSC append (Vyukov). Producers only; the owner never pushes here.
fn wsqPush(st: *ConnState, node: *WsSeg) void {
    node.next.store(null, .release);
    const prev = st.wsq_tail.swap(node, .acq_rel);
    if (prev) |p| p.next.store(node, .release);
}

// Drop every remaining broadcast node (teardown). Runs when the refcount hits
// zero — no producer can be appending.
fn wsqClear(st: *ConnState) void {
    const head = st.wsq_head orelse return;
    var node: ?*WsSeg = head.next.load(.acquire);
    while (node) |n| {
        const next = n.next.load(.acquire);
        frameDecref(n.frame);
        pumpAlloc().destroy(n);
        node = next;
    }
    if (head != &st.wsq_stub) pumpAlloc().destroy(head);
    st.wsq_head = null;
    st.wsq_tail.store(null, .monotonic);
}

// Push one refcounted broadcast frame into the lock-free queue, respecting
// MAX_PENDING via the atomic byte counter. The caller already holds a
// reference it will drop; this appends one more (the queue's), which the
// owner's drain drops on completion.
fn wsqPushFrame(st: *ConnState, f: *Frame) bool {
    const add = f.bytes.len;
    if (st.wsq_bytes.fetchAdd(add, .monotonic) + add > MAX_PENDING) {
        _ = st.wsq_bytes.fetchSub(add, .monotonic);
        return false;
    }
    const node = pumpAlloc().create(WsSeg) catch {
        _ = st.wsq_bytes.fetchSub(add, .monotonic);
        return false;
    };
    node.* = .{ .frame = f, .off = 0 };
    frameIncref(f);
    wsqPush(st, node);
    return true;
}

const IOVEC_BATCH = 64;

// The owner-side drain of the broadcast queue. TLS writes go through
// sslWriteSome one node at a time (a frame can straddle WANT_WRITE), and
// cleartext gathers up to IOVEC_BATCH nodes into one writev. The sentinel
// head stays behind by one node — the retired node frees on the NEXT drain
// step, so a producer racing in sees a stable list.
fn flushWsq(st: *ConnState) Flush {
    while (true) {
        const head = st.wsq_head orelse break;
        const cur = head.next.load(.acquire) orelse break;
        if (HAS_OPENSSL) {
            if (st.ssl) |tls| {
                const mod = @import("root").koru_koru.koru_openssl;
                const s = tls.ssl orelse return .dead;
                switch (mod.sslWriteSome(s, cur.frame.bytes[cur.off..])) {
                    .wrote => |w| {
                        cur.off += w;
                        _ = st.wsq_bytes.fetchSub(w, .monotonic);
                        if (cur.off == cur.frame.bytes.len) {
                            frameDecref(cur.frame);
                            st.wsq_head = cur;
                            if (head != &st.wsq_stub) pumpAlloc().destroy(head);
                        }
                    },
                    .want_read, .want_write => return .stalled,
                    .failed => return .dead,
                }
                continue;
            }
        }
        var iov: [IOVEC_BATCH]posix.iovec_const = undefined;
        var count: usize = 0;
        var node: ?*WsSeg = cur;
        while (node) |n| {
            if (count == iov.len) break;
            iov[count] = .{ .base = n.frame.bytes.ptr + n.off, .len = n.frame.bytes.len - n.off };
            count += 1;
            node = n.next.load(.acquire);
        }
        const n = posix.writev(@intCast(st.fd), iov[0..count]) catch |err| switch (err) {
            error.WouldBlock => return .stalled,
            else => return .dead,
        };
        if (n == 0) return .dead;
        _ = st.wsq_bytes.fetchSub(n, .monotonic);
        var rem = n;
        while (rem > 0) {
            const h2 = st.wsq_head orelse break;
            const c2 = h2.next.load(.acquire) orelse break;
            const left = c2.frame.bytes.len - c2.off;
            if (rem >= left) {
                rem -= left;
                c2.off = c2.frame.bytes.len;
                frameDecref(c2.frame);
                st.wsq_head = c2;
                if (h2 != &st.wsq_stub) pumpAlloc().destroy(h2);
            } else {
                c2.off += rem;
                rem = 0;
            }
        }
    }
    return .drained;
}

// Work the owner's write side still owes: the mutex-guarded byte queue (own
// replies, ws-send-fd control frames) OR the lock-free broadcast queue.
fn hasWork(st: *ConnState) bool {
    return pendingLen(st) > 0 or wsqBytes(st) > 0;
}

// The owner reactor's drain. `flushPending` is caller-locked: ws-mode callers
// hold ws_mu (the owner's inline paths and `ws-send-fd` both write `pending`
// under it). The broadcast PRODUCER (wsPublishFrame) never takes ws_mu — it
// pushes wsq lock-free — so this is not the hot path. http-mode pending is
// owner-thread-only (no ws_mu).
fn flushPendingOwned(st: *ConnState) Flush {
    if (st.mode == .ws) st.ws_mu.lock();
    defer if (st.mode == .ws) st.ws_mu.unlock();
    const pr = flushPending(st);
    if (pr == .dead) {
        st.armed.store(false, .release);
        return .dead;
    }
    if (pr == .stalled) {
        st.armed.store(false, .release);
        return .stalled;
    }
    const wr = flushWsq(st);
    st.armed.store(false, .release);
    if (wr == .dead) return .dead;
    if (hasWork(st)) return .stalled;
    return .drained;
}

// Batch append: queue without flushing. Over the cap the socket drains
// inline first — a full queue is the socket's problem, not the app's.
// Caller-locked: ws-mode conns reach this only from wsSendFrameRaw, whose
// two callers (ws-send in a frame arm, ws-send-fd) already hold ws_mu —
// taking it again here self-deadlocks the worker. ws-send-fd writes can
// race the owner's post-upgrade replies on the shared ArrayList, which is
// exactly what ws_mu serializes at the call sites.
fn appendPending(st: *ConnState, segments: []const []const u8) bool {
    var need: usize = 0;
    for (segments) |seg| need += seg.len;
    if (st.owner_ring != null) {
        // Ring conns never flush inline — output is the next send SQE's job.
        // No send in flight means send_buf is unpinned and can grow under us;
        // with one in flight the kernel owns it, so bytes queue in pending
        // instead. ws conns always take the pending leg: a foreign pusher
        // shares only that region under ws_mu, never the buffer a submit is
        // about to pin. Socket-BIO TLS conns take pending too: their wire is
        // OpenSSL's, so send_buf must never see their plaintext.
        if (st.send_len == 0 and st.send_iov_n == 0 and st.mode != .ws and !st.tls_sockbio) {
            // Plan mode: once any segment in this window was staged as an
            // iovec, every later byte must be plan-recorded too — wire order
            // is the plan's, not the buffer's. A seg that arrives when the
            // plan is full spills to pending and drains in the NEXT window.
            const plan_mode = st.send_plan_n > 0;
            for (segments, 0..) |seg, si| {
                if (seg.len == 0) continue;
                if (plan_mode and st.send_plan_n == SEND_PLAN_MAX)
                    return spillToPending(st, segments[si..]);
                if (!stageIntoSendBuf(st, seg, plan_mode)) return false;
            }
            return true;
        }
        if (pendingLen(st) + need > MAX_PENDING) return false;
        var i: usize = 0;
        while (i < segments.len and pendingClaim(st, segments[i])) i += 1;
        if (i == segments.len) return true;
        st.pending.ensureUnusedCapacity(pumpAlloc(), need) catch return false;
        for (segments[i..]) |seg| st.pending.appendSliceAssumeCapacity(seg);
        return true;
    }
    if (st.pending.items.len + need > MAX_PENDING) {
        if (flushPending(st) == .dead) return false;
        if (st.pending.items.len + need > MAX_PENDING) return false;
    }
    st.pending.ensureUnusedCapacity(pumpAlloc(), need) catch return false;
    for (segments) |seg| st.pending.appendSliceAssumeCapacity(seg);
    return true;
}

fn planRecord(st: *ConnState, entry: SendPlanEntry) void {
    st.send_plan[st.send_plan_n] = entry;
    st.send_plan_n += 1;
}

// One segment into the ring window: claim in-place renders, copy the rest.
// The empty-segment check lives in the callers — they know whether a zero
// len means "skip" (loop) or "absent" (pair).
fn stageIntoSendBuf(st: *ConnState, seg: []const u8, plan_mode: bool) bool {
    // Rendered straight into send_buf via ringRenderTarget —
    // claim the span instead of copying it. The renderer
    // reserved capacity, so the buffer cannot need growth here.
    if (seg.ptr == st.send_buf.ptr + st.send_staged) {
        if (plan_mode) planRecord(st, .{ .base = st.send_staged, .len = seg.len, .buf = true });
        st.send_staged += seg.len;
        return true;
    }
    // Head-parked render: the renderer left a gap inside
    // send_buf and composed the response head into it, so the
    // message it returns starts at send_buf + send_base instead
    // of the staging boundary. The claim is free only while the
    // window is empty — a gap between staged bytes and a later
    // claim would go out on the wire — so once anything is
    // staged this falls through to the copy leg like before.
    if (st.send_staged == 0) {
        const off = @intFromPtr(seg.ptr) -% @intFromPtr(st.send_buf.ptr);
        if (off < st.send_buf.len and off + seg.len <= st.send_buf.len and off + seg.len <= MAX_PENDING) {
            if (plan_mode) planRecord(st, .{ .base = off, .len = seg.len, .buf = true });
            st.send_base = off;
            st.send_staged = off + seg.len;
            return true;
        }
    }
    if (st.send_staged + seg.len > MAX_PENDING) return false;
    if (st.send_buf.len < st.send_staged + seg.len) {
        const nb = pumpAlloc().alloc(u8, @max(4096, st.send_buf.len * 2, st.send_staged + seg.len)) catch return false;
        @memcpy(nb[0..st.send_staged], st.send_buf[0..st.send_staged]);
        if (st.send_buf.len > 0) pumpAlloc().free(st.send_buf);
        st.send_buf = nb;
    }
    // A slice inside send_buf but not at the staged boundary
    // can only be a displaced pre-stage — the ranges overlap,
    // so forwards is the defined order.
    if (@intFromPtr(seg.ptr) -% @intFromPtr(st.send_buf.ptr) < st.send_buf.len) {
        std.mem.copyForwards(u8, st.send_buf[st.send_staged..][0..seg.len], seg);
    } else {
        @memcpy(st.send_buf[st.send_staged..][0..seg.len], seg);
    }
    if (plan_mode) planRecord(st, .{ .base = st.send_staged, .len = seg.len, .buf = true });
    st.send_staged += seg.len;
    return true;
}

// The two-segment hot path: writevAllConn hands head+body (or a baked flat
// head + body) straight through in registers — no stack-resident segment
// array built and re-read per response. Same merge rules as appendPending,
// which stays for the N-segment callers; the plan-full guard differs in
// one way: with no index into a remainder slice, a full plan on `b`
// spills just `b`.
fn appendPair(st: *ConnState, a: []const u8, b: []const u8) bool {
    const need = a.len + b.len;
    if (st.owner_ring != null) {
        if (st.send_len == 0 and st.send_iov_n == 0 and st.mode != .ws and !st.tls_sockbio) {
            const plan_mode = st.send_plan_n > 0;
            if (a.len != 0) {
                if (plan_mode and st.send_plan_n == SEND_PLAN_MAX)
                    return spillToPending(st, &.{ a, b });
                if (!stageIntoSendBuf(st, a, plan_mode)) return false;
            }
            if (b.len != 0) {
                if (plan_mode and st.send_plan_n == SEND_PLAN_MAX)
                    return spillToPending(st, &.{b});
                if (!stageIntoSendBuf(st, b, plan_mode)) return false;
            }
            return true;
        }
        if (pendingLen(st) + need > MAX_PENDING) return false;
        // A reply rendered into pending's own tail claims by pointer —
        // only segments not already in place pay the copy. `a` claimed
        // already moved its bytes into items, so `b` alone may still need
        // the append; claiming first means a growth here cannot dangle a.
        if (pendingClaim(st, a)) {
            if (!pendingClaim(st, b)) {
                st.pending.ensureUnusedCapacity(pumpAlloc(), b.len) catch return false;
                st.pending.appendSliceAssumeCapacity(b);
            }
            return true;
        }
        st.pending.ensureUnusedCapacity(pumpAlloc(), need) catch return false;
        st.pending.appendSliceAssumeCapacity(a);
        st.pending.appendSliceAssumeCapacity(b);
        return true;
    }
    if (st.pending.items.len + need > MAX_PENDING) {
        if (flushPending(st) == .dead) return false;
        if (st.pending.items.len + need > MAX_PENDING) return false;
    }
    st.pending.ensureUnusedCapacity(pumpAlloc(), need) catch return false;
    st.pending.appendSliceAssumeCapacity(a);
    st.pending.appendSliceAssumeCapacity(b);
    return true;
}

// Segments that arrive after the plan filled are newer than the window's —
// pending drains only after this send completes, so queueing them there is
// the order-preserving answer. spill_mark tags where the newer bytes begin
// so advance doesn't promote them into THIS window ahead of the plan.
fn spillToPending(st: *ConnState, segments: []const []const u8) bool {
    if (st.spill_mark == std.math.maxInt(usize)) st.spill_mark = st.pending.items.len;
    var need: usize = 0;
    for (segments) |seg| need += seg.len;
    if (pendingLen(st) + need > MAX_PENDING) return false;
    st.pending.ensureUnusedCapacity(pumpAlloc(), need) catch return false;
    for (segments) |seg| st.pending.appendSliceAssumeCapacity(seg);
    return true;
}

// One planned segment: immortal memory records a raw-pointer entry, anything
// else is copied into send_buf and records an OFFSET — send_buf may still
// grow before this window submits, so storing its pointer now would dangle.
fn stageSeg(st: *ConnState, seg: []const u8, stable: bool) bool {
    if (seg.len == 0) return true;
    if (stable) {
        planRecord(st, .{ .base = @intFromPtr(seg.ptr), .len = seg.len, .buf = false });
        return true;
    }
    if (st.send_staged + seg.len > MAX_PENDING) return false;
    if (st.send_buf.len < st.send_staged + seg.len) {
        const nb = pumpAlloc().alloc(u8, @max(4096, st.send_buf.len * 2, st.send_staged + seg.len)) catch return false;
        @memcpy(nb[0..st.send_staged], st.send_buf[0..st.send_staged]);
        if (st.send_buf.len > 0) pumpAlloc().free(st.send_buf);
        st.send_buf = nb;
    }
    @memcpy(st.send_buf[st.send_staged..][0..seg.len], seg);
    planRecord(st, .{ .base = st.send_staged, .len = seg.len, .buf = true });
    st.send_staged += seg.len;
    return true;
}

// The scatter-send leg: whichever of head/body the handler vouched immortal
// (Response.body_static → a rodata template) rides the send SQE as an iovec
// — no copy into send_buf. The Date line is threadlocal and flips on the
// next second, so it gets the window's one pinned copy in send_buf, deduped
// by content since a pipelined batch shares the second.
fn stageIovStatic(st: *ConnState, head: []const u8, body: []const u8, date_hole: usize, date_line: []const u8, head_static: bool, body_static: bool) bool {
    // Adopt any unplanned staged bytes as one BUF entry — they are older
    // than this response and must precede it on the wire.
    if (st.send_plan_n == 0 and st.send_staged > st.send_base)
        planRecord(st, .{ .base = st.send_base, .len = st.send_staged - st.send_base, .buf = true });

    const need: usize = @as(usize, if (date_hole != 0) 3 else 1) + @intFromBool(body.len != 0);
    if (st.send_plan_n + need > SEND_PLAN_MAX) {
        const segs: [4][]const u8 = if (date_hole != 0)
            .{ head[0..date_hole], date_line, head[date_hole..], body }
        else
            .{ head, body, "", "" };
        return spillToPending(st, &segs);
    }

    if (date_hole == 0) {
        if (!stageSeg(st, head, head_static)) return false;
    } else {
        if (!stageSeg(st, head[0..date_hole], head_static)) return false;
        // Pin the Date line once per window-second; a matching earlier pin
        // is reused — iov order is the plan's, so pointing backward inside
        // send_buf is fine.
        if (st.send_date_len == date_line.len and st.send_date_off + date_line.len <= st.send_staged and
            std.mem.eql(u8, st.send_buf[st.send_date_off..][0..date_line.len], date_line))
        {
            planRecord(st, .{ .base = st.send_date_off, .len = date_line.len, .buf = true });
        } else {
            if (st.send_staged + date_line.len > MAX_PENDING) return false;
            if (st.send_buf.len < st.send_staged + date_line.len) {
                const nb = pumpAlloc().alloc(u8, @max(4096, st.send_buf.len * 2, st.send_staged + date_line.len)) catch return false;
                @memcpy(nb[0..st.send_staged], st.send_buf[0..st.send_staged]);
                if (st.send_buf.len > 0) pumpAlloc().free(st.send_buf);
                st.send_buf = nb;
            }
            @memcpy(st.send_buf[st.send_staged..][0..date_line.len], date_line);
            st.send_date_off = st.send_staged;
            st.send_date_len = date_line.len;
            planRecord(st, .{ .base = st.send_staged, .len = date_line.len, .buf = true });
            st.send_staged += date_line.len;
        }
        if (!stageSeg(st, head[date_hole..], head_static)) return false;
    }
    return stageSeg(st, body, body_static);
}

// A renderer may ask for space inside the dispatching conn's send_buf and
// write the response where it will be sent from — appendPending claims the
// span by pointer match instead of copying it. Null wherever staging into
// send_buf would be unsafe: a send SQE owns the buffer while in flight, ws
// shares it under ws_mu, and a socket-BIO TLS conn owes the bytes a trip
// through the cipher before they may touch the wire.
pub fn ringRenderTarget(fd: posix.fd_t, min_len: usize) ?[]u8 {
    const st = connState(@intCast(fd)) orelse return null;
    if (st.owner_ring == null or st.mode == .ws or st.send_len != 0 or st.send_iov_n != 0) return null;
    if (HAS_OPENSSL and st.ssl != null) {
        // Socket-BIO TLS: send_buf must never see plaintext (OpenSSL owns
        // the wire), but pending IS this conn's pre-encryption queue — a
        // render into its tail is claimed by the pointer match in
        // pendingClaim instead of copied. The empty-queue requirement is
        // what makes every rendered span claimable: a head gap in front of
        // the message becomes a leading pending_off skip, which a nonempty
        // queue could not express.
        if (!st.tls_sockbio or st.pending.items.len != 0 or st.pending_off != 0) return null;
        if (min_len > MAX_PENDING) return null;
        st.pending.ensureUnusedCapacity(pumpAlloc(), min_len) catch return null;
        return st.pending.items.ptr[0..st.pending.capacity];
    }
    if (st.send_staged + min_len > MAX_PENDING) return null;
    if (st.send_buf.len < st.send_staged + min_len) {
        const nb = pumpAlloc().alloc(u8, @max(4096, st.send_buf.len * 2, st.send_staged + min_len)) catch return null;
        @memcpy(nb[0..st.send_staged], st.send_buf[0..st.send_staged]);
        if (st.send_buf.len > 0) pumpAlloc().free(st.send_buf);
        st.send_buf = nb;
    }
    return st.send_buf[st.send_staged..];
}

// Append an ordered segment to the queue and try to drain — the shape every
// write takes when the queue is already holding bytes or the cipher needs
// one contiguous buffer. `false` means dead, never merely unwritten.
fn queueAndFlush(st: *ConnState, segments: []const []const u8) bool {
    var need: usize = 0;
    for (segments) |seg| need += seg.len;
    if (st.pending.items.len + need > MAX_PENDING) return false;
    st.pending.ensureUnusedCapacity(pumpAlloc(), need) catch return false;
    for (segments) |seg| st.pending.appendSliceAssumeCapacity(seg);
    return flushPending(st) != .dead;
}

// TLS write path: hand each segment to SSL_write directly and only queue what
// the cipher refuses — the common case never touches `pending`, so a response
// does not pay an allocation + copy before encryption. Ordering is the queue's
// job once it holds bytes, so a stalled conn falls back to queueAndFlush.
fn tlsWriteOrQueue(st: *ConnState, segments: []const []const u8) bool {
    const mod = @import("root").koru_koru.koru_openssl;
    const s = st.ssl.?.ssl orelse return false;
    if (pendingLen(st) > 0) return queueAndFlush(st, segments);
    for (segments, 0..) |seg, si| {
        var off: usize = 0;
        while (off < seg.len) {
            switch (mod.sslWriteSome(s, seg[off..])) {
                .wrote => |n| off += n,
                .want_read, .want_write => {
                    // Queue the unwritten remainder — this segment's tail plus
                    // every segment after it.
                    var need: usize = seg.len - off;
                    for (segments[si + 1 ..]) |rest| need += rest.len;
                    if (st.pending.items.len + need > MAX_PENDING) return false;
                    st.pending.ensureUnusedCapacity(pumpAlloc(), need) catch return false;
                    st.pending.appendSliceAssumeCapacity(seg[off..]);
                    for (segments[si + 1 ..]) |rest| st.pending.appendSliceAssumeCapacity(rest);
                    return true;
                },
                .failed => return false,
            }
        }
    }
    return true;
}

fn writeAllConn(st: *ConnState, data: []const u8) bool {
    if (st.batching or st.owner_ring != null) return appendPending(st, &.{data});
    if (HAS_OPENSSL) {
        if (st.ssl != null) {
            return tlsWriteOrQueue(st, &.{data});
        }
    }
    if (pendingLen(st) > 0) return queueAndFlush(st, &.{data});
    return writeAllOrQueue(st, data);
}

// Cleartext fast path: write straight through, and only when the kernel
// refuses mid-write does the remainder become pending bytes. Keeps the
// no-stall case allocation-free.
fn writeAllOrQueue(st: *ConnState, data: []const u8) bool {
    var offset: usize = 0;
    while (offset < data.len) {
        const n = posix.write(@intCast(st.fd), data[offset..]) catch |err| switch (err) {
            error.WouldBlock => {
                const segs = [_][]const u8{data[offset..]};
                return queueAndFlush(st, &segs);
            },
            else => return false,
        };
        if (n == 0) return false;
        offset += @intCast(n);
    }
    return true;
}

// head+body in ONE syscall — writev gathers both without a copy. TLS is a
// stream cipher with no scatter write: the ssl leg stages head+body into
// pending as ONE buffer, so a response leaves as a single TLS record instead
// of four sslWriteAll calls each paying a record of crypto.
//
// `date_hole` is where a `Date:` line belongs inside `head` — baked static
// responses are const rodata and cannot be patched, so the line goes out as a
// middle iovec (same syscall, one extra vector). The slice points at the
// orisha module's per-second threadlocal buffer: a lookup, not a format.
// Scatter-send pays only where it skips a real copy. Measured 2026-10-11 on
// the pipeline profile: a ~150-byte static head as raw iovecs LOST ~11% to
// the flat send_buf copy — the iovec materialization plus the kernel's
// import of ~24 scattered vectors costs more than memcpy'ing L1-hot bytes.
// Below a page the copy is the fast path; above it, skipping it is.
const SCATTER_MIN: usize = 4096;

// A holed static head needs its Date line spliced per send — composing
// head+line+tail into one flat segment once per (head, second) turns three
// appendPending copies into one per response. The bake lives per worker in
// threadlocal: rodata head pointers are stable keys and the line flips once
// a second, so a tiny direct-mapped cache amortizes the splice over the
// million sends a hot route does in that second. Bigger-than-cap heads take
// the ordinary three-segment path.
const BAKE_SLOTS = 4;
const BAKE_CAP = 4096;
threadlocal var bake_ptr: [BAKE_SLOTS]?[*]const u8 = .{ null, null, null, null };
threadlocal var bake_line: [BAKE_SLOTS][37]u8 = undefined;
threadlocal var bake_len: [BAKE_SLOTS]usize = .{ 0, 0, 0, 0 };
threadlocal var bake_buf: [BAKE_SLOTS][BAKE_CAP]u8 = undefined;

fn bakedSegment(head: []const u8, date_hole: usize, date_line: []const u8, head_static: bool) ?[]const u8 {
    const need = head.len + date_line.len;
    if (need > BAKE_CAP or date_line.len > 37) return null;
    if (head_static) {
        const slot: usize = (@intFromPtr(head.ptr) >> 6) & (BAKE_SLOTS - 1);
        if (bake_ptr[slot] == head.ptr and bake_len[slot] == need and
            std.mem.eql(u8, bake_line[slot][0..date_line.len], date_line))
        {
            return bake_buf[slot][0..need];
        }
        @memcpy(bake_buf[slot][0..date_hole], head[0..date_hole]);
        @memcpy(bake_buf[slot][date_hole..][0..date_line.len], date_line);
        @memcpy(bake_buf[slot][date_hole + date_line.len ..][0 .. head.len - date_hole], head[date_hole..]);
        @memcpy(bake_line[slot][0..date_line.len], date_line);
        bake_ptr[slot] = head.ptr;
        bake_len[slot] = need;
        return bake_buf[slot][0..need];
    }
    // Not cacheable — compose into slot 0 anyway so the send still leaves as
    // one flat copy; the next request may overwrite it, which is safe: the
    // caller hands it to appendPending, which copies synchronously.
    @memcpy(bake_buf[0][0..date_hole], head[0..date_hole]);
    @memcpy(bake_buf[0][date_hole..][0..date_line.len], date_line);
    @memcpy(bake_buf[0][date_hole + date_line.len ..][0 .. head.len - date_hole], head[date_hole..]);
    return bake_buf[0][0..need];
}

fn writevAllConn(st: *ConnState, head: []const u8, body: []const u8, date_hole: usize, head_static: bool, body_static: bool) bool {
    const date_line: []const u8 = if (date_hole != 0) @import("root").koru_orisha.httpDateLine() else "";
    // Handler-vouched immortal memory rides the send SQE as iovecs instead
    // of copying — when the segment is big enough for the copy to matter.
    // Gated the same places send_buf staging is: a send in flight pins the
    // window, ws and socket-BIO TLS are their own output paths.
    const big = (head_static and head.len >= SCATTER_MIN) or (body_static and body.len >= SCATTER_MIN);
    if (big and st.owner_ring != null and st.mode != .ws and st.send_len == 0 and st.send_iov_n == 0 and st.ssl == null)
        return stageIovStatic(st, head, body, date_hole, date_line, head_static, body_static);
    // A holed head composes once per second — one flat segment beats three
    // small copies through appendPending.
    if (st.batching or st.owner_ring != null) {
        if (date_hole == 0) return appendPair(st, head, body);
        if (bakedSegment(head, date_hole, date_line, head_static)) |flat|
            return appendPair(st, flat, body);
        const segs4: [4][]const u8 = .{ head[0..date_hole], date_line, head[date_hole..], body };
        return appendPending(st, &segs4);
    }
    const segs: [4][]const u8 = if (date_hole != 0)
        .{ head[0..date_hole], date_line, head[date_hole..], body }
    else
        .{ head, body, "", "" };
    if (HAS_OPENSSL) {
        if (st.ssl != null) {
            return tlsWriteOrQueue(st, &segs);
        }
    }
    if (pendingLen(st) > 0) {
        return queueAndFlush(st, &segs);
    }
    var iov = [4]posix.iovec_const{
        .{ .base = head.ptr, .len = head.len },
        .{ .base = if (body.len == 0) head.ptr else body.ptr, .len = body.len },
        undefined,
        undefined,
    };
    var total = head.len + body.len;
    if (date_hole != 0) {
        iov = .{
            .{ .base = head.ptr, .len = date_hole },
            .{ .base = date_line.ptr, .len = date_line.len },
            .{ .base = head.ptr + date_hole, .len = head.len - date_hole },
            .{ .base = if (body.len == 0) head.ptr else body.ptr, .len = body.len },
        };
        total += date_line.len;
    }
    // The live iovec count: 4 when the Date splice widened the set, 2
    // otherwise. Slicing `iov[idx..]` unbounded would hand writev the
    // `undefined` tail — a len of garbage is an instant EFAULT and a dead
    // connection, which is why this bound exists at all.
    const iov_count: usize = if (date_hole != 0) 4 else 2;
    var idx: usize = if (head.len == 0) 1 else 0;
    while (total > 0) {
        const n = posix.writev(@intCast(st.fd), iov[idx..][0 .. iov_count - idx]) catch |err| switch (err) {
            error.WouldBlock => {
                // The socket is full — the unwritten iovec tail becomes
                // pending bytes and a write-ready event finishes the send.
                var tail_segs: [4][]const u8 = undefined;
                var seg_count: usize = 0;
                for (iov[idx..iov_count]) |v| {
                    if (v.len == 0) continue;
                    tail_segs[seg_count] = v.base[0..v.len];
                    seg_count += 1;
                }
                return queueAndFlush(st, tail_segs[0..seg_count]);
            },
            else => return false,
        };
        if (n == 0) return false;
        var rem: usize = @intCast(n);
        total -= rem;
        while (rem > 0 and idx < iov_count) {
            if (rem >= iov[idx].len) {
                rem -= iov[idx].len;
                idx += 1;
            } else {
                iov[idx].base += rem;
                iov[idx].len -= rem;
                rem = 0;
            }
        }
    }
    return true;
}

// Writing to a peer-closed socket raises SIGPIPE; the default action kills
// the process silently. Any server that keep-alives must ignore it once, up
// front — then send/write/SSL_write return EPIPE and the write loop treats a
// vanished peer as an ordinary close. Called at the top of every drive body.
fn ignoreSigpipe() void {
    const ign = posix.Sigaction{
        .handler = .{ .handler = posix.SIG.IGN },
        .mask = posix.sigemptyset(),
        .flags = 0,
    };
    posix.sigaction(posix.SIG.PIPE, &ign, null);
}

fn maybeStartTls(
    tls_port: ?u16,
    cert_path: ?[]const u8,
    key_path: ?[]const u8,
) ?[]const u8 {
    if (HAS_OPENSSL) {
        const tp = tls_port orelse return null;
        const cert = cert_path orelse "/certs/server.crt";
        const key = key_path orelse "/certs/server.key";
        const loaded = @import("root").koru_koru.koru_openssl.loadServerCtx(std.heap.page_allocator, cert, key);
        switch (loaded) {
            .ok => |ctx| {
                tls_server_ctx = ctx;
                tls_listen_port = tp;
                return null;
            },
            .err => |e| return e.msg,
        }
    } else {
        // Params unused when the gate is false — a plain `_ =` discard is a
        // compile error on targets where the branch above is live, so these
        // are real references in a branch that is never emitted there.
        std.mem.doNotOptimizeAway(cert_path);
        std.mem.doNotOptimizeAway(key_path);
    }
    return if (tls_port != null)
        "orisha:serve got tls_port, but this target cannot link openssl"
    else
        null;
}

// The TLS handle types, named not opaque: a connection's `ssl` is an open
// `*Tls` the ConnState owns until releaseConn frees it (releaseServerSsl +
// destroy — the pump keeps the fd, so the package's `close` is NOT called;
// it would double-close the socket). Both are comptime-selected off
// HAS_OPENSSL so a non-TLS target never resolves the openssl cImport — the
// same gate that keeps cross-compile free of openssl headers.
const ServerTls = if (HAS_OPENSSL) @import("root").koru_koru.koru_openssl.Tls else anyopaque;
const ServerTlsCtx = if (HAS_OPENSSL) @import("root").koru_koru.koru_openssl.ServerCtx else anyopaque;

var tls_server_ctx: ?*ServerTlsCtx = null;
// h2-over-TLS is a dedicated ctx, not the shared one — the ALPN select
// callback is h2-or-nothing, and installing it on the h1-TLS ctx would
// fail every client that honestly offers "h1".
var h2_tls_server_ctx: ?*ServerTlsCtx = null;
var h2_tls_listen_port: u16 = 0;
var tls_listen_port: u16 = 0;
// Prior-knowledge HTTP/2 cleartext listener — the harness's h2c port is
// fixed at 8082 and the entry opts in via H2C_PORT, the same env-driven
// shape as STATIC_DIR: zero stays a `.k`-surface-free opt-out.
var h2c_listen_port: u16 = 0;

fn h2cPortEnv() u16 {
    const s = std.posix.getenv("H2C_PORT") orelse return 0;
    return std.fmt.parseInt(u16, s, 10) catch 0;
}

// h2-over-TLS listener — the arena publishes :8443 for baseline-h2 /
// static-h2 / unary-grpc-tls. Same certs as the h1-TLS port, its own ctx
// because the ALPN policy differs.
fn h2TlsPortEnv() u16 {
    const s = std.posix.getenv("H2_TLS_PORT") orelse return 0;
    return std.fmt.parseInt(u16, s, 10) catch 0;
}

// Load the h2-TLS ctx once when the port is declared: same cert pair, the
// h2-only ALPN select callback. Failure is a startup refusal, same rule
// as maybeStartTls.
fn maybeStartH2Tls(port_env: u16, cert_path: ?[]const u8, key_path: ?[]const u8) ?[]const u8 {
    if (HAS_OPENSSL) {
        if (port_env == 0) return null;
        const cert = cert_path orelse "/certs/server.crt";
        const key = key_path orelse "/certs/server.key";
        const loaded = @import("root").koru_koru.koru_openssl.loadServerCtx(std.heap.page_allocator, cert, key);
        switch (loaded) {
            .ok => |ctx| {
                @import("root").koru_koru.koru_openssl.setAlpnH2Only(ctx);
                h2_tls_server_ctx = ctx;
                h2_tls_listen_port = port_env;
                return null;
            },
            .err => |e| return e.msg,
        }
    }
    return if (port_env != 0)
        "H2_TLS_PORT set, but this target cannot link openssl"
    else
        null;
}

// ── HTTP/2 cleartext (h2c) — prior-knowledge per the arena profile ──────────
// Skeleton shape: the client preface and the SETTINGS exchange are protocol
// overhead every h2c conn pays once; frames are parsed header-first and the
// ones this skeleton doesn't serve yet are ignored per RFC 7540 §5.5 —
// stream machinery (HEADERS/DATA/flow control) lands on top of this.
// ── HPACK decoder — RFC 7541 ────────────────────────────────────────────────
//
// Splice note: `const std` below exists so this file also compiles alone
// (the standalone test @imports it). pump.kz already declares `std` — at
// top level drop this line, inside a wrapper struct it is a private alias
// and may stay.

// One decoded header field. The slices are borrows — static-table literals,
// bytes of the block itself, or dynamic-table memory — and stay valid until
// the next hpackDecode call on this table or HpackTable.deinit.
pub const HpackPair = struct {
    name: []const u8,
    value: []const u8,
};

// Per-connection HPACK state (RFC 7541 §4): the dynamic table plus the
// scratch that keeps the borrow contract honest. `.{}` is a ready table at
// the RFC 7540 default SETTINGS_HEADER_TABLE_SIZE.
pub const HpackTable = struct {
    // Newest entry LAST — dynamic index 62 is entries.items[len - 1].
    // Appending is O(1); eviction removes index 0 (oldest) only when the
    // table is over budget, so the front-shift is rare and small.
    entries: std.ArrayListUnmanaged(HpackPair) = .{},
    // Sum of name.len + value.len + 32 over live entries (RFC §4.1).
    size: usize = 0,
    max_size: usize = 4096,
    // Allocations whose bytes must survive to the next decode: Huffman
    // output not adopted into `entries`, and entry bytes evicted mid-block
    // that already-emitted pairs may still point at. Freed at the top of
    // the next hpackDecode and at deinit — that boundary IS the contract.
    retired: std.ArrayListUnmanaged([]const u8) = .{},

    pub fn deinit(table: *HpackTable, alloc: std.mem.Allocator) void {
        for (table.entries.items) |e| {
            alloc.free(e.name);
            alloc.free(e.value);
        }
        table.entries.deinit(alloc);
        for (table.retired.items) |s| alloc.free(s);
        table.retired.deinit(alloc);
        table.* = .{};
    }
};

// Highest table size a peer may declare via a §6.3 size update: the value we
// advertise in SETTINGS_HEADER_TABLE_SIZE. pump.kz emits an empty SETTINGS
// frame, so the negotiated value is the RFC 7540 default 4096 — a larger
// update is a connection error. If the SETTINGS frame ever carries an
// explicit value, this tracks it.
const HPACK_MAX_TABLE_SIZE = 4096;

// RFC 7541 Appendix A — the static table, 1-indexed on the wire.
const HPACK_STATIC_COUNT = 61;
const HPACK_STATIC = [HPACK_STATIC_COUNT]HpackPair{
    .{ .name = ":authority", .value = "" },
    .{ .name = ":method", .value = "GET" },
    .{ .name = ":method", .value = "POST" },
    .{ .name = ":path", .value = "/" },
    .{ .name = ":path", .value = "/index.html" },
    .{ .name = ":scheme", .value = "http" },
    .{ .name = ":scheme", .value = "https" },
    .{ .name = ":status", .value = "200" },
    .{ .name = ":status", .value = "204" },
    .{ .name = ":status", .value = "206" },
    .{ .name = ":status", .value = "304" },
    .{ .name = ":status", .value = "400" },
    .{ .name = ":status", .value = "404" },
    .{ .name = ":status", .value = "500" },
    .{ .name = "accept-charset", .value = "" },
    .{ .name = "accept-encoding", .value = "gzip, deflate" },
    .{ .name = "accept-language", .value = "" },
    .{ .name = "accept-ranges", .value = "" },
    .{ .name = "accept", .value = "" },
    .{ .name = "access-control-allow-origin", .value = "" },
    .{ .name = "age", .value = "" },
    .{ .name = "allow", .value = "" },
    .{ .name = "authorization", .value = "" },
    .{ .name = "cache-control", .value = "" },
    .{ .name = "content-disposition", .value = "" },
    .{ .name = "content-encoding", .value = "" },
    .{ .name = "content-language", .value = "" },
    .{ .name = "content-length", .value = "" },
    .{ .name = "content-location", .value = "" },
    .{ .name = "content-range", .value = "" },
    .{ .name = "content-type", .value = "" },
    .{ .name = "cookie", .value = "" },
    .{ .name = "date", .value = "" },
    .{ .name = "etag", .value = "" },
    .{ .name = "expect", .value = "" },
    .{ .name = "expires", .value = "" },
    .{ .name = "from", .value = "" },
    .{ .name = "host", .value = "" },
    .{ .name = "if-match", .value = "" },
    .{ .name = "if-modified-since", .value = "" },
    .{ .name = "if-none-match", .value = "" },
    .{ .name = "if-range", .value = "" },
    .{ .name = "if-unmodified-since", .value = "" },
    .{ .name = "last-modified", .value = "" },
    .{ .name = "link", .value = "" },
    .{ .name = "location", .value = "" },
    .{ .name = "max-forwards", .value = "" },
    .{ .name = "proxy-authenticate", .value = "" },
    .{ .name = "proxy-authorization", .value = "" },
    .{ .name = "range", .value = "" },
    .{ .name = "referer", .value = "" },
    .{ .name = "refresh", .value = "" },
    .{ .name = "retry-after", .value = "" },
    .{ .name = "server", .value = "" },
    .{ .name = "set-cookie", .value = "" },
    .{ .name = "strict-transport-security", .value = "" },
    .{ .name = "transfer-encoding", .value = "" },
    .{ .name = "user-agent", .value = "" },
    .{ .name = "vary", .value = "" },
    .{ .name = "via", .value = "" },
    .{ .name = "www-authenticate", .value = "" },
};

// §5.1 integer: an N-bit prefix saturating at its mask, then 7-bit
// continuation bytes least-significant first. Values needing >5
// continuation bytes (>35 bits) exceed anything legal here — indices are
// bounded by the table, lengths by the block — so they are malformed.
fn hpackInt(block: []const u8, pos: *usize, comptime prefix: u3) ?u64 {
    if (pos.* >= block.len) return null;
    const mask: u8 = (@as(u8, 1) << prefix) - 1;
    var v: u64 = block[pos.*] & mask;
    pos.* += 1;
    if (v < mask) return v;
    var m: u6 = 0;
    while (true) {
        if (pos.* >= block.len) return null;
        const b = block[pos.*];
        pos.* += 1;
        v += @as(u64, b & 0x7f) << m;
        if (b & 0x80 == 0) return v;
        m += 7;
        if (m > 28) return null;
    }
}

// §5.2 string literal: 1-bit Huffman flag, 7-bit-prefix length, then bytes.
// Plain strings borrow the block. Huffman strings decode into an owned
// allocation parked in `retired`, so the slice follows the same
// valid-until-next-call rule as everything else we hand out.
fn hpackString(
    table: *HpackTable,
    alloc: std.mem.Allocator,
    block: []const u8,
    pos: *usize,
) ?[]const u8 {
    if (pos.* >= block.len) return null;
    const huffman = block[pos.*] & 0x80 != 0;
    const len = hpackInt(block, pos, 7) orelse return null;
    if (len > block.len - pos.*) return null;
    const raw = block[pos.* .. pos.* + @as(usize, @intCast(len))];
    pos.* += @intCast(len);
    if (!huffman) return raw;
    return huffDecode(table, alloc, raw);
}

const HuffCode = struct { code: u32, bits: u8 };

// RFC 7541 Appendix B, rows 0..255 plus EOS (256) — transcribed from the
// spec text, NOT recomputed. The decoder tables below derive from this.
const HUFF_CODES = [257]HuffCode{
    .{ .code = 0x1ff8, .bits = 13 },
    .{ .code = 0x7fffd8, .bits = 23 },
    .{ .code = 0xfffffe2, .bits = 28 },
    .{ .code = 0xfffffe3, .bits = 28 },
    .{ .code = 0xfffffe4, .bits = 28 },
    .{ .code = 0xfffffe5, .bits = 28 },
    .{ .code = 0xfffffe6, .bits = 28 },
    .{ .code = 0xfffffe7, .bits = 28 },
    .{ .code = 0xfffffe8, .bits = 28 },
    .{ .code = 0xffffea, .bits = 24 },
    .{ .code = 0x3ffffffc, .bits = 30 },
    .{ .code = 0xfffffe9, .bits = 28 },
    .{ .code = 0xfffffea, .bits = 28 },
    .{ .code = 0x3ffffffd, .bits = 30 },
    .{ .code = 0xfffffeb, .bits = 28 },
    .{ .code = 0xfffffec, .bits = 28 },
    .{ .code = 0xfffffed, .bits = 28 },
    .{ .code = 0xfffffee, .bits = 28 },
    .{ .code = 0xfffffef, .bits = 28 },
    .{ .code = 0xffffff0, .bits = 28 },
    .{ .code = 0xffffff1, .bits = 28 },
    .{ .code = 0xffffff2, .bits = 28 },
    .{ .code = 0x3ffffffe, .bits = 30 },
    .{ .code = 0xffffff3, .bits = 28 },
    .{ .code = 0xffffff4, .bits = 28 },
    .{ .code = 0xffffff5, .bits = 28 },
    .{ .code = 0xffffff6, .bits = 28 },
    .{ .code = 0xffffff7, .bits = 28 },
    .{ .code = 0xffffff8, .bits = 28 },
    .{ .code = 0xffffff9, .bits = 28 },
    .{ .code = 0xffffffa, .bits = 28 },
    .{ .code = 0xffffffb, .bits = 28 },
    .{ .code = 0x14, .bits = 6 },
    .{ .code = 0x3f8, .bits = 10 },
    .{ .code = 0x3f9, .bits = 10 },
    .{ .code = 0xffa, .bits = 12 },
    .{ .code = 0x1ff9, .bits = 13 },
    .{ .code = 0x15, .bits = 6 },
    .{ .code = 0xf8, .bits = 8 },
    .{ .code = 0x7fa, .bits = 11 },
    .{ .code = 0x3fa, .bits = 10 },
    .{ .code = 0x3fb, .bits = 10 },
    .{ .code = 0xf9, .bits = 8 },
    .{ .code = 0x7fb, .bits = 11 },
    .{ .code = 0xfa, .bits = 8 },
    .{ .code = 0x16, .bits = 6 },
    .{ .code = 0x17, .bits = 6 },
    .{ .code = 0x18, .bits = 6 },
    .{ .code = 0x0, .bits = 5 },
    .{ .code = 0x1, .bits = 5 },
    .{ .code = 0x2, .bits = 5 },
    .{ .code = 0x19, .bits = 6 },
    .{ .code = 0x1a, .bits = 6 },
    .{ .code = 0x1b, .bits = 6 },
    .{ .code = 0x1c, .bits = 6 },
    .{ .code = 0x1d, .bits = 6 },
    .{ .code = 0x1e, .bits = 6 },
    .{ .code = 0x1f, .bits = 6 },
    .{ .code = 0x5c, .bits = 7 },
    .{ .code = 0xfb, .bits = 8 },
    .{ .code = 0x7ffc, .bits = 15 },
    .{ .code = 0x20, .bits = 6 },
    .{ .code = 0xffb, .bits = 12 },
    .{ .code = 0x3fc, .bits = 10 },
    .{ .code = 0x1ffa, .bits = 13 },
    .{ .code = 0x21, .bits = 6 },
    .{ .code = 0x5d, .bits = 7 },
    .{ .code = 0x5e, .bits = 7 },
    .{ .code = 0x5f, .bits = 7 },
    .{ .code = 0x60, .bits = 7 },
