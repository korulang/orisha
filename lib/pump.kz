// Orisha — the pump.
//
// A pump owns the accept-and-readiness loop for exactly one platform. It reads
// a request off the wire and fires `arrived` once per request; everything a
// pump does NOT do — parsing, routing, response shaping — belongs to the Koru
// flow that consumes the stream, and is written once for every platform.
//
// The point of the split: a new platform is a `~proc drive|<name>` body, not a
// copy of the server. Selection is a build-time variant, so the unselected
// pumps are not merely unused — they are not emitted at all.
//
//   ~[build(linux)]std/build:variants { "orisha/pump:drive": "epoll" }
//
// The `unikraft` variant is the reason this file exists: a unikernel has no
// second thread to spawn and no kqueue, so it needs its own loop — and now
// that loop is the only thing it needs.
//
// Note the `$mod.` qualification through both loop bodies: a proc body that
// carries effect branches splices into its CALLER, where this module's scope
// does not exist. The compiler refuses the bare names and says so.

~import koru/openssl

const std = @import("std");
const posix = std.posix;
const c = std.c;

// One request, read and waiting for its answer. `raw` borrows the pump's read
// buffer and is valid for the duration of the `arrived` arm only.
//
// `fd` is `c_int`, not `posix.fd_t`. Exchange is reachable from every pump
// including the unikernel one, and on `x86_64-freestanding` `std.posix` has no
// syscall layer to name a descriptor type with. `c_int` is what `accept`
// returns on every target we build, and it is what `posix.fd_t` already is on
// Linux and macOS, so the hosted pumps are unaffected.
pub const Exchange = struct {
    fd: c_int,
    st: ?*ConnState = null,
    raw: []const u8,
    keep_alive: bool = true,
    // On a `! frame` dispatch this is the websocket message opcode (0x1 text,
    // 0x2 binary); on `! arrived` it is 0 and means nothing.
    opcode: u8 = 0,
};

const READ_BUFFER = 4096;
const MAX_EVENTS = 64;

// io_uring: how deep the submission ring is, and the tag that marks an accept
// completion apart from a connection's.
//
// kqueue and epoll ask "which of these is ready, so I can then read it". io_uring
// inverts that: the read is submitted UP FRONT and the completion says it already
// happened. So this pump has no readiness step at all — the loop body handles a
// result, never a hint.
const URING_ENTRIES: u16 = 256;
const URING_ACCEPT: u64 = std.math.maxInt(u64);

// One read is not one request.
//
// A browser opening a page fires its asset requests back to back, and TCP is
// free to hand all of them over in a single read. Answering only the first —
// which is what all three pumps did until 2026-08-10 — does not drop those
// requests visibly. The connection stays open and the client keeps waiting, so
// when a later response finally arrives the client matches it to the OLDEST
// request it has outstanding. The bytes are then read as the wrong resource:
// Firefox reports a JavaScript module "blocked because of a disallowed MIME
// type (text/html)", because it is being handed the HTML document's response.
//
// curl cannot see this. It waits for each response before sending the next, so
// every request is alone in its packet and the bug never fires. Only a client
// that pipelines reaches it — which is every browser.
//
// This function answers the one question the three pumps share: where does the
// first request in this buffer end? The loops that use it are mechanical; this
// is the part that must not be written three times.
fn transferEncodingChunked(head: []const u8) bool {
    var line_start: usize = 0;
    while (line_start < head.len) {
        const line_end = std.mem.indexOfPos(u8, head, line_start, "\r\n") orelse break;
        const line = head[line_start..line_end];
        if (std.mem.indexOfScalar(u8, line, ':')) |colon| {
            if (std.ascii.eqlIgnoreCase(std.mem.trim(u8, line[0..colon], " \t"), "transfer-encoding")) {
                const value = std.mem.trim(u8, line[colon + 1 ..], " \t");
                var lower_buf: [128]u8 = undefined;
                if (value.len > lower_buf.len) return false;
                const lower = std.ascii.lowerString(&lower_buf, value);
                return std.mem.indexOf(u8, lower, "chunked") != null;
            }
        }
        line_start = line_end + 2;
    }
    return false;
}

fn chunkedMessageLen(body: []const u8) ?usize {
    var pos: usize = 0;
    while (true) {
        const line_end = std.mem.indexOfPos(u8, body, pos, "\r\n") orelse return null;
        const chunk_size = std.fmt.parseInt(usize, body[pos..line_end], 16) catch return null;
        pos = line_end + 2;
        if (chunk_size == 0) {
            if (pos + 2 <= body.len and body[pos] == '\r' and body[pos + 1] == '\n') return pos + 2;
            return null;
        }
        pos += chunk_size;
        if (pos + 2 > body.len or body[pos] != '\r' or body[pos + 1] != '\n') return null;
        pos += 2;
    }
}

fn requestLen(buf: []const u8) ?usize {
    const head_end = std.mem.indexOf(u8, buf, "\r\n\r\n") orelse return null;
    const headers_end = head_end + 4;
    if (contentLength(buf[0..headers_end])) |body_len| {
        const total = headers_end + body_len;
        if (total > buf.len) return null;
        return total;
    }
    if (transferEncodingChunked(buf[0..headers_end])) {
        const chunk_len = chunkedMessageLen(buf[headers_end..]) orelse return null;
        const total = headers_end + chunk_len;
        if (total > buf.len) return null;
        return total;
    }
    return headers_end;
}

// A request can arrive in pieces, so a connection needs somewhere to keep the
// part that has not finished yet.
//
// Without this the pump had only the bytes of one read. A burst bigger than the
// read buffer therefore split a request down the middle, and the tail was then
// parsed as if it were the start of a new one — which produced EXTRA responses,
// not fewer: measured 43 responses to 40 pipelined requests. A client counting
// replies against its own outstanding requests is desynchronised from then on,
// and what it renders depends on where the split happened to land. That is the
// "sometimes it works" shape.
const REQUEST_BUFFER = 16 * 1024;
const MAX_TRACKED_FD = 4096;

// One connection, and everything reading it needs: the socket, the bytes held
// so far, and how many of them there are.
//
// `fd` lives here because `fill` takes a connection and nothing else. A read
// step that has to be told which descriptor to read is not a seam — the caller
// would still be the one holding the platform's idea of a socket.
//
// It is `c_int` for the same reason Exchange's is: this type is now reachable
// from the unikernel pump too, and `x86_64-freestanding` has no `std.posix`
// syscall layer to name a descriptor type with. On Linux and macOS `posix.fd_t`
// already IS `c_int`, so the hosted pumps hand theirs over unchanged.
// The connection's protocol mode. `http` is every connection at accept; a 101
// answer flips it to `ws`, after which bytes on the wire are websocket frames
// and `requestLen` never sees them again.
pub const ConnMode = enum { http, ws };

// One writer at a time on a websocket connection. `ws-send` in a frame arm
// and `ws-send-fd` from a pusher thread can both target the same socket;
// without the lock two frames interleave on the wire. Freestanding targets
// run the pump single-threaded, so the type degrades to a no-op there —
// std.Thread.Mutex's futex path has no kernel behind it on a unikernel.
const SendMutex = switch (@import("builtin").os.tag) {
    .freestanding => struct {
        pub fn lock(_: *const @This()) void {}
        pub fn unlock(_: *const @This()) void {}
    },
    else => std.Thread.Mutex,
};

pub const ConnState = struct {
    fd: c_int = -1,
    ssl: ?*ServerTls = null,
    mode: ConnMode = .http,
    ws_mu: SendMutex = .{},
    buf: [REQUEST_BUFFER]u8 = undefined,
    len: usize = 0,
    // Websocket reassembly — only meaningful while mode == .ws. `buf` holds
    // undispatched wire bytes like always; frames too big or fragmented for
    // one buffer accumulate their (unmasked) payload into `ws_msg`, and the
    // frame fields carry the in-flight frame's parse state across fills.
    ws_in_frame: bool = false,
    ws_need: usize = 0,
    ws_fin: bool = true,
    ws_op: u8 = 0,
    ws_mask: [4]u8 = .{ 0, 0, 0, 0 },
    ws_seen: usize = 0,
    ws_msg: std.ArrayListUnmanaged(u8) = .{},
    ws_msg_op: u8 = 0,
    ws_msg_open: bool = false,
    // Control payloads are ≤125 bytes by spec (RFC 6455 §5.5) — they get their
    // own fixed buffer so a ping mid-fragment never joins the message.
    ws_ctrl: [125]u8 = undefined,
    ws_ctrl_len: usize = 0,
    // TLS handshake still in flight. The fd registered with the reactor
    // BEFORE SSL_accept finished — the owning worker steps it once per
    // readiness event, and no bytes are framed as a request until it clears.
    // This replaces a single accept thread doing every SSL_accept
    // synchronously, which serialised all handshake crypto onto one core.
    tls_hs: bool = false,
    // Output accepted from the app faster than the socket took it. Writes
    // append at the tail, a readiness-for-write event drains from
    // pending_off, and the queue keeps ordering without a copy: nothing a
    // later answer writes can overtake it.
    pending: std.ArrayListUnmanaged(u8) = .{},
    pending_off: usize = 0,
    // A closing answer (Connection: close, a ws close frame, a refused
    // upgrade) landed while pending still holds bytes. The close must wait
    // for the drain — closing early would cut the response mid-flight.
    close_when_drained: bool = false,
    // The readiness queue this conn is armed on (a worker's kqueue, or the
    // shared epoll fd) — set at registration. A `ws-send-fd` write from a
    // pusher thread that stalls must re-arm write readiness on the owner,
    // or the queued tail would wait for traffic that may never come.
    owner_q: i32 = -1,
};

var conn_states: [MAX_TRACKED_FD]?*ConnState = .{null} ** MAX_TRACKED_FD;

// The "no index is ever touched twice" claim is false: the accept thread
// writes the slot (registerClient → connState) while a worker detaches it
// (releaseConn), and the kernel reissues a just-closed fd immediately. The
// lock makes the table honest; the ordering — detach BEFORE close in
// releaseConn — is what keeps a reissued descriptor from inheriting the
// previous connection's buffered tail, ssl, or a second close.
var conn_states_mu: std.Thread.Mutex = .{};

fn connState(fd: posix.fd_t) ?*ConnState {
    const idx: usize = @intCast(fd);
    if (idx >= MAX_TRACKED_FD) return null;
    conn_states_mu.lock();
    defer conn_states_mu.unlock();
    if (conn_states[idx]) |s| return s;
    const s = std.heap.c_allocator.create(ConnState) catch return null;
    s.* = .{ .fd = fd };
    conn_states[idx] = s;
    return s;
}

fn releaseConn(fd: posix.fd_t) void {
    const idx: usize = @intCast(fd);
    if (idx >= MAX_TRACKED_FD) {
        posix.close(@intCast(fd));
        return;
    }
    conn_states_mu.lock();
    const s = conn_states[idx];
    conn_states[idx] = null;
    conn_states_mu.unlock();
    if (s) |st| {
        // A `ws-send-fd` already mid-write holds ws_mu; teardown waits for it
        // rather than freeing the ConnState out from under its frame.
        st.ws_mu.lock();
        closeConn(st);
        st.ws_mu.unlock();
        std.heap.c_allocator.destroy(st);
    } else {
        posix.close(@intCast(fd));
    }
}

// "Is this fd an upgraded websocket connection right now" — asked at teardown
// sites to decide whether `closed` fires, and asked BEFORE releaseConn takes
// the slot, so the fd still names this connection and not a reissued one.
fn connIsWs(fd: posix.fd_t) bool {
    const idx: usize = @intCast(fd);
    if (idx >= MAX_TRACKED_FD) return false;
    conn_states_mu.lock();
    defer conn_states_mu.unlock();
    const s = conn_states[idx] orelse return false;
    return s.mode == .ws;
}

fn closeConn(st: *ConnState) void {
    if (HAS_OPENSSL) {
        if (st.ssl) |tls| {
            const mod = @import("root").koru_koru.koru_openssl;
            if (tls.ssl) |s| mod.releaseServerSsl(s);
            tls.allocator.destroy(tls);
            st.ssl = null;
        }
    }
    if (st.fd >= 0) {
        posix.shutdown(@intCast(st.fd), .both) catch {};
        posix.close(@intCast(st.fd));
        st.fd = -1;
    }
    st.ws_msg.deinit(std.heap.c_allocator);
    st.pending.deinit(std.heap.c_allocator);
    st.len = 0;
}

fn shutdownConn(st: *ConnState) void {
    if (st.fd >= 0) {
        posix.shutdown(@intCast(st.fd), .both) catch {};
    }
}

// A stalled peer must not stall the worker. `pending` is the answer a write
// couldn't deliver: bytes land there ordered, a readiness-for-write event
// drains them, and the reactor keeps moving. Above MAX_PENDING the peer is
// not slow, it is gone — the connection dies rather than buffering forever.
const MAX_PENDING: usize = 1 << 20;

const Flush = enum { drained, stalled, dead };

fn pendingLen(st: *ConnState) usize {
    return st.pending.items.len - st.pending_off;
}

// Push what the socket will take right now, no waiting. `stalled` leaves the
// tail in pending for a write-ready event; the rearm that follows every
// dispatch is what asks the reactor for it.
fn flushPending(st: *ConnState) Flush {
    while (st.pending_off < st.pending.items.len) {
        if (HAS_OPENSSL) {
            if (st.ssl) |tls| {
                const mod = @import("root").koru_koru.koru_openssl;
                const s = tls.ssl orelse return .dead;
                switch (mod.sslWriteSome(s, st.pending.items[st.pending_off..])) {
                    .wrote => |n| st.pending_off += n,
                    .want_read, .want_write => return .stalled,
                    .failed => return .dead,
                }
                continue;
            }
        }
        const n = posix.write(@intCast(st.fd), st.pending.items[st.pending_off..]) catch |err| switch (err) {
            error.WouldBlock => return .stalled,
            else => return .dead,
        };
        if (n == 0) return .dead;
        st.pending_off += n;
    }
    st.pending.clearRetainingCapacity();
    st.pending_off = 0;
    return .drained;
}

// Append an ordered segment to the queue and try to drain — the shape every
// write takes when the queue is already holding bytes or the cipher needs
// one contiguous buffer. `false` means dead, never merely unwritten.
fn queueAndFlush(st: *ConnState, segments: []const []const u8) bool {
    var need: usize = 0;
    for (segments) |seg| need += seg.len;
    if (st.pending.items.len + need > MAX_PENDING) return false;
    st.pending.ensureUnusedCapacity(std.heap.c_allocator, need) catch return false;
    for (segments) |seg| st.pending.appendSliceAssumeCapacity(seg);
    return flushPending(st) != .dead;
}

// TLS write path: hand each segment to SSL_write directly and only queue what
// the cipher refuses — the common case never touches `pending`, so a response
// does not pay an allocation + copy before encryption. Ordering is the queue's
// job once it holds bytes, so a stalled conn falls back to queueAndFlush.
fn tlsWriteOrQueue(st: *ConnState, segments: []const []const u8) bool {
    const mod = @import("root").koru_koru.koru_openssl;
    const s = st.ssl.?.ssl orelse return false;
    if (pendingLen(st) > 0) return queueAndFlush(st, segments);
    for (segments, 0..) |seg, si| {
        var off: usize = 0;
        while (off < seg.len) {
            switch (mod.sslWriteSome(s, seg[off..])) {
                .wrote => |n| off += n,
                .want_read, .want_write => {
                    // Queue the unwritten remainder — this segment's tail plus
                    // every segment after it.
                    var need: usize = seg.len - off;
                    for (segments[si + 1 ..]) |rest| need += rest.len;
                    if (st.pending.items.len + need > MAX_PENDING) return false;
                    st.pending.ensureUnusedCapacity(std.heap.c_allocator, need) catch return false;
                    st.pending.appendSliceAssumeCapacity(seg[off..]);
                    for (segments[si + 1 ..]) |rest| st.pending.appendSliceAssumeCapacity(rest);
                    return true;
                },
                .failed => return false,
            }
        }
    }
    return true;
}

fn writeAllConn(st: *ConnState, data: []const u8) bool {
    if (HAS_OPENSSL) {
        if (st.ssl != null) {
            return tlsWriteOrQueue(st, &.{data});
        }
    }
    if (pendingLen(st) > 0) return queueAndFlush(st, &.{data});
    return writeAllOrQueue(st, data);
}

// Cleartext fast path: write straight through, and only when the kernel
// refuses mid-write does the remainder become pending bytes. Keeps the
// no-stall case allocation-free.
fn writeAllOrQueue(st: *ConnState, data: []const u8) bool {
    var offset: usize = 0;
    while (offset < data.len) {
        const n = posix.write(@intCast(st.fd), data[offset..]) catch |err| switch (err) {
            error.WouldBlock => {
                const segs = [_][]const u8{data[offset..]};
                return queueAndFlush(st, &segs);
            },
            else => return false,
        };
        if (n == 0) return false;
        offset += @intCast(n);
    }
    return true;
}

// head+body in ONE syscall — writev gathers both without a copy. TLS is a
// stream cipher with no scatter write: the ssl leg stages head+body into
// pending as ONE buffer, so a response leaves as a single TLS record instead
// of four sslWriteAll calls each paying a record of crypto.
//
// `date_hole` is where a `Date:` line belongs inside `head` — baked static
// responses are const rodata and cannot be patched, so the line goes out as a
// middle iovec (same syscall, one extra vector). The slice points at the
// orisha module's per-second threadlocal buffer: a lookup, not a format.
fn writevAllConn(st: *ConnState, head: []const u8, body: []const u8, date_hole: usize) bool {
    const date_line: []const u8 = if (date_hole != 0) @import("root").koru_orisha.httpDateLine() else "";
    if (HAS_OPENSSL) {
        if (st.ssl != null) {
            const segs = if (date_hole != 0)
                [4][]const u8{ head[0..date_hole], date_line, head[date_hole..], body }
            else
                [4][]const u8{ head, body, "", "" };
            return tlsWriteOrQueue(st, &segs);
        }
    }
    if (pendingLen(st) > 0) {
        const segs = if (date_hole != 0)
            [4][]const u8{ head[0..date_hole], date_line, head[date_hole..], body }
        else
            [4][]const u8{ head, body, "", "" };
        return queueAndFlush(st, &segs);
    }
    var iov = [4]posix.iovec_const{
        .{ .base = head.ptr, .len = head.len },
        .{ .base = if (body.len == 0) head.ptr else body.ptr, .len = body.len },
        undefined,
        undefined,
    };
    var total = head.len + body.len;
    if (date_hole != 0) {
        iov = .{
            .{ .base = head.ptr, .len = date_hole },
            .{ .base = date_line.ptr, .len = date_line.len },
            .{ .base = head.ptr + date_hole, .len = head.len - date_hole },
            .{ .base = if (body.len == 0) head.ptr else body.ptr, .len = body.len },
        };
        total += date_line.len;
    }
    // The live iovec count: 4 when the Date splice widened the set, 2
    // otherwise. Slicing `iov[idx..]` unbounded would hand writev the
    // `undefined` tail — a len of garbage is an instant EFAULT and a dead
    // connection, which is why this bound exists at all.
    const iov_count: usize = if (date_hole != 0) 4 else 2;
    var idx: usize = if (head.len == 0) 1 else 0;
    while (total > 0) {
        const n = posix.writev(@intCast(st.fd), iov[idx..][0 .. iov_count - idx]) catch |err| switch (err) {
            error.WouldBlock => {
                // The socket is full — the unwritten iovec tail becomes
                // pending bytes and a write-ready event finishes the send.
                var segs: [4][]const u8 = undefined;
                var seg_count: usize = 0;
                for (iov[idx..iov_count]) |v| {
                    if (v.len == 0) continue;
                    segs[seg_count] = v.base[0..v.len];
                    seg_count += 1;
                }
                return queueAndFlush(st, segs[0..seg_count]);
            },
            else => return false,
        };
        if (n == 0) return false;
        var rem: usize = @intCast(n);
        total -= rem;
        while (rem > 0 and idx < iov_count) {
            if (rem >= iov[idx].len) {
                rem -= iov[idx].len;
                idx += 1;
            } else {
                iov[idx].base += rem;
                iov[idx].len -= rem;
                rem = 0;
            }
        }
    }
    return true;
}

// Writing to a peer-closed socket raises SIGPIPE; the default action kills
// the process silently. Any server that keep-alives must ignore it once, up
// front — then send/write/SSL_write return EPIPE and the write loop treats a
// vanished peer as an ordinary close. Called at the top of every drive body.
fn ignoreSigpipe() void {
    const ign = posix.Sigaction{
        .handler = .{ .handler = posix.SIG.IGN },
        .mask = posix.sigemptyset(),
        .flags = 0,
    };
    posix.sigaction(posix.SIG.PIPE, &ign, null);
}

fn maybeStartTls(
    tls_port: ?u16,
    cert_path: ?[]const u8,
    key_path: ?[]const u8,
) ?[]const u8 {
    if (HAS_OPENSSL) {
        const tp = tls_port orelse return null;
        const cert = cert_path orelse "/certs/server.crt";
        const key = key_path orelse "/certs/server.key";
        const loaded = @import("root").koru_koru.koru_openssl.loadServerCtx(std.heap.page_allocator, cert, key);
        switch (loaded) {
            .ok => |ctx| {
                tls_server_ctx = ctx;
                tls_listen_port = tp;
                return null;
            },
            .err => |e| return e.msg,
        }
    } else {
        // Params unused when the gate is false — a plain `_ =` discard is a
        // compile error on targets where the branch above is live, so these
        // are real references in a branch that is never emitted there.
        std.mem.doNotOptimizeAway(cert_path);
        std.mem.doNotOptimizeAway(key_path);
    }
    return if (tls_port != null)
        "orisha:serve got tls_port, but this target cannot link openssl"
    else
        null;
}

// The TLS handle types, named not opaque: a connection's `ssl` is an open
// `*Tls` the ConnState owns until releaseConn frees it (releaseServerSsl +
// destroy — the pump keeps the fd, so the package's `close` is NOT called;
// it would double-close the socket). Both are comptime-selected off
// HAS_OPENSSL so a non-TLS target never resolves the openssl cImport — the
// same gate that keeps cross-compile free of openssl headers.
const ServerTls = if (HAS_OPENSSL) @import("root").koru_koru.koru_openssl.Tls else anyopaque;
const ServerTlsCtx = if (HAS_OPENSSL) @import("root").koru_koru.koru_openssl.ServerCtx else anyopaque;

var tls_server_ctx: ?*ServerTlsCtx = null;
var tls_listen_port: u16 = 0;

// TLS exists only where a system openssl can be linked — this must stay the
// same condition as koru/openssl's ~std/build:requires, which emits no link
// flags outside it. When this is comptime-false nothing can ever assign
// `st.ssl` (acceptServerSsl is unreachable), so every `if (st.ssl)` leg below
// is dead code Zig never analyzes — which is also what keeps the package's
// @cImport out of the build and lets non-TLS programs cross-compile for musl
// and freestanding targets at all.
pub const HAS_OPENSSL = switch (@import("builtin").os.tag) {
    .macos => true,
    .linux => @import("builtin").abi != .musl,
    else => false,
};

// Participant-verb state (std/pump contract). `init` fills these; `step`
// accepts against the listener; `wait` exposes it; `stop`/`live` carry the
// retirement flag. The workers' kqueues stay participant-internal — a conn
// fd's readiness never reaches the pump's union wait.
var listen_server: ?std.net.Server = null;
var worker_kqs: [MAX_WORKERS]i32 = undefined;
var worker_total: usize = 0;
var worker_next: usize = 0;
var should_stop: bool = false;
// Set by `init` on success — `live` reports 0 until the machinery actually
// stands up, so a failed init retires the participant instead of pinning the
// pump on an immortal that never was.
var pump_started: bool = false;

// Drop the requests already answered and slide the unfinished tail to the
// front, so the next read continues it instead of mistaking it for a new one.
fn retainTail(buf: []u8, len: usize, consumed: usize) usize {
    if (consumed == 0) return len;
    const remaining = len - consumed;
    if (remaining > 0) std.mem.copyForwards(u8, buf[0..remaining], buf[consumed..len]);
    return remaining;
}

fn contentLength(head: []const u8) ?usize {
    var line_start: usize = 0;
    while (line_start < head.len) {
        const line_end = std.mem.indexOfPos(u8, head, line_start, "\r\n") orelse break;
        const line = head[line_start..line_end];
        if (std.mem.indexOfScalar(u8, line, ':')) |colon| {
            // Header names are case-insensitive — RFC 9110.
            if (std.ascii.eqlIgnoreCase(std.mem.trim(u8, line[0..colon], " \t"), "content-length")) {
                return std.fmt.parseInt(usize, std.mem.trim(u8, line[colon + 1 ..], " \t"), 10) catch null;
            }
        }
        line_start = line_end + 2;
    }
    return null;
}

fn pumpHeaderValue(raw: []const u8, comptime name: []const u8) ?[]const u8 {
    const first_line = std.mem.indexOf(u8, raw, "\r\n") orelse return null;
    var scan: usize = first_line + 2;
    while (scan < raw.len) {
        const nl = std.mem.indexOfPos(u8, raw, scan, "\r\n") orelse break;
        const line = raw[scan..nl];
        scan = nl + 2;
        if (line.len == 0) break;
        const colon = std.mem.indexOfScalar(u8, line, ':') orelse continue;
        if (!std.ascii.eqlIgnoreCase(line[0..colon], name)) continue;
        return std.mem.trim(u8, line[colon + 1 ..], " \t");
    }
    return null;
}

fn requestWantsClose(raw: []const u8) bool {
    const value = pumpHeaderValue(raw, "connection") orelse return false;
    var lower_buf: [64]u8 = undefined;
    if (value.len > lower_buf.len) return false;
    const lower = std.ascii.lowerString(&lower_buf, value);
    return std.mem.indexOf(u8, lower, "close") != null;
}

// ---------------------------------------------------------------------------
// Websocket framing — the ws half of ConnState.mode.
// ---------------------------------------------------------------------------
// The wire grammar (RFC 6455 §5.2): fin/opcode byte, mask+length byte, 0/2/8
// extended-length bytes, 0/4 mask-key bytes, payload. Every read boundary can
// split ANY of those, so parsing is a state machine across fills — ws_in_frame
// etc. on ConnState — not a slice function like requestLen.

const WsHdr = struct {
    fin: bool,
    op: u8,
    mask: [4]u8, // all-zero when the frame is unmasked, so XOR is uniform
    len: usize,
    hdr: usize, // header byte count — consumed before the payload starts
};

// Parse one frame header, or null when the buffered bytes cannot spell one
// yet. A 64-bit length with the high bit set is a malformed frame — but so is
// an unmasked client frame per RFC 6455 §5.3; both are accepted leniently
// (topcoat's tokio-tungstenite rejects unmasked; the oracle never sends one,
// so the divergence is unmeasured).
fn wsHeader(buf: []const u8) ?WsHdr {
    if (buf.len < 2) return null;
    const fin = buf[0] & 0x80 != 0;
    const op = buf[0] & 0x0F;
    const masked = buf[1] & 0x80 != 0;
    var len: usize = buf[1] & 0x7F;
    var i: usize = 2;
    if (len == 126) {
        if (buf.len < i + 2) return null;
        len = std.mem.readInt(u16, buf[i..][0..2], .big);
        i += 2;
    } else if (len == 127) {
        if (buf.len < i + 8) return null;
        len = @intCast(std.mem.readInt(u64, buf[i..][0..8], .big));
        i += 8;
    }
    var mask: [4]u8 = .{ 0, 0, 0, 0 };
    if (masked) {
        if (buf.len < i + 4) return null;
        @memcpy(&mask, buf[i..][0..4]);
        i += 4;
    }
    return .{ .fin = fin, .op = op, .mask = mask, .len = len, .hdr = i };
}

// What a completed websocket frame means for the loop. `message` borrows
// st.ws_msg — valid until the caller clears it, which it must do once `frame`
// returns. `ping`/`close` borrow st.ws_ctrl. `dead` is a protocol violation:
// the connection is finished either way.
const WsItem = union(enum) {
    message: struct { op: u8, payload: []const u8 },
    ping: []const u8,
    close: []const u8,
    dead,
};

// Consume bytes for the next dispatchable item. Returns null when nothing
// complete is buffered. Control frames complete inside one ws_ctrl buffer;
// data frames append to ws_msg and a fragmented message only surfaces when
// its final continuation lands.
fn wsNext(st: *ConnState, consumed: *usize) ?WsItem {
    while (consumed.* < st.len) {
        if (!st.ws_in_frame) {
            const h = wsHeader(st.buf[consumed.*..st.len]) orelse return null;
            consumed.* += h.hdr;
            st.ws_in_frame = true;
            st.ws_op = h.op;
            st.ws_fin = h.fin;
            st.ws_need = h.len;
            st.ws_mask = h.mask;
            st.ws_seen = 0;
            st.ws_ctrl_len = 0;
        }
        if (st.ws_need > 0) {
            const take = @min(st.ws_need, st.len - consumed.*);
            if (st.ws_op >= 0x8) {
                // A control frame over 125 bytes violates RFC 6455 §5.5.
                if (st.ws_ctrl_len + take > st.ws_ctrl.len) return .dead;
                for (st.buf[consumed.* .. consumed.* + take], 0..) |b, k| {
                    st.ws_ctrl[st.ws_ctrl_len + k] = b ^ st.ws_mask[(st.ws_seen + k) & 3];
                }
                st.ws_ctrl_len += take;
            } else {
                const base = st.ws_msg.items.len;
                st.ws_msg.resize(std.heap.c_allocator, base + take) catch return .dead;
                for (st.buf[consumed.* .. consumed.* + take], 0..) |b, k| {
                    st.ws_msg.items[base + k] = b ^ st.ws_mask[(st.ws_seen + k) & 3];
                }
            }
            consumed.* += take;
            st.ws_seen += take;
            st.ws_need -= take;
            if (st.ws_need != 0) return null;
        }
        // Frame complete.
        st.ws_in_frame = false;
        switch (st.ws_op) {
            0x8 => return .{ .close = st.ws_ctrl[0..st.ws_ctrl_len] },
            0x9 => return .{ .ping = st.ws_ctrl[0..st.ws_ctrl_len] },
            0xA => continue, // pong — nothing to answer
            0x0 => {
                // Continuation outside a fragmented message violates §5.4.
                if (!st.ws_msg_open) return .dead;
                if (st.ws_fin) {
                    st.ws_msg_open = false;
                    return .{ .message = .{ .op = st.ws_msg_op, .payload = st.ws_msg.items } };
                }
            },
            0x1, 0x2 => {
                // A new data frame mid-message violates §5.4.
                if (st.ws_msg_open) return .dead;
                st.ws_msg_op = st.ws_op;
                if (st.ws_fin) {
                    return .{ .message = .{ .op = st.ws_op, .payload = st.ws_msg.items } };
                }
                st.ws_msg_open = true;
            },
            else => return .dead,
        }
    }
    return null;
}

// Emit one unmasked frame — server frames are never masked (§5.1) and never
// fragmented here: a message the application sent is one frame. The Raw half
// writes; the locking half is what `ws-send`-in-an-arm and `ws-send-fd` from
// another thread both funnel through, so two writers on one connection can
// never interleave bytes mid-frame.
fn wsSendFrameRaw(st: *ConnState, opcode: u8, payload: []const u8) bool {
    var hdr: [10]u8 = undefined;
    hdr[0] = 0x80 | opcode;
    var hlen: usize = 2;
    if (payload.len < 126) {
        hdr[1] = @intCast(payload.len);
    } else if (payload.len <= 0xFFFF) {
        hdr[1] = 126;
        std.mem.writeInt(u16, hdr[2..4], @intCast(payload.len), .big);
        hlen = 4;
    } else {
        hdr[1] = 127;
        std.mem.writeInt(u64, hdr[2..10], payload.len, .big);
        hlen = 10;
    }
    if (!writeAllConn(st, hdr[0..hlen])) return false;
    return payload.len == 0 or writeAllConn(st, payload);
}

fn wsSendFrame(st: *ConnState, opcode: u8, payload: []const u8) bool {
    st.ws_mu.lock();
    defer st.ws_mu.unlock();
    return wsSendFrameRaw(st, opcode, payload);
}

// The cross-thread counterpart: name a connection by descriptor rather than
// by the exchange being dispatched. The lookup happens under conn_states_mu
// and ws_mu is taken BEFORE that lock drops — releaseConn detaches the slot
// under the same mutex and then waits on ws_mu before freeing, so a ConnState
// cannot be destroyed between lookup and send. Lock order is fixed:
// conn_states_mu, then ws_mu, never the reverse.
fn wsSendFd(fd: usize, opcode: u8, payload: []const u8) bool {
    if (fd >= MAX_TRACKED_FD) return false;
    conn_states_mu.lock();
    const st = conn_states[fd] orelse {
        conn_states_mu.unlock();
        return false;
    };
    if (st.mode != .ws) {
        conn_states_mu.unlock();
        return false;
    }
    st.ws_mu.lock();
    conn_states_mu.unlock();
    defer st.ws_mu.unlock();
    const ok = wsSendFrameRaw(st, opcode, payload);
    // A stalled queue written from off the owning worker needs the owner's
    // write-readiness armed explicitly — nobody else will.
    if (pendingLen(st) > 0) armOwnerWrite(st);
    return ok;
}

// Re-arm write readiness on whatever reactor owns this conn — used by
// cross-thread sends (ws-send-fd) that left bytes in the queue. The pump is
// comptime-selected per binary, so `owner_q` means exactly one thing.
fn armOwnerWrite(st: *ConnState) void {
    if (st.owner_q < 0) return;
    if (@import("builtin").os.tag == .linux) {
        const linux = std.os.linux;
        var wait = linux.epoll_event{
            .events = linux.EPOLL.IN | linux.EPOLL.OUT | linux.EPOLL.ONESHOT,
            .data = .{ .fd = st.fd },
        };
        _ = linux.epoll_ctl(st.owner_q, linux.EPOLL.CTL_MOD, st.fd, &wait);
    } else {
        armKqueueFilter(st.owner_q, st.fd, libc.EVFILT.WRITE);
    }
}

// ---------------------------------------------------------------------------
// The unikernel's sockets, as plain C.
// ---------------------------------------------------------------------------
// Unikraft's posix-socket + lwip put these in the image as ordinary symbols in
// the same address space — the same way std/io reaches nolibc's fputs. They are
// declared here rather than reached through `std.net` because STD.NET CANNOT
// EXIST on this target: `std.posix` has no `sockaddr` there, and it is a hard
// compile error rather than a missing feature. That is the whole reason this
// file is split by platform. Measured in koru/examples/unikraft-net.
extern fn socket(domain: c_int, stype: c_int, protocol: c_int) c_int;
extern fn bind(fd: c_int, addr: *const anyopaque, len: u32) c_int;
extern fn listen(fd: c_int, backlog: c_int) c_int;
extern fn accept(fd: c_int, addr: ?*anyopaque, len: ?*u32) c_int;
extern fn recv(fd: c_int, buf: [*]u8, len: usize, flags: c_int) isize;
extern fn send(fd: c_int, buf: [*]const u8, len: usize, flags: c_int) isize;
extern fn close(fd: c_int) c_int;

// Wall-clock seconds. The idle timeout below has to be measured in TIME, and
// the pump's own loop is not a clock — see KEEPALIVE_IDLE_SECONDS.
//
// Bound through `@extern` rather than declared as `extern fn time`, because the
// companion contract already declares that symbol for the Date header and the
// two modules are emitted into ONE file: two declarations of the same name are
// an ambiguous reference, not a duplicate the compiler can silently accept.
const wallClockSeconds = @extern(*const fn (?*i64) callconv(.c) i64, .{ .name = "time" });

// Unikraft's nolibc imports musl's `netinet/in.h`, where there is NO `sin_len`
// byte: the family is a u16 at offset 0. Writing the BSD layout instead puts
// 0x0210 where the family belongs, and then `socket` and `listen` both succeed
// while `bind` fails — so the error points at the wrong call.
const SockaddrIn = extern struct {
    family: u16 = 2,
    port: u16,
    addr: u32,
    zero: [8]u8 = [_]u8{0} ** 8,
};

// `poll`, from the same place the socket calls come from — Unikraft's
// posix-socket layer, as an ordinary symbol in the same address space.
//
// The unikernel pump needs it for the reason the hosted pumps need kqueue and
// epoll: a browser opens SEVERAL connections and holds them all open. A loop
// that accepts one connection and serves it to completion answers the first
// browser connection and never accepts the second, so the page never finishes
// loading. Measured 2026-08-10 against korulang.org in this very image: curl
// worked perfectly (it closes between requests) and Firefox timed out on every
// page, because the difference is not the requests, it is how many sockets are
// open at once.
const PollFd = extern struct { fd: c_int, events: c_short, revents: c_short };
const POLLIN: c_short = 0x001;
// A hangup is not readability. `poll` reports a peer that went away through
// these, and it may report them WITHOUT POLLIN — so a loop that waits only for
// readable data never learns the connection is dead and never frees its slot.
// The table then fills with sockets nobody is on the other end of, and the next
// real connection is the one that suffers.
const POLLERR: c_short = 0x008;
const POLLHUP: c_short = 0x010;
const POLLNVAL: c_short = 0x020;
extern fn poll(fds: [*]PollFd, nfds: c_ulong, timeout: c_int) c_int;

// One in-flight connection per slot, each owning the request it has not
// finished reading.
//
// A browser does not close a connection when it is finished with it — it keeps
// it open in case there is more to fetch. One page of korulang.org issues 68
// requests, spread over however many sockets Firefox feels like holding, and
// those sockets stay open across page loads. So slots do not free themselves on
// any timescale the server controls.
// Keep this comfortably BELOW lwip's own pool (CONFIG_LWIP_NUM_TCPCON in the
// Kraftfile), so the pump is what runs out first and does so gracefully —
// hanging up on its idlest connection — rather than the network stack refusing
// a connection the pump never hears about.
//
// Measured 2026-08-10: with both set to 64 they collided exactly there. Load at
// 48 concurrent connections was clean; 64 produced dropped reads, because two
// independent limits with the same value have no headroom between them.
const MAX_UK_CONNS = 128;

// A unikernel connection is a connection plus the bookkeeping only this pump
// does. The socket and the held bytes are `ConnState`, the same type the hosted
// pumps use, so `fill` takes one thing on every platform rather than two shapes
// that happen to have the same fields.
const UkConn = struct {
    st: ConnState = .{},
    /// When this connection was last heard from. Only the ORDER matters.
    seq: u64 = 0,
    /// Wall-clock second this connection was last heard from.
    last_seen: i64 = 0,
};

var uk_conns: [MAX_UK_CONNS]UkConn = [_]UkConn{.{}} ** MAX_UK_CONNS;
var uk_seq: u64 = 0;

// Hang up on a connection nobody is using.
//
// A slot is not the scarce thing — lwip's own connection pool is, and it is
// sized in the image config (CONFIG_LWIP_NUM_TCPCON). A browser holds keep-alive
// sockets open indefinitely, so if the server never hangs up, that pool fills
// with connections nobody is on and the NEXT visitor gets a reset. Waiting for
// the client to close is waiting for something that does not happen.
//
// Every other HTTP server has this timeout; this one did not until 2026-08-10,
// and the symptom was a browser that loaded eighteen pages and then could not
// load any.
const POLL_TICK_MS: c_int = 1000;

// Idle time is measured with a CLOCK, not by counting loop iterations.
//
// This counted iterations until 2026-08-10, and an event loop is not a clock:
// when there is work to do `poll` returns immediately, so the loop spins
// thousands of times a second and "5 ticks" becomes a few milliseconds. Any
// connection that simply had no data ready for five consecutive iterations —
// which under load is most of them, most of the time — was hung up on mid-use.
//
// The measurement hid it: an IDLE browser lets `poll` block its full second, so
// ticks and seconds coincide exactly when nothing is happening. It only bit
// under load, as a slow drip of dropped reads — 19 in 30 seconds at just 32
// connections, scaling with both concurrency and duration.
const KEEPALIVE_IDLE_SECONDS: i64 = 5;

// Give a newly accepted connection a slot, evicting the longest-idle one if
// every slot is taken.
//
// Refusing the NEW connection instead — which is what this did first — drops
// the request somebody is actually waiting for in favour of sockets a browser
// has finished with but not closed. Firefox reports that as NS_ERROR_NET_RESET
// and the page fails to load, after three page loads had filled the table.
// A unikernel conn dies in place — there is no releaseConn here. The caller
// fires `closed` first (it lives in the drive body's scope); this is only the
// socket teardown.
fn ukRelease(st: *ConnState) void {
    _ = close(st.fd);
    st.fd = -1;
    st.len = 0;
}

// The descriptor of an evicted websocket connection, if eviction is what the
// admit cost — so the caller can fire `closed` for it.
fn ukAdmit(incoming: c_int) ?c_int {
    uk_seq += 1;
    for (&uk_conns) |*s| {
        if (s.st.fd >= 0) continue;
        // A slot keeps its buffer's ws state across connections otherwise:
        // the second connection through a slot that ran websocket traffic
        // would start in ws mode with a half-parsed frame.
        s.st.ws_msg.deinit(std.heap.c_allocator);
        s.st = .{ .fd = incoming };
        s.seq = uk_seq;
        s.last_seen = wallClockSeconds(null);
            return null;
    }

    var oldest: *UkConn = &uk_conns[0];
    for (&uk_conns) |*s| {
        if (s.seq < oldest.seq) oldest = s;
    }
    // The evicted connection's ws-ness rides back so the caller can fire
    // `closed` — the arm callback only exists in the drive body's scope.
    const evicted_ws = oldest.st.mode == .ws;
    const evicted_fd = oldest.st.fd;
    ukRelease(&oldest.st);
    oldest.st.ws_msg.deinit(std.heap.c_allocator);
    oldest.st = .{ .fd = incoming };
    oldest.seq = uk_seq;
    oldest.last_seen = wallClockSeconds(null);
    return if (evicted_ws) evicted_fd else null;
}

fn armKqueueFilter(kq: i32, fd: posix.fd_t, filter: i16) void {
    var changes: [1]libc.Kevent = undefined;
    var none: [0]libc.Kevent = undefined;
    changes[0] = .{
        .ident = @intCast(fd),
        .filter = filter,
        .flags = libc.EV.ADD | libc.EV.ONESHOT,
        .fflags = 0,
        .data = 0,
        .udata = undefined,
    };
    _ = libc.kevent(kq, &changes, 1, &none, 0, null);
}

fn armKqueueRead(kq: i32, fd: posix.fd_t) void {
    armKqueueFilter(kq, fd, libc.EVFILT.READ);
}

// The kqueue spelling of the same mask epollMask builds: a closing conn asks
// only to drain, a queued-up conn adds EVFILT_WRITE, a live conn keeps
// reading. Two filters are two change entries — there is no combined event.
fn kqueueRearm(kq: i32, fd: posix.fd_t, st: *ConnState) void {
    var changes: [2]libc.Kevent = undefined;
    var count: usize = 0;
    if (!st.close_when_drained) {
        changes[count] = .{
            .ident = @intCast(fd),
            .filter = libc.EVFILT.READ,
            .flags = libc.EV.ADD | libc.EV.ONESHOT,
            .fflags = 0,
            .data = 0,
            .udata = undefined,
        };
        count += 1;
    }
    if (st.pending_off < st.pending.items.len) {
        changes[count] = .{
            .ident = @intCast(fd),
            .filter = libc.EVFILT.WRITE,
            .flags = libc.EV.ADD | libc.EV.ONESHOT,
            .fflags = 0,
            .data = 0,
            .udata = undefined,
        };
        count += 1;
    }
    if (count == 0) return;
    var none: [0]libc.Kevent = undefined;
    _ = libc.kevent(kq, &changes, @intCast(count), &none, 0, null);
}

// Create the SSL and bind the descriptor — nothing more. The handshake
// itself is deliberately NOT here: SSL_accept drives out of the owning
// worker's event loop (driveTlsHandshake, one step per readiness event), so
// the crypto of a thousand simultaneous handshakes spreads across every
// worker instead of queueing behind one accept thread.
fn beginTlsHandshake(client_fd: c_int) ?*ServerTls {
    if (HAS_OPENSSL) {
        const openssl = @import("root").koru_koru.koru_openssl;
        const ctx = tls_server_ctx orelse return null;
        const begun = openssl.acceptBegin(ctx, client_fd, std.heap.page_allocator);
        return switch (begun) {
            .ok => |ssl| blk: {
                // The pump wraps the raw handle in the package's Tls so
                // `ConnState.ssl` names what it is — an open TLS connection.
                // The fd stays pump-owned: teardown frees via releaseServerSsl
                // + destroy, never the package `close` (it would double-close).
                const conn = std.heap.page_allocator.create(openssl.Tls) catch {
                    openssl.releaseServerSsl(ssl);
                    posix.close(@intCast(client_fd));
                    return null;
                };
                conn.* = .{ .ssl = ssl, .ctx = ctx.ctx, .owns_ctx = false, .fd = client_fd, .allocator = std.heap.page_allocator };
                break :blk conn;
            },
            .err => {
                posix.close(@intCast(client_fd));
                return null;
            },
        };
    } else {
        // Refuse the connection we cannot handshake — also keeps client_fd a
        // real use, where `_ = client_fd` would error as a pointless discard.
        posix.close(@intCast(client_fd));
    }
    return null;
}

const TlsStep = enum { ready, want_read, want_write, failed };

// One non-blocking SSL_accept step. `want_*` names the readiness the caller
// must re-arm; `failed` is a dead connection, already queue-drained.
fn driveTlsHandshake(st: *ConnState) TlsStep {
    if (HAS_OPENSSL) {
        const openssl = @import("root").koru_koru.koru_openssl;
        if (st.ssl) |tls| {
            const s = tls.ssl orelse return .failed;
            return switch (openssl.driveAccept(s)) {
                .ready => .ready,
                .want_read => .want_read,
                .want_write => .want_write,
                .failed => .failed,
            };
        }
    } else {
        std.mem.doNotOptimizeAway(st);
    }
    return .failed;
}

fn registerClient(client_fd: posix.fd_t, ssl: ?*ServerTls, kq: i32) void {
    disableNagle(client_fd);
    markNonBlocking(client_fd);
    const st = connState(client_fd) orelse {
        if (HAS_OPENSSL) {
            if (ssl) |tls| {
                const mod = @import("root").koru_koru.koru_openssl;
                if (tls.ssl) |s| mod.releaseServerSsl(s);
                tls.allocator.destroy(tls);
            }
        }
        posix.close(client_fd);
        return;
    };
    st.ssl = ssl;
    st.tls_hs = ssl != null;
    st.owner_q = kq;
    armKqueueRead(kq, client_fd);
}

fn registerClientEpoll(client_fd: posix.fd_t, ssl: ?*ServerTls, epfd: i32) void {
    const linux = std.os.linux;
    disableNagle(client_fd);
    markNonBlocking(client_fd);
    const st = connState(client_fd) orelse {
        if (HAS_OPENSSL) {
            if (ssl) |tls| {
                const mod = @import("root").koru_koru.koru_openssl;
                if (tls.ssl) |s| mod.releaseServerSsl(s);
                tls.allocator.destroy(tls);
            }
        }
        posix.close(client_fd);
        return;
    };
    st.ssl = ssl;
    st.tls_hs = ssl != null;
    st.owner_q = epfd;
    var client_event = linux.epoll_event{
        .events = linux.EPOLL.IN | linux.EPOLL.ONESHOT,
        .data = .{ .fd = client_fd },
    };
    _ = linux.epoll_ctl(epfd, linux.EPOLL.CTL_ADD, client_fd, &client_event);
}

// The readiness a conn wants next, as epoll bits: a closing conn asks only
// to drain, a queued-up conn asks for write-ready as well as reads, and a
// live conn keeps reading. ONESHOT does the once-per-worker handoff.
fn epollMask(st: *ConnState) u32 {
    const linux = std.os.linux;
    var mask: u32 = linux.EPOLL.ONESHOT;
    if (!st.close_when_drained) mask |= linux.EPOLL.IN;
    if (st.pending_off < st.pending.items.len) mask |= linux.EPOLL.OUT;
    return mask;
}

// ---------------------------------------------------------------------------
// RUN — the loop. One variant per platform.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Shared helpers — identical on every POSIX platform, written once.
// ---------------------------------------------------------------------------

// Ask the TARGET what non-blocking means; do not assert it.
//
// This was `0x0004` — the macOS value — hardcoded, and the Linux pump used it
// too. On Linux the bit is `0x800`, so the flag never took: the socket stayed
// blocking, and an accept loop whose only exit is "would block" never exits.
// The Linux build therefore accepted connections forever and read none of them.
// It printed "Orisha listening", accepted the first connection, and went silent
// — a server that looks up and answers nothing.
//
// A number copied from one platform's headers is a fact about THAT platform. The
// pump seam exists precisely so each platform states its own; this one line went
// around it, which is why the bug survived until the program was first run on
// Linux (2026-08-10, in a container).
const O_NONBLOCK: u32 = @as(u32, @bitCast(posix.O{ .NONBLOCK = true }));

fn openListener(port: u16) ?std.net.Server {
    const address = std.net.Address.parseIp("0.0.0.0", port) catch return null;
    return address.listen(.{
        .reuse_address = true,
        .kernel_backlog = 512,
    }) catch null;
}

fn markNonBlocking(fd: posix.fd_t) void {
    const flags = posix.fcntl(fd, posix.F.GETFL, 0) catch 0;
    _ = posix.fcntl(fd, posix.F.SETFL, flags | O_NONBLOCK) catch {};
}

fn disableNagle(fd: posix.fd_t) void {
    const enable: i32 = 1;
    posix.setsockopt(fd, posix.IPPROTO.TCP, posix.TCP.NODELAY, std.mem.asBytes(&enable)) catch {};
}

// Write the whole thing, and treat "would block" as what it is — a request to
// come back later, not a failure and not a license to sleep.
//
// Every accepted connection is non-blocking (markNonBlocking, below). So once a
// response is bigger than the kernel's send buffer, `write` stops accepting and
// says WouldBlock. Catching that alongside real errors and returning false — as
// this did until 2026-08-10 — abandons the response part-written and closes the
// connection, while the headers have already promised the full Content-Length.
// Nothing about that looks like a failure from the outside: measured against
// korulang.org, one 1.5 MB image returned 327093, 1561984, 1348077, 768057 and
// 498501 bytes on five consecutive requests. A browser renders half an image,
// and a truncated JavaScript module simply fails to import.
//
// The first fix waited — `poll` inside the write loop, up to WRITE_WAIT_MS.
// That made a stalled peer stall its whole worker: every other connection on
// it froze behind one full socket buffer. The second fix is the honest one:
// unwritten bytes go into `st.pending` and a write-ready event drains them
// (queueAndFlush/flushPending, above), so a slow peer costs the worker memory
// — capped at MAX_PENDING — instead of time.

// ---------------------------------------------------------------------------
// How many loops a hosted pump runs.
// ---------------------------------------------------------------------------
// One readiness loop saturates one core and no more, so a single-threaded pump
// on a twelve-core machine is measured against eleven idle ones. This is the
// same choice nginx spells `worker_processes auto`, and comparing against nginx
// with that set while running one loop is not a comparison — it is a handicap
// nobody wrote down.
//
// Each worker owns a private readiness instance and the connections handed to
// it. Nothing is shared: a descriptor belongs to exactly one worker for its
// whole life, so the connection table is only ever touched at an index one
// thread owns. The one genuinely shared thing in a request's path — the buffer
// the response header is built into — is `threadlocal` in the companion, and
// was the ONLY thing that had to change above this file.
const MAX_WORKERS = 16;

fn workerCount() usize {
    const n = std.Thread.getCpuCount() catch return 1;
    return @min(@max(n, 1), MAX_WORKERS);
}

// ---------------------------------------------------------------------------
// FILL — the read seam. One variant per platform, mirroring `reply`.
// ---------------------------------------------------------------------------

// The hosted read: everything with a `std.posix`.
//
// `read` says "nothing available right now" by returning error.WouldBlock, and
// a peer that has finished says it by returning zero bytes. The loops used to
// spell this `catch 0` and then treat zero as the end of the connection, which
// gives those two answers the same meaning. They are not the same: one is a
// connection with more to come, the other is a connection with nothing more
// ever. Separating them is what `idle` is for.
~proc fill|zig {
    if ($mod.HAS_OPENSSL) {
        if (st.ssl) |tls| {
            const mod = @import("root").koru_koru.koru_openssl;
            // `sslFill` can't substitute here — its `more` carries no byte
            // count, and this read must advance st.len.
            const s = tls.ssl orelse return .gone;
            const rc = mod.c.SSL_read(s, @ptrCast(st.buf[st.len..].ptr), @intCast(st.buf.len - st.len));
            if (rc > 0) {
                st.len += @intCast(rc);
                return .more;
            }
            const err_code = mod.c.SSL_get_error(s, rc);
            return switch (err_code) {
                mod.c.SSL_ERROR_WANT_READ, mod.c.SSL_ERROR_WANT_WRITE => .idle,
                else => .gone,
            };
        }
    }
    const n = $mod.posix.read(@intCast(st.fd), st.buf[st.len..]) catch |err| switch (err) {
        error.WouldBlock => return .idle,
        else => return .gone,
    };
    if (n == 0) return .gone;
    st.len += n;
    return .more;
}

// The unikernel's read. `posix.read` has no implementation on a freestanding
// target; `recv` is the socket symbol this pump already uses for everything
// else.
//
// A negative result is an error and zero is a closed peer — but this pump only
// calls `fill` after `poll` said the socket was readable, so "nothing to read"
// is not a case it reaches. Both fold to `gone`.
~proc fill|unikraft {
    const got = $mod.recv(st.fd, @ptrCast(&st.buf[st.len]), st.buf.len - st.len, 0);
    if (got <= 0) return .gone;
    st.len += @intCast(got);
    return .more;
}

// ---------------------------------------------------------------------------
// kqueue — macOS and the BSDs. The default variant.
// ---------------------------------------------------------------------------

~proc init|zig {
    $mod.ignoreSigpipe();

    if ($mod.maybeStartTls(tls_port, cert_path, key_path)) |err_msg| {
        return .{ .failed = err_msg };
    }

    $mod.listen_server = $mod.openListener(port) orelse return .{ .failed = "Failed to listen" };
    $mod.worker_total = $mod.workerCount();
    $mod.should_stop = false;

    // The per-connection half of the loop, unchanged — one runs per worker,
    // each on its own kqueue, each seeing only the descriptors handed to it.
    const Worker = struct {
    fn loop(kq: i32) void {
        var no_changes: [0]$mod.libc.Kevent = undefined;
        var events: [$mod.MAX_EVENTS]$mod.libc.Kevent = undefined;

        while (true) {
            const n = $mod.libc.kevent(kq, &no_changes, 0, &events, $mod.MAX_EVENTS, null);
            if (n <= 0) continue;

            for (events[0..@intCast(n)]) |event| {
                const fd: $mod.posix.fd_t = @intCast(event.ident);

                const st = $mod.connState(fd) orelse {
                    $mod.posix.close(fd);
                    continue;
                };

                // The conn registers before its handshake finishes — step it
                // once per readiness event so a thousand concurrent
                // handshakes spread over every worker, and trust no bytes as
                // requests until the cipher is up.
                if (st.tls_hs) {
                    switch ($mod.driveTlsHandshake(st)) {
                        .ready => st.tls_hs = false,
                        .want_read => {
                            $mod.armKqueueFilter(kq, fd, $mod.libc.EVFILT.READ);
                            continue;
                        },
                        .want_write => {
                            $mod.armKqueueFilter(kq, fd, $mod.libc.EVFILT.WRITE);
                            continue;
                        },
                        .failed => {
                            $mod.releaseConn(fd);
                            continue;
                        },
                    }
                }

                // Write-ready drains whatever earlier sends could not
                // deliver; a conn closing behind a queue ends here.
                if (event.filter == $mod.libc.EVFILT.WRITE) {
                    switch ($mod.flushPending(st)) {
                        .dead => {
                            if ($mod.connIsWs(fd)) closed(@intCast(fd));
                            $mod.releaseConn(fd);
                            continue;
                        },
                        .stalled => {
                            $mod.kqueueRearm(kq, fd, st);
                            continue;
                        },
                        .drained => {
                            if (st.close_when_drained) {
                                if ($mod.connIsWs(fd)) closed(@intCast(fd));
                                $mod.releaseConn(fd);
                                continue;
                            }
                        },
                    }
                    // A WRITE event carries no request bytes — back to read
                    // readiness for the next one.
                    $mod.armKqueueFilter(kq, fd, $mod.libc.EVFILT.READ);
                    continue;
                }

                switch ($mod.fill_event.handler(.{ .st = st })) {
                    .more => {},
                    // Nothing new to frame, but the connection is alive.
                    // Re-arm and wait rather than closing it.
                    .idle => {
                        $mod.kqueueRearm(kq, fd, st);
                        continue;
                    },
                    .gone => {
                        if ($mod.connIsWs(fd)) closed(@intCast(fd));
                        $mod.releaseConn(fd);
                        continue;
                    },
                }

                // An upgraded connection speaks frames, not requests — wsNext
                // is the splitter, control frames are answered at the seam,
                // and complete messages reach the flow's `! frame` arm.
                if (st.mode == .ws) {
                    var ws_consumed: usize = 0;
                    var ws_alive = true;
                    while (ws_consumed < st.len) {
                        const item = $mod.wsNext(st, &ws_consumed) orelse break;
                        switch (item) {
                            .ping => |pl| {
                                if (!$mod.wsSendFrame(st, 0xA, pl)) ws_alive = false;
                            },
                            .close => |pl| {
                                _ = $mod.wsSendFrame(st, 0x8, pl);
                                ws_alive = false;
                            },
                            .dead => ws_alive = false,
                            .message => |m| {
                                var fx = $mod.Exchange{ .fd = fd, .st = st, .raw = m.payload, .opcode = m.op };
                                frame(&fx);
                                st.ws_msg.clearRetainingCapacity();
                                if (!fx.keep_alive) ws_alive = false;
                            },
                        }
                        if (!ws_alive) break;
                    }
                    st.len = $mod.retainTail(&st.buf, st.len, ws_consumed);
                    if (ws_alive and st.len == st.buf.len) ws_alive = false;
                    if (!ws_alive) {
                        if ($mod.pendingLen(st) > 0) {
                            st.close_when_drained = true;
                            $mod.armKqueueFilter(kq, fd, $mod.libc.EVFILT.WRITE);
                            continue;
                        }
                        if ($mod.connIsWs(fd)) closed(@intCast(fd));
                        $mod.releaseConn(fd);
                        continue;
                    }
                    $mod.kqueueRearm(kq, fd, st);
                    continue;
                }

                // Answer every COMPLETE request; keep any unfinished tail
                // for the next read rather than parsing it as a fresh one.
                var consumed: usize = 0;
                var alive = true;
                while (consumed < st.len) {
                    const take = $mod.requestLen(st.buf[consumed..st.len]) orelse break;
                    var exchange = $mod.Exchange{ .fd = fd, .st = st, .raw = st.buf[consumed .. consumed + take] };
                    if ($mod.requestWantsClose(exchange.raw)) exchange.keep_alive = false;
                    arrived(&exchange);
                    consumed += take;
                    if (!exchange.keep_alive) {
                        alive = false;
                        break;
                    }
                }
                st.len = $mod.retainTail(&st.buf, st.len, consumed);

                // Headers that never end are not a request this server can answer.
                if (alive and st.len == st.buf.len) alive = false;

                if (!alive) {
                    if ($mod.pendingLen(st) > 0) {
                        st.close_when_drained = true;
                        $mod.armKqueueFilter(kq, fd, $mod.libc.EVFILT.WRITE);
                        continue;
                    }
                    if ($mod.connIsWs(fd)) closed(@intCast(fd));
                    $mod.releaseConn(fd);
                    continue;
                }

                // ONESHOT disarms on delivery — re-arm for the next request.
                $mod.kqueueRearm(kq, fd, st);
            }
        }
    }
};

    for (0..$mod.worker_total) |i| {
        $mod.worker_kqs[i] = $mod.posix.kqueue() catch {
            if ($mod.listen_server) |*srv| { srv.deinit(); $mod.listen_server = null; }
            return .{ .failed = "Failed to create kqueue" };
        };
        _ = std.Thread.spawn(.{}, Worker.loop, .{ $mod.worker_kqs[i] }) catch {
            if ($mod.listen_server) |*srv| { srv.deinit(); $mod.listen_server = null; }
            return .{ .failed = "Failed to spawn worker" };
        };
    }

    if ($mod.tls_server_ctx != null) {
            const TlsAccept = struct {
        fn loop(kqs_ptr: *[$mod.MAX_WORKERS]i32, n: usize, next_ptr: *usize) void {
            var tls_listener = $mod.openListener($mod.tls_listen_port) orelse return;
            defer tls_listener.deinit();
            while (true) {
                const conn = tls_listener.accept() catch continue;
                const client_fd = conn.stream.handle;
                // Only the SSL object is made here — the handshake runs in
                // the worker loop, one step per readiness event.
                const ssl = $mod.beginTlsHandshake(@intCast(client_fd)) orelse continue;
                const worker = next_ptr.*;
                next_ptr.* = (next_ptr.* + 1) % n;
                $mod.registerClient(client_fd, ssl, kqs_ptr[worker]);
            }
        }
    };

        _ = std.Thread.spawn(.{}, TlsAccept.loop, .{ &$mod.worker_kqs, $mod.worker_total, &$mod.worker_next }) catch
            return .{ .failed = "Failed to spawn TLS accept thread" };
    }

    std.debug.print("Orisha listening on http://0.0.0.0:{}\n", .{port});
    if ($mod.tls_server_ctx != null) {
        std.debug.print("Orisha listening on https://0.0.0.0:{}\n", .{$mod.tls_listen_port});
    }
    std.debug.print("Pump: kqueue, {} workers, keep-alive, TCP_NODELAY\n", .{$mod.worker_total});

    $mod.pump_started = true;
    return .{ .started = .{} };
}

~proc step|zig {
    _ = &__koru_event_input;
    // One pass of the old accept loop: while the listener signals, take the
    // connection and hand it to the next worker in turn. Non-blocking poll
    // first — accept() itself stays blocking; it just never gets the chance.
    var accepted: i32 = 0;
    if ($mod.listen_server) |*srv| {
        while (true) {
            var pfd = [_]std.posix.pollfd{.{ .fd = srv.stream.handle, .events = std.posix.POLL.IN, .revents = 0 }};
            if ((std.posix.poll(&pfd, 0) catch 0) <= 0) break;
            const conn = srv.accept() catch break;
            const client_fd = conn.stream.handle;
            const w = $mod.worker_next;
            $mod.worker_next = (w + 1) % $mod.worker_total;
            $mod.registerClient(client_fd, null, $mod.worker_kqs[w]);
            accepted += 1;
        }
    }
    return accepted;
}

~proc live|zig {
    _ = &__koru_event_input;
    return @intFromBool($mod.pump_started and !$mod.should_stop);
}

~proc wait|zig {
    _ = i;
    const fd: i32 = if ($mod.listen_server) |*srv| srv.stream.handle else -1;
    return .{ .fd = fd, .wait_ns = std.math.maxInt(i128) };
}

~proc stop|zig {
    _ = &__koru_event_input;
    $mod.should_stop = true;
}

~proc deinit|zig {
    _ = &__koru_event_input;
    if ($mod.listen_server) |*srv| {
        srv.deinit();
        $mod.listen_server = null;
    }
    $mod.pump_started = false;
    $mod.should_stop = false;
}

// Retirement verdict for a captured run's `| stopped` — "somebody stopped a
// running server" versus "the machinery never stood up" (init failed). The
// pump's driver calls the retire unit on the first `live() == 0` pass; this
// is what keeps `| stopped` honest inside a compound pump. A stopped
// participant also releases its listener — retirement means torn down, not
// merely quiet.
~proc __retire|zig {
    _ = &__koru_event_input;
    const stopped = $mod.pump_started and $mod.should_stop;
    if (!stopped) return .{ .silent = .{} };
    $mod.deinit_event.handler(.{});
    return .{ .stopped = .{} };
}

// ---------------------------------------------------------------------------
// RUN — context-aware. `orisha/pump:run(...)` reads the same whether it owns
// the program's loop or an open `std/pump` absorbs it: no open pump ahead of
// the site → emits `drive` (the standalone accept loops below). An open pump
// → emits `init` at the site (carrying `! arrived` and `| failed`) plus the
// join units `std/pump:run` enumerates: `__pump_<name>_{step,live,wait}_<idx>`,
// and `__pump_<name>_retired_<idx>` when `| stopped` is armed.
// ---------------------------------------------------------------------------

~proc run|zig {
    const ast_functional = @import("ast_functional");

    const flow = if (item.* == .flow) &item.flow else return .{};
    const rinv = flow.inv();
    if (rinv.inline_body != null) return .{};

    // Helpers live in one container — a Zig local struct can't see the
    // function's other locals, so these are members looking sideways at each
    // other. The marker/decl scans restate koru_pump's PH (private to
    // std/pump — consumer-side transforms restate them, channel.kz precedent).
    //
    // RULED: `// __pump_decl_<name>` / `// __pump_ran_<name>` is the
    // open-pump marker spelling — decided in koru 7636e4146 and named in
    // koru concepts/frag-comment-markers-are-the-inter-transform-wire.
    //
    // ASPIRATIONAL — the `__pump_decl_/__pump_ran_` scan is one edge of the
    // comment wire, duplicated per participant library. The resolved
    // migration is a typed program item (facet_decl precedent) owned by
    // std/pump and queried, not scanned. See the frag above.
    const TH = struct {
        fn mkPath(a: std.mem.Allocator, module: []const u8, name: []const u8) ast.DottedPath {
            const segs = a.alloc([]const u8, 1) catch unreachable;
            segs[0] = a.dupe(u8, name) catch unreachable;
            return ast.DottedPath{ .module_qualifier = a.dupe(u8, module) catch unreachable, .segments = segs };
        }
        fn refuse(a: std.mem.Allocator, f: *const ast.Flow, msg: []const u8) ast.Item {
            const code = std.fmt.allocPrint(a, "comptime {{ @compileError(\"{s}\"); }}", .{msg}) catch unreachable;
            return ast.Item{ .inline_code = ast.InlineCode{ .code = code, .location = f.location, .module = f.module } };
        }
        // A marker host_line is exactly `// <marker>` — anything looser and
        // prose naming the marker (this file's own comments do) reads as a
        // planted pump.
        fn markerScan(its: []const ast.Item, w: []const u8) bool {
            for (its) |*pi| {
                switch (pi.*) {
                    .host_line => |*hl| {
                        const t = std.mem.trim(u8, hl.content, " \r\n\t");
                        if (t.len >= 3 and std.mem.startsWith(u8, t, "// ") and std.mem.eql(u8, t[3..], w)) return true;
                    },
                    .module_decl => |*md| {
                        if (markerScan(md.items, w)) return true;
                    },
                    else => {},
                }
            }
            return false;
        }
        fn markerExists(prog: *const ast.Program, w: []const u8) bool {
            return markerScan(prog.items, w);
        }
        // `// __pump_decl_<name>` planted whole — prose may name the marker
        // pattern (`<name>` in angle brackets), so the tail must parse as a
        // bare identifier.
        fn declName(t: []const u8) ?[]const u8 {
            const prefix = "// __pump_decl_";
            if (!std.mem.startsWith(u8, t, prefix)) return null;
            const name = t[prefix.len..];
            if (name.len == 0) return null;
            for (name) |ch| {
                if (!std.ascii.isAlphanumeric(ch) and ch != '_') return null;
            }
            return name;
        }
        fn declScan(its: []const ast.Item, want: []const u8) bool {
            for (its) |*pi| {
                switch (pi.*) {
                    .event_decl => |*ed| {
                        if (ed.path.segments.len > 0 and std.mem.eql(u8, ed.path.segments[ed.path.segments.len - 1], want)) return true;
                    },
                    .proc_decl => |*pd| {
                        if (pd.path.segments.len > 0 and std.mem.eql(u8, pd.path.segments[pd.path.segments.len - 1], want)) return true;
                    },
                    .module_decl => |*md| {
                        if (declScan(md.items, want)) return true;
                    },
                    else => {},
                }
            }
            return false;
        }
        fn declExists(prog: *const ast.Program, want: []const u8) bool {
            return declScan(prog.items, want);
        }
        fn collectOpen(list: *std.ArrayList([]const u8), a: std.mem.Allocator, prog: *const ast.Program, its: []const ast.Item) void {
            for (its) |*pi| {
                switch (pi.*) {
                    .host_line => |*hl| {
                        const t = std.mem.trim(u8, hl.content, " \r\n\t");
                        if (declName(t)) |name| {
                            for (list.items) |seen| {
                                if (std.mem.eql(u8, seen, name)) break;
                            } else {
                                const ran = std.fmt.allocPrint(a, "__pump_ran_{s}", .{name}) catch unreachable;
                                if (!markerExists(prog, ran)) list.append(a, a.dupe(u8, name) catch unreachable) catch unreachable;
                            }
                        }
                    },
                    .module_decl => |*md| collectOpen(list, a, prog, md.items),
                    else => {},
                }
            }
        }
        // A `->` return inside a transplanted arm would leave the generated
        // unit's flow — detect it before splicing.
        fn hasReturn(cont: *const ast.Continuation) bool {
            if (cont.node) |*n| {
                if (n.* == .branch_constructor) return true;
            }
            for (cont.continuations) |*cc| {
                if (hasReturn(cc)) return true;
            }
            return false;
        }
        fn bareRet(a: std.mem.Allocator, val: []const u8) ast.Continuation {
            return ast.Continuation{
                .branch = a.dupe(u8, "") catch unreachable,
                .binding = null,
                .kind = .terminal,
                .condition = null,
                .node = ast.Node{ .branch_constructor = ast.BranchConstructor{
                    .branch_name = a.dupe(u8, "") catch unreachable,
                    .fields = &[_]ast.Field{},
                    .plain_value = a.dupe(u8, val) catch unreachable,
                    .is_bare_return = true,
                } },
                .indent = 0,
                .continuations = &[_]ast.Continuation{},
            };
        }
        // `__pump_<p>_<verb>_<i>` decl + impl: the module verb call, bound
        // `-> <bind_name>`, with a bare-return tail answering `ret_expr`.
        fn emitUnit(a: std.mem.Allocator, items: *std.ArrayList(ast.Item), flow_: *const ast.Flow, qual: ?[]const u8, unit: []const u8, verb: []const u8, args: []ast.Arg, input: []ast.Field, ret_ty: []const u8, bind_name: []const u8, ret_expr: []const u8, retain: []const []const u8) void {
            const uname = a.dupe(u8, unit) catch unreachable;
            items.append(a, ast.Item{ .event_decl = ast.EventDecl{
                .path = mkPath(a, flow_.module, uname),
                .input = ast.Shape{ .fields = input },
                .branches = &[_]ast.Branch{},
                .return_type = a.dupe(u8, ret_ty) catch unreachable,
                .is_public = false,
                .is_implicit_flow = false,
                .annotations = retain,
                .location = flow_.location,
                .module = a.dupe(u8, flow_.module) catch unreachable,
            } }) catch unreachable;
            const vsegs = a.alloc([]const u8, 1) catch unreachable;
            vsegs[0] = a.dupe(u8, verb) catch unreachable;
            const vinv = ast.Invocation{
                .path = ast.DottedPath{
                    .module_qualifier = if (qual) |mq| a.dupe(u8, mq) catch unreachable else null,
                    .segments = vsegs,
                },
                .args = args,
                .source_module = a.dupe(u8, flow_.module) catch unreachable,
                .return_binding = a.dupe(u8, bind_name) catch unreachable,
            };
            const tail = a.alloc(ast.Continuation, 1) catch unreachable;
            tail[0] = bareRet(a, ret_expr);
            items.append(a, ast.Item{ .flow = ast.Flow{
                .body = ast.rootSite(vinv, tail, flow_.location),
                .pre_label = null,
                .impl_of = mkPath(a, flow_.module, uname),
                .super_shape = null,
                .is_pure = false,
                .is_transitively_pure = false,
                .location = flow_.location,
                .module = a.dupe(u8, flow_.module) catch unreachable,
            } }) catch unreachable;
        }
    };

    // Open pumps: `__pump_decl_<n>` planted and no `__pump_ran_<n>` yet.
    // One open pump absorbs this site; more than one is ambiguous.
    var open = std.ArrayList([]const u8).initCapacity(allocator, 2) catch unreachable;
    TH.collectOpen(&open, allocator, program, program.items);
    if (open.items.len > 1) {
        const msg = std.fmt.allocPrint(allocator, "orisha/pump:run: two pumps are open ('{s}', '{s}') - a captured run can't tell which to join; drive one before opening the next", .{ open.items[0], open.items[1] }) catch unreachable;
        return .{ .replacement = TH.refuse(allocator, flow, msg) };
    }

    // Partition the site's arms: `!` is `arrived` (one exchange per request)
    // or `frame` (one dispatch per complete websocket message); `|` answers
    // are `stopped`/`failed`; unlabeled `|>` steps ride the emitted call in
    // either mode.
    var arrived_arm: ?*const ast.Continuation = null;
    var frame_arm: ?*const ast.Continuation = null;
    var closed_arm: ?*const ast.Continuation = null;
    var stopped_arm: ?*const ast.Continuation = null;
    var failed_arm: ?*const ast.Continuation = null;
    for (flow.body.continuations) |*cont| {
        const cb = std.mem.trim(u8, cont.branch, " ");
        if (cont.kind == .effect) {
            if (std.mem.eql(u8, cb, "arrived") and arrived_arm == null) {
                arrived_arm = cont;
                continue;
            }
            if (std.mem.eql(u8, cb, "frame") and frame_arm == null) {
                frame_arm = cont;
                continue;
            }
            if (std.mem.eql(u8, cb, "closed") and closed_arm == null) {
                closed_arm = cont;
                continue;
            }
            const msg = std.fmt.allocPrint(allocator, "orisha/pump:run: `! {s}` doesn't parse on a run call - the pump's effects are `! arrived` (one exchange per request), `! frame` (one websocket message) and `! closed` (an upgraded connection released)", .{cb}) catch unreachable;
            return .{ .replacement = TH.refuse(allocator, flow, msg) };
        }
        if (cb.len == 0) continue;
        if (std.mem.eql(u8, cb, "stopped")) {
            if (stopped_arm != null) {
                return .{ .replacement = TH.refuse(allocator, flow, "orisha/pump:run: one `| stopped` per run") };
            }
            stopped_arm = cont;
        } else if (std.mem.eql(u8, cb, "failed")) {
            if (failed_arm != null) {
                return .{ .replacement = TH.refuse(allocator, flow, "orisha/pump:run: one `| failed` per run") };
            }
            failed_arm = cont;
        } else {
            const msg = std.fmt.allocPrint(allocator, "orisha/pump:run: `| {s}` doesn't parse - a run answers `| stopped` and `| failed`", .{cb}) catch unreachable;
            return .{ .replacement = TH.refuse(allocator, flow, msg) };
        }
    }

    if (open.items.len == 0) {
        // Standalone — `drive` is today's fused accept loop, variants and all.
        var inv_clone = ast_functional.cloneInvocation(allocator, rinv) catch unreachable;
        const dsegs = allocator.alloc([]const u8, 1) catch unreachable;
        dsegs[0] = allocator.dupe(u8, "drive") catch unreachable;
        inv_clone.path.segments = dsegs;
        const cloned = allocator.alloc(ast.Continuation, flow.body.continuations.len) catch unreachable;
        for (flow.body.continuations, 0..) |*cont, i| {
            cloned[i] = ast_functional.cloneContinuation(allocator, cont) catch unreachable;
        }
        return .{ .replacement = ast.Item{ .flow = ast.Flow{
            .body = ast.rootSite(inv_clone, cloned, flow.location),
            .annotations = flow.annotations,
            .pre_label = flow.pre_label,
            .impl_of = flow.impl_of,
            .super_shape = flow.super_shape,
            .inline_body = flow.inline_body,
            .preamble_code = flow.preamble_code,
            .is_pure = flow.is_pure,
            .is_transitively_pure = flow.is_transitively_pure,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } } };
    }

    // Captured — join the open pump.
    const pump_name = open.items[0];
    if (stopped_arm) |sa| {
        if (sa.binding) |b| {
            if (b.len > 0 and !std.mem.eql(u8, b, "_")) {
                return .{ .replacement = TH.refuse(allocator, flow, "orisha/pump:run: a captured `| stopped` can't bind a payload - the driver retires the participant; no reason string reaches the arm") };
            }
        }
        if (TH.hasReturn(sa)) {
            return .{ .replacement = TH.refuse(allocator, flow, "orisha/pump:run: a captured `| stopped` can't `->` return - the arm runs inside the pump's retire unit, not this flow") };
        }
    }

    var join_idx: usize = 0;
    while (TH.declExists(program, std.fmt.allocPrint(allocator, "__pump_{s}_step_{d}", .{ pump_name, join_idx }) catch unreachable)) join_idx += 1;

    var appended = std.ArrayList(ast.Item).initCapacity(allocator, 8) catch unreachable;
    const retain_ann = blk_ra: {
        const anns = allocator.alloc([]const u8, 1) catch unreachable;
        anns[0] = allocator.dupe(u8, "retain") catch unreachable;
        break :blk_ra anns;
    };
    const mq = rinv.path.module_qualifier;
    TH.emitUnit(allocator, &appended, flow, mq, std.fmt.allocPrint(allocator, "__pump_{s}_step_{d}", .{ pump_name, join_idx }) catch unreachable, "step", &[_]ast.Arg{}, &[_]ast.Field{}, "i32", "__koru_r", "__koru_r", retain_ann);
    TH.emitUnit(allocator, &appended, flow, mq, std.fmt.allocPrint(allocator, "__pump_{s}_live_{d}", .{ pump_name, join_idx }) catch unreachable, "live", &[_]ast.Arg{}, &[_]ast.Field{}, "i64", "__koru_r", "__koru_r", retain_ann);
    const wait_field = allocator.alloc(ast.Field, 1) catch unreachable;
    wait_field[0] = ast.Field{ .name = allocator.dupe(u8, "i") catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
    const wait_arg = allocator.alloc(ast.Arg, 1) catch unreachable;
    wait_arg[0] = ast.Arg{ .name = allocator.dupe(u8, "i") catch unreachable, .value = allocator.dupe(u8, "i") catch unreachable };
    TH.emitUnit(allocator, &appended, flow, mq, std.fmt.allocPrint(allocator, "__pump_{s}_wait_{d}", .{ pump_name, join_idx }) catch unreachable, "wait", wait_arg, wait_field, "{ fd: i32, wait_ns: i128 }", "__koru_w", ".{ .fd = __koru_w.fd, .wait_ns = __koru_w.wait_ns }", retain_ann);

    if (stopped_arm) |sa| {
        const rname = std.fmt.allocPrint(allocator, "__pump_{s}_retired_{d}", .{ pump_name, join_idx }) catch unreachable;
        appended.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
            .path = TH.mkPath(allocator, flow.module, rname),
            .input = ast.Shape{ .fields = &[_]ast.Field{} },
            .branches = &[_]ast.Branch{},
            .is_public = false,
            .is_implicit_flow = false,
            .annotations = retain_ann,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;
        const rsegs = allocator.alloc([]const u8, 1) catch unreachable;
        rsegs[0] = allocator.dupe(u8, "__retire") catch unreachable;
        const retire_inv = ast.Invocation{
            .path = ast.DottedPath{
                .module_qualifier = if (mq) |q| allocator.dupe(u8, q) catch unreachable else null,
                .segments = rsegs,
            },
            .args = &[_]ast.Arg{},
            .source_module = allocator.dupe(u8, flow.module) catch unreachable,
        };
        const sconts = allocator.alloc(ast.Continuation, 1) catch unreachable;
        sconts[0] = ast_functional.cloneContinuation(allocator, sa) catch unreachable;
        appended.append(allocator, ast.Item{ .flow = ast.Flow{
            .body = ast.rootSite(retire_inv, sconts, flow.location),
            .pre_label = null,
            .impl_of = TH.mkPath(allocator, flow.module, rname),
            .super_shape = null,
            .is_pure = false,
            .is_transitively_pure = false,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;
    }

    // The site's replacement: `init` with the same args, wearing `! arrived`,
    // `| failed`, and the unlabeled chain — everything but `| stopped`, which
    // lives on the retire unit now.
    var init_inv = ast_functional.cloneInvocation(allocator, rinv) catch unreachable;
    const isegs = allocator.alloc([]const u8, 1) catch unreachable;
    isegs[0] = allocator.dupe(u8, "init") catch unreachable;
    init_inv.path.segments = isegs;
    var iconts = std.ArrayList(ast.Continuation).initCapacity(allocator, flow.body.continuations.len) catch unreachable;
    for (flow.body.continuations) |*cont| {
        if (stopped_arm != null and cont == stopped_arm.?) continue;
        iconts.append(allocator, ast_functional.cloneContinuation(allocator, cont) catch unreachable) catch unreachable;
    }
    return .{ .replacement = ast.Item{ .flow = ast.Flow{
        .body = ast.rootSite(init_inv, iconts.items, flow.location),
        .annotations = flow.annotations,
        .pre_label = flow.pre_label,
        .impl_of = flow.impl_of,
        .super_shape = flow.super_shape,
        .inline_body = flow.inline_body,
        .preamble_code = flow.preamble_code,
        .is_pure = flow.is_pure,
        .is_transitively_pure = flow.is_transitively_pure,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } }, .appended = appended.toOwnedSlice(allocator) catch unreachable };
}

~proc drive|zig {
    $mod.ignoreSigpipe();

    if ($mod.maybeStartTls(tls_port, cert_path, key_path)) |err_msg| {
        return .{ .failed = err_msg };
    }

    var server = $mod.openListener(port) orelse return .{ .failed = "Failed to listen" };

    const n_workers = $mod.workerCount();

    // The listener is NOT in anybody's readiness set. This thread does nothing
    // but accept, and blocks while it waits — which is why the listener stays
    // blocking where the connections do not. Arming it inside a worker's kqueue
    // would make that one worker answer every new connection as well as its own
    // traffic.
    var kqs: [$mod.MAX_WORKERS]i32 = undefined;

    // The per-connection half of the loop, which is the whole loop now that
    // accepting has moved out. One runs per worker, each on its own kqueue,
    // each seeing only the descriptors handed to it.
    const Worker = struct {
        fn loop(kq: i32) void {
            var no_changes: [0]$mod.libc.Kevent = undefined;
            var events: [$mod.MAX_EVENTS]$mod.libc.Kevent = undefined;

            while (true) {
                const n = $mod.libc.kevent(kq, &no_changes, 0, &events, $mod.MAX_EVENTS, null);
                if (n <= 0) continue;

                for (events[0..@intCast(n)]) |event| {
                    const fd: $mod.posix.fd_t = @intCast(event.ident);

                    const st = $mod.connState(fd) orelse {
                        $mod.posix.close(fd);
                        continue;
                    };

                    // The conn registers before its handshake finishes —
                    // step it once per readiness event so a thousand
                    // concurrent handshakes spread over every worker, and
                    // trust no bytes as requests until the cipher is up.
                    if (st.tls_hs) {
                        switch ($mod.driveTlsHandshake(st)) {
                            .ready => st.tls_hs = false,
                            .want_read => {
                                $mod.armKqueueFilter(kq, fd, $mod.libc.EVFILT.READ);
                                continue;
                            },
                            .want_write => {
                                $mod.armKqueueFilter(kq, fd, $mod.libc.EVFILT.WRITE);
                                continue;
                            },
                            .failed => {
                                $mod.releaseConn(fd);
                                continue;
                            },
                        }
                    }

                    // Write-ready drains whatever earlier sends could not
                    // deliver; a conn closing behind a queue ends here.
                    if (event.filter == $mod.libc.EVFILT.WRITE) {
                        switch ($mod.flushPending(st)) {
                            .dead => {
                                if ($mod.connIsWs(fd)) closed(@intCast(fd));
                                $mod.releaseConn(fd);
                                continue;
                            },
                            .stalled => {
                                $mod.kqueueRearm(kq, fd, st);
                                continue;
                            },
                            .drained => {
                                if (st.close_when_drained) {
                                    if ($mod.connIsWs(fd)) closed(@intCast(fd));
                                    $mod.releaseConn(fd);
                                    continue;
                                }
                            },
                        }
                        // A WRITE event carries no request bytes — back to
                        // read readiness for the next one.
                        $mod.armKqueueFilter(kq, fd, $mod.libc.EVFILT.READ);
                        continue;
                    }

                    switch ($mod.fill_event.handler(.{ .st = st })) {
                        .more => {},
                        // Nothing new to frame, but the connection is alive.
                        // Re-arm and wait rather than closing it.
                        .idle => {
                            $mod.kqueueRearm(kq, fd, st);
                            continue;
                        },
                        .gone => {
                            if ($mod.connIsWs(fd)) closed(@intCast(fd));
                            $mod.releaseConn(fd);
                            continue;
                        },
                    }

                    // Upgraded connection: frames, not requests — same seam as
                    // `init|zig`'s `st.mode == .ws` block above.
                    if (st.mode == .ws) {
                        var ws_consumed: usize = 0;
                        var ws_alive = true;
                        while (ws_consumed < st.len) {
                            const item = $mod.wsNext(st, &ws_consumed) orelse break;
                            switch (item) {
                                .ping => |pl| {
                                    if (!$mod.wsSendFrame(st, 0xA, pl)) ws_alive = false;
                                },
                                .close => |pl| {
                                    _ = $mod.wsSendFrame(st, 0x8, pl);
                                    ws_alive = false;
                                },
                                .dead => ws_alive = false,
                                .message => |m| {
                                    var fx = $mod.Exchange{ .fd = fd, .st = st, .raw = m.payload, .opcode = m.op };
                                    frame(&fx);
                                    st.ws_msg.clearRetainingCapacity();
                                    if (!fx.keep_alive) ws_alive = false;
                                },
                            }
                            if (!ws_alive) break;
                        }
                        st.len = $mod.retainTail(&st.buf, st.len, ws_consumed);
                        if (ws_alive and st.len == st.buf.len) ws_alive = false;
                        if (!ws_alive) {
                            if ($mod.pendingLen(st) > 0) {
                                st.close_when_drained = true;
                                $mod.armKqueueFilter(kq, fd, $mod.libc.EVFILT.WRITE);
                                continue;
                            }
                            if ($mod.connIsWs(fd)) closed(@intCast(fd));
                            $mod.releaseConn(fd);
                            continue;
                        }
                        $mod.kqueueRearm(kq, fd, st);
                        continue;
                    }

                    // Answer every COMPLETE request; keep any unfinished tail
                    // for the next read rather than parsing it as a fresh one.
                    var consumed: usize = 0;
                    var alive = true;
                    while (consumed < st.len) {
                        const take = $mod.requestLen(st.buf[consumed..st.len]) orelse break;
                        var exchange = $mod.Exchange{ .fd = fd, .st = st, .raw = st.buf[consumed .. consumed + take] };
                        if ($mod.requestWantsClose(exchange.raw)) exchange.keep_alive = false;
                        arrived(&exchange);
                        consumed += take;
                        if (!exchange.keep_alive) {
                            alive = false;
                            break;
                        }
                    }
                    st.len = $mod.retainTail(&st.buf, st.len, consumed);

                    // Headers that never end are not a request this server can answer.
                    if (alive and st.len == st.buf.len) alive = false;

                    if (!alive) {
                        // A closing answer still in the queue drains first —
                        // releasing here would cut it mid-flight.
                        if ($mod.pendingLen(st) > 0) {
                            st.close_when_drained = true;
                            $mod.armKqueueFilter(kq, fd, $mod.libc.EVFILT.WRITE);
                            continue;
                        }
                        if ($mod.connIsWs(fd)) closed(@intCast(fd));
                        $mod.releaseConn(fd);
                        continue;
                    }

                    // ONESHOT disarms on delivery — re-arm for the next request.
                    $mod.kqueueRearm(kq, fd, st);
                }
            }
        }
    };

    for (0..n_workers) |i| {
        kqs[i] = $mod.posix.kqueue() catch return .{ .failed = "Failed to create kqueue" };
        _ = std.Thread.spawn(.{}, Worker.loop, .{kqs[i]}) catch
            return .{ .failed = "Failed to spawn worker" };
    }

    var next: usize = 0;
    if ($mod.tls_server_ctx != null) {
        const TlsAccept = struct {
            fn loop(kqs_ptr: *[$mod.MAX_WORKERS]i32, n: usize, next_ptr: *usize) void {
                var tls_listener = $mod.openListener($mod.tls_listen_port) orelse return;
                defer tls_listener.deinit();
                while (true) {
                    const conn = tls_listener.accept() catch continue;
                    const client_fd = conn.stream.handle;
                    // Only the SSL object is made here — the handshake runs
                    // in the worker loop, one step per readiness event.
                    const ssl = $mod.beginTlsHandshake(@intCast(client_fd)) orelse continue;
                    const worker = next_ptr.*;
                    next_ptr.* = (next_ptr.* + 1) % n;
                    $mod.registerClient(client_fd, ssl, kqs_ptr[worker]);
                }
            }
        };
        _ = std.Thread.spawn(.{}, TlsAccept.loop, .{ &kqs, n_workers, &next }) catch
            return .{ .failed = "Failed to spawn TLS accept thread" };
    }

    std.debug.print("Orisha listening on http://0.0.0.0:{}\n", .{port});
    if ($mod.tls_server_ctx != null) {
        std.debug.print("Orisha listening on https://0.0.0.0:{}\n", .{$mod.tls_listen_port});
    }
    std.debug.print("Pump: kqueue, {} workers, keep-alive, TCP_NODELAY\n", .{n_workers});

    // Hand each new connection to the next worker in turn. A descriptor belongs
    // to that worker for the rest of its life, which is what makes the shared
    // connection table safe without a lock: no index is ever touched twice.
    while (true) {
        const conn = server.accept() catch continue;
        const client_fd = conn.stream.handle;
        const worker = next;
        next = (next + 1) % n_workers;
        $mod.registerClient(client_fd, null, kqs[worker]);
    }

    return .{ .stopped = "Server stopped" };
}

// ---------------------------------------------------------------------------
// epoll — Linux. Selected by `--build=linux`.
// ---------------------------------------------------------------------------

~proc drive|epoll {
    $mod.ignoreSigpipe();

    const linux = std.os.linux;

    if ($mod.maybeStartTls(tls_port, cert_path, key_path)) |err_msg| {
        return .{ .failed = err_msg };
    }

    var server = $mod.openListener(port) orelse return .{ .failed = "Failed to listen" };

    const n_workers = $mod.workerCount();

    // The listener is NOT in anybody's readiness set. This thread does nothing
    // but accept, and it blocks while it waits — which is why the listener is
    // left blocking where the connections are not. Multiplexing the listener
    // into a worker's epoll would make one worker answer every new connection
    // as well as its own traffic.
    // ONE readiness instance, shared by every worker.
    //
    // This was one epoll per worker, with each connection assigned at accept
    // time and owned by that worker for life. Round-robin hands out connections
    // without any idea how much work each will turn out to be, and a request
    // could then only ever be served by the worker it was given to, however
    // idle the others were.
    //
    // ONESHOT keeps the property that made the old design lock-free — exactly
    // one worker holds a descriptor at a time, so the connection table still
    // needs no lock. What changes is only WHICH worker, and that it is decided
    // when the work appears rather than when the connection arrived.
    //
    // Measured: 197,065 against 189,447 req/s, winning all three rounds.
    // It did NOT change the tail (6.99ms against 6.68ms at p99), which was the
    // reason it was written — see benchmarks/twobox/CONDITIONS.md.
    var shared_epfd: i32 = -1;

    // The per-connection half of the loop, which is the whole loop now that
    // accepting has moved out. One of these runs per worker, each on its own
    // epoll instance, each seeing only the descriptors handed to it.
    const Worker = struct {
        fn loop(epfd: i32) void {
            var events: [$mod.MAX_EVENTS]linux.epoll_event = undefined;
            while (true) {
                const n_rc = linux.epoll_wait(epfd, &events, $mod.MAX_EVENTS, -1);
                const n: i32 = @bitCast(@as(u32, @truncate(n_rc)));
                if (n <= 0) continue;

                for (events[0..@intCast(n)]) |event| {
                    const fd: $mod.posix.fd_t = event.data.fd;

                    const st = $mod.connState(fd) orelse {
                        $mod.posix.close(fd);
                        continue;
                    };

                    // The conn registers before its handshake finishes —
                    // step it once per readiness event so a thousand
                    // concurrent handshakes spread over every worker, and
                    // trust no bytes as requests until the cipher is up.
                    if (st.tls_hs) {
                        switch ($mod.driveTlsHandshake(st)) {
                            .ready => st.tls_hs = false,
                            // Arm only the direction the cipher asked for: a
                            // want_read conn re-armed IN|OUT refires instantly
                            // (OUT is level-true on any writable socket), and a
                            // thousand handshakes doing that drown the real
                            // readiness events in futile SSL_accept calls.
                            .want_read, .want_write => |w| {
                                const dir: u32 = if (w == .want_read) linux.EPOLL.IN else linux.EPOLL.OUT;
                                var wait = linux.epoll_event{
                                    .events = dir | linux.EPOLL.ONESHOT,
                                    .data = .{ .fd = fd },
                                };
                                _ = linux.epoll_ctl(epfd, linux.EPOLL.CTL_MOD, fd, &wait);
                                continue;
                            },
                            .failed => {
                                $mod.releaseConn(fd);
                                continue;
                            },
                        }
                    }

                    // Write-ready drains whatever earlier sends could not
                    // deliver; a conn closing behind a queue ends here.
                    if (event.events & linux.EPOLL.OUT != 0) {
                        switch ($mod.flushPending(st)) {
                            .dead => {
                                if ($mod.connIsWs(fd)) closed(@intCast(fd));
                                $mod.releaseConn(fd);
                                continue;
                            },
                            .stalled => {
                                var wait = linux.epoll_event{
                                    .events = $mod.epollMask(st),
                                    .data = .{ .fd = fd },
                                };
                                _ = linux.epoll_ctl(epfd, linux.EPOLL.CTL_MOD, fd, &wait);
                                continue;
                            },
                            .drained => {
                                if (st.close_when_drained) {
                                    if ($mod.connIsWs(fd)) closed(@intCast(fd));
                                    $mod.releaseConn(fd);
                                    continue;
                                }
                            },
                        }
                        if (event.events & linux.EPOLL.IN == 0) {
                            var wait = linux.epoll_event{
                                .events = linux.EPOLL.IN | linux.EPOLL.ONESHOT,
                                .data = .{ .fd = fd },
                            };
                            _ = linux.epoll_ctl(epfd, linux.EPOLL.CTL_MOD, fd, &wait);
                            continue;
                        }
                    }

                    switch ($mod.fill_event.handler(.{ .st = st })) {
                        .more => {},
                        .idle => {
                            var wait = linux.epoll_event{
                                .events = $mod.epollMask(st),
                                .data = .{ .fd = fd },
                            };
                            _ = linux.epoll_ctl(epfd, linux.EPOLL.CTL_MOD, fd, &wait);
                            continue;
                        },
                        .gone => {
                            if ($mod.connIsWs(fd)) closed(@intCast(fd));
                            $mod.releaseConn(fd);
                            continue;
                        },
                    }

                    // Upgraded connection: frames, not requests — same seam as
                    // the kqueue pump's `st.mode == .ws` block.
                    if (st.mode == .ws) {
                        var ws_consumed: usize = 0;
                        var ws_alive = true;
                        while (ws_consumed < st.len) {
                            const item = $mod.wsNext(st, &ws_consumed) orelse break;
                            switch (item) {
                                .ping => |pl| {
                                    if (!$mod.wsSendFrame(st, 0xA, pl)) ws_alive = false;
                                },
                                .close => |pl| {
                                    _ = $mod.wsSendFrame(st, 0x8, pl);
                                    ws_alive = false;
                                },
                                .dead => ws_alive = false,
                                .message => |m| {
                                    var fx = $mod.Exchange{ .fd = fd, .st = st, .raw = m.payload, .opcode = m.op };
                                    frame(&fx);
                                    st.ws_msg.clearRetainingCapacity();
                                    if (!fx.keep_alive) ws_alive = false;
                                },
                            }
                            if (!ws_alive) break;
                        }
                        st.len = $mod.retainTail(&st.buf, st.len, ws_consumed);
                        if (ws_alive and st.len == st.buf.len) ws_alive = false;
                        if (!ws_alive) {
                            if ($mod.pendingLen(st) > 0) {
                                st.close_when_drained = true;
                                var wait = linux.epoll_event{
                                    .events = linux.EPOLL.OUT | linux.EPOLL.ONESHOT,
                                    .data = .{ .fd = fd },
                                };
                                _ = linux.epoll_ctl(epfd, linux.EPOLL.CTL_MOD, fd, &wait);
                                continue;
                            }
                            if ($mod.connIsWs(fd)) closed(@intCast(fd));
                            $mod.releaseConn(fd);
                            continue;
                        }
                        var ws_rearm = linux.epoll_event{
                            .events = $mod.epollMask(st),
                            .data = .{ .fd = fd },
                        };
                        _ = linux.epoll_ctl(epfd, linux.EPOLL.CTL_MOD, fd, &ws_rearm);
                        continue;
                    }

                    // Same shape as the kqueue pump — see requestLen and retainTail.
                    var consumed: usize = 0;
                    var alive = true;
                    while (consumed < st.len) {
                        const take = $mod.requestLen(st.buf[consumed..st.len]) orelse break;
                        var exchange = $mod.Exchange{ .fd = fd, .st = st, .raw = st.buf[consumed .. consumed + take] };
                        if ($mod.requestWantsClose(exchange.raw)) exchange.keep_alive = false;
                        arrived(&exchange);
                        consumed += take;
                        if (!exchange.keep_alive) {
                            alive = false;
                            break;
                        }
                    }
                    st.len = $mod.retainTail(&st.buf, st.len, consumed);
                    if (alive and st.len == st.buf.len) alive = false;

                    if (!alive) {
                        // A closing answer still in the queue drains first —
                        // releasing here would cut it mid-flight.
                        if ($mod.pendingLen(st) > 0) {
                            st.close_when_drained = true;
                            var wait = linux.epoll_event{
                                .events = linux.EPOLL.OUT | linux.EPOLL.ONESHOT,
                                .data = .{ .fd = fd },
                            };
                            _ = linux.epoll_ctl(epfd, linux.EPOLL.CTL_MOD, fd, &wait);
                            continue;
                        }
                        if ($mod.connIsWs(fd)) closed(@intCast(fd));
                        $mod.releaseConn(fd);
                        continue;
                    }

                    var rearm = linux.epoll_event{
                        .events = $mod.epollMask(st),
                        .data = .{ .fd = fd },
                    };
                    _ = linux.epoll_ctl(epfd, linux.EPOLL.CTL_MOD, fd, &rearm);
                }
            }
        }
    };

    const rc = linux.epoll_create1(0);
    shared_epfd = @bitCast(@as(u32, @truncate(rc)));
    if (shared_epfd < 0) return .{ .failed = "Failed to create epoll" };
    for (0..n_workers) |_| {
        _ = std.Thread.spawn(.{}, Worker.loop, .{shared_epfd}) catch
            return .{ .failed = "Failed to spawn worker" };
    }

    if ($mod.tls_server_ctx != null) {
        const TlsAccept = struct {
            fn loop(epfd: i32) void {
                var tls_listener = $mod.openListener($mod.tls_listen_port) orelse return;
                defer tls_listener.deinit();
                while (true) {
                    const conn = tls_listener.accept() catch continue;
                    const client_fd = conn.stream.handle;
                    // Only the SSL object is made here — the handshake runs
                    // in the worker loop, one step per readiness event.
                    const ssl = $mod.beginTlsHandshake(@intCast(client_fd)) orelse continue;
                    $mod.registerClientEpoll(client_fd, ssl, epfd);
                }
            }
        };
        _ = std.Thread.spawn(.{}, TlsAccept.loop, .{shared_epfd}) catch
            return .{ .failed = "Failed to spawn TLS accept thread" };
    }

    std.debug.print("Orisha listening on http://0.0.0.0:{}\n", .{port});
    if ($mod.tls_server_ctx != null) {
        std.debug.print("Orisha listening on https://0.0.0.0:{}\n", .{$mod.tls_listen_port});
    }
    std.debug.print("Pump: epoll, {} workers on one shared queue, keep-alive, TCP_NODELAY\n", .{n_workers});

    while (true) {
        const conn = server.accept() catch continue;
        const client_fd = conn.stream.handle;
        $mod.registerClientEpoll(client_fd, null, shared_epfd);
    }

    return .{ .stopped = "Server stopped" };
}

// ---------------------------------------------------------------------------
// io_uring — Linux 5.x and later. Selected by `--build=io-uring`.
// ---------------------------------------------------------------------------
// The other three pumps ask the kernel WHICH descriptor is ready and then do the
// read themselves. This one submits the read up front and is told it has already
// happened — so there is no readiness step, and the loop body handles a result
// rather than a hint.
//
// That is a different shape, not a faster spelling of the same one, and it is
// the reason the seam is worth having: everything above `run` is untouched by
// the inversion. Framing, buffering and the idle timeout are the shared helpers
// the other pumps use; only the way bytes arrive is new.
//
// A blocking write is used for the reply (the `reply|zig` body, unchanged): the
// connections here are never marked non-blocking, so `write` completes or waits,
// and there is no readiness to wait for anyway.
//
// This is also the one pump that does NOT go through `fill`, and the inversion
// is why: `fill` is a call that fetches bytes, and here nobody calls anything —
// the bytes are already in the buffer by the time the loop hears about them, and
// the count arrives in the completion. The three answers `fill` gives are all
// still here, just read off `cqe.res` instead of returned. Anything that wants
// to sit between the wire and the parser attaches at that harvest below, not at
// a call site.

~proc drive|io-uring {
    if (tls_port != null) {
        return .{ .failed = "TLS is not supported on the io_uring pump yet" };
    }
    // `std.os.linux.IoUring` cannot be NAMED on a non-Linux target — it reaches
    // for `linux.E` and a macOS build has `darwin.E` instead, so this is a type
    // error, not a missing feature. The guard is comptime-known, so the body
    // below is never analysed when the host is not Linux, and `koruc` can still
    // produce its host executable on a laptop.
    if (@import("builtin").os.tag != .linux) {
        return .{ .failed = "io_uring is a Linux mechanism — build with --build=linux for this host" };
    }

    $mod.ignoreSigpipe();

    const linux = std.os.linux;

    const server = $mod.openListener(port) orelse return .{ .failed = "Failed to listen" };
    const listen_fd = server.stream.handle;

    // Say which io_uring is missing, because there are two very different
    // reasons and they need opposite responses. A kernel older than 5.1 has no
    // io_uring at all. A modern kernel inside a container usually HAS it and is
    // being refused by the sandbox: Docker's default seccomp profile blocks
    // io_uring_setup, so `uname -r` says 6.12 while the call still fails.
    //
    // Measured 2026-08-11: this reported "needs Linux 5.1 or later" on a 6.12
    // kernel, which is a diagnostic pointing at the wrong cause — the fix was
    // `--security-opt seccomp=unconfined`, not an upgrade.
    var ring = linux.IoUring.init($mod.URING_ENTRIES, 0) catch |err| {
        const why = switch (err) {
            error.PermissionDenied, error.SystemOutdated => "io_uring refused: the kernel has it but something is blocking io_uring_setup — a container seccomp profile is the usual cause (try --security-opt seccomp=unconfined), or the kernel predates 5.1",
            error.SystemResources => "io_uring unavailable: not enough locked memory for the ring — raise RLIMIT_MEMLOCK",
            else => "io_uring unavailable — io_uring_setup failed",
        };
        return .{ .failed = why };
    };

    _ = ring.accept($mod.URING_ACCEPT, listen_fd, null, null, 0) catch
        return .{ .failed = "io_uring accept" };

    std.debug.print("Orisha listening on http://0.0.0.0:{}\n", .{port});
    std.debug.print("Pump: io_uring, keep-alive, TCP_NODELAY\n", .{});

    var cqes: [$mod.MAX_EVENTS]linux.io_uring_cqe = undefined;

    while (true) {
        _ = ring.submit_and_wait(1) catch continue;
        const ready = ring.copy_cqes(&cqes, 1) catch continue;

        for (cqes[0..ready]) |cqe| {
            if (cqe.user_data == $mod.URING_ACCEPT) {
                // Re-arm FIRST. A burst of connections is otherwise serialised
                // behind whatever this one turns into.
                _ = ring.accept($mod.URING_ACCEPT, listen_fd, null, null, 0) catch {};
                if (cqe.res < 0) continue;

                const client_fd: $mod.posix.fd_t = @intCast(cqe.res);
                $mod.disableNagle(client_fd);

                const fresh = $mod.connState(client_fd) orelse {
                    $mod.posix.close(client_fd);
                    continue;
                };
                fresh.len = 0;
                // The buffer lives in the connection's own state, which is
                // heap-stable — the kernel writes into it before we are told.
                _ = ring.recv(@intCast(client_fd), client_fd, .{ .buffer = fresh.buf[0..] }, 0) catch {
                    // releaseConn closes the fd — a second close is EBADF.
                    if ($mod.connIsWs(client_fd)) closed(@intCast(client_fd));
                    $mod.releaseConn(client_fd);
                };
                continue;
            }

            const fd: $mod.posix.fd_t = @intCast(cqe.user_data);
            const st = $mod.connState(fd) orelse continue;

            if (cqe.res <= 0) {
                if ($mod.connIsWs(fd)) closed(@intCast(fd));
                $mod.releaseConn(fd);
                continue;
            }
            st.len += @intCast(cqe.res);

            // Upgraded connection: frames, not requests — same seam as the
            // kqueue pump's `st.mode == .ws` block; the re-arm here is the
            // next submitted recv rather than a readiness re-arm.
            if (st.mode == .ws) {
                var ws_consumed: usize = 0;
                var ws_alive = true;
                while (ws_consumed < st.len) {
                    const item = $mod.wsNext(st, &ws_consumed) orelse break;
                    switch (item) {
                        .ping => |pl| {
                            if (!$mod.wsSendFrame(st, 0xA, pl)) ws_alive = false;
                        },
                        .close => |pl| {
                            _ = $mod.wsSendFrame(st, 0x8, pl);
                            ws_alive = false;
                        },
                        .dead => ws_alive = false,
                        .message => |m| {
                            var fx = $mod.Exchange{ .fd = fd, .st = st, .raw = m.payload, .opcode = m.op };
                            frame(&fx);
                            st.ws_msg.clearRetainingCapacity();
                            if (!fx.keep_alive) ws_alive = false;
                        },
                    }
                    if (!ws_alive) break;
                }
                st.len = $mod.retainTail(&st.buf, st.len, ws_consumed);
                if (ws_alive and st.len == st.buf.len) ws_alive = false;
                if (!ws_alive) {
                    if ($mod.connIsWs(fd)) closed(@intCast(fd));
                    $mod.releaseConn(fd);
                    continue;
                }
                _ = ring.recv(@intCast(fd), fd, .{ .buffer = st.buf[st.len..] }, 0) catch {
                    if ($mod.connIsWs(fd)) closed(@intCast(fd));
                    $mod.releaseConn(fd);
                };
                continue;
            }

            // Answer every COMPLETE request — the same helpers the other pumps
            // use, so a browser is handled identically here.
            var consumed: usize = 0;
            var alive = true;
            while (consumed < st.len) {
                const take = $mod.requestLen(st.buf[consumed..st.len]) orelse break;
                var exchange = $mod.Exchange{ .fd = fd, .st = st, .raw = st.buf[consumed .. consumed + take] };
                if ($mod.requestWantsClose(exchange.raw)) exchange.keep_alive = false;
                arrived(&exchange);
                consumed += take;
                if (!exchange.keep_alive) {
                    alive = false;
                    break;
                }
            }
            st.len = $mod.retainTail(&st.buf, st.len, consumed);
            if (alive and st.len == st.buf.len) alive = false;

            if (!alive) {
                if ($mod.connIsWs(fd)) closed(@intCast(fd));
                $mod.releaseConn(fd);
                continue;
            }

            // Ask for the next bytes, appending to whatever is unfinished.
            _ = ring.recv(@intCast(fd), fd, .{ .buffer = st.buf[st.len..] }, 0) catch {
                if ($mod.connIsWs(fd)) closed(@intCast(fd));
                $mod.releaseConn(fd);
            };
        }
    }

    return .{ .stopped = "Server stopped" };
}

// ---------------------------------------------------------------------------
// unikraft — a unikernel. Selected by `--build=unikraft`.
// ---------------------------------------------------------------------------
// No kqueue, no epoll, and nothing to multiplex onto: one vCPU, one loop, one
// exchange in flight. A readiness mechanism would buy nothing here, which is
// why this variant is SHORTER than the two above rather than a port of them.
//
// Blocking accept is deliberate. lwip runs its own stack thread, so blocking in
// the application does not stall the network.

~proc drive|unikraft {
    if (tls_port != null) {
        return .{ .failed = "TLS is not supported on the unikernel pump yet" };
    }
    const fd = $mod.socket(2, 1, 0);
    if (fd < 0) return .{ .failed = "socket" };

    var addr = $mod.SockaddrIn{ .port = @byteSwap(port), .addr = 0 };
    if ($mod.bind(fd, &addr, @sizeOf($mod.SockaddrIn)) < 0) return .{ .failed = "bind" };
    if ($mod.listen(fd, 512) < 0) return .{ .failed = "listen" };

    // Wait on the listener AND every live connection at once. Serving one
    // connection to completion before accepting the next is what made a browser
    // hang here while curl was perfectly happy.
    while (true) {
        var pfds: [$mod.MAX_UK_CONNS + 1]$mod.PollFd = undefined;
        var slot: [$mod.MAX_UK_CONNS + 1]i32 = undefined;
        var n: usize = 0;

        pfds[n] = .{ .fd = fd, .events = $mod.POLLIN, .revents = 0 };
        slot[n] = -1; // the listener
        n += 1;

        for (&$mod.uk_conns, 0..) |*conn, i| {
            if (conn.st.fd < 0) continue;
            pfds[n] = .{ .fd = conn.st.fd, .events = $mod.POLLIN, .revents = 0 };
            slot[n] = @intCast(i);
            n += 1;
        }

        const ready = $mod.poll(&pfds, @intCast(n), $mod.POLL_TICK_MS);

        // Time passes whether or not anything arrived, so the sweep runs here.
        const now = $mod.wallClockSeconds(null);
        for (&$mod.uk_conns) |*idle| {
            if (idle.st.fd < 0) continue;
            if (idle.st.len != 0) continue; // mid-request; it is still talking
            if (now - idle.last_seen <= $mod.KEEPALIVE_IDLE_SECONDS) continue;
            if (idle.st.mode == .ws) closed(@intCast(idle.st.fd));
            $mod.ukRelease(&idle.st);
        }

        if (ready <= 0) continue;

        for (pfds[0..n], slot[0..n]) |p, which| {
            const gone = p.revents & ($mod.POLLERR | $mod.POLLHUP | $mod.POLLNVAL) != 0;

            // A dead connection frees its slot even when there is nothing to read.
            if (which >= 0 and gone) {
                const dead = &$mod.uk_conns[@intCast(which)];
                if (dead.st.mode == .ws) closed(@intCast(dead.st.fd));
                $mod.ukRelease(&dead.st);
                continue;
            }

            if (p.revents & $mod.POLLIN == 0) continue;

            if (which < 0) {
                const accepted = $mod.accept(fd, null, null);
                if (accepted < 0) continue;
                if ($mod.ukAdmit(accepted)) |evicted| closed(@intCast(evicted));
                continue;
            }

            const live = &$mod.uk_conns[@intCast(which)];

            // Read onto the END of what is already held, so a request split
            // across two reads is finished rather than restarted.
            // `handler__unikraft`, named outright, because a variants block does
            // NOT reach a call site written in raw Zig — it rewrites the ones the
            // flow makes. `run` and `reply` are chosen for us that way; `fill` is
            // called from inside a loop body, so this body says which reader it
            // wants. Getting this wrong is invisible on a laptop: the default
            // body is `posix.read`, which macOS has and a unikernel does not.
            switch ($mod.fill_event.handler__unikraft(.{ .st = &live.st })) {
                .more => {},
                // `poll` said readable, so this pump has no idle case — but the
                // seam has one, and waiting is always the safe answer to it.
                .idle => continue,
                .gone => {
                    if (live.st.mode == .ws) closed(@intCast(live.st.fd));
                    $mod.ukRelease(&live.st);
                    continue;
                },
            }

            // Heard from — so it is no longer the idlest.
            $mod.uk_seq += 1;
            live.seq = $mod.uk_seq;
            live.last_seen = now;

            // Upgraded connection: frames, not requests — same seam as the
            // kqueue pump's `st.mode == .ws` block. There is no readiness to
            // re-arm here; the poll loop already waits on every live slot.
            if (live.st.mode == .ws) {
                var ws_consumed: usize = 0;
                var ws_alive = true;
                while (ws_consumed < live.st.len) {
                    const item = $mod.wsNext(&live.st, &ws_consumed) orelse break;
                    switch (item) {
                        .ping => |pl| {
                            if (!$mod.wsSendUk(&live.st, 0xA, pl)) ws_alive = false;
                        },
                        .close => |pl| {
                            _ = $mod.wsSendUk(&live.st, 0x8, pl);
                            ws_alive = false;
                        },
                        .dead => ws_alive = false,
                        .message => |m| {
                            var fx = $mod.Exchange{ .fd = live.st.fd, .st = &live.st, .raw = m.payload, .opcode = m.op };
                            frame(&fx);
                            live.st.ws_msg.clearRetainingCapacity();
                            if (!fx.keep_alive) ws_alive = false;
                        },
                    }
                    if (!ws_alive) break;
                }
                live.st.len = $mod.retainTail(&live.st.buf, live.st.len, ws_consumed);
                if (ws_alive and live.st.len == live.st.buf.len) ws_alive = false;
                if (!ws_alive) {
                    closed(@intCast(live.st.fd));
                    $mod.ukRelease(&live.st);
                }
                continue;
            }

            // Answer every COMPLETE request — see requestLen and retainTail.
            var consumed: usize = 0;
            var alive = true;
            while (consumed < live.st.len) {
                const take = $mod.requestLen(live.st.buf[consumed..live.st.len]) orelse break;
                var x = $mod.Exchange{ .fd = live.st.fd, .st = &live.st, .raw = live.st.buf[consumed .. consumed + take] };
                if ($mod.requestWantsClose(x.raw)) x.keep_alive = false;
                arrived(&x);
                consumed += take;
                if (!x.keep_alive) {
                    alive = false;
                    break;
                }
            }
            live.st.len = $mod.retainTail(&live.st.buf, live.st.len, consumed);
            if (alive and live.st.len == live.st.buf.len) alive = false;

            if (!alive) {
                _ = $mod.close(live.st.fd);
                live.st.fd = -1;
                live.st.len = 0;
            }
        }
    }

    return .{ .stopped = "Server stopped" };
}

// ============================================================================
// REPLY / HANG-UP — how the flow answers an exchange
// ============================================================================

// Write an answer back. `head` and `body` go out in that order; a caller that
// already holds a whole rendered response passes it as `head` with an empty
// `body`, which is what a pre-rendered static route does.
~proc reply|zig {
    if (hang) x.keep_alive = false;
    const st = x.st orelse connState(@intCast(x.fd)) orelse {
        x.keep_alive = false;
        return .{ .broken = "write failed" };
    };
    // A 101 answer is the handshake completing. Its head goes out raw like
    // always, but the body — if the handler set one — is already websocket
    // payload: it must be FRAMED, and it must land after the handshake bytes
    // on the wire. This is the welcome-seam: `{"type":"welcome"}` reaches the
    // client before any frame it could have sent.
    if (head.len >= 13 and std.mem.eql(u8, head[0..13], "HTTP/1.1 101 ")) {
        if (!writevAllConn(st, head, "", date_hole)) {
            x.keep_alive = false;
            return .{ .broken = "write failed" };
        }
        st.mode = .ws;
        if (body.len > 0) {
            if (!wsSendFrame(st, 0x1, body)) x.keep_alive = false;
        }
        // RFC 6455: a close frame's payload opens with the 2-byte status —
        // empty would wire as 1005 (no status), not the 1000 a refused
        // protocol upgrade must send.
        if (!x.keep_alive) _ = wsSendFrame(st, 0x8, "\x03\xe8");
    } else {
        if (!writevAllConn(st, head, body, date_hole)) {
            x.keep_alive = false;
            return .{ .broken = "write failed" };
        }
    }
    // keep_alive was already resolved at arrival (the pump scans
    // `Connection: close` once when the request lands) — re-scanning the raw
    // request here was a second full pass for the same answer.
    if (!x.keep_alive) {
        // A FIN before the queue drains would cut the response mid-flight —
        // when bytes are still pending, mark the conn and let the
        // write-ready event do the closing instead.
        if (pendingLen(st) > 0) {
            st.close_when_drained = true;
        } else {
            $mod.shutdownConn(st);
        }
    }
    return .sent;
}

// The unikernel's writer. `writeAll` above is built on `posix.write`, which has
// no implementation on a freestanding target; `send` is the same loop over the
// socket symbol the pump already uses.
~proc reply|unikraft {
    if (hang) x.keep_alive = false;
    // No scatter write here either — a holed head goes out as three sends:
    // up to the insertion point, the Date line, the rest.
    const segs = if (date_hole != 0)
        [3][]const u8{ head[0..date_hole], @import("root").koru_orisha.httpDateLine(), head[date_hole..] }
    else
        [3][]const u8{ head, "", "" };

    for (segs) |seg| {
        var offset: usize = 0;
        while (offset < seg.len) {
            const n = $mod.send(x.fd, seg.ptr + offset, seg.len - offset, 0);
            if (n <= 0) {
                x.keep_alive = false;
                return .{ .broken = "write failed" };
            }
            offset += @intCast(n);
        }
    }

    // Same flip as the hosted reply — and the same rule for the body: after a
    // 101 it is websocket payload, framed, never raw bytes on the wire.
    if (head.len >= 13 and std.mem.eql(u8, head[0..13], "HTTP/1.1 101 ")) {
        if (x.st) |st| {
            st.mode = .ws;
            if (body.len > 0) {
                if (!$mod.wsSendUk(st, 0x1, body)) x.keep_alive = false;
            }
            if (!x.keep_alive) _ = $mod.wsSendUk(st, 0x8, "");
        }
    } else {
        var body_offset: usize = 0;
        while (body_offset < body.len) {
            const n = $mod.send(x.fd, body.ptr + body_offset, body.len - body_offset, 0);
            if (n <= 0) {
                x.keep_alive = false;
                return .{ .broken = "write failed" };
            }
            body_offset += @intCast(n);
        }
    }
    return .sent;
}

// The unikernel spelling of wsSendFrame — lwip's `send`, no std.posix.
fn wsSendUk(st: *ConnState, opcode: u8, payload: []const u8) bool {
    var hdr: [10]u8 = undefined;
    hdr[0] = 0x80 | opcode;
    var hlen: usize = 2;
    if (payload.len < 126) {
        hdr[1] = @intCast(payload.len);
    } else if (payload.len <= 0xFFFF) {
        hdr[1] = 126;
        std.mem.writeInt(u16, hdr[2..4], @intCast(payload.len), .big);
        hlen = 4;
    } else {
        hdr[1] = 127;
        std.mem.writeInt(u64, hdr[2..10], payload.len, .big);
        hlen = 10;
    }
    const segs = [2][]const u8{ hdr[0..hlen], payload };
    for (segs) |seg| {
        var offset: usize = 0;
        while (offset < seg.len) {
            const n = $mod.send(st.fd, seg.ptr + offset, seg.len - offset, 0);
            if (n <= 0) return false;
            offset += @intCast(n);
        }
    }
    return true;
}

// Send one websocket frame. `opcode` absent means echo the frame being
// answered — x.opcode carries what `frame` dispatched.
~proc ws-send|zig {
    const st = x.st orelse connState(@intCast(x.fd)) orelse {
        x.keep_alive = false;
        return;
    };
    const op = opcode orelse x.opcode;
    const wire_op: u8 = if (op == 0) 0x1 else op;
    if (!$mod.wsSendFrame(st, wire_op, payload)) x.keep_alive = false;
}

~proc ws-send|unikraft {
    const st = x.st orelse {
        x.keep_alive = false;
        return;
    };
    const op = opcode orelse x.opcode;
    const wire_op: u8 = if (op == 0) 0x1 else op;
    if (!$mod.wsSendUk(st, wire_op, payload)) x.keep_alive = false;
}

// Send a close frame and end the connection when the arm returns.
~proc ws-close|zig {
    const st = x.st orelse connState(@intCast(x.fd)) orelse {
        x.keep_alive = false;
        return;
    };
    // 0x03e8 = 1000, normal closure — the code a server-initiated teardown
    // owes the peer (an empty payload wires as 1005 "no status").
    _ = $mod.wsSendFrame(st, 0x8, "\x03\xe8");
    x.keep_alive = false;
}

~proc ws-close|unikraft {
    if (x.st) |st| _ = $mod.wsSendUk(st, 0x8, "\x03\xe8");
    x.keep_alive = false;
}

// The cross-thread send: name the connection by descriptor and the pump does
// the writing. `gone` when nothing upgraded sits on that fd — dead, never
// upgraded, or past MAX_TRACKED_FD — which is also how a registry learns an
// entry it held is finished.
~proc ws-send-fd|zig {
    const wire_op: u8 = opcode orelse 0x1;
    if ($mod.wsSendFd(fd, wire_op, payload)) return .sent;
    return .gone;
}

// The unikernel conn table is the fixed `uk_conns` slot array, and the pump
// is single-threaded there — a scan finds the target and `wsSendUk` writes.
~proc ws-send-fd|unikraft {
    const wire_op: u8 = opcode orelse 0x1;
    for (&$mod.uk_conns) |*uk| {
        if (uk.st.fd < 0) continue;
        if (uk.st.fd != @as(c_int, @intCast(fd))) continue;
        if (uk.st.mode != .ws) return .gone;
        if ($mod.wsSendUk(&uk.st, wire_op, payload)) return .sent;
        return .gone;
    }
    return .gone;
}

// The default ws-frame: a server that never upgrades never sees it, and a
// claimant that upgrades without implementing it drops messages silently —
// the same shape `orisha:handler`'s 404 default takes for requests.
~proc ws-frame|zig {}

// The default ws-closed: a claimant that tracks connections by fd implements
// it to prune; one that doesn't is unaffected either way.
~proc ws-closed|zig {}

// Refuse to keep the connection. The pump closes it when the arm returns.
~proc hang-up|zig {
    x.keep_alive = false;
}

// The raw request bytes, for the parsing layer.


// The descriptor, for arms that hand ownership to something that outlives
// them. Hosted targets and the unikernel read the same integer — both socket
// layers take a descriptor, so there is nothing platform-shaped to vary.
~proc fileno|zig {
    return @intCast(x.fd);
}

~proc fileno|unikraft {
    return @intCast(x.fd);
}
// RAW — owned copy of the request bytes for the parsing layer.
//
// `x.raw` borrows the pump's read buffer (`ConnState.buf`), and a Koru `->`
// return may not hand back a borrow of its parameter (610_007) — so this proc
// copies the bytes into a per-request arena instead of projecting the field.
// Every construction of `Exchange.raw` slices `ConnState.buf` (REQUEST_BUFFER),
// so the copy fits by construction and `catch unreachable` never fires.
//
// The arena MUST be threadlocal: workers run on their own threads and a
// shared arena lets one worker's reset()+dupe overwrite a slice another
// worker's router is still parsing — a mangled path is a 404, a mangled path
// that lands on a live route is a wrong response. The response-side buffer in
// the companion got this treatment; the request side was missed.
threadlocal var raw_arena_buf: [REQUEST_BUFFER]u8 = undefined;

~proc raw|zig {
    var fba = std.heap.FixedBufferAllocator.init(&raw_arena_buf);
    const data = fba.allocator().dupe(u8, x.raw) catch unreachable;
    return data;
}
