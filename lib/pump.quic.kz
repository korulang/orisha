// ── packet spaces + sent records (RFC 9002) ──────────────────────────────────

const QSpace = enum(usize) { initial = 0, handshake = 1, app = 2 };

const QRxSpace = struct {
    ranges: std.ArrayListUnmanaged(QRange) = .{}, // received pns, ascending
    largest: i64 = -1,
    ack_pending: bool = false,
    newest_rx_us: i64 = 0, // when the largest-acked pn was received (ack_delay)
    unacked_eliciting: u64 = 0, // ack-eliciting pkts since last ack sent
};

const QSentFrame = union(enum) {
    ack,
    crypto: QRange,
    stream: struct { id: u64, off: u64, len: u64, fin: bool },
    handshake_done,
    max_data: u64,
    max_stream_data: struct { id: u64, v: u64 },
    max_streams_bidi: u64,
    max_streams_uni: u64,
    path_response: [8]u8,
    conn_close: struct { code: u64, app: bool },
    reset_stream: struct { id: u64, code: u64, final_size: u64 },
    ping,
};

const QSentPacket = struct {
    pn: u64 = 0,
    time_us: i64 = 0,
    size: usize = 0,
    ack_eliciting: bool = false,
    in_flight: bool = false,
    pmtu_probe: bool = false,
    frames: std.ArrayListUnmanaged(QSentFrame) = .{},
};

const QTxSpace = struct {
    next_pn: u64 = 0,
    sent: std.ArrayListUnmanaged(QSentPacket) = .{},
    largest_acked: i64 = -1,
};

// Received CRYPTO reassembly per level + the OpenSSL pull cursor.
const QCryptoRx = struct {
    buf: std.ArrayListUnmanaged(u8) = .{},
    ranges: std.ArrayListUnmanaged(QRange) = .{},
    tls_off: u64 = 0, // consumed via release_rcd
};

// ── stream state ─────────────────────────────────────────────────────────────

const QStream = struct {
    id: u64 = 0,
    conn: *QuicConn = undefined,
    // Receive side: sparse buffer + ranges; fin_off = final size when FIN seen.
    rx: std.ArrayListUnmanaged(u8) = .{},
    rx_ranges: std.ArrayListUnmanaged(QRange) = .{},
    rx_fin_off: ?u64 = null,
    rx_max_off: u64 = 0, // largest offset received — conn-level fc accounting
    rx_hi: u64 = 0, // flow-control high-water we gave the peer
    rx_dead: bool = false,
    stype: i64 = -1, // uni stream type; -2 = request (bidi) stream
    // H3 parse state
    h3_off: u64 = 0,
    h3_headers_done: bool = false,
    h3_method: std.ArrayListUnmanaged(u8) = .{},
    h3_path: std.ArrayListUnmanaged(u8) = .{},
    h3_authority: std.ArrayListUnmanaged(u8) = .{},
    h3_headers: std.ArrayListUnmanaged(u8) = .{},
    h3_body: std.ArrayListUnmanaged(u8) = .{},
    served: bool = false,
    // Send side: sb holds every byte ever staged; retransmit ranges point
    // back into it. sb_hi is the next unsent offset.
    sb: std.ArrayListUnmanaged(u8) = .{},
    sb_hi: u64 = 0,
    sb_retx: std.ArrayListUnmanaged(QRange) = .{},
    sb_acked: std.ArrayListUnmanaged(QRange) = .{},
    sb_fin: bool = false, // FIN once sb is fully out
    tx_done: bool = false, // fin sent AND acked
    rst_acked: bool = false, // our RESET_STREAM acked
    flow_hi: u64 = 0, // peer's max_stream_data for us
    park_until: i64 = 0,
    reset: bool = false,
    tx_queued: bool = false, // a slot in conn.tx_ready is ours

    fn deinit(s: *QStream, a: std.mem.Allocator) void {
        s.rx.deinit(a);
        s.rx_ranges.deinit(a);
        s.h3_method.deinit(a);
        s.h3_path.deinit(a);
        s.h3_authority.deinit(a);
        s.h3_headers.deinit(a);
        s.h3_body.deinit(a);
        s.sb.deinit(a);
        s.sb_retx.deinit(a);
        s.sb_acked.deinit(a);
        a.destroy(s);
    }
};

// ── the connection ───────────────────────────────────────────────────────────

const QState = enum { hs, app, closing, draining, dead };

const QuicConn = struct {
    lane: *QuicLane = undefined,
    peer: posix.sockaddr.storage = undefined,
    peer_len: posix.socklen_t = 0,
    scid: [QUIC_SCID_LEN]u8 = undefined,
    scid_key: u64 = 0,
    odcid: [32]u8 = undefined, // client's original DCID
    odcid_len: u8 = 0,
    odcid_key: u64 = 0,
    dcid: [32]u8 = undefined, // client's SCID — our packets' DCID
    dcid_len: u8 = 0,
    state: QState = .hs,
    ssl: ?*oss.SSL = null,
    keys_rx: [3]QKeys = .{ .{}, .{}, .{} },
    keys_tx: [3]QKeys = .{ .{}, .{}, .{} },
    init_cli: [32]u8 = undefined,
    init_srv: [32]u8 = undefined,
    have_init: bool = false,
    rx_space: [3]QRxSpace = .{ .{}, .{}, .{} },
    tx_space: [3]QTxSpace = .{ .{}, .{}, .{} },
    // TLS pull feed: contiguous CRYPTO per level, tls_off = released prefix.
    crx: [3]QCryptoRx = .{ .{}, .{}, .{} },
    tls_rx_level: usize = 0,
    tls_tx_level: usize = 0,
    ctx: [3]std.ArrayListUnmanaged(u8) = .{ .{}, .{}, .{} },
    ctx_hi: [3]u64 = .{ 0, 0, 0 }, // next unsent crypto offset
    ctx_retx: [3]std.ArrayListUnmanaged(QRange) = .{ .{}, .{}, .{} },
    hs_pkt_seen: bool = false,
    hs_confirmed: bool = false,
    ctrl_opened: bool = false,
    hs_done_sent: bool = false,
    streams: std.AutoHashMapUnmanaged(u64, *QStream) = .{},
    next_uni_id: u64 = 3, // server-initiated uni stream ids: 3,7,11,... (initiator bit + uni bit)
    streams_bidi_top: i64 = -1, // highest client bidi id opened
    bidi_closed: std.ArrayListUnmanaged(QRange) = .{}, // freed bidi seqs — late dups must not resurrect
    streams_bidi_credit: u64 = QUIC_MAX_STREAMS_BIDI,
    streams_bidi_done: u64 = 0,
    // peer limits (their transport params)
    peer_max_data: u64 = 0,
    peer_imsd_bl: u64 = 0, // our send limit on client's bidi (request) streams
    peer_imsd_uni: u64 = 0,
    peer_imsu: u64 = 0,
    ack_due_now: bool = false,
    peer_max_ack_delay: u64 = 25,
    peer_ack_delay_exp: u64 = 3,
    peer_got_tp: bool = false,
    // our receive flow accounting
    rx_consumed_total: u64 = 0,
    rx_fc: u64 = 0, // fresh stream bytes received (conn-level fc check)
    rx_max_data: u64 = QUIC_MAX_DATA,
    tx_data_sent: u64 = 0, // total stream bytes sent (peer_max_data budget)
    // recovery (RFC 9002)
    latest_rtt_us: i64 = 0,
    smoothed_rtt_us: i64 = -1,
    rttvar_us: i64 = 0,
    pto_count: u32 = 0,
    pto_base_us: i64 = 0,
    cwnd: usize = QUIC_CWND_INIT,
    ssthresh: usize = std.math.maxInt(usize),
    recovery_start_us: i64 = 0,
    pmtu: usize = QUIC_MAX_DGRAM,
    pmtu_idx: u8 = 0,
    pmtu_probe_pn: i64 = -1,
    pmtu_probe_size: usize = 0,
    pmtu_probe_deadline_us: i64 = 0,
    pmtu_fails: u8 = 0,
    pmtu_retry_ms: i64 = 0,
    peer_max_udp: u64 = 65527,
    in_recovery: bool = false,
    bytes_in_flight: usize = 0,
    loss_deadline_us: i64 = 0,
    // anti-amplification + idle
    rx_bytes_total: u64 = 0,
    tx_bytes_limited: u64 = 0,
    addr_validated: bool = false,
    idle_deadline_ms: i64 = 0,
    // close
    close_pending: ?QSentFrame = null,
    draining_until_ms: i64 = 0,
    close_code: u64 = 0,
    peer_kbit: u8 = 0,
    ctrl_q: std.ArrayListUnmanaged(QSentFrame) = .{},
    // Recycled sent-record frame lists: a packet's QSentPacket.frames buffer
    // returns here on ack/loss instead of round-tripping malloc per packet.
    frame_pool: std.ArrayListUnmanaged(std.ArrayListUnmanaged(QSentFrame)) = .{},
    tp_buf: std.ArrayListUnmanaged(u8) = .{},
    // Streams holding unemitted send bytes (sb or sb_retx). The packet
    // builder drains the front; still-pending streams re-join at the back —
    // ngtcp2's tx.strmq pop/push cycle, minus the heap.
    tx_ready: std.ArrayListUnmanaged(*QStream) = .{},
    probe_pending: bool = false,
    huff: HpackTable = .{},

    fn a(conn: *QuicConn) std.mem.Allocator {
        _ = conn;
        return pumpAlloc();
    }
};

// ── the lane: one per worker ─────────────────────────────────────────────────

const H3Ready = struct { stream: *QStream, raw: []u8 };

pub const QuicLane = struct {
    fd: posix.fd_t = -1,
    conns: std.AutoHashMapUnmanaged(u64, *QuicConn) = .{},
    odcid_map: std.AutoHashMapUnmanaged(u64, *QuicConn) = .{},
    ready: std.ArrayListUnmanaged(H3Ready) = .{},
    ready_head: usize = 0,
    rxbuf: [65536]u8 = undefined,
    dbuf: [65536]u8 = undefined,
    pt_buf: [65536]u8 = undefined,
    // quicBuildPacket scratch: one reused list instead of a fresh
    // malloc/free for every packet built on this lane. Packets are built
    // serially per lane, so sharing the buffer is safe.
    build_frames: std.ArrayListUnmanaged(u8) = .{},
    flush_again: bool = false,
};

fn quicPopReady(lane: *QuicLane) ?H3Ready {
    if (lane.ready_head >= lane.ready.items.len) return null;
    const r = lane.ready.items[lane.ready_head];
    lane.ready_head += 1;
    if (lane.ready_head == lane.ready.items.len) {
        lane.ready.clearRetainingCapacity();
        lane.ready_head = 0;
    }
    return r;
}

fn dcidKey(bytes: []const u8) u64 {
    var k: u64 = 1469598103934665603;
    for (bytes) |b| {
        k ^= b;
        k *%= 1099511628211;
    }
    return k;
}

// ── OpenSSL QUIC-TLS callbacks ───────────────────────────────────────────────

fn qtlsCryptoSend(ssl: ?*oss.SSL, buf: [*c]const u8, buf_len: usize, consumed: [*c]usize, arg: ?*anyopaque) callconv(.c) c_int {
    _ = ssl;
    const conn: *QuicConn = @ptrCast(@alignCast(arg));
    const lvl = conn.tls_tx_level;
    conn.ctx[lvl].appendSlice(conn.a(), buf[0..buf_len]) catch return 0; // 0 = not consumed → OpenSSL aborts the handshake, loud
    consumed.* = buf_len;
    return 1;
}

fn qtlsCryptoRecvRcd(ssl: ?*oss.SSL, buf: [*c][*c]const u8, bytes_read: [*c]usize, arg: ?*anyopaque) callconv(.c) c_int {
    _ = ssl;
    const conn: *QuicConn = @ptrCast(@alignCast(arg));
    const lvl = conn.tls_rx_level;
    const crx = &conn.crx[lvl];
    const contig = rangesContig(&crx.ranges);
    if (crx.tls_off >= contig) {
        buf.* = null;
        bytes_read.* = 0;
        return 1;
    }
    const avail = contig - crx.tls_off;
    buf.* = @ptrCast(crx.buf.items.ptr + crx.tls_off);
    bytes_read.* = @intCast(avail);
    return 1;
}

fn qtlsCryptoReleaseRcd(ssl: ?*oss.SSL, bytes_read: usize, arg: ?*anyopaque) callconv(.c) c_int {
    _ = ssl;
    const conn: *QuicConn = @ptrCast(@alignCast(arg));
    conn.crx[conn.tls_rx_level].tls_off += bytes_read;
    return 1;
}

fn qtlsYieldSecret(ssl: ?*oss.SSL, prot_level: u32, direction: c_int, secret: [*c]const u8, secret_len: usize, arg: ?*anyopaque) callconv(.c) c_int {
    _ = ssl;
    const conn: *QuicConn = @ptrCast(@alignCast(arg));
    // prot_level: 0 none, 1 early, 2 handshake, 3 application.
    const space: usize = switch (prot_level) {
        2 => 1,
        3 => 2,
        else => return 1, // early data / none — we refuse 0-RTT
    };
    const ks: *QKeys = if (direction == 0) &conn.keys_rx[space] else &conn.keys_tx[space];
    keysFromSecret(ks, secret[0..secret_len]);
    if (direction == 1) {
        conn.tls_tx_level = space;
    } else {
        conn.tls_rx_level = space;
    }
    return 1;
}

fn qtlsGotTransportParams(ssl: ?*oss.SSL, params: [*c]const u8, params_len: usize, arg: ?*anyopaque) callconv(.c) c_int {
    _ = ssl;
    const conn: *QuicConn = @ptrCast(@alignCast(arg));
    const buf = params[0..params_len];
    var pos: usize = 0;
    while (pos < buf.len) {
        const id = qvGet(buf, &pos) orelse return 0;
        const len = qvGet(buf, &pos) orelse return 0;
        if (pos + len > buf.len) return 0;
        var vp = pos;
        const v = qvGet(buf[0 .. pos + @as(usize, @intCast(len))], &vp) orelse 0;
        switch (id) {
            0x01 => {},
            0x03 => conn.peer_max_udp = v,
            0x04 => conn.peer_max_data = v,
            0x05 => conn.peer_imsd_bl = v,
            0x06 => {},
            0x07 => conn.peer_imsd_uni = v,
            0x08 => {},
            0x09 => conn.peer_imsu = v,
            0x0a => conn.peer_ack_delay_exp = v,
            0x0b => conn.peer_max_ack_delay = v,
            0x0f => {
                // initial_source_connection_id — our packets' DCID.
                const sl = @min(len, 32);
                @memcpy(conn.dcid[0..@intCast(sl)], buf[pos .. pos + @as(usize, @intCast(sl))]);
                conn.dcid_len = @intCast(sl);
            },
            else => {},
        }
        pos += @intCast(len);
    }
    conn.peer_got_tp = true;
    return 1;
}

fn qtlsAlert(ssl: ?*oss.SSL, alert_code: u8, arg: ?*anyopaque) callconv(.c) c_int {
    _ = ssl;
    const conn: *QuicConn = @ptrCast(@alignCast(arg));
    conn.close_code = 0x100 + @as(u64, alert_code);
    conn.close_pending = .{ .conn_close = .{ .code = conn.close_code, .app = false } };
    conn.state = .closing;
    return 1;
}

const QTDIS = if (HAS_OPENSSL) [_]oss.OSSL_DISPATCH{
    .{ .function_id = 2001, .function = @ptrCast(&qtlsCryptoSend) },
    .{ .function_id = 2002, .function = @ptrCast(&qtlsCryptoRecvRcd) },
    .{ .function_id = 2003, .function = @ptrCast(&qtlsCryptoReleaseRcd) },
    .{ .function_id = 2004, .function = @ptrCast(&qtlsYieldSecret) },
    .{ .function_id = 2005, .function = @ptrCast(&qtlsGotTransportParams) },
    .{ .function_id = 2006, .function = @ptrCast(&qtlsAlert) },
    .{ .function_id = 0, .function = null },
} else {};

// ── transport params we announce ─────────────────────────────────────────────

fn buildTransportParams(conn: *QuicConn, out: *std.ArrayListUnmanaged(u8)) error{OutOfMemory}!void {
    const a = conn.a();
    // original_destination_connection_id (0x00)
    try qvPut(out, a, 0x00);
    try qvPut(out, a, conn.odcid_len);
    try out.appendSlice(a, conn.odcid[0..conn.odcid_len]);
    const ints = [_]struct { id: u64, v: u64 }{
        .{ .id = 0x01, .v = QUIC_IDLE_MS },
        .{ .id = 0x03, .v = 65527 },
        .{ .id = 0x04, .v = conn.rx_max_data },
        .{ .id = 0x05, .v = QUIC_MAX_STREAM_DATA },
        .{ .id = 0x06, .v = QUIC_MAX_STREAM_DATA },
        .{ .id = 0x07, .v = QUIC_MAX_STREAM_DATA },
        .{ .id = 0x08, .v = QUIC_MAX_STREAMS_BIDI },
        .{ .id = 0x09, .v = QUIC_MAX_STREAMS_UNI },
        .{ .id = 0x0a, .v = 3 },
        .{ .id = 0x0b, .v = 25 },
        .{ .id = 0x0e, .v = 8 },
    };
    for (ints) |p| {
        try qvPut(out, a, p.id);
        try qvPut(out, a, qvLen(p.v));
        try qvPut(out, a, p.v);
    }
    try qvPut(out, a, 0x0c); // disable_active_migration
    try qvPut(out, a, 0);
    // initial_source_connection_id (0x0f)
    try qvPut(out, a, 0x0f);
    try qvPut(out, a, QUIC_SCID_LEN);
    try out.appendSlice(a, &conn.scid);
}

// ── conn create / destroy ────────────────────────────────────────────────────

fn quicConnCreate(lane: *QuicLane, peer: *const posix.sockaddr, peer_len: posix.socklen_t, odcid: []const u8, client_scid: []const u8) ?*QuicConn {
    if (!HAS_OPENSSL) return null;
    const ctx = quic_ssl_ctx orelse return null;
    const a = pumpAlloc();
    const conn = a.create(QuicConn) catch return null;
    conn.* = .{ .lane = lane };
    @memcpy(@as([*]u8, @ptrCast(&conn.peer))[0..peer_len], @as([*]const u8, @ptrCast(peer))[0..peer_len]);
    conn.peer_len = peer_len;
    std.crypto.random.bytes(&conn.scid);
    conn.scid_key = std.mem.readInt(u64, &conn.scid, .big);
    conn.odcid_len = @intCast(@min(odcid.len, 32));
    @memcpy(conn.odcid[0..conn.odcid_len], odcid[0..conn.odcid_len]);
    conn.odcid_key = dcidKey(odcid);
    conn.dcid_len = @intCast(@min(client_scid.len, 32));
    @memcpy(conn.dcid[0..conn.dcid_len], client_scid[0..conn.dcid_len]);
    conn.idle_deadline_ms = std.time.milliTimestamp() + QUIC_IDLE_MS;
    // initial keys from the client's original DCID
    initialSecrets(odcid, &conn.init_cli, &conn.init_srv);
    keysFromSecret(&conn.keys_rx[0], &conn.init_cli);
    keysFromSecret(&conn.keys_tx[0], &conn.init_srv);
    conn.have_init = true;
    // TLS object with the QUIC record layer callbacks.
    const ssl = oss.SSL_new(ctx);
    if (ssl == null) {
        a.destroy(conn);
        return null;
    }
    conn.ssl = ssl;
    if (oss.SSL_set_quic_tls_cbs(ssl, &QTDIS, conn) != 1) {
        oss.SSL_free(ssl);
        a.destroy(conn);
        return null;
    }
    // The params buffer must outlive the SSL object — OpenSSL sends it
    // lazily during the handshake, so it lives on the conn.
    buildTransportParams(conn, &conn.tp_buf) catch {
        oss.SSL_free(ssl);
        a.destroy(conn);
        return null;
    };
    if (oss.SSL_set_quic_tls_transport_params(ssl, conn.tp_buf.items.ptr, conn.tp_buf.items.len) != 1) {
        oss.SSL_free(ssl);
        conn.tp_buf.deinit(a);
        a.destroy(conn);
        return null;
    }
    oss.SSL_set_accept_state(ssl);
    lane.conns.put(a, conn.scid_key, conn) catch {
        oss.SSL_free(ssl);
        conn.tp_buf.deinit(a);
        a.destroy(conn);
        return null;
    };
    lane.odcid_map.put(a, conn.odcid_key, conn) catch {
        _ = lane.conns.remove(conn.scid_key);
        oss.SSL_free(ssl);
        conn.tp_buf.deinit(a);
        a.destroy(conn);
        return null;
    };
    return conn;
}

fn quicStreamDestroy(conn: *QuicConn, s: *QStream) void {
    // Pull the stream's tx_ready slot before its memory goes — a queued
    // pointer to freed stream memory is a UAF in the packet builder.
    if (s.tx_queued) {
        var i: usize = 0;
        while (i < conn.tx_ready.items.len) : (i += 1) {
            if (conn.tx_ready.items[i] == s) {
                _ = conn.tx_ready.orderedRemove(i);
                break;
            }
        }
        s.tx_queued = false;
    }
    s.deinit(conn.a());
}

// Purge every lane.ready entry that points at a stream of `conn` — a queued
// exchange holding a freed stream pointer is a UAF.
fn quicPurgeReady(lane: *QuicLane, conn: *QuicConn) void {
    var w: usize = 0;
    for (lane.ready.items[lane.ready_head..]) |r| {
        if (r.stream.conn != conn) {
            lane.ready.items[w] = r;
            w += 1;
        }
    }
    lane.ready.items.len = w;
    lane.ready_head = 0;
}

// A request stream's resources are reclaimable once the send side is fully
// acked (data + FIN) and the receive side is done (FIN seen or reset).
fn quicStreamMaybeFree(conn: *QuicConn, s: *QStream) void {
    if (s.stype != -2) return;
    if (!s.sb_fin and !s.rst_acked) return;
    const tx_done = s.rst_acked or rangesContig(&s.sb_acked) >= s.sb.items.len + 1;
    const rx_done = s.rx_fin_off != null or s.rx_dead or s.reset;
    if (!(tx_done and rx_done)) return;
    if (conn.streams.remove(s.id)) {
        // reopening lower ids stays legal (RFC 9000 §3.2) — only explicitly
        // freed seqs are barred, so record this one for the dup guard. An
        // OOM here would silently disarm the guard — close instead.
        rangesAdd(&conn.bidi_closed, conn.a(), s.id >> 2, 1) catch { quicClose(conn, 0x01, false); };
        quicStreamDestroy(conn, s);
    }
}

fn quicConnDestroy(conn: *QuicConn) void {
    const a = conn.a();
    quicPurgeReady(conn.lane, conn);
    if (conn.ssl) |ssl| oss.SSL_free(ssl);
    var it = conn.streams.iterator();
    while (it.next()) |e| e.value_ptr.*.deinit(a);
    conn.streams.deinit(a);
    for (0..3) |i| {
        conn.rx_space[i].ranges.deinit(a);
        for (conn.tx_space[i].sent.items) |*p| p.frames.deinit(a);
        conn.tx_space[i].sent.deinit(a);
        conn.crx[i].buf.deinit(a);
        conn.crx[i].ranges.deinit(a);
        conn.ctx[i].deinit(a);
        conn.ctx_retx[i].deinit(a);
    }
    conn.ctrl_q.deinit(a);
    for (conn.frame_pool.items) |*fl| fl.deinit(a);
    conn.frame_pool.deinit(a);
    conn.tx_ready.deinit(a);
    conn.bidi_closed.deinit(a);
    conn.tp_buf.deinit(a);
    conn.huff.deinit(a);
    _ = conn.lane.conns.remove(conn.scid_key);
    _ = conn.lane.odcid_map.remove(conn.odcid_key);
    a.destroy(conn);
}

fn quicStreamGet(conn: *QuicConn, id: u64, create: bool) ?*QStream {
    if (conn.streams.get(id)) |s| return s;
    if (!create) return null;
    // enforce client's bidi limit
    if (id & 3 == 0) {
        const seq = id >> 2;
        if (seq >= conn.streams_bidi_credit) return null;
        if (@as(i64, @intCast(seq)) > conn.streams_bidi_top) conn.streams_bidi_top = @intCast(seq);
    }
    const s = conn.a().create(QStream) catch return null;
    s.* = .{ .id = id, .conn = conn };
    s.stype = if (id & 2 != 0) -1 else -2;
    s.flow_hi = if (id & 3 == 0) conn.peer_imsd_bl else conn.peer_imsd_uni;
    s.rx_hi = QUIC_MAX_STREAM_DATA;
    conn.streams.put(conn.a(), id, s) catch {
        conn.a().destroy(s);
        return null;
    };
    return s;
}

// Sent-record frame lists are per-packet allocations on the hot path; the
// conn-local pool keeps the buffer alive across packets. Cap is a bound on
// retained bytes, not correctness — a full pool just falls back to free.
fn quicFramesScratch(conn: *QuicConn) std.ArrayListUnmanaged(QSentFrame) {
    if (conn.frame_pool.pop()) |l| return l;
    return .{};
}

fn quicRecycleSentFrames(conn: *QuicConn, p: *QSentPacket) void {
    p.frames.clearRetainingCapacity();
    if (conn.frame_pool.items.len < 128) {
        conn.frame_pool.append(conn.a(), p.frames) catch {
            p.frames.deinit(conn.a());
            p.frames = .{};
            return;
        };
        p.frames = .{};
    } else {
        p.frames.deinit(conn.a());
        p.frames = .{};
    }
}

// ── packet receive ───────────────────────────────────────────────────────────

const QPktKind = enum { initial, handshake, app };

// Reconstruct the full packet number from its truncated wire form (RFC 9000
// §A.3). pnl is the encoded byte count.
fn pnExpand(wire: u64, pnl: usize, largest: i64) u64 {
    const pn_bits = pnl * 8;
    const pn_win = @as(u64, 1) << @intCast(pn_bits);
    const pn_half = pn_win / 2;
    const pn_mask = pn_win - 1;
    const expected = @as(u64, @intCast(largest + 1));
    const candidate = (expected & ~pn_mask) | wire;
    if (candidate + pn_half <= expected and candidate + pn_win <= (1 << 62))
        return candidate + pn_win;
    if (candidate > expected + pn_half and candidate >= pn_win)
        return candidate - pn_win;
    return candidate;
}

fn hpMask(ks: *const QKeys, sample: *const [16]u8) [16]u8 {
    var out: [16]u8 = undefined;
    if (comptime @import("builtin").cpu.arch == .aarch64) {
        if (ks.hw_aes) {
            ks.hw_hp_ctx.encrypt(&out, sample);
            return out;
        }
    }
    ks.hp_ctx.encrypt(&out, sample);
    return out;
}

// Aes128-GCM over a cached key schedule — std's AesGcm.encrypt/decrypt re-run
// Aes128.initEnc and E(key,0) per call; both are key-only work, so they live
// on QKeys now. Bodies mirror std.crypto.aead.aes_gcm.AesGcm(Aes128) exactly.
// On aese-capable arm64 the whole op hands off to HwAesGcm instead — the hw
// path keeps std's key-in shape (its schedule expansion is a handful of aese
// rounds, not worth a second cached-ctx mirror).
fn gcmEncrypt(ks: *const QKeys, dst: []u8, tag: *[16]u8, m: []const u8, ad: []const u8, npub: [12]u8) void {
    if (comptime @import("builtin").cpu.arch == .aarch64) {
        if (ks.hw_aes) return HwAesGcm.encrypt(dst, tag, m, ad, npub, ks.key);
    }
    var t: [16]u8 = undefined;
    var j: [16]u8 = undefined;
    j[0..12].* = npub;
    std.mem.writeInt(u32, j[12..][0..4], 1, .big);
    ks.enc_ctx.encrypt(&t, &j);
    const block_count = (std.math.divCeil(usize, ad.len, QGhash.block_length) catch unreachable) +
        (std.math.divCeil(usize, dst.len, QGhash.block_length) catch unreachable) + 1;
    var mac = QGhash.initForBlockCount(&ks.ghash_h, block_count);
    mac.update(ad);
    mac.pad();
    std.mem.writeInt(u32, j[12..][0..4], 2, .big);
    QCtr(AesEncCtx, ks.enc_ctx, dst, m, j, .big);
    mac.update(dst);
    mac.pad();
    var final_block = ks.ghash_h;
    std.mem.writeInt(u64, final_block[0..8], @as(u64, ad.len) * 8, .big);
    std.mem.writeInt(u64, final_block[8..16], @as(u64, m.len) * 8, .big);
    mac.update(&final_block);
    mac.final(tag);
    for (t, 0..) |x, i| tag[i] ^= x;
}

fn gcmDecrypt(ks: *const QKeys, m: []u8, ct: []const u8, tag: [16]u8, ad: []const u8, npub: [12]u8) error{AuthenticationFailed}!void {
    if (comptime @import("builtin").cpu.arch == .aarch64) {
        if (ks.hw_aes) return HwAesGcm.decrypt(m, ct, tag, ad, npub, ks.key);
    }
    var t: [16]u8 = undefined;
    var j: [16]u8 = undefined;
    j[0..12].* = npub;
    std.mem.writeInt(u32, j[12..][0..4], 1, .big);
    ks.enc_ctx.encrypt(&t, &j);
    const block_count = (std.math.divCeil(usize, ad.len, QGhash.block_length) catch unreachable) +
        (std.math.divCeil(usize, ct.len, QGhash.block_length) catch unreachable) + 1;
    var mac = QGhash.initForBlockCount(&ks.ghash_h, block_count);
    mac.update(ad);
    mac.pad();
    mac.update(ct);
    mac.pad();
    var final_block = ks.ghash_h;
    std.mem.writeInt(u64, final_block[0..8], @as(u64, ad.len) * 8, .big);
    std.mem.writeInt(u64, final_block[8..16], @as(u64, m.len) * 8, .big);
    mac.update(&final_block);
    var computed: [16]u8 = undefined;
    mac.final(&computed);
    for (t, 0..) |x, i| computed[i] ^= x;
    if (!std.crypto.timing_safe.eql([16]u8, computed, tag)) {
        std.crypto.secureZero(u8, &computed);
        @memset(m, undefined);
        return error.AuthenticationFailed;
    }
    std.mem.writeInt(u32, j[12..][0..4], 2, .big);
    QCtr(AesEncCtx, ks.enc_ctx, m, ct, j, .big);
}

// Feed received CRYPTO bytes into the level's reassembly, then drive the TLS.
fn quicCryptoFeed(conn: *QuicConn, space: usize, off: u64, data: []const u8) void {
    const crx = &conn.crx[space];
    const end = off + data.len;
    if (end > crx.tls_off + 64 * 1024) {
        quicClose(conn, 0x0d, false); // CRYPTO_BUFFER_EXCEEDED
        return;
    }
    if (crx.buf.items.len < end) {
        const newlen = @as(usize, @intCast(end));
        crx.buf.resize(conn.a(), newlen) catch { quicClose(conn, 0x01, false); return; };
    }
    @memcpy(crx.buf.items[@intCast(off)..@intCast(end)], data);
    rangesAdd(&crx.ranges, conn.a(), off, data.len) catch { quicClose(conn, 0x01, false); return; };
    quicDriveTls(conn);
}

fn quicDriveTls(conn: *QuicConn) void {
    if (conn.ssl == null or conn.state == .dead or conn.state == .draining) return;
    while (true) {
        const ssl = conn.ssl.?;
        const before_tx = conn.ctx[0].items.len + conn.ctx[1].items.len + conn.ctx[2].items.len;
        _ = before_tx;
        const ret = oss.SSL_do_handshake(ssl);
        if (ret == 1) {
            conn.state = .app;
            // handshake complete: queue HANDSHAKE_DONE + the h3 control stream
            if (!conn.hs_done_sent) {
                conn.hs_done_sent = true;
                quicCtrlQueue(conn, .handshake_done);
            }
            if (!conn.ctrl_opened) {
                conn.ctrl_opened = true;
                quicH3OpenControl(conn);
            }
            // Post-handshake CRYPTO (NewSessionTicket etc.) still flows.
            _ = oss.SSL_read(ssl, null, 0);
            break;
        }
        if (ret <= 0) {
            const err = oss.SSL_get_error(ssl, ret);
            // SSL_ERROR_WANT_READ = 2, WANT_WRITE = 3: wait for more wire data.
            if (err == 2 or err == 3) break;
            conn.close_code = 0x100;
            conn.close_pending = .{ .conn_close = .{ .code = conn.close_code, .app = false } };
            conn.state = .closing;
            break;
        }
        break;
    }
}

// ACK bookkeeping + per-frame receive dispatch.
fn quicRecordPn(conn: *QuicConn, space: usize, pn: u64) void {
    const rs = &conn.rx_space[space];
    if (rangesHas(&rs.ranges, pn)) return;
    rangesAdd(&rs.ranges, conn.a(), pn, 1) catch { quicClose(conn, 0x01, false); return; };
    if (pn > rs.largest) {
        rs.largest = @intCast(pn);
        rs.newest_rx_us = std.time.microTimestamp();
    }
    if (space == 1) {
        conn.hs_pkt_seen = true;
        conn.addr_validated = true;
        conn.keys_rx[0].present = false; // RFC 9001 §4.9.1 — initial keys out
    }
    conn.idle_deadline_ms = std.time.milliTimestamp() + QUIC_IDLE_MS;
}

// Mark a stream as having unemitted send bytes. Queued once — the packet
// builder drops the flag when the stream drains.
fn quicTxQueue(conn: *QuicConn, s: *QStream) void {
    if (s.tx_queued) return;
    s.tx_queued = true;
    conn.tx_ready.append(conn.a(), s) catch { quicClose(conn, 0x01, false); };
}

fn quicCtrlQueue(conn: *QuicConn, f: QSentFrame) void {
    // credit frames are self-superseding: keep ONE pending entry holding
    // the latest value — a flood of requests must not emit a flood of
    // MAX_STREAMS/MAX_DATA. Retx of a lost one re-queues a stale value;
    // emit always reads the conn's current values, so it self-heals.
    for (conn.ctrl_q.items) |*q| {
        switch (f) {
            .max_data => if (q.* == .max_data) { q.max_data = f.max_data; return; },
            .max_streams_bidi => if (q.* == .max_streams_bidi) { q.max_streams_bidi = f.max_streams_bidi; return; },
            .max_streams_uni => if (q.* == .max_streams_uni) { q.max_streams_uni = f.max_streams_uni; return; },
            .max_stream_data => |msd| if (q.* == .max_stream_data and q.max_stream_data.id == msd.id) { q.max_stream_data.v = msd.v; return; },
            else => {},
        }
    }
    conn.ctrl_q.append(conn.a(), f) catch quicClose(conn, 0x01, false);
}

fn quicOnFrames(conn: *QuicConn, space: usize, pn: u64, bytes: []const u8) void {
    _ = pn;
    var eliciting = false;
    var pos: usize = 0;
    const a = conn.a();
    while (pos < bytes.len) {
        const ft = qvGet(bytes, &pos) orelse break;
        switch (ft) {
            0x00 => {}, // PADDING
            0x01 => eliciting = true, // PING
            0x02, 0x03 => { // ACK [,ECN]
                const largest = qvGet(bytes, &pos) orelse return;
                const delay = qvGet(bytes, &pos) orelse return;
                _ = delay;
                const n_ranges = qvGet(bytes, &pos) orelse return;
                const first_range = qvGet(bytes, &pos) orelse return;
                // Collect the wire's descending ranges, then make ONE pass
                // over the sent list — a pass per range is O(ranges×sent).
                var ars: [64]QAckRange = undefined;
                var arn: usize = 0;
                var lo = largest -| first_range;
                var hi = largest;
                ars[0] = .{ .lo = lo, .hi = hi };
                arn = 1;
                var i: u64 = 0;
                while (i < n_ranges) : (i += 1) {
                    const gap = qvGet(bytes, &pos) orelse return;
                    const rlen = qvGet(bytes, &pos) orelse return;
                    hi = lo -| (gap + 2);
                    lo = hi -| rlen;
                    if (arn == ars.len) {
                        quicOnAckRanges(conn, space, ars[0..arn]);
                        arn = 0;
                    }
                    ars[arn] = .{ .lo = lo, .hi = hi };
                    arn += 1;
                }
                quicOnAckRanges(conn, space, ars[0..arn]);
                if (ft == 0x03) {
                    _ = qvGet(bytes, &pos); // ect0
                    _ = qvGet(bytes, &pos); // ect1
                    _ = qvGet(bytes, &pos); // ce
                }
            },
            0x04 => { // RESET_STREAM
                eliciting = true;
                const sid = qvGet(bytes, &pos) orelse return;
                _ = qvGet(bytes, &pos);
                _ = qvGet(bytes, &pos);
                if (quicStreamGet(conn, sid, false)) |s| s.rx_dead = true;
            },
            0x05 => { // STOP_SENDING — answer with our own RESET_STREAM
                eliciting = true;
                const sid = qvGet(bytes, &pos) orelse return;
                const code = qvGet(bytes, &pos) orelse return;
                if (quicStreamGet(conn, sid, false)) |s| {
                    if (!s.reset) {
                        s.reset = true;
                        quicCtrlQueue(conn, .{ .reset_stream = .{ .id = sid, .code = code, .final_size = s.sb_hi } });
                    }
                }
            },
            0x06 => { // CRYPTO
                eliciting = true;
                const off = qvGet(bytes, &pos) orelse return;
                const len = qvGet(bytes, &pos) orelse return;
                if (pos + len > bytes.len) return;
                quicCryptoFeed(conn, space, off, bytes[pos .. pos + @as(usize, @intCast(len))]);
                pos += @intCast(len);
            },
            0x07 => { // NEW_TOKEN — server-only frame (RFC 9000 §19.7)
                quicClose(conn, 0x0a, false); // PROTOCOL_VIOLATION
                return;
            },
            0x08...0x0f => { // STREAM
                eliciting = true;
                const has_off = ft & 0x04 != 0;
                const has_len = ft & 0x02 != 0;
                const has_fin = ft & 0x01 != 0;
                const sid = qvGet(bytes, &pos) orelse return;
                const off = if (has_off) (qvGet(bytes, &pos) orelse return) else 0;
                var len: u64 = bytes.len - pos;
                if (has_len) len = qvGet(bytes, &pos) orelse return;
                if (pos + len > bytes.len) return;
                quicOnStreamData(conn, sid, off, bytes[pos .. pos + @as(usize, @intCast(len))], has_fin);
                pos += @intCast(len);
            },
            0x10 => { // MAX_DATA — raises our conn-level send budget
                eliciting = true;
                const v = qvGet(bytes, &pos) orelse return;
                conn.peer_max_data = @max(conn.peer_max_data, v);
            },
            0x11 => { // MAX_STREAM_DATA — raises this stream's send budget
                eliciting = true;
                const sid = qvGet(bytes, &pos) orelse return;
                const v = qvGet(bytes, &pos) orelse return;
                if (quicStreamGet(conn, sid, false)) |st| st.flow_hi = @max(st.flow_hi, v);
            },
            0x12, 0x13 => { eliciting = true; _ = qvGet(bytes, &pos); }, // MAX_STREAMS
            0x14, 0x15, 0x16, 0x17 => {
                eliciting = true;
                _ = qvGet(bytes, &pos);
                if (ft == 0x15) _ = qvGet(bytes, &pos);
            },
            0x18 => { // NEW_CONNECTION_ID: seq, retire_prior_to (varints), len u8, cid, token
                eliciting = true;
                _ = qvGet(bytes, &pos);
                _ = qvGet(bytes, &pos);
                if (pos >= bytes.len) return;
                const clen: usize = bytes[pos];
                pos += 1 + @as(usize, @intCast(clen)) + 16;
            },
            0x19 => { eliciting = true; _ = qvGet(bytes, &pos); }, // RETIRE_CONNECTION_ID
            0x1a => { // PATH_CHALLENGE
                eliciting = true;
                if (pos + 8 > bytes.len) return;
                var d: [8]u8 = undefined;
                @memcpy(&d, bytes[pos .. pos + 8]);
                pos += 8;
                quicCtrlQueue(conn, .{ .path_response = d });
            },
            0x1b => { eliciting = true; pos += 8; }, // PATH_RESPONSE
            0x1c, 0x1d => { // CONNECTION_CLOSE
                _ = qvGet(bytes, &pos); // error code
                if (ft == 0x1c) _ = qvGet(bytes, &pos); // frame type
                const rlen = qvGet(bytes, &pos) orelse return;
                pos += @intCast(rlen);
                conn.state = .draining;
                conn.draining_until_ms = std.time.milliTimestamp() + 3000;
                return;
            },
            0x1e => { // HANDSHAKE_DONE — server-only frame
                quicClose(conn, 0x0a, false); // PROTOCOL_VIOLATION
                return;
            },
            else => {
                quicClose(conn, 0x07, false); // FRAME_ENCODING_ERROR
                return;
            },
        }
    }
    if (eliciting) {
        const rs = &conn.rx_space[space];
        rs.ack_pending = true;
        // RFC 9000 §13.2.2: ack at least every 2nd ack-eliciting packet —
        // the second marks the ack due NOW rather than the timer.
        rs.unacked_eliciting += 1;
        if (rs.unacked_eliciting >= 2) conn.ack_due_now = true;
    }
    _ = a;
}

const QAckRange = struct { lo: u64, hi: u64 };

// One pass over the sent list for a whole run of wire-ack ranges. The list
// is pn-ascending and ranges arrive pn-descending, so a single cursor over
// the reversed ranges answers membership in O(1) amortized per packet;
// removals share one compaction write index, not per-packet memmoves.
fn quicOnAckRanges(conn: *QuicConn, space: usize, ranges: []const QAckRange) void {
    if (ranges.len == 0) return;
    const sp = &conn.tx_space[space];
    const now = std.time.microTimestamp();
    var w: usize = 0;
    var i: usize = 0;
    var ri: usize = ranges.len;
    while (i < sp.sent.items.len) : (i += 1) {
        const p = &sp.sent.items[i];
        // advance the cursor past every range that ends below this pn;
        // what remains has hi >= p.pn, so lo <= p.pn decides membership.
        while (ri > 0 and ranges[ri - 1].hi < p.pn) ri -= 1;
        const keep = !(ri > 0 and p.pn >= ranges[ri - 1].lo);
        if (!keep) {
            if (p.pn > @as(u64, @intCast(@max(sp.largest_acked, 0)))) sp.largest_acked = @intCast(p.pn);
            if (p.ack_eliciting and p.time_us > 0) {
                conn.latest_rtt_us = now - p.time_us;
                if (conn.smoothed_rtt_us < 0) {
                    conn.smoothed_rtt_us = conn.latest_rtt_us;
                    conn.rttvar_us = @divTrunc(conn.latest_rtt_us, 2);
                } else {
                    const diff = @abs(conn.smoothed_rtt_us - conn.latest_rtt_us);
                    conn.rttvar_us = @divTrunc(3 * conn.rttvar_us + @as(i64, @intCast(diff)), 4);
                    conn.smoothed_rtt_us = @divTrunc(7 * conn.smoothed_rtt_us + conn.latest_rtt_us, 8);
                }
                conn.pto_count = 0;
            }
            if (p.in_flight) {
                if (p.pmtu_probe) {
                    conn.pmtu = @max(conn.pmtu, conn.pmtu_probe_size);
                    conn.pmtu_idx +|= 1;
                    conn.pmtu_probe_pn = -1;
                }
                conn.bytes_in_flight -|= p.size;
                // RFC 9002 §7.4: recovery ends when a packet sent after
                // recovery_start is acked; pre-recovery packets don't grow.
                if (conn.in_recovery and p.time_us > 0 and p.time_us > conn.recovery_start_us) {
                    conn.in_recovery = false;
                }
                if (!conn.in_recovery) {
                    if (conn.cwnd < conn.ssthresh) {
                        conn.cwnd += p.size; // slow start
                    } else {
                        conn.cwnd += @max(1, QUIC_MAX_DGRAM * p.size / @max(conn.cwnd, 1)); // congestion avoidance
                    }
                }
            }
            for (p.frames.items) |f| {
                switch (f) {
                    .stream => |sf| {
                        if (quicStreamGet(conn, sf.id, false)) |s| {
                            rangesAdd(&s.sb_acked, conn.a(), sf.off, sf.len + @intFromBool(sf.fin)) catch { quicClose(conn, 0x01, false); return; };
                            quicStreamMaybeFree(conn, s);
                        }
                    },
                    .handshake_done => {
                        conn.hs_confirmed = true;
                        conn.keys_rx[1].present = false;
                        conn.keys_tx[1].present = false;
                    },
                    .reset_stream => |rs| {
                        if (quicStreamGet(conn, rs.id, false)) |s| {
                            s.rst_acked = true;
                            quicStreamMaybeFree(conn, s);
                        }
                    },
                    else => {},
                }
            }
            quicRecycleSentFrames(conn, p);
        } else {
            if (w != i) sp.sent.items[w] = sp.sent.items[i];
            w += 1;
        }
    }
    sp.sent.items.len = w;
}

fn quicOnStreamData(conn: *QuicConn, id: u64, off: u64, data: []const u8, fin: bool) void {
    // client uni streams and client bidi streams only; our own uni stream
    // ids (&3==2? ours are 2,6,...) can't carry client data — ignore.
    if (id & 3 == 1 or id & 3 == 3) return; // server-initiated; client can't write
    // a retransmitted/duplicated frame for an already-freed bidi stream must
    // not resurrect it — freed seqs are recorded in conn.bidi_closed, and a
    // missing map entry on that list means it was closed.
    if (id & 3 == 0 and conn.streams.get(id) == null and
        rangesHas(&conn.bidi_closed, id >> 2)) {
        return;
    }
    const s = quicStreamGet(conn, id, true) orelse return;
    const end = off + data.len;
    // RFC 9000 §4.5/§4.6: enforce our advertised receive limits and the
    // final-size rule once FIN fixed the stream's length.
    if (end > s.rx_hi) { quicClose(conn, 0x03, false); return; } // FLOW_CONTROL_ERROR
    if (s.rx_fin_off != null and end > s.rx_fin_off.?) { quicClose(conn, 0x06, false); return; } // FINAL_SIZE_ERROR
    if (fin and s.rx_fin_off != null and s.rx_fin_off.? != end) { quicClose(conn, 0x06, false); return; }
    conn.rx_fc += end -| s.rx_max_off;
    s.rx_max_off = @max(s.rx_max_off, end);
    if (conn.rx_fc > conn.rx_max_data + 4 * QUIC_MAX_DGRAM) { quicClose(conn, 0x03, false); return; }
    if (data.len > 0) {
        if (s.rx.items.len < end) s.rx.resize(conn.a(), @intCast(end)) catch { quicClose(conn, 0x01, false); return; };
        @memcpy(s.rx.items[@intCast(off)..@intCast(end)], data);
        const old_contig = rangesContig(&s.rx_ranges);
        rangesAdd(&s.rx_ranges, conn.a(), off, data.len) catch { quicClose(conn, 0x01, false); return; };
        const new_contig = rangesContig(&s.rx_ranges);
        const fresh = new_contig -| @min(old_contig, new_contig);
        if (fresh > 0) {
            conn.rx_consumed_total += fresh;
            // credit: keep the advertised window ~a full MAX_DATA ahead of
            // cumulative consumption so sustained uploads never stall.
            if (conn.rx_max_data -| conn.rx_consumed_total < QUIC_MAX_DATA / 2) {
                conn.rx_max_data = conn.rx_consumed_total + QUIC_MAX_DATA;
                quicCtrlQueue(conn, .{ .max_data = conn.rx_max_data });
            }
            if (s.rx_hi < new_contig + QUIC_MAX_STREAM_DATA / 2) {
                s.rx_hi = new_contig + QUIC_MAX_STREAM_DATA;
                quicCtrlQueue(conn, .{ .max_stream_data = .{ .id = id, .v = s.rx_hi } });
            }
        }
    }
    if (fin) s.rx_fin_off = off + data.len;
    if (s.stype == -2) quicH3Parse(conn, s);
    if (s.stype == -1) quicUniType(conn, s);
    quicStreamMaybeFree(conn, s);
}

// Uni streams: first varint is the type; content is ignored (control/qpack).
fn quicUniType(conn: *QuicConn, s: *QStream) void {
    _ = conn;
    const contig = rangesContig(&s.rx_ranges);
    if (contig == 0) return;
    var pos: usize = 0;
    _ = qvGet(s.rx.items[0..@intCast(contig)], &pos) orelse return;
    s.stype = @intCast(pos); // consumed bytes mark type length
    s.stype = 0; // treated as drained-forever: content ignored
}

// ── HTTP/3 framing + QPACK decode ────────────────────────────────────────────

fn qpackString(conn: *QuicConn, block: []const u8, pos: *usize) ?[]const u8 {
    if (pos.* >= block.len) return null;
    const huffman = block[pos.*] & 0x80 != 0;
    var vpos = pos.*;
    const len = hpackInt(block, &vpos, 7) orelse return null;
    pos.* = vpos;
    if (len > block.len - pos.*) return null;
    const raw = block[pos.* .. pos.* + @as(usize, @intCast(len))];
    pos.* += @intCast(len);
    if (!huffman) return raw;
    return huffDecode(&conn.huff, conn.a(), raw);
}

// Decode a QPACK field section (static table only) into `pairs`. RIC must be
// 0 — we advertised capacity 0, so any dynamic reference is a violation.
fn qpackDecode(conn: *QuicConn, block: []const u8, pairs: []HpackPair) ?usize {
    var pos: usize = 0;
    const ric = qvGet(block, &pos) orelse return null;
    const delta_base = qvGet(block, &pos) orelse return null;
    _ = delta_base;
    if (ric != 0) return null;
    var n: usize = 0;
    while (pos < block.len) {
        const b = block[pos];
        if (b & 0x80 != 0) {
            // indexed field line: T=1 → static
            if (b & 0x40 == 0) return null;
            const idx = hpackInt(block, &pos, 6) orelse return null;
            if (idx >= QPACK_STATIC.len or n >= pairs.len) return null;
            pairs[n] = QPACK_STATIC[@intCast(idx)];
            n += 1;
        } else if (b & 0xC0 == 0x40) {
            // literal with name reference: T at bit 4, idx 4-bit prefix
            if (b & 0x10 == 0) return null;
            const idx = hpackInt(block, &pos, 4) orelse return null;
            if (idx >= QPACK_STATIC.len or n >= pairs.len) return null;
            const name = QPACK_STATIC[@intCast(idx)].name;
            const value = qpackString(conn, block, &pos) orelse return null;
            pairs[n] = .{ .name = name, .value = value };
            n += 1;
        } else if (b & 0xE0 == 0x20) {
            // literal with literal name: 001 N H len(3+)
            const nhuff = b & 0x08 != 0;
            var vpos = pos;
            const nlen = hpackInt(block, &vpos, 3) orelse return null;
            pos = vpos;
            if (nlen > block.len - pos) return null;
            var name: []const u8 = block[pos .. pos + @as(usize, @intCast(nlen))];
            pos += @intCast(nlen);
            if (nhuff) name = huffDecode(&conn.huff, conn.a(), name) orelse return null;
            const value = qpackString(conn, block, &pos) orelse return null;
            if (n >= pairs.len) return null;
            pairs[n] = .{ .name = name, .value = value };
            n += 1;
        } else {
            return null; // dynamic/post-base — capacity 0 forbids them
        }
    }
    return n;
}

// Parse h3 frames off the contiguous receive prefix. HEADERS first, then
// DATA until FIN; unknown frame types skipped per RFC 9114 §7.1.
fn quicH3Parse(conn: *QuicConn, s: *QStream) void {
    const a = conn.a();
    while (true) {
        const contig = rangesContig(&s.rx_ranges);
        if (s.rx_fin_off) |f| {
            if (contig < f) {
                // still waiting for a hole to fill
            }
        }
        const avail: usize = @intCast(@min(contig, s.rx.items.len));
        if (s.h3_off >= avail) break;
        const buf = s.rx.items[@intCast(s.h3_off)..avail];
        var pos: usize = 0;
        const ft = qvGet(buf, &pos) orelse break;
        const flen = qvGet(buf, &pos) orelse break;
        if (flen > buf.len - pos) break; // incomplete frame
        const payload = buf[pos .. pos + @as(usize, @intCast(flen))];
        pos += @intCast(flen);
        switch (ft) {
            0x01 => { // HEADERS
                var pairs: [64]HpackPair = undefined;
                const n = qpackDecode(conn, payload, &pairs) orelse {
                    quicClose(conn, 0x0200, true); // QPACK_DECOMPRESSION_FAILED
                    return;
                };
                if (!s.h3_headers_done) {
                    for (pairs[0..n]) |p| {
                        if (std.mem.eql(u8, p.name, ":method")) {
                            s.h3_method.appendSlice(a, p.value) catch { quicClose(conn, 0x0102, true); return; };
                        } else if (std.mem.eql(u8, p.name, ":path")) {
                            s.h3_path.appendSlice(a, p.value) catch { quicClose(conn, 0x0102, true); return; };
                        } else if (std.mem.eql(u8, p.name, ":authority")) {
                            s.h3_authority.appendSlice(a, p.value) catch { quicClose(conn, 0x0102, true); return; };
                        } else if (p.name.len > 0 and p.name[0] != ':') {
                            s.h3_headers.appendSlice(a, p.name) catch { quicClose(conn, 0x0102, true); return; };
                            s.h3_headers.appendSlice(a, ": ") catch { quicClose(conn, 0x0102, true); return; };
                            s.h3_headers.appendSlice(a, p.value) catch { quicClose(conn, 0x0102, true); return; };
                            s.h3_headers.appendSlice(a, "\r\n") catch { quicClose(conn, 0x0102, true); return; };
                        }
                    }
                    s.h3_headers_done = true;
                    for (conn.huff.retired.items) |r| a.free(r);
                    conn.huff.retired.clearRetainingCapacity();
                }
            },
            0x00 => { // DATA
                if (!s.h3_headers_done) {
                    quicClose(conn, 0x0105, true); // H3_FRAME_UNEXPECTED
                    return;
                }
                s.h3_body.appendSlice(a, payload) catch { quicClose(conn, 0x0102, true); return; };
            },
            else => {}, // SETTINGS on request stream / unknowns: skip
        }
        s.h3_off += pos;
    }
    // RFC 9114 §4.1: a request stream that FINs with no HEADERS is
    // H3_REQUEST_INCOMPLETE — reset it and never serve it.
    if (!s.served and !s.h3_headers_done and s.rx_fin_off != null and
        rangesContig(&s.rx_ranges) >= s.rx_fin_off.? and s.h3_off >= s.rx_fin_off.?)
    {
        s.served = true;
        s.rx_dead = true;
        quicCtrlQueue(conn, .{ .reset_stream = .{ .id = s.id, .code = 0x0106, .final_size = s.h3_off } });
        return;
    }
    // Request complete when FIN arrived and we consumed everything before it.
    if (!s.served and s.h3_headers_done) {
        if (s.rx_fin_off) |fin| {
            if (rangesContig(&s.rx_ranges) >= fin and s.h3_off >= fin) {
                s.served = true;
                quicH3Serve(conn, s);
            }
        }
    }
}

// Synthesize the h1-format request — same shape h2FillRequestHead emits — and
// queue it for the ~proc body's arrived() dispatch.
fn quicH3Serve(conn: *QuicConn, s: *QStream) void {
    const a = conn.a();
    if (s.h3_method.items.len == 0 or s.h3_path.items.len == 0) {
        quicClose(conn, 0x0107, true); // H3_MESSAGE_ERROR
        return;
    }
    var rq: std.ArrayListUnmanaged(u8) = .{};
    rq.appendSlice(a, s.h3_method.items) catch { quicClose(conn, 0x0102, true); return; };
    rq.appendSlice(a, " ") catch { quicClose(conn, 0x0102, true); return; };
    rq.appendSlice(a, s.h3_path.items) catch { quicClose(conn, 0x0102, true); return; };
    rq.appendSlice(a, " HTTP/1.1\r\nhost: ") catch { quicClose(conn, 0x0102, true); return; };
    rq.appendSlice(a, s.h3_authority.items) catch { quicClose(conn, 0x0102, true); return; };
    rq.appendSlice(a, "\r\n") catch { quicClose(conn, 0x0102, true); return; };
    rq.appendSlice(a, s.h3_headers.items) catch { quicClose(conn, 0x0102, true); return; };
    var cl_buf: [32]u8 = undefined;
    const cl = std.fmt.bufPrint(&cl_buf, "content-length: {}\r\n\r\n", .{s.h3_body.items.len}) catch { quicClose(conn, 0x0102, true); return; };
    rq.appendSlice(a, cl) catch { quicClose(conn, 0x0102, true); return; };
    rq.appendSlice(a, s.h3_body.items) catch { quicClose(conn, 0x0102, true); return; };
    const raw = a.dupe(u8, rq.items) catch { quicClose(conn, 0x0102, true); return; };
    rq.deinit(a);
    const lane = conn.lane;
    lane.ready.append(pumpAlloc(), .{ .stream = s, .raw = raw }) catch {
        a.free(raw);
        quicClose(conn, 0x0102, true); // H3_INTERNAL_ERROR
        return;
    };
    // Credit: a completed request stream earns the client another one.
    conn.streams_bidi_done += 1;
    const credit = QUIC_MAX_STREAMS_BIDI + conn.streams_bidi_done;
    if (credit > conn.streams_bidi_credit) {
        conn.streams_bidi_credit = credit;
        quicCtrlQueue(conn, .{ .max_streams_bidi = credit });
    }
}

fn quicH3OpenControl(conn: *QuicConn) void {
    const s = quicStreamGet(conn, conn.next_uni_id, true) orelse return;
    conn.next_uni_id += 4;
    const a = conn.a();
    s.sb.append(a, 0x00) catch { quicClose(conn, 0x01, false); return; }; // control stream type
    // SETTINGS frame: QPACK_MAX_TABLE_CAPACITY=0, QPACK_BLOCKED_STREAMS=0
    const settings = [_]u8{ 0x01, 0x00, 0x07, 0x00 };
    s.sb.append(a, 0x04) catch { quicClose(conn, 0x01, false); return; };
    qvPut(&s.sb, a, settings.len) catch { quicClose(conn, 0x01, false); return; };
    s.sb.appendSlice(a, &settings) catch { quicClose(conn, 0x01, false); return; };
    s.flow_hi = conn.peer_imsd_uni;
    quicTxQueue(conn, s);
}

// ── close ────────────────────────────────────────────────────────────────────

fn quicClose(conn: *QuicConn, code: u64, app: bool) void {
    if (conn.state == .closing or conn.state == .draining or conn.state == .dead) return;
    conn.close_code = code;
    conn.close_pending = .{ .conn_close = .{ .code = code, .app = app } };
    conn.state = .closing;
    conn.draining_until_ms = std.time.milliTimestamp() + 3000;
}

// ── ACK frame emit ───────────────────────────────────────────────────────────

fn emitAckFrame(out: *std.ArrayListUnmanaged(u8), a: std.mem.Allocator, rs: *QRxSpace) bool {
    const rs_list = &rs.ranges;
    if (rs_list.items.len == 0) return false;
    var buf: [64]u8 = undefined;
    const last = rs_list.items[rs_list.items.len - 1];
    // RFC 9000 §13.2.4: may drop old ranges — cap emitted ranges and prune
    // the stored list so sustained loss can't grow it without bound.
    while (rs_list.items.len > 64) _ = rs_list.orderedRemove(0);
    const emit_n = @min(rs_list.items.len, 32);
    const largest = last.off + last.len - 1;
    var fo: usize = 0;
    buf[0] = 0x02;
    fo = 1;
    fo += qvPutSlice(buf[fo..], largest);
    // real ack_delay, encoded with our advertised exponent 3
    const delay_us = @max(0, std.time.microTimestamp() - rs.newest_rx_us);
    fo += qvPutSlice(buf[fo..], @intCast(delay_us >> 3));
    fo += qvPutSlice(buf[fo..], emit_n - 1); // ack range count
    fo += qvPutSlice(buf[fo..], last.len - 1); // first ack range
    out.appendSlice(a, buf[0..fo]) catch return false;
    var prev_off = last.off;
    var i = rs_list.items.len - 1;
    var emitted: usize = 1;
    while (i > 0 and emitted < emit_n) {
        i -= 1;
        const r = rs_list.items[i];
        emitted += 1;
        // gap = unacked pns between this range's top and prev range's bottom - 1
        qvPut(out, a, prev_off - (r.off + r.len) - 1) catch return false;
        qvPut(out, a, r.len - 1) catch return false;
        prev_off = r.off;
    }
    rs.ack_pending = false;
    rs.unacked_eliciting = 0;
    return true;
}

// ── packet build ─────────────────────────────────────────────────────────────

// Write a protected packet for `space` into out[] (at most budget bytes).
// Returns bytes written; 0 = nothing to send at this space.
fn quicBuildPacket(conn: *QuicConn, space: usize, out: []u8, budget: usize, pad_to_1200: bool, probe: bool, ack_only: bool) usize {
    const ks = &conn.keys_tx[space];
    if (!ks.present) return 0;
    const a = conn.a();
    const ts = &conn.tx_space[space];
    // Frame bytes go to the lane's reused scratch list — serial per lane —
    // and the header is serialized straight into `out`. Nothing below
    // allocates on the packet path except the sent record's frame list,
    // which itself comes from the conn's pool of recycled buffers.
    const frames = &conn.lane.build_frames;
    frames.clearRetainingCapacity();
    var rec: QSentPacket = .{ .frames = quicFramesScratch(conn) };
    var rec_stored = false;
    defer if (!rec_stored) quicRecycleSentFrames(conn, &rec);
    var elicit = false;

    const room = budget -| 64; // header + tag slack
    if (room < 16) return 0;

    // ACK
    const rs = &conn.rx_space[space];
    if (rs.ack_pending and space != 0 or (space == 0 and rs.ack_pending)) {
        if (emitAckFrame(frames, a, rs)) {
            rec.frames.append(a, .ack) catch { quicClose(conn, 0x01, false); return 0; };
            // ACK alone is not ack-eliciting — do not set elicit here.
        }
    }
    // CRYPTO: retransmit ranges first, then new data.
    while (!ack_only and conn.ctx_retx[space].items.len > 0 and frames.items.len < room) {
        const r = conn.ctx_retx[space].orderedRemove(0);
        const n = @min(r.len, room -| frames.items.len -| 16);
        if (n == 0) break;
        frames.append(a, 0x06) catch { quicClose(conn, 0x01, false); return 0; };
        qvPut(frames, a, r.off) catch { quicClose(conn, 0x01, false); return 0; };
        qvPut(frames, a, n) catch { quicClose(conn, 0x01, false); return 0; };
        frames.appendSlice(a, conn.ctx[space].items[@intCast(r.off)..@intCast(r.off + n)]) catch { quicClose(conn, 0x01, false); return 0; };
        rec.frames.append(a, .{ .crypto = .{ .off = r.off, .len = n } }) catch { quicClose(conn, 0x01, false); return 0; };
        elicit = true;
        if (n < r.len) {
            conn.ctx_retx[space].insert(a, 0, .{ .off = r.off + n, .len = r.len - n }) catch { quicClose(conn, 0x01, false); return 0; };
            break;
        }
    }
    while (!ack_only and conn.ctx_hi[space] < conn.ctx[space].items.len and frames.items.len < room) {
        const off = conn.ctx_hi[space];
        const n = @min(conn.ctx[space].items.len - off, room -| frames.items.len -| 16);
        if (n == 0) break;
        frames.append(a, 0x06) catch { quicClose(conn, 0x01, false); return 0; };
        qvPut(frames, a, off) catch { quicClose(conn, 0x01, false); return 0; };
        qvPut(frames, a, n) catch { quicClose(conn, 0x01, false); return 0; };
        frames.appendSlice(a, conn.ctx[space].items[off .. off + n]) catch { quicClose(conn, 0x01, false); return 0; };
        conn.ctx_hi[space] += n;
        rec.frames.append(a, .{ .crypto = .{ .off = off, .len = n } }) catch { quicClose(conn, 0x01, false); return 0; };
        elicit = true;
    }
    // control queue (app space only, plus close anywhere)
    if (space == 2 and !ack_only) {
        const qi: usize = 0;
        while (qi < conn.ctrl_q.items.len and frames.items.len < room) {
            const f = conn.ctrl_q.items[qi];
            const before = frames.items.len;
            switch (f) {
                .handshake_done => frames.append(a, 0x1e) catch { quicClose(conn, 0x01, false); return 0; },
                .max_data => {
                    // retransmits must carry the CURRENT credit, not the
                    // value captured when the frame was first queued.
                    frames.append(a, 0x10) catch { quicClose(conn, 0x01, false); return 0; };
                    qvPut(frames, a, conn.rx_max_data) catch { quicClose(conn, 0x01, false); return 0; };
                },
                .max_stream_data => |md| {
                    frames.append(a, 0x11) catch { quicClose(conn, 0x01, false); return 0; };
                    qvPut(frames, a, md.id) catch { quicClose(conn, 0x01, false); return 0; };
                    const cur: u64 = if (quicStreamGet(conn, md.id, false)) |st| st.rx_hi else md.v;
                    qvPut(frames, a, cur) catch { quicClose(conn, 0x01, false); return 0; };
                },
                .max_streams_bidi => {
                    frames.append(a, 0x12) catch { quicClose(conn, 0x01, false); return 0; };
                    qvPut(frames, a, conn.streams_bidi_credit) catch { quicClose(conn, 0x01, false); return 0; };
                },
                .max_streams_uni => |v| {
                    frames.append(a, 0x13) catch { quicClose(conn, 0x01, false); return 0; };
                    qvPut(frames, a, v) catch { quicClose(conn, 0x01, false); return 0; };
                },
                .path_response => |d| {
                    frames.append(a, 0x1b) catch { quicClose(conn, 0x01, false); return 0; };
                    frames.appendSlice(a, &d) catch { quicClose(conn, 0x01, false); return 0; };
                },
                else => break,
            }
            if (frames.items.len > room) {
                frames.items.len = before;
                break;
            }
            rec.frames.append(a, f) catch { quicClose(conn, 0x01, false); return 0; };
            elicit = true;
            _ = conn.ctrl_q.orderedRemove(qi);
        }
    }
    // close always wins on any space with keys
    if (conn.close_pending != null) {
        if (conn.close_pending) |pf| {
            conn.close_pending = null;
            const before = frames.items.len;
            switch (pf) {
                .conn_close => |cc| {
                    // RFC 9000 §10.2.3: an app close must be re-encoded as a
                    // transport close in Initial/Handshake space.
                    frames.append(a, if (cc.app and space == 2) 0x1d else 0x1c) catch { quicClose(conn, 0x01, false); return 0; };
                    qvPut(frames, a, cc.code) catch { quicClose(conn, 0x01, false); return 0; };
                    if (!cc.app) qvPut(frames, a, 0) catch { quicClose(conn, 0x01, false); return 0; }; // frame type 0
                    qvPut(frames, a, 0) catch { quicClose(conn, 0x01, false); return 0; }; // reason len
                },
                else => {},
            }
            rec.frames.append(a, pf) catch { quicClose(conn, 0x01, false); return 0; };
            _ = before;
            elicit = true;
        }
    }
    // STREAM data (app space): retransmits then new bytes, peer-window-bound.
    // Only tx_ready streams are visited — not every stream on the conn.
    // Each packet gives the queue's snapshot one pass; a stream still
    // holding unemitted bytes re-joins at the back (round-robin, the same
    // pop→push shape as ngtcp2's tx.strmq cycle).
    if (space == 2 and !ack_only and conn.close_pending == null and conn.state != .closing and conn.state != .draining) {
        const now_ms = std.time.milliTimestamp();
        // Snapshot pass over the queue's head; survivors compact left
        // in-place (order preserved, O(queue) per packet — not a
        // pop-front memmove per stream).
        const qlen = conn.tx_ready.items.len;
        var qw: usize = 0; // survivor write index
        var qi: usize = 0;
        while (qi < qlen and frames.items.len < room) : (qi += 1) {
            const s = conn.tx_ready.items[qi];
            if (s.park_until > now_ms or s.reset) {
                // Parked / resetting streams keep their queue slot only while
                // bytes remain — a parked reply still emits once the park
                // expires; a drained or reset one drops out for good.
                if (!s.reset and (s.sb_retx.items.len > 0 or s.sb_hi < s.sb.items.len)) {
                    conn.tx_ready.items[qw] = s;
                    qw += 1;
                } else {
                    s.tx_queued = false;
                }
                continue;
            }
            // retransmit ranges
            while (s.sb_retx.items.len > 0 and frames.items.len < room) {
                const r = s.sb_retx.orderedRemove(0);
                var n = @min(r.len, room -| frames.items.len -| 24);
                const fc_room = s.flow_hi -| @min(s.flow_hi, s.sb_hi);
                _ = fc_room;
                if (n == 0) break;
                n = @min(n, s.sb.items.len - r.off);
                const fin = s.sb_fin and r.off + n >= s.sb.items.len;
                quicEmitStreamFrame(frames, a, s.id, r.off, n, fin, s.sb.items[@intCast(r.off)..@intCast(r.off + n)]) catch { quicClose(conn, 0x01, false); return 0; };
                rec.frames.append(a, .{ .stream = .{ .id = s.id, .off = r.off, .len = n, .fin = fin } }) catch { quicClose(conn, 0x01, false); return 0; };
                elicit = true;
                if (n < r.len) {
                    s.sb_retx.insert(a, 0, .{ .off = r.off + n, .len = r.len - n }) catch { quicClose(conn, 0x01, false); return 0; };
                }
            }
            // new data within the peer's stream window + conn max_data
            while (s.sb_hi < s.sb.items.len and frames.items.len < room and conn.tx_data_sent < conn.peer_max_data and s.sb_hi < s.flow_hi) {
                var n = @min(s.sb.items.len - s.sb_hi, room -| frames.items.len -| 24);
                n = @min(n, s.flow_hi - s.sb_hi);
                n = @min(n, conn.peer_max_data - conn.tx_data_sent);
                if (n == 0) break;
                const off = s.sb_hi;
                const fin = s.sb_fin and off + n >= s.sb.items.len;
                quicEmitStreamFrame(frames, a, s.id, off, n, fin, s.sb.items[@intCast(off)..@intCast(off + n)]) catch { quicClose(conn, 0x01, false); return 0; };
                rec.frames.append(a, .{ .stream = .{ .id = s.id, .off = off, .len = n, .fin = fin } }) catch { quicClose(conn, 0x01, false); return 0; };
                s.sb_hi += n;
                conn.tx_data_sent += n;
                elicit = true;
                if (fin) s.tx_done = false; // becomes done when acked
            }
            if (!s.reset and (s.sb_retx.items.len > 0 or s.sb_hi < s.sb.items.len)) {
                conn.tx_ready.items[qw] = s;
                qw += 1;
            } else {
                s.tx_queued = false;
            }
        }
        // Entries past qi never got visited (room ran out) — they stay
        // queued, shifted down behind the survivors.
        if (qi < qlen) {
            std.mem.copyForwards(*QStream, conn.tx_ready.items[qw .. qw + qlen - qi], conn.tx_ready.items[qi..qlen]);
            qw += qlen - qi;
        }
        conn.tx_ready.items.len = qw;
    }
    // PTO probe: nothing to say but must elicit — PING.
    if (!elicit and probe) {
        frames.append(a, 0x01) catch { quicClose(conn, 0x01, false); return 0; };
        rec.frames.append(a, .ping) catch { quicClose(conn, 0x01, false); return 0; };
        elicit = true;
    }
    if (frames.items.len == 0) return 0;

    // Pad: a datagram carrying an Initial ack-eliciting packet must be 1200
    // bytes. frames += PADDING (0x00) so this packet fills `budget`.
    if (pad_to_1200) {
        const hdr_est = 1 + 4 + 1 + conn.dcid_len + 1 + QUIC_SCID_LEN + 1 + 4 + 4; // initial hdr + len vi + pn
        const want = budget -| (hdr_est + 16);
        if (frames.items.len < want) {
            const pad_n = want - frames.items.len;
            frames.appendNTimes(a, 0, pad_n) catch { quicClose(conn, 0x01, false); return 0; };
        }
    }
    const pnl: usize = 4;
    const pn = ts.next_pn;
    // The header is ≤61 bytes and out.len is `budget` at every call site
    // (room>=16 pinned budget>=80), so it serializes straight into `out`.
    var hl: usize = 0;
    if (space == 2) {
        out[hl] = 0x40 | @as(u8, @intCast(pnl - 1));
        hl += 1;
        @memcpy(out[hl .. hl + conn.dcid_len], conn.dcid[0..conn.dcid_len]);
        hl += conn.dcid_len;
    } else {
        out[hl] = (if (space == 0) @as(u8, 0xc0) else 0xe0) | @as(u8, @intCast(pnl - 1));
        hl += 1;
        std.mem.writeInt(u32, out[hl..][0..4], QUIC_VERSION_1, .big);
        hl += 4;
        out[hl] = conn.dcid_len;
        hl += 1;
        @memcpy(out[hl .. hl + conn.dcid_len], conn.dcid[0..conn.dcid_len]);
        hl += conn.dcid_len;
        out[hl] = QUIC_SCID_LEN;
        hl += 1;
        @memcpy(out[hl .. hl + QUIC_SCID_LEN], &conn.scid);
        hl += QUIC_SCID_LEN;
        if (space == 0) {
            out[hl] = 0; // token len 0
            hl += 1;
        }
        hl += qvPutSlice(out[hl..], pnl + frames.items.len + 16);
    }
    const pn_off = hl;
    var pnb: [4]u8 = undefined;
    std.mem.writeInt(u32, &pnb, @intCast(pn & 0xffffffff), .big);
    @memcpy(out[pn_off .. pn_off + pnl], pnb[4 - pnl ..]);
    hl += pnl;

    // encrypt frames straight into the datagram — no payload copy
    const total = hl + frames.items.len + 16;
    if (total > out.len or total > budget + 64) {
        // over budget — put everything back so nothing is lost.
        for (rec.frames.items) |f| quicRequeueFrame(conn, space, f);
        return 0;
    }
    var tag: [16]u8 = undefined;
    const nonce = pnNonce(&ks.iv, pn);
    gcmEncrypt(ks, out[hl .. hl + frames.items.len], &tag, frames.items, out[0..hl], nonce);
    @memcpy(out[hl + frames.items.len ..][0..16], &tag);
    // header protection: sample 16 bytes starting pn_off+4
    if (pn_off + 4 + 16 <= total) {
        var sample: [16]u8 = undefined;
        @memcpy(&sample, out[pn_off + 4 .. pn_off + 20]);
        const mask = hpMask(ks, &sample);
        out[0] ^= mask[0] & (if (space == 2) @as(u8, 0x1f) else 0x0f);
        for (0..pnl) |i| out[pn_off + i] ^= mask[1 + i];
    }
    ts.next_pn += 1;
    rec.pn = pn;
    rec.time_us = std.time.microTimestamp();
    rec.size = total;
    rec.ack_eliciting = elicit;
    rec.in_flight = elicit;
    if (elicit) conn.bytes_in_flight += total;
    // Only ack-eliciting packets enter loss tracking — a pure-ACK packet is
    // never acked, so tracking it would loop retransmit forever.
    if (elicit) {
        ts.sent.append(a, rec) catch {
            quicClose(conn, 0x01, false);
            return 0; // defer recycles rec.frames
        };
        rec_stored = true;
    }
    return total;
}

fn quicEmitStreamFrame(out: *std.ArrayListUnmanaged(u8), a: std.mem.Allocator, id: u64, off: u64, n: u64, fin: bool, data: []const u8) error{OutOfMemory}!void {
    var ft: u8 = 0x08;
    if (off != 0) ft |= 0x04;
    ft |= 0x02; // LEN always present
    if (fin) ft |= 0x01;
    try out.append(a, ft);
    try qvPut(out, a, id);
    if (off != 0) try qvPut(out, a, off);
    try qvPut(out, a, n);
    try out.appendSlice(a, data);
}

// ── datagram assembly + flush ────────────────────────────────────────────────

// Max datagrams batched into one sendmmsg — ngtcp2's write_aggregate_pkt
// shape: the flush loop keeps producing packets until the burst fills or a
// round yields nothing, then ONE syscall emits the burst.
const QUIC_SEND_BURST: usize = 32;

fn quicFlush(lane: *QuicLane) void {
    lane.flush_again = false;
    var it = lane.conns.iterator();
    const dbuf = &lane.dbuf;
    const now_ms = std.time.milliTimestamp();
    while (it.next()) |e| {
        const conn = e.value_ptr.*;
        if (conn.state == .dead) continue;
        if (conn.state == .draining) {
            if (now_ms >= conn.draining_until_ms) conn.state = .dead;
            continue;
        }
        var burst_lens: [QUIC_SEND_BURST]usize = undefined;
        var burst_n: usize = 0; // datagrams staged in dbuf
        var burst_off: usize = 0; // bytes consumed in dbuf
        var pending_limited: u64 = 0; // staged-not-yet-sent bytes (anti-amp check)
        var guard: usize = 0;
        while (guard < 64) : (guard += 1) {
            // RFC 9002 §7.2: ack-eliciting sends gated on cwnd (probes exempt).
            const budget: usize = @min(conn.pmtu, conn.cwnd -| conn.bytes_in_flight);
            // anti-amplification: 3x received until the address validates —
            // staged-but-unsent datagrams count against the budget.
            if (!conn.addr_validated and conn.tx_bytes_limited + pending_limited + budget > 3 * conn.rx_bytes_total) break;
            if (burst_n > 0 and (burst_n == QUIC_SEND_BURST or dbuf.len - burst_off < conn.pmtu + 64)) {
                // burst full (msgs or buffer) — drain before building more
                if (!quicSendBurst(conn, dbuf[0..burst_off], burst_lens[0..burst_n])) break;
                burst_n = 0;
                burst_off = 0;
                pending_limited = 0;
                continue;
            }
            var total: usize = 0;
            conn.ack_due_now = false;
            if (budget > 0) {
                for (0..3) |sp| {
                    const pad = sp == 0 and !conn.addr_validated;
                    const n = quicBuildPacket(conn, sp, dbuf[burst_off + total ..][0 .. budget -| total], budget -| total, pad, false, false);
                    if (n > 0) total += n;
                }
            }
            // ACK-only packets are exempt from cwnd (RFC 9002 §7).
            if (total == 0) {
                for (0..3) |sp| {
                    if (conn.rx_space[sp].ack_pending) {
                        const n = quicBuildPacket(conn, sp, dbuf[burst_off..][0..conn.pmtu], conn.pmtu, false, false, true);
                        if (n > 0) total += n;
                        break;
                    }
                }
            }
            // PTO probe: nothing else to send but a probe is owed
            if (total == 0 and conn.probe_pending) {
                const n = quicBuildPacket(conn, if (conn.keys_tx[2].present) 2 else if (conn.keys_tx[1].present) 1 else 0, dbuf[burst_off..][0..budget], budget, false, true, false);
                if (n > 0) total = n;
            }
            if (total == 0) break;
            conn.probe_pending = false;
            burst_lens[burst_n] = total;
            burst_n += 1;
            burst_off += total;
            pending_limited += total;
            // keep looping while the round produces packets — a sub-1200
            // datagram is normal (room reserves header slack), not a drain.
        }
        if (burst_n > 0) _ = quicSendBurst(conn, dbuf[0..burst_off], burst_lens[0..burst_n]);
        lane.flush_again = lane.flush_again or guard >= 64;
    }
    quicSweepDead(lane);
}

// Emit a staged burst of whole datagrams for one conn. Linux: sendmmsg
// drains them in one syscall — the wire sees exactly what per-dgram sendto
// would send. Other targets have no sendmmsg; the sendto loop IS their
// send API, not a degraded path.
fn quicSendBurst(conn: *QuicConn, buf: []const u8, lens: []const usize) bool {
    if (@import("builtin").os.tag != .linux) {
        var off: usize = 0;
        for (lens) |l| {
            if (!quicSendDgram(conn, buf[off .. off + l])) return false;
            off += l;
        }
        return true;
    }
    var msgs: [QUIC_SEND_BURST]std.os.linux.mmsghdr_const = undefined;
    var iovs: [QUIC_SEND_BURST]posix.iovec_const = undefined;
    var off: usize = 0;
    for (lens, 0..) |l, i| {
        iovs[i] = .{ .base = buf.ptr + off, .len = l };
        msgs[i] = .{
            .hdr = .{
                .name = @ptrCast(&conn.peer),
                .namelen = conn.peer_len,
                .iov = iovs[i..].ptr,
                .iovlen = 1,
                .control = null,
                .controllen = 0,
                .flags = 0,
            },
            .len = 0,
        };
        off += l;
    }
    var sent: usize = 0;
    while (sent < lens.len) {
        const rc = std.os.linux.sendmmsg(conn.lane.fd, msgs[sent..].ptr, @intCast(lens.len - sent), 0);
        if (std.os.linux.E.init(rc) != .SUCCESS) return false; // socket full/dead — stop this flush round
        if (rc == 0) return false;
        // only fully-sent datagrams count against the anti-amplification cap
        var i = sent;
        while (i < sent + rc) : (i += 1) conn.tx_bytes_limited += lens[i];
        sent += rc;
    }
    return true;
}

fn quicSendDgram(conn: *QuicConn, bytes: []u8) bool {
    const n = posix.sendto(conn.lane.fd, bytes, 0, @ptrCast(&conn.peer), conn.peer_len) catch |e| switch (e) {
        error.WouldBlock => return false, // socket full — stop this flush round
        error.MessageTooBig => {
            // PMTU probe overshot the path — stop the climb, drop the probe.
            if (conn.pmtu_probe_pn >= 0) {
                conn.pmtu_fails += 1;
                conn.pmtu_probe_pn = -1;
                if (conn.pmtu_fails >= 3) {
                    conn.pmtu_fails = 0;
                    if (conn.pmtu_idx == 0) conn.pmtu_idx = 255
                    else conn.pmtu_retry_ms = std.time.milliTimestamp() + 10_000;
                }
            }
            return false;
        },
        else => {
            std.debug.print("Pump: quic sendto failed: {s}\n", .{@errorName(e)});
            return false;
        },
    };
    conn.tx_bytes_limited += n;
    return true;
}

fn quicSweepDead(lane: *QuicLane) void {
    var dead: std.ArrayListUnmanaged(*QuicConn) = .{};
    defer dead.deinit(pumpAlloc());
    var it = lane.conns.iterator();
    while (it.next()) |e| {
        if (e.value_ptr.*.state == .dead) dead.append(pumpAlloc(), e.value_ptr.*) catch { std.debug.print("Pump: quic sweep OOM — dead conn leaked\n", .{}); };
    }
    for (dead.items) |conn| quicConnDestroy(conn);
}

// ── datagram ingress ─────────────────────────────────────────────────────────

fn quicOnDgram(lane: *QuicLane, dgram: []u8, src: *const posix.sockaddr, src_len: posix.socklen_t) void {
    if (dgram.len < 6) return;
    if (dgram[0] & 0x80 == 0) {
        // short header: DCID = our scid (8 bytes)
        if (dgram.len < 1 + QUIC_SCID_LEN) return;
        const key = std.mem.readInt(u64, dgram[1..9], .big);
        const conn = lane.conns.get(key) orelse return;
        conn.rx_bytes_total += dgram.len;
        quicOnShort(conn, dgram);
        return;
    }
    const version = std.mem.readInt(u32, dgram[1..5], .big);
    var pos: usize = 5;
    if (pos >= dgram.len) return;
    const dcil: usize = dgram[pos];
    pos += 1;
    if (pos + dcil > dgram.len or pos + 1 > dgram.len) return;
    const dcid = dgram[pos .. pos + dcil];
    pos += dcil;
    const scil: usize = dgram[pos];
    pos += 1;
    if (pos + scil > dgram.len) return;
    const scid = dgram[pos .. pos + scil];
    pos += scil;
    if (version != QUIC_VERSION_1) {
        // Version negotiation: only for long headers ≥1200 bytes
        if (dgram.len >= 1200) {
            var vn: [7 + 255 + 255 + 4]u8 = undefined;
            vn[0] = 0xc0 | 0x7f;
            @memset(vn[1..5], 0);
            vn[5] = @intCast(scil);
            @memcpy(vn[6 .. 6 + scil], scid);
            vn[6 + scil] = @intCast(dcil);
            @memcpy(vn[7 + scil .. 7 + scil + dcil], dcid);
            std.mem.writeInt(u32, vn[7 + scil + dcil ..][0..4], QUIC_VERSION_1, .big);
            _ = posix.sendto(lane.fd, vn[0 .. 11 + scil + dcil], 0, src, src_len) catch {};
        }
        return;
    }
    const ptype = (dgram[0] >> 4) & 3;
    // conn lookup: DCID is either our scid or the client's original dcid
    var conn: ?*QuicConn = null;
    if (dcil == QUIC_SCID_LEN) conn = lane.conns.get(std.mem.readInt(u64, dcid[0..8], .big));
    if (conn == null) conn = lane.odcid_map.get(dcidKey(dcid));
    if (ptype == 0 and (dcil < 8 or dcil > 20)) return; // RFC 9000 §17.2
    if (ptype == 0 and conn == null) {
        // Initial → new connection
        conn = quicConnCreate(lane, src, src_len, dcid, scid);
        if (conn == null) return;
    }
    const qc = conn orelse return;
    qc.rx_bytes_total += dgram.len;
    // coalesced packet walk
    var p: usize = 0;
    while (p < dgram.len) {
        const consumed = quicOnLongPacket(qc, dgram[p..]) orelse break;
        p += consumed;
    }
}

// Parse+decrypt one long-header packet (or short, same fn shape split below).
fn quicOnLongPacket(conn: *QuicConn, buf: []u8) ?usize {
    if (buf.len < 6 or buf[0] & 0x80 == 0) return null;
    const version = std.mem.readInt(u32, buf[1..5], .big);
    if (version != QUIC_VERSION_1) return null;
    const ptype = (buf[0] >> 4) & 3;
    if (ptype == 1 or ptype == 3) return null; // 0-RTT, Retry
    const space: usize = if (ptype == 0) 0 else 1; // ptype 2 = handshake
    var pos: usize = 5;
    const dcil: usize = buf[pos];
    pos += 1;
    if (pos + dcil + 1 > buf.len) return null;
    pos += dcil;
    const scil: usize = buf[pos];
    pos += 1;
    if (pos + scil > buf.len) return null;
    pos += scil;
    if (space == 0) {
        const tlen = qvGet(buf, &pos) orelse return null;
        if (pos + tlen > buf.len) return null;
        pos += @intCast(tlen);
    }
    const pay_len = qvGet(buf, &pos) orelse return null;
    const pn_off = pos;
    const total = pos + @as(usize, @intCast(pay_len));
    if (total > buf.len) return null;
    // No keys for this space (e.g. a stray Initial after we dropped initial
    // keys): skip it but let coalesced siblings through.
    const ks = &conn.keys_rx[space];
    if (!ks.present) return total;
    // header protection
    if (pn_off + 4 + 16 > total) return null;
    var sample: [16]u8 = undefined;
    @memcpy(&sample, buf[pn_off + 4 .. pn_off + 20]);
    const mask = hpMask(ks, &sample);
    buf[0] ^= mask[0] & 0x0f;
    const pnl: usize = @intCast((buf[0] & 3) + 1);
    if (pn_off + pnl > total) return null;
    for (0..pnl) |i| buf[pn_off + i] ^= mask[1 + i];
    var wire: u64 = 0;
    for (0..pnl) |i| wire = (wire << 8) | buf[pn_off + i];
    const pn = pnExpand(wire, pnl, conn.rx_space[space].largest);
    const hdr_len = pn_off + pnl;
    const ct = buf[hdr_len..total];
    if (ct.len < 16) return null;
    const pt_buf = &conn.lane.pt_buf;
    if (ct.len - 16 > pt_buf.len) return null;
    const tag: *const [16]u8 = @ptrCast(ct[ct.len - 16 ..]);
    const nonce = pnNonce(&ks.iv, pn);
    gcmDecrypt(ks, pt_buf[0 .. ct.len - 16], ct[0 .. ct.len - 16], tag.*, buf[0..hdr_len], nonce) catch {
        return null;
    };
    quicRecordPn(conn, space, pn);
    quicOnFrames(conn, space, pn, pt_buf[0 .. ct.len - 16]);
    return total;
}

fn quicOnShort(conn: *QuicConn, buf: []u8) void {
    const space: usize = 2;
    const ks = &conn.keys_rx[space];
    if (!ks.present) return;
    const pn_off = 1 + conn.scid.len;
    if (buf.len < pn_off + 4 + 16) return;
    var sample: [16]u8 = undefined;
    @memcpy(&sample, buf[pn_off + 4 .. pn_off + 20]);
    const mask = hpMask(ks, &sample);
    buf[0] ^= mask[0] & 0x1f;
    const kbit = buf[0] & 0x04;
    const pnl: usize = @intCast((buf[0] & 3) + 1);
    for (0..pnl) |i| buf[pn_off + i] ^= mask[1 + i];
    var wire: u64 = 0;
    for (0..pnl) |i| wire = (wire << 8) | buf[pn_off + i];
    const pn = pnExpand(wire, pnl, conn.rx_space[space].largest);
    const hdr_len = pn_off + pnl;
    const ct = buf[hdr_len..];
    if (ct.len < 16) return;
    const pt_buf = &conn.lane.pt_buf;
    if (ct.len - 16 > pt_buf.len) return;
    const tag: *const [16]u8 = @ptrCast(ct[ct.len - 16 ..]);
    const nonce = pnNonce(&ks.iv, pn);
    gcmDecrypt(ks, pt_buf[0 .. ct.len - 16], ct[0 .. ct.len - 16], tag.*, buf[0..hdr_len], nonce) catch {
        return;
    };
    // Key-phase flip by the peer — we never initiate key updates, so a new
    // phase is a protocol violation: close loudly.
    if (kbit != conn.peer_kbit) {
        quicClose(conn, 0x0e, false); // KEY_UPDATE_ERROR
        return;
    }
    quicRecordPn(conn, space, pn);
    quicOnFrames(conn, space, pn, pt_buf[0 .. ct.len - 16]);
}

// ── timers: PTO / loss detection / idle ─────────────────────────────────────

fn quicPtoUs(conn: *QuicConn) i64 {
    const srtt = if (conn.smoothed_rtt_us < 0) 333_000 else conn.smoothed_rtt_us;
    const var4 = @max(4 * conn.rttvar_us, QUIC_K_GRANULARITY_US);
    return srtt + var4 + @as(i64, @intCast(conn.peer_max_ack_delay)) * 1000;
}

fn quicMsUntilDue(lane: *QuicLane) i64 {
    const now_ms = std.time.milliTimestamp();
    const now_us = std.time.microTimestamp();
    var best: i64 = std.math.maxInt(i64);
    var it = lane.conns.iterator();
    while (it.next()) |e| {
        const conn = e.value_ptr.*;
        if (conn.ack_due_now) return 0; // every 2nd ack-eliciting pkt: ack now
        if (conn.lane.flush_again) return 0; // guard hit with data queued
        var d: i64 = conn.idle_deadline_ms;
        if (conn.state == .draining) d = @min(d, conn.draining_until_ms);
        if (conn.loss_deadline_us > 0) d = @min(d, @divTrunc(conn.loss_deadline_us, 1000));
        if (conn.pto_base_us > 0) {
            const pto_us = conn.pto_base_us + (quicPtoUs(conn) << @intCast(@min(conn.pto_count, 20)));
            d = @min(d, @divTrunc(pto_us, 1000));
        }
        var si = conn.streams.iterator();
        while (si.next()) |se| {
            const s = se.value_ptr.*;
            if (s.park_until > 0) d = @min(d, s.park_until);
        }
        // any space with pending ack → wake soon (10ms)
        for (0..3) |sp| {
            if (conn.rx_space[sp].ack_pending) d = @min(d, now_ms + 5);
        }
        _ = now_us;
        if (d < best) best = d;
    }
    if (best == std.math.maxInt(i64)) return best;
    return @max(0, best - now_ms);
}

fn quicTick(lane: *QuicLane) void {
    const now_us = std.time.microTimestamp();
    const now_ms = std.time.milliTimestamp();
    var it = lane.conns.iterator();
    while (it.next()) |e| {
        const conn = e.value_ptr.*;
        if (conn.state == .dead) continue;
        if (now_ms >= conn.idle_deadline_ms) {
            conn.state = .dead;
            continue;
        }
        // loss detection per space
        for (0..3) |sp| {
            quicDetectLoss(conn, sp, now_us);
        }
        // DPLPMTUD (RFC 8899): one padded PING probe in flight, climbing
        // toward the peer's max_udp_payload_size. Lost → stop, never cwnd.
        if (conn.state == .app and conn.pmtu_idx < QUIC_PMTU_LADDER.len and now_ms >= conn.pmtu_retry_ms) {
            if (conn.pmtu_probe_pn >= 0) {
                if (now_us >= conn.pmtu_probe_deadline_us) {
                    conn.pmtu_fails += 1;
                    conn.pmtu_probe_pn = -1;
                    if (conn.pmtu_fails >= 3) { // RFC 8899 MAX_PROBES
                        conn.pmtu_fails = 0;
                        // give up only at the smallest step; otherwise
                        // re-attempt the whole climb after a backoff.
                        if (conn.pmtu_idx == 0) conn.pmtu_idx = 255
                        else conn.pmtu_retry_ms = now_ms + 10_000;
                    }
                }
            } else {
                conn.pmtu_fails = 0;
                const want: usize = @min(QUIC_PMTU_LADDER[conn.pmtu_idx], @as(usize, @intCast(@min(conn.peer_max_udp, 65527))));
                if (want <= conn.pmtu) conn.pmtu_idx = 255 else {
                    const n = quicBuildPacket(conn, 2, lane.dbuf[0..want], want, true, true, false);
                    if (n > 0 and quicSendDgram(conn, lane.dbuf[0..n])) {
                        const rec = &conn.tx_space[2].sent.items[conn.tx_space[2].sent.items.len - 1];
                        rec.pmtu_probe = true;
                        conn.pmtu_probe_pn = @intCast(rec.pn);
                        conn.pmtu_probe_size = n;
                        conn.pmtu_probe_deadline_us = now_us + 3 * quicPtoUs(conn);
                    }
                }
            }
        }
        // PTO: if unacked ack-eliciting exists and pto expired → probe
        var any_eliciting = false;
        chk: for (0..3) |sp_chk| {
            for (conn.tx_space[sp_chk].sent.items) |pkt| {
                if (pkt.ack_eliciting) {
                    any_eliciting = true;
                    break :chk;
                }
            }
        }
        if (!any_eliciting) conn.pto_base_us = 0;
        if (conn.pto_base_us > 0) {
            const due = conn.pto_base_us + (quicPtoUs(conn) << @intCast(@min(conn.pto_count, 20)));
            if (now_us >= due) {
                conn.pto_count += 1;
                conn.pto_base_us = now_us;
                // probe: force retransmit of oldest unacked in the lowest space with any
                for (0..3) |sp| {
                    if (conn.tx_space[sp].sent.items.len > 0) {
                        quicRequeueOldest(conn, sp);
                        break;
                    }
                }
                // ensure a packet goes out even if queues were empty
                if (!conn.probe_pending) conn.probe_pending = true;
            }
        }
    }
    quicFlush(lane);
}

fn quicRequeueOldest(conn: *QuicConn, space: usize) void {
    const sp = &conn.tx_space[space];
    if (sp.sent.items.len == 0) return;
    const p = &sp.sent.items[0];
    for (p.frames.items) |f| quicRequeueFrame(conn, space, f);
    p.time_us = 0;
    conn.bytes_in_flight -|= p.size;
    quicRecycleSentFrames(conn, p);
    _ = sp.sent.orderedRemove(0);
}

fn quicRequeueFrame(conn: *QuicConn, space: usize, f: QSentFrame) void {
    const a = conn.a();
    switch (f) {
        .ack => conn.rx_space[space].ack_pending = true,
        .crypto => |r| rangesAdd(&conn.ctx_retx[space], a, r.off, r.len) catch { quicClose(conn, 0x01, false); return; },
        .stream => |sf| {
            if (quicStreamGet(conn, sf.id, false)) |s| {
                rangesAdd(&s.sb_retx, a, sf.off, sf.len + @intFromBool(sf.fin)) catch { quicClose(conn, 0x01, false); return; };
                quicTxQueue(conn, s);
            }
        },
        .handshake_done, .max_data, .max_stream_data, .max_streams_bidi, .max_streams_uni, .path_response, .reset_stream => quicCtrlQueue(conn, f),
        .conn_close => |cc| conn.close_pending = .{ .conn_close = cc },
        .ping => conn.probe_pending = true,
    }
}

fn quicDetectLoss(conn: *QuicConn, space: usize, now_us: i64) void {
    const sp = &conn.tx_space[space];
    if (sp.sent.items.len == 0) return;
    const srtt = if (conn.smoothed_rtt_us < 0) 333_000 else conn.smoothed_rtt_us;
    const thresh_us = @divTrunc(9 * @max(conn.latest_rtt_us, srtt), 8) + QUIC_K_GRANULARITY_US;
    const largest_acked = sp.largest_acked;
    var i: usize = 0;
    var w: usize = 0; // compaction write index — same batched-removal shape
    // as quicOnAckRanges, not per-loss orderedRemove memmoves.
    var lost_any = false;
    while (i < sp.sent.items.len) : (i += 1) {
        const p = &sp.sent.items[i];
        // RFC 9002 §6.1: only packets sent before largest_acked can be lost —
        // time-threshold on newer packets would spuriously retransmit.
        const older = largest_acked >= 0 and p.pn < @as(u64, @intCast(largest_acked));
        const pkt_lost = (!p.pmtu_probe and largest_acked >= 0 and p.pn + QUIC_PKT_THRESH <= @as(u64, @intCast(largest_acked))) or
            (older and p.time_us > 0 and p.time_us + (if (p.pmtu_probe) 3 * thresh_us else thresh_us) <= now_us);
        if (!pkt_lost) {
            if (w != i) sp.sent.items[w] = sp.sent.items[i];
            w += 1;
            continue;
        }
        if (p.pmtu_probe) {
            conn.pmtu_fails += 1;
            if (conn.pmtu_fails >= 3) {
                conn.pmtu_fails = 0;
                if (conn.pmtu_idx == 0) conn.pmtu_idx = 255
                else conn.pmtu_retry_ms = std.time.milliTimestamp() + 10_000;
            }
            conn.pmtu_probe_pn = -1;
        } else {
            lost_any = true;
        }
        for (p.frames.items) |f| quicRequeueFrame(conn, space, f);
        conn.bytes_in_flight -|= p.size;
        quicRecycleSentFrames(conn, p);
    }
    sp.sent.items.len = w;
    if (lost_any) {
        // congestion: enter recovery once per round trip
        if (conn.recovery_start_us < now_us -| conn.smoothed_rtt_us or !conn.in_recovery) {
            conn.in_recovery = true;
            conn.recovery_start_us = now_us;
            conn.ssthresh = @max(conn.cwnd / 2, 2 * QUIC_MAX_DGRAM);
            conn.cwnd = conn.ssthresh;
        }
    }
    // recompute deadlines — only ack-eliciting packets arm the PTO.
    conn.pto_base_us = 0;
    var earliest: i64 = 0;
    for (0..3) |s| {
        const tsp = &conn.tx_space[s];
        for (tsp.sent.items) |pkt| {
            if (pkt.ack_eliciting and pkt.time_us > 0) {
                if (earliest == 0 or pkt.time_us < earliest) earliest = pkt.time_us;
                break;
            }
        }
    }
    conn.pto_base_us = earliest;
    conn.loss_deadline_us = if (earliest > 0) earliest + quicPtoUs(conn) else 0;
}

// ── response path: h3Reply mirrors h2Reply ──────────────────────────────────

// QPACK-encode one field line: indexed static where an exact pair match
// exists, else literal-with-name-reference against any static entry sharing
// the name, else literal-with-literal-name.
fn qpackEncodePair(out: []u8, name: []const u8, value: []const u8) usize {
    var n: usize = 0;
    // exact pair match → indexed static (T=1)
    for (QPACK_STATIC, 0..) |e, i| {
        if (std.mem.eql(u8, e.name, name) and std.mem.eql(u8, e.value, value)) {
            if (i < 63) {
                out[0] = 0x80 | 0x40 | @as(u8, @intCast(i));
                return 1;
            }
            // 6-bit prefix integer: 0xFF then 7-bit continuation of i-63
            out[0] = 0xFF;
            var v: u64 = i - 63;
            n = 1;
            while (v >= 128) {
                out[n] = @intCast((v & 0x7f) | 0x80);
                n += 1;
                v >>= 7;
            }
            out[n] = @intCast(v);
            return n + 1;
        }
    }
    // name match → literal with name ref (01 N=0 T=1 idx(4+))
    for (QPACK_STATIC, 0..) |e, i| {
        if (std.mem.eql(u8, e.name, name)) {
            if (i < 16) {
                out[0] = 0x40 | 0x10 | @as(u8, @intCast(i));
                n = 1;
            } else {
                n = qvPutSlice(out, @as(u64, i));
                // rebuild: 4-bit prefix int with 0101xxxx first byte
                out[0] = 0x50 | 0x0f;
                var rest: [8]u8 = undefined;
                const m = i - 15;
                var v: u64 = m;
                var k: usize = 0;
                while (v >= 128) { rest[k] = @intCast((v & 0x7f) | 0x80); k += 1; v >>= 7; }
                rest[k] = @intCast(v);
                @memcpy(out[1 .. 1 + k + 1], rest[0 .. k + 1]);
                n = 1 + k + 1;
            }
            n += h2EncodeStr(out[n..], value, false);
            return n;
        }
    }
    // literal name: 001 N=0 H=0 len(3+) name, H len(7+) value
    if (name.len < 8) {
        out[0] = 0x20 | @as(u8, @intCast(name.len));
        n = 1;
        @memcpy(out[1 .. 1 + name.len], name);
        n += name.len;
    } else {
        var rest: [8]u8 = undefined;
        var v = name.len - 7;
        var k: usize = 0;
        out[0] = 0x27;
        while (v >= 128) { rest[k] = @intCast((v & 0x7f) | 0x80); k += 1; v >>= 7; }
        rest[k] = @intCast(v);
        @memcpy(out[1 .. 1 + k + 1], rest[0 .. k + 1]);
        n = 1 + k + 1;
        @memcpy(out[n .. n + name.len], name);
        n += name.len;
    }
    n += h2EncodeStr(out[n..], value, false);
    return n;
}

fn h3Reply(s: *QStream, x: *Exchange, head: []const u8, body: []const u8, delay_ms: i64) bool {
    _ = x;
    const conn = s.conn;
    if (conn.state == .dead or conn.state == .draining) return false;
    // stream already reset by the peer (STOP_SENDING) or by us (R11) —
    // replying would touch a closing stream.
    if (s.reset or s.rst_acked) return false;
    // consistency assert for an invariant (a stream in ready can't be
    // freed): if this fires the invariant is broken, not just this reply.
    if (conn.streams.get(s.id) != s) return false;
    const a = conn.a();
    s.sb.clearRetainingCapacity();
    s.sb_hi = 0;
    s.sb_retx.clearRetainingCapacity();
    s.sb_acked.clearRetainingCapacity();
    s.sb_fin = true;
    // field section: RIC=0, base=0
    var fs: std.ArrayListUnmanaged(u8) = .{};
    defer fs.deinit(a);
    fs.appendSlice(a, &[2]u8{ 0, 0 }) catch return false;
    const status = if (head.len >= 12) head[9..12] else "200";
    var ebuf: [256]u8 = undefined;
    var en = qpackEncodePair(&ebuf, ":status", status);
    fs.appendSlice(a, ebuf[0..en]) catch return false;
    var cl_buf: [24]u8 = undefined;
    const cl = std.fmt.bufPrint(&cl_buf, "{}", .{body.len}) catch "0";
    en = qpackEncodePair(&ebuf, "content-length", cl);
    fs.appendSlice(a, ebuf[0..en]) catch return false;
    var ctype: []const u8 = "text/plain";
    if (std.mem.indexOf(u8, head, "Content-Type: ")) |at| {
        const vs = at + 14;
        const ve = std.mem.indexOfScalarPos(u8, head, vs, '\r') orelse head.len;
        ctype = head[vs..ve];
    }
    en = qpackEncodePair(&ebuf, "content-type", ctype);
    fs.appendSlice(a, ebuf[0..en]) catch return false;
    // static-h3 sends Accept-Encoding: br — a precompressed body's encoding
    // must reach the client or the bytes are mislabeled.
    if (std.mem.indexOf(u8, head, "Content-Encoding: ")) |at| {
        const vs = at + 18;
        const ve = std.mem.indexOfScalarPos(u8, head, vs, '\r') orelse head.len;
        en = qpackEncodePair(&ebuf, "content-encoding", head[vs..ve]);
        fs.appendSlice(a, ebuf[0..en]) catch return false;
    }
    if (std.mem.indexOf(u8, head, "Vary: ")) |at| {
        const vs = at + 6;
        const ve = std.mem.indexOfScalarPos(u8, head, vs, '\r') orelse head.len;
        en = qpackEncodePair(&ebuf, "vary", head[vs..ve]);
        fs.appendSlice(a, ebuf[0..en]) catch return false;
    }
    // HEADERS frame
    s.sb.append(a, 0x01) catch return false;
    qvPut(&s.sb, a, fs.items.len) catch return false;
    s.sb.appendSlice(a, fs.items) catch return false;
    // one DATA frame header; payload follows contiguously
    s.sb.append(a, 0x00) catch return false;
    qvPut(&s.sb, a, body.len) catch return false;
    s.sb.appendSlice(a, body) catch return false;
    if (delay_ms > 0) s.park_until = std.time.milliTimestamp() + delay_ms;
    quicTxQueue(conn, s);
    return true;
}

// db-obligation fallback on h3: the park machinery is TCP-only — answer 503
// exactly like the h1 dispatch does on a failed park.
fn h3Reply503(s: *QStream) void {
    const head = "HTTP/1.1 503 Service Unavailable\r\nContent-Length: 0\r\n\r\n";
    var x = Exchange{ .fd = 0, .raw = head };
    _ = h3Reply(s, &x, head, "", 0);
}
