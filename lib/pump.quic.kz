// ============================================================================
// pump.quic.kz — QUIC v1 + HTTP/3 for the io_uring pump.
// Joined via `~part quic` in pump.kz; merged into the pump module at load.
//
// RFC 9000 (transport), 9001 (TLS use via OpenSSL 3.5 third-party QUIC TLS
// API), 9002 (loss recovery + NewReno), 9114 (HTTP/3), 9204 (QPACK, static
// table only — our SETTINGS pin MAX_TABLE_CAPACITY=0 and BLOCKED_STREAMS=0).
//
// All per-connection state lives in QuicLane, embedded per-worker in the
// drive|io-uring W struct — SO_REUSEPORT hashes a client's 4-tuple to one
// worker, so no conn state is ever shared between workers.
// ============================================================================

const oss = if (HAS_OPENSSL) @import("root").koru_koru.koru_openssl.c else struct {};

const QUIC_VERSION_1: u32 = 0x00000001;
const QUIC_INITIAL_SALT = [20]u8{ 0x38, 0x76, 0x2c, 0xf7, 0xf5, 0x59, 0x34, 0xb3, 0x4d, 0x17, 0x9a, 0xe6, 0xa4, 0xc8, 0x0c, 0xad, 0xcc, 0xbb, 0x7f, 0x0a };
const QUIC_MAX_DGRAM: usize = 1200;
const QUIC_PMTU_LADDER = [_]usize{ 1452, 9000, 16384, 32768, 65527 };
const QUIC_IDLE_MS: i64 = 30_000;
const QUIC_SCID_LEN: usize = 8;
const QUIC_MAX_STREAMS_BIDI: u64 = 1024;
const QUIC_MAX_STREAMS_UNI: u64 = 64;
const QUIC_MAX_DATA: u64 = 64 * 1024 * 1024;
const QUIC_MAX_STREAM_DATA: u64 = 4 * 1024 * 1024;
const QUIC_K_GRANULARITY_US: i64 = 1000;
const QUIC_PKT_THRESH: u64 = 3;
const QUIC_CWND_INIT: usize = 10 * QUIC_MAX_DGRAM;

const AesHp = std.crypto.core.aes.Aes128;
const HkdfQ = std.crypto.kdf.hkdf.HkdfSha256;
const AesEncCtx = std.crypto.core.aes.AesEncryptCtx(AesHp);
const QGhash = std.crypto.onetimeauth.Ghash;
const QCtr = std.crypto.core.modes.ctr;
const GCM_ZEROS = [_]u8{0} ** 16;

// ── arm64 hardware AES ───────────────────────────────────────────────────────
// Zig 0.15.2's std.crypto.core.aes selects its armcrypto backend only when
// builtin.cpu declares .aarch64/.aes — and zig's native CPU detection in the
// build VM resolves "generic" (no aes), so std silently ships the software
// T-tables path while the silicon has aese/aesmc. This is a mirror of
// std.crypto.aes.armcrypto's AES-128 encrypt path (GCM and QUIC header
// protection never decrypt a block — no aesd/aesimc needed) plus a mirror of
// std.crypto.aead.aes_gcm's encrypt/decrypt with the Aes type pinned to the
// hardware impl. Selection is a runtime oracle — getauxval(AT_HWCAP) on
// linux, unconditional on darwin, the declared feature set elsewhere — the
// same contract koru_std's CRC pmull fold already uses. `.arch_extension aes`
// inside each asm block admits the crypto mnemonics the target doesn't
// declare; the branch keeps soft-AES silicon on the std path.

var qk_aes_state = std.atomic.Value(u8).init(0); // 0 unknown, 1 absent, 2 present

fn qkHwAes() bool {
    switch (qk_aes_state.load(.monotonic)) {
        1 => return false,
        2 => return true,
        else => {},
    }
    const builtin = @import("builtin");
    // HWCAP_AES = 1<<3 — kernel ABI bit.
    const v = if (builtin.cpu.arch != .aarch64)
        false
    else switch (builtin.os.tag) {
        .linux => std.os.linux.getauxval(std.elf.AT_HWCAP) & (1 << 3) != 0,
        .macos => true,
        else => std.Target.aarch64.featureSetHas(builtin.cpu.features, .aes),
    };
    qk_aes_state.store(if (v) 2 else 1, .monotonic);
    return v;
}

const HwAesBlock = struct {
    const Repr = @Vector(2, u64);

    pub const block_length: usize = 16;

    repr: Repr,

    pub fn fromBytes(bytes: *const [16]u8) HwAesBlock {
        const repr = std.mem.bytesToValue(Repr, bytes);
        return HwAesBlock{ .repr = repr };
    }

    pub fn toBytes(block: HwAesBlock) [16]u8 {
        return std.mem.toBytes(block.repr);
    }

    pub fn xorBytes(block: HwAesBlock, bytes: *const [16]u8) [16]u8 {
        const x = block.repr ^ fromBytes(bytes).repr;
        return std.mem.toBytes(x);
    }

    const zero = @Vector(2, u64){ 0, 0 };

    pub fn encrypt(block: HwAesBlock, round_key: HwAesBlock) HwAesBlock {
        return HwAesBlock{
            .repr = (asm (
                \\ .arch_extension aes
                \\ mov   %[out].16b, %[in].16b
                \\ aese  %[out].16b, %[zero].16b
                \\ aesmc %[out].16b, %[out].16b
                : [out] "=&w" (-> Repr),
                : [in] "w" (block.repr),
                  [zero] "w" (zero),
            )) ^ round_key.repr,
        };
    }

    pub fn encryptLast(block: HwAesBlock, round_key: HwAesBlock) HwAesBlock {
        return HwAesBlock{
            .repr = (asm (
                \\ .arch_extension aes
                \\ mov   %[out].16b, %[in].16b
                \\ aese  %[out].16b, %[zero].16b
                : [out] "=&w" (-> Repr),
                : [in] "w" (block.repr),
                  [zero] "w" (zero),
            )) ^ round_key.repr,
        };
    }

    pub fn xorBlocks(block1: HwAesBlock, block2: HwAesBlock) HwAesBlock {
        return HwAesBlock{ .repr = block1.repr ^ block2.repr };
    }

    pub const parallel = struct {
        pub const optimal_parallel_blocks = 6;

        pub fn encryptWide(comptime count: usize, blocks: [count]HwAesBlock, round_key: HwAesBlock) [count]HwAesBlock {
            comptime var i = 0;
            var out: [count]HwAesBlock = undefined;
            inline while (i < count) : (i += 1) {
                out[i] = blocks[i].encrypt(round_key);
            }
            return out;
        }

        pub fn encryptLastWide(comptime count: usize, blocks: [count]HwAesBlock, round_key: HwAesBlock) [count]HwAesBlock {
            comptime var i = 0;
            var out: [count]HwAesBlock = undefined;
            inline while (i < count) : (i += 1) {
                out[i] = blocks[i].encryptLast(round_key);
            }
            return out;
        }
    };
};

const HwAes128KeySchedule = struct {
    const rounds = 10;
    const Repr = HwAesBlock.Repr;

    const zero = @Vector(2, u64){ 0, 0 };
    const mask1 = @Vector(16, u8){ 13, 14, 15, 12, 13, 14, 15, 12, 13, 14, 15, 12, 13, 14, 15, 12 };

    round_keys: [rounds + 1]HwAesBlock,

    fn drc128(comptime rc: u8, t: Repr) Repr {
        var v1: Repr = undefined;
        var v2: Repr = undefined;
        var v3: Repr = undefined;
        var v4: Repr = undefined;

        return asm (
            \\ .arch_extension aes
            \\ movi %[v2].4s, %[rc]
            \\ tbl  %[v4].16b, {%[t].16b}, %[mask].16b
            \\ ext  %[r].16b, %[zero].16b, %[t].16b, #12
            \\ aese %[v4].16b, %[zero].16b
            \\ eor  %[v2].16b, %[r].16b, %[v2].16b
            \\ ext  %[r].16b, %[zero].16b, %[r].16b, #12
            \\ eor  %[v1].16b, %[v2].16b, %[t].16b
            \\ ext  %[v3].16b, %[zero].16b, %[r].16b, #12
            \\ eor  %[v1].16b, %[v1].16b, %[r].16b
            \\ eor  %[r].16b, %[v1].16b, %[v3].16b
            \\ eor  %[r].16b, %[r].16b, %[v4].16b
            : [r] "=&w" (-> Repr),
              [v1] "=&w" (v1),
              [v2] "=&w" (v2),
              [v3] "=&w" (v3),
              [v4] "=&w" (v4),
            : [rc] "N" (rc),
              [t] "w" (t),
              [zero] "w" (zero),
              [mask] "w" (mask1),
        );
    }

    fn expand128(t1: *HwAesBlock) HwAes128KeySchedule {
        var round_keys: [11]HwAesBlock = undefined;
        const rcs = [_]u8{ 1, 2, 4, 8, 16, 32, 64, 128, 27, 54 };
        inline for (rcs, 0..) |rc, round| {
            round_keys[round] = t1.*;
            t1.repr = drc128(rc, t1.repr);
        }
        round_keys[rcs.len] = t1.*;
        return .{ .round_keys = round_keys };
    }
};

const HwAes128EncCtx = struct {
    pub const block = HwAesBlock;
    pub const block_length = block.block_length;
    key_schedule: HwAes128KeySchedule,

    pub fn init(key: [16]u8) HwAes128EncCtx {
        var t1 = HwAesBlock.fromBytes(key[0..16]);
        return .{ .key_schedule = HwAes128KeySchedule.expand128(&t1) };
    }

    pub fn encrypt(ctx: HwAes128EncCtx, dst: *[16]u8, src: *const [16]u8) void {
        const round_keys = ctx.key_schedule.round_keys;
        var t = HwAesBlock.fromBytes(src).xorBlocks(round_keys[0]);
        comptime var i = 1;
        inline while (i < 10) : (i += 1) {
            t = t.encrypt(round_keys[i]);
        }
        t = t.encryptLast(round_keys[10]);
        dst.* = t.toBytes();
    }

    pub fn xor(ctx: HwAes128EncCtx, dst: *[16]u8, src: *const [16]u8, counter: [16]u8) void {
        const round_keys = ctx.key_schedule.round_keys;
        var t = HwAesBlock.fromBytes(&counter).xorBlocks(round_keys[0]);
        comptime var i = 1;
        inline while (i < 10) : (i += 1) {
            t = t.encrypt(round_keys[i]);
        }
        t = t.encryptLast(round_keys[10]);
        dst.* = t.xorBytes(src);
    }

    pub fn encryptWide(ctx: HwAes128EncCtx, comptime count: usize, dst: *[16 * count]u8, src: *const [16 * count]u8) void {
        const round_keys = ctx.key_schedule.round_keys;
        var ts: [count]HwAesBlock = undefined;
        comptime var j = 0;
        inline while (j < count) : (j += 1) {
            ts[j] = HwAesBlock.fromBytes(src[j * 16 .. j * 16 + 16][0..16]).xorBlocks(round_keys[0]);
        }
        comptime var i = 1;
        inline while (i < 10) : (i += 1) {
            ts = HwAesBlock.parallel.encryptWide(count, ts, round_keys[i]);
        }
        ts = HwAesBlock.parallel.encryptLastWide(count, ts, round_keys[i]);
        j = 0;
        inline while (j < count) : (j += 1) {
            dst[16 * j .. 16 * j + 16].* = ts[j].toBytes();
        }
    }

    pub fn xorWide(ctx: HwAes128EncCtx, comptime count: usize, dst: *[16 * count]u8, src: *const [16 * count]u8, counters: [16 * count]u8) void {
        const round_keys = ctx.key_schedule.round_keys;
        var ts: [count]HwAesBlock = undefined;
        comptime var j = 0;
        inline while (j < count) : (j += 1) {
            ts[j] = HwAesBlock.fromBytes(counters[j * 16 .. j * 16 + 16][0..16]).xorBlocks(round_keys[0]);
        }
        comptime var i = 1;
        inline while (i < 10) : (i += 1) {
            ts = HwAesBlock.parallel.encryptWide(count, ts, round_keys[i]);
        }
        ts = HwAesBlock.parallel.encryptLastWide(count, ts, round_keys[i]);
        j = 0;
        inline while (j < count) : (j += 1) {
            dst[16 * j .. 16 * j + 16].* = ts[j].xorBytes(src[16 * j .. 16 * j + 16]);
        }
    }
};

const HwAes128 = struct {
    pub const key_bits: usize = 128;
    pub const rounds = 10;
    pub const block = HwAesBlock;

    pub fn initEnc(key: [key_bits / 8]u8) HwAes128EncCtx {
        return HwAes128EncCtx.init(key);
    }
};

// Mirror of std.crypto.aead.aes_gcm.AesGcm — std's is a private generic we
// cannot instantiate against HwAes128, so the body is copied with the Aes
// type pinned. Ghash stays std's (its clmul is a private comptime pick on
// the same builtin.cpu that missed aes — vendoring it is a separate cost).
const HwAesGcm = struct {
    pub const tag_length = 16;
    pub const nonce_length = 12;
    pub const key_length = HwAes128.key_bits / 8;

    const Ghash = std.crypto.onetimeauth.Ghash;
    const zeros = [_]u8{0} ** 16;

    pub fn encrypt(ct: []u8, tag: *[tag_length]u8, m: []const u8, ad: []const u8, npub: [nonce_length]u8, key: [key_length]u8) void {
        std.debug.assert(ct.len == m.len);
        std.debug.assert(m.len <= 16 * ((1 << 32) - 2));

        const aes = HwAes128.initEnc(key);
        var h: [16]u8 = undefined;
        aes.encrypt(&h, &zeros);

        var t: [16]u8 = undefined;
        var j: [16]u8 = undefined;
        j[0..nonce_length].* = npub;
        std.mem.writeInt(u32, j[nonce_length..][0..4], 1, .big);
        aes.encrypt(&t, &j);

        const block_count = (std.math.divCeil(usize, ad.len, Ghash.block_length) catch unreachable) + (std.math.divCeil(usize, ct.len, Ghash.block_length) catch unreachable) + 1;
        var mac = Ghash.initForBlockCount(&h, block_count);
        mac.update(ad);
        mac.pad();

        std.mem.writeInt(u32, j[nonce_length..][0..4], 2, .big);
        std.crypto.core.modes.ctr(@TypeOf(aes), aes, ct, m, j, .big);
        mac.update(ct[0..m.len][0..]);
        mac.pad();

        var final_block = h;
        std.mem.writeInt(u64, final_block[0..8], @as(u64, ad.len) * 8, .big);
        std.mem.writeInt(u64, final_block[8..16], @as(u64, m.len) * 8, .big);
        mac.update(&final_block);
        mac.final(tag);
        for (t, 0..) |x, i| {
            tag[i] ^= x;
        }
    }

    pub fn decrypt(m: []u8, ct: []const u8, tag: [tag_length]u8, ad: []const u8, npub: [nonce_length]u8, key: [key_length]u8) std.crypto.errors.AuthenticationError!void {
        std.debug.assert(ct.len == m.len);

        const aes = HwAes128.initEnc(key);
        var h: [16]u8 = undefined;
        aes.encrypt(&h, &zeros);

        var t: [16]u8 = undefined;
        var j: [16]u8 = undefined;
        j[0..nonce_length].* = npub;
        std.mem.writeInt(u32, j[nonce_length..][0..4], 1, .big);
        aes.encrypt(&t, &j);

        const block_count = (std.math.divCeil(usize, ad.len, Ghash.block_length) catch unreachable) + (std.math.divCeil(usize, ct.len, Ghash.block_length) catch unreachable) + 1;
        var mac = Ghash.initForBlockCount(&h, block_count);
        mac.update(ad);
        mac.pad();

        mac.update(ct);
        mac.pad();

        var final_block = h;
        std.mem.writeInt(u64, final_block[0..8], @as(u64, ad.len) * 8, .big);
        std.mem.writeInt(u64, final_block[8..16], @as(u64, m.len) * 8, .big);
        mac.update(&final_block);
        var computed_tag: [Ghash.mac_length]u8 = undefined;
        mac.final(&computed_tag);
        for (t, 0..) |x, i| {
            computed_tag[i] ^= x;
        }

        const verify = std.crypto.timing_safe.eql([tag_length]u8, computed_tag, tag);
        if (!verify) {
            std.crypto.secureZero(u8, &computed_tag);
            @memset(m, undefined);
            return error.AuthenticationFailed;
        }

        std.mem.writeInt(u32, j[nonce_length..][0..4], 2, .big);
        std.crypto.core.modes.ctr(@TypeOf(aes), aes, m, ct, j, .big);
    }
};

// Packet-protection surface: qkHwAes() dispatches each op to HwAesGcm on
// aese-capable arm64, or to the cached-ctx soft path below otherwise. The
// dispatch lives inside gcmEncrypt/gcmDecrypt/hpMask — one layer, not two.

// ── env + ctx ────────────────────────────────────────────────────────────────

var h3_listen_port: u16 = 0;

fn h3PortEnv() u16 {
    const s = std.posix.getenv("H3_PORT") orelse return 0;
    return std.fmt.parseInt(u16, s, 10) catch 0;
}

fn quicAlpnSelect(ssl: ?*oss.SSL, out: [*c][*c]const u8, outlen: [*c]u8, in: [*c]const u8, inlen: c_uint, arg: ?*anyopaque) callconv(.c) c_int {
    _ = ssl;
    _ = arg;
    const list: [*c]const u8 = in;
    var i: usize = 0;
    while (i < inlen) {
        const l: usize = list[i];
        if (i + 1 + l > inlen) break;
        if (l == 2 and list[i + 1] == 'h' and list[i + 2] == '3') {
            out.* = list + i + 1;
            outlen.* = 2;
            return 0; // SSL_TLSEXT_ERR_OK
        }
        i += 1 + l;
    }
    return 2; // SSL_TLSEXT_ERR_ALERT_FATAL — h3-only policy
}

// The QUIC TLS ctx: TLS1.3 only, one ciphersuite so our AES-128-GCM packet
// crypto always matches the negotiated suite. No KTLS — QUIC owns the
// record layer entirely.
fn maybeStartH3(port_env: u16, cert_path: ?[]const u8, key_path: ?[]const u8) ?[]const u8 {
    if (!HAS_OPENSSL) {
        return if (port_env != 0) "H3_PORT set, but this target cannot link openssl" else null;
    }
    if (port_env == 0) return null;
    const cert = cert_path orelse "/certs/server.crt";
    const key = key_path orelse "/certs/server.key";
    var cz: [256]u8 = undefined;
    var kz: [256]u8 = undefined;
    if (cert.len >= cz.len or key.len >= kz.len) return "h3: cert path too long";
    @memcpy(cz[0..cert.len], cert);
    cz[cert.len] = 0;
    @memcpy(kz[0..key.len], key);
    kz[key.len] = 0;
    const ctx = oss.SSL_CTX_new(oss.TLS_method());
    if (ctx == null) return "h3: SSL_CTX_new failed";
    _ = oss.SSL_CTX_set_min_proto_version(ctx, oss.TLS1_3_VERSION);
    _ = oss.SSL_CTX_set_max_proto_version(ctx, oss.TLS1_3_VERSION);
    if (oss.SSL_CTX_set_ciphersuites(ctx, "TLS_AES_128_GCM_SHA256") != 1) {
        oss.SSL_CTX_free(ctx);
        return "h3: SSL_CTX_set_ciphersuites failed";
    }
    if (oss.SSL_CTX_use_certificate_chain_file(ctx, @ptrCast(&cz)) != 1) {
        oss.SSL_CTX_free(ctx);
        return "h3: certificate chain load failed";
    }
    if (oss.SSL_CTX_use_PrivateKey_file(ctx, @ptrCast(&kz), oss.SSL_FILETYPE_PEM) != 1) {
        oss.SSL_CTX_free(ctx);
        return "h3: private key load failed";
    }
    oss.SSL_CTX_set_alpn_select_cb(ctx, quicAlpnSelect, null);
    quic_ssl_ctx = ctx;
    h3_listen_port = port_env;
    return null;
}

var quic_ssl_ctx: ?*oss.SSL_CTX = null;

// ── dual-stack UDP socket ────────────────────────────────────────────────────

fn openQuicSocket(port: u16) ?posix.fd_t {
    const fd = posix.socket(posix.AF.INET6, posix.SOCK.DGRAM | posix.SOCK.NONBLOCK | posix.SOCK.CLOEXEC, 0) catch return null;
    const one = std.mem.toBytes(@as(c_int, 1));
    const zero = std.mem.toBytes(@as(c_int, 0));
    posix.setsockopt(fd, posix.IPPROTO.IPV6, 26, &zero) catch { // IPV6_V6ONLY off — v4 arrives mapped
        posix.close(fd);
        return null;
    };
    posix.setsockopt(fd, posix.SOL.SOCKET, posix.SO.REUSEPORT, &one) catch {
        posix.close(fd);
        return null;
    };
    var addr = std.net.Address.initIp6([_]u8{0} ** 16, port, 0, 0);
    posix.bind(fd, &addr.any, addr.getOsSockLen()) catch {
        posix.close(fd);
        return null;
    };
    return fd;
}

// ── varint ───────────────────────────────────────────────────────────────────

fn qvLen(v: u64) usize {
    if (v < 1 << 6) return 1;
    if (v < 1 << 14) return 2;
    if (v < 1 << 30) return 4;
    return 8;
}

fn qvPut(out: *std.ArrayListUnmanaged(u8), a: std.mem.Allocator, v: u64) error{OutOfMemory}!void {
    var b: [8]u8 = undefined;
    const n = qvPutSlice(&b, v);
    try out.appendSlice(a, b[0..n]);
}

fn qvPutSlice(b: []u8, v: u64) usize {
    if (v < 1 << 6) {
        b[0] = @intCast(v);
        return 1;
    }
    if (v < 1 << 14) {
        b[0] = 0x40 | @as(u8, @intCast(v >> 8));
        b[1] = @intCast(v & 0xff);
        return 2;
    }
    if (v < 1 << 30) {
        std.mem.writeInt(u32, b[0..4], @intCast(v), .big);
        b[0] |= 0x80;
        return 4;
    }
    std.mem.writeInt(u64, b[0..8], v, .big);
    b[0] |= 0xc0;
    return 8;
}

fn qvGet(buf: []const u8, pos: *usize) ?u64 {
    if (pos.* >= buf.len) return null;
    const b0 = buf[pos.*];
    switch (b0 >> 6) {
        0 => {
            pos.* += 1;
            return b0;
        },
        1 => {
            if (pos.* + 2 > buf.len) return null;
            const v = (@as(u64, b0 & 0x3f) << 8) | buf[pos.* + 1];
            pos.* += 2;
            return v;
        },
        2 => {
            if (pos.* + 4 > buf.len) return null;
            const v = @as(u64, std.mem.readInt(u32, buf[pos.*..][0..4], .big) & 0x3fffffff);
            pos.* += 4;
            return v;
        },
        else => {
            if (pos.* + 8 > buf.len) return null;
            const v = std.mem.readInt(u64, buf[pos.*..][0..8], .big) & 0x3fffffffffffffff;
            pos.* += 8;
            return v;
        },
    }
}

// ── offset ranges (recv pn sets, stream/crypto reassembly) ──────────────────

const QRange = struct { off: u64, len: u64 };

fn rangesAdd(rs: *std.ArrayListUnmanaged(QRange), a: std.mem.Allocator, off: u64, len: u64) error{OutOfMemory}!void {
    if (len == 0) return;
    // Insertion keeps the list sorted ascending by off, merging overlaps.
    var no = off;
    var ne = off + len;
    var i: usize = 0;
    while (i < rs.items.len) {
        const r = rs.items[i];
        if (r.off + r.len < no) {
            i += 1;
            continue;
        }
        if (r.off > ne) break;
        no = @min(no, r.off);
        ne = @max(ne, r.off + r.len);
        _ = rs.orderedRemove(i);
    }
    rs.insert(a, i, .{ .off = no, .len = ne - no }) catch |e| return e;
}

fn rangesHas(rs: *const std.ArrayListUnmanaged(QRange), off: u64) bool {
    for (rs.items) |r| {
        if (off < r.off) return false;
        if (off < r.off + r.len) return true;
    }
    return false;
}

// Contiguous prefix length: how far ranges reach from 0 without a gap.
fn rangesContig(rs: *const std.ArrayListUnmanaged(QRange)) u64 {
    var end: u64 = 0;
    for (rs.items) |r| {
        if (r.off > end) break;
        end = @max(end, r.off + r.len);
    }
    return end;
}

fn rangesCover(rs: *const std.ArrayListUnmanaged(QRange), off: u64, len: u64) bool {
    const need_end = off + len;
    for (rs.items) |r| {
        if (r.off > off) return false;
        if (r.off + r.len >= need_end) return true;
    }
    return false;
}

// ── QUIC TLS key derivation (RFC 9001 §5) ────────────────────────────────────

const QKeys = struct {
    key: [16]u8 = undefined,
    iv: [12]u8 = undefined,
    hp: [16]u8 = undefined,
    // Expanded AES contexts + the GHASH subkey, expanded once per secret.
    // Before this, every packet paid a full AES key expansion twice: once
    // inside AesGcm.encrypt/decrypt and once inside hpMask's initEnc.
    enc_ctx: AesEncCtx = undefined,
    hp_ctx: AesEncCtx = undefined,
    ghash_h: [16]u8 = undefined, // H = E(key, 0) — depends on the key only
    // Hardware path (aarch64 + HWCAP_AES): hp gets the same cached-ctx
    // treatment — hw expansion is cheap but still per-call otherwise.
    // Payload encrypt/decrypt goes through HwAesGcm, which mirrors std's
    // key-in API; ghash_h/enc_ctx stay the soft path's cache.
    hw_aes: bool = false,
    hw_hp_ctx: HwAes128EncCtx = undefined,
    present: bool = false,
};

fn hkdfLabel(secret: []const u8, label: []const u8, out: []u8) void {
    var info: [64]u8 = undefined;
    var n: usize = 0;
    std.mem.writeInt(u16, info[n..][0..2], @intCast(out.len), .big);
    n += 2;
    const full_len = 6 + label.len;
    info[n] = @intCast(full_len);
    n += 1;
    @memcpy(info[n .. n + 6], "tls13 ");
    n += 6;
    @memcpy(info[n .. n + label.len], label);
    n += label.len;
    info[n] = 0;
    n += 1;
    var prk: [32]u8 = undefined;
    @memcpy(&prk, secret[0..32]);
    HkdfQ.expand(out, info[0..n], prk);
}

fn keysFromSecret(ks: *QKeys, secret: []const u8) void {
    hkdfLabel(secret, "quic key", &ks.key);
    hkdfLabel(secret, "quic iv", &ks.iv);
    hkdfLabel(secret, "quic hp", &ks.hp);
    ks.enc_ctx = AesHp.initEnc(ks.key);
    ks.hp_ctx = AesHp.initEnc(ks.hp);
    ks.enc_ctx.encrypt(&ks.ghash_h, &GCM_ZEROS);
    if (comptime @import("builtin").cpu.arch == .aarch64) {
        ks.hw_aes = qkHwAes();
        if (ks.hw_aes) ks.hw_hp_ctx = HwAes128.initEnc(ks.hp);
    }
    ks.present = true;
}

fn initialSecrets(dcid: []const u8, client_secret: *[32]u8, server_secret: *[32]u8) void {
    const prk = HkdfQ.extract(&QUIC_INITIAL_SALT, dcid);
    hkdfLabel(&prk, "client in", client_secret);
    hkdfLabel(&prk, "server in", server_secret);
}

fn pnNonce(iv: *const [12]u8, pn: u64) [12]u8 {
    var n = iv.*;
    var p: [8]u8 = undefined;
    std.mem.writeInt(u64, &p, pn, .big);
    for (0..8) |i| n[4 + i] ^= p[i];
    return n;
}

