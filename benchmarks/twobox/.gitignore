# Build artifacts and machine state — regenerated by run.sh every time, and
# large enough to matter (two 25 MB binaries and a 29 MB tarball).
.stage/
.hosts

# The parent .gitignore has a bare `server` rule, which matches a directory of
# that name at ANY depth — so the harness's own server/ was silently untracked
# and a fresh clone could not run it.
!server/
