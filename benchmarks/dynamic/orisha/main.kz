// Orisha Dynamic Benchmark - Using the Router DSL
//
// Tests the ~orisha:router pattern-matching syntax with a real server
// Endpoints: /plaintext, /json, /api/health, /api/users/:id
//
// Run: koruc main.kz && ./a.out

~import orisha
~import koru/sqlite3
const std = @import("std");
const c = koru_koru.koru_sqlite3.c;

// Vendored amalgamation — the same sqlite3.c rusqlite's bundled feature
// compiles (sqlite 3.53.2), but built LEAN (benchmarks/build_sqlite.sh):
// no FTS/RTREE/SOUNDEX/STAT4/load-extension/memory-management. Those all
// register per-open work the cold leg pays on every request. FLAVOR=bundled
// reproduces rusqlite's exact flags for same-internals verification.
~std/build:requires {
    exe.addObjectFile(.{ .cwd_relative = "sqlite3_amalg.o" });
}

// Build JSON body for /api/users/:id (upstream formatting)
fn userJsonBody(id: []const u8) []const u8 {
    const S = struct {
        threadlocal var buf: [256]u8 = undefined;
    };

    return std.fmt.bufPrint(&S.buf, "{{\"id\":\"{s}\",\"name\":\"User {s}\"}}", .{ id, id }) catch id;
}

// DB leg: full driver path per request — open, prepare, bind, step, close.
// `id` is borrowed from the request frame; destructor null (SQLITE_STATIC)
// is safe because step+finalize happen inside this call.
fn dbUserJson(id: []const u8) ?[]const u8 {
    const S = struct {
        threadlocal var buf: [256]u8 = undefined;
    };
    var db: ?*c.sqlite3 = null;
    if (c.sqlite3_open_v2("../bench.db", &db, c.SQLITE_OPEN_READWRITE | c.SQLITE_OPEN_NOMUTEX | c.SQLITE_OPEN_URI | c.SQLITE_OPEN_PRIVATECACHE, null) != c.SQLITE_OK) return null;
    defer _ = c.sqlite3_close(db);
    var stmt: ?*c.sqlite3_stmt = null;
    const sql = "SELECT name FROM users WHERE id = ?1";
    if (c.sqlite3_prepare_v2(db, sql, sql.len, &stmt, null) != c.SQLITE_OK) return null;
    defer _ = c.sqlite3_finalize(stmt);
    _ = c.sqlite3_bind_text(stmt, 1, id.ptr, @intCast(id.len), null);
    if (c.sqlite3_step(stmt) == c.SQLITE_ROW) {
        const name = std.mem.span(c.sqlite3_column_text(stmt, 0));
        return std.fmt.bufPrint(&S.buf, "{{\"id\":\"{s}\",\"name\":\"{s}\"}}", .{ id, name }) catch "{}";
    }
    return "{}";
}

// Persistent leg: one connection + one prepared statement per worker thread,
// lazily opened — the shape a real service takes. Per request: bind, step,
// reset, clear. `id` is borrowed from the request frame; SQLITE_STATIC is safe
// for the same reason as in dbUserJson.
fn dbUserJsonHot(id: []const u8) ?[]const u8 {
    const S = struct {
        threadlocal var buf: [256]u8 = undefined;
        threadlocal var db: ?*c.sqlite3 = null;
        threadlocal var stmt: ?*c.sqlite3_stmt = null;
    };
    if (S.stmt == null) {
        if (c.sqlite3_open_v2("../bench.db", &S.db, c.SQLITE_OPEN_READWRITE | c.SQLITE_OPEN_NOMUTEX | c.SQLITE_OPEN_URI | c.SQLITE_OPEN_PRIVATECACHE, null) != c.SQLITE_OK) return null;
        const sql = "SELECT name FROM users WHERE id = ?1";
        if (c.sqlite3_prepare_v2(S.db, sql, sql.len, &S.stmt, null) != c.SQLITE_OK) return null;
    }
    defer {
        _ = c.sqlite3_reset(S.stmt);
        _ = c.sqlite3_clear_bindings(S.stmt);
    }
    _ = c.sqlite3_bind_text(S.stmt, 1, id.ptr, @intCast(id.len), null);
    if (c.sqlite3_step(S.stmt) == c.SQLITE_ROW) {
        const name = std.mem.span(c.sqlite3_column_text(S.stmt, 0));
        return std.fmt.bufPrint(&S.buf, "{{\"id\":\"{s}\",\"name\":\"{s}\"}}", .{ id, name }) catch "{}";
    }
    return "{}";
}

~tor dbUserHot { id: string } -> orisha:Response
~proc dbUserHot|zig {
    if (dbUserJsonHot(id)) |body| {
        return .{ .status = 200, .body = body, .content_type = "application/json" };
    }
    return .{ .status = 500, .body = "{\"error\":\"db\"}", .content_type = "application/json" };
}

~tor dbUser { id: string } -> orisha:Response
~proc dbUser|zig {
    if (dbUserJson(id)) |body| {
        return .{ .status = 200, .body = body, .content_type = "application/json" };
    }
    return .{ .status = 500, .body = "{\"error\":\"db\"}", .content_type = "application/json" };
}

~tor userJson { id: string } -> orisha:Response
~proc userJson|zig {
    return .{ .status = 200, .body = userJsonBody(id), .content_type = "application/json" };
}

// Package leg: the driver path a real Koru program writes — libs/sqlite3's
// own API end to end (open → Source-block query → close per request). The
// row text is a row-scoped borrow, so pkgRow materializes it into a
// per-thread cell before the borrow dies; pkgDone reads it at the terminal.
fn pkgCell() *?[]const u8 {
    const S = struct {
        threadlocal var body: ?[]const u8 = null;
    };
    return &S.body;
}
fn pkgBuf() *[256]u8 {
    const S = struct {
        threadlocal var buf: [256]u8 = undefined;
    };
    return &S.buf;
}

~tor pkgBegin { }
~proc pkgBegin|zig {
    pkgCell().* = null;
}

~tor pkgRow { id: string, name: string }
~proc pkgRow|zig {
    pkgCell().* = std.fmt.bufPrint(pkgBuf(), "{{\"id\":\"{s}\",\"name\":\"{s}\"}}", .{ id, name }) catch "{}";
}

~tor pkgDone { id: string } -> orisha:Response
~proc pkgDone|zig {
    _ = id;
    return .{ .status = 200, .body = pkgCell().* orelse "{}", .content_type = "application/json" };
}

~tor pkgErr { } -> orisha:Response
~proc pkgErr|zig {
    return .{ .status = 500, .body = "{\"error\":\"db\"}", .content_type = "application/json" };
}

~tor dbUserPkg { id: string } -> orisha:Response
~dbUserPkg = pkgBegin() |> koru/sqlite3:open(path: "../bench.db")
| db d |> koru/sqlite3:default(conn: d) {
        SELECT name FROM users WHERE id = {{id}}
    }
    ! row r |> koru/sqlite3:col.text(stmt: r, index: 0): n |> pkgRow(id, name: n)
    | done d2 |> koru/sqlite3:close(conn: d2) |> pkgDone(id): r -> r
    | err e |> koru/sqlite3:close(e.conn) |> pkgErr(): r -> r
| err _ |> pkgErr(): r -> r

// Implement the handler as a subflow with router
// Log-guided order based on access.log (most frequent first)
~orisha:handler = orisha:router(req)
! [GET /api/db/hot/users/:id] p |> dbUserHot(p.id)
! [GET /api/db/pkg/users/:id] p |> dbUserPkg(p.id)
! [GET /api/db/users/:id] p |> dbUser(p.id)
! [GET /api/users/:id] p |> userJson(p.id)
! [GET /json] -> { status: 200, body: "{\"message\":\"Hello, World!\"}", content_type: "application/json" }
! [GET /api/health] -> { status: 200, body: "{\"status\":\"ok\"}", content_type: "application/json" }
! [GET /plaintext] -> { status: 200, body: "Hello, World!", content_type: "text/plain" }
! [*] -> { status: 404, body: "Not Found", content_type: "text/plain" }

// Start the server
~orisha:serve(port: 3100)
| shutdown _ |> _
| failed _ |> _
